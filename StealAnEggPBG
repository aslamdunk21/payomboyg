local function getRarityColor(rarityStr)
    local str = tostring(rarityStr or ""):lower()
    if str:find("secret") or str:find("divine") then
        return Color3.fromRGB(255, 0, 0)
    elseif str:find("legendary") then
        return Color3.fromRGB(255, 140, 0)
    elseif str:find("mythic") then
        return Color3.fromRGB(238, 130, 238)
    elseif str:find("epic") then
        return Color3.fromRGB(128, 0, 128)
    elseif str:find("rare") then
        return Color3.fromRGB(0, 191, 255)
    elseif str:find("uncommon") then
        return Color3.fromRGB(50, 205, 50)
    else
        return Color3.fromRGB(169, 169, 169)
    end
end

local function applyEggESP(key, name, rarity, area)
    pcall(function()
        local oldEsp = ESPFolder:FindFirstChild(key:GetDebugId())
        if oldEsp then oldEsp:Destroy() end

        if not Config.EggESP then return end

        local container = Instance.new("Folder")
        container.Name = key:GetDebugId()
        container.Parent = ESPFolder

        local color = getRarityColor(rarity)

        local highlight = Instance.new("Highlight")
        highlight.FillColor = color
        highlight.FillTransparency = 0.55
        highlight.OutlineColor = Color3.new(1, 1, 1)
        highlight.OutlineTransparency = 0.15
        highlight.Adornee = key
        highlight.Parent = container

        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = 500
        billboard.ExtentsOffset = Vector3.new(0, 3, 0)
        billboard.Adornee = key
        billboard.Parent = container

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = color
        textLabel.TextStrokeTransparency = 0
        textLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.TextSize = 14
        textLabel.Parent = billboard

        local connection
        connection = RunService.Heartbeat:Connect(function()
            if not key or not key.Parent or not container.Parent then
                connection:Disconnect()
                return
            end
            local char = LocalPlayer.Character
            local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
            if root then
                local pos = key:IsA("Model") and key:GetPivot().Position or (key:IsA("BasePart") and key.Position or Vector3.zero)
                local dist = math.floor((pos - root.Position).Magnitude)
                textLabel.Text = string.format("%s\n[%s] - %d studs\n(%s)", name, rarity, dist, area)
            else
                textLabel.Text = string.format("%s\n[%s]\n(%s)", name, rarity, area)
            end
        end)
    end)
end

local function clearEggESP(key)
    pcall(function()
        local oldEsp = ESPFolder:FindFirstChild(key:GetDebugId())
        if oldEsp then oldEsp:Destroy() end
    end)
end

local function updateAllESP()
    ESPFolder:ClearAllChildren()
    if Config.EggESP then
        for key, data in pairs(EggCache.Eggs) do
            applyEggESP(key, data.Name, data.Rarity, data.Area)
        end
    end
end

local function isWildEggTarget(inst)
    if not inst then return false end
    local plotsFolder = Workspace:FindFirstChild("Plots") or (Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Plots"))
    local rendersFolder = Workspace:FindFirstChild("PlacedEggRenders")
    if (plotsFolder and inst:IsDescendantOf(plotsFolder)) or (rendersFolder and inst:IsDescendantOf(rendersFolder)) then
        return false
    end

    if inst:IsA("ProximityPrompt") then
        return true
    elseif inst:IsA("Model") or inst:IsA("BasePart") then
        local nameLower = inst.Name:lower()
        if (nameLower:find("egg") or inst:GetAttribute("EggId") or inst:GetAttribute("IsEgg") or inst:FindFirstChildWhichIsA("ProximityPrompt", true)) and not nameLower:find("render") then
            return true
        end
    end
    return false
end

local function addEggToCache(inst)
    if not inst then return end
    if isWildEggTarget(inst) then
        local pos = nil
        local prompt = inst:IsA("ProximityPrompt") and inst or inst:FindFirstChildWhichIsA("ProximityPrompt", true)

        if inst:IsA("BasePart") then
            pos = inst.Position
        elseif inst:IsA("Model") then
            pos = (inst.PrimaryPart and inst.PrimaryPart.Position) or (inst:FindFirstChildWhichIsA("BasePart", true) and inst:FindFirstChildWhichIsA("BasePart", true).Position) or inst:GetPivot().Position
        elseif inst:IsA("ProximityPrompt") and inst.Parent then
            local parent = inst.Parent
            pos = parent:IsA("BasePart") and parent.Position or (parent:IsA("Model") and (parent.PrimaryPart and parent.PrimaryPart.Position or parent:GetPivot().Position) or nil)
        end

        if pos then
            local key = inst:IsA("ProximityPrompt") and (inst.Parent or inst) or inst
            local rarity = inst:GetAttribute("Rarity") or (inst.Parent and inst.Parent:GetAttribute("Rarity")) or inst.Name
            local area = "ALL"
            local curr = key
            while curr and curr ~= Workspace do
                local name = curr.Name
                for _, a in ipairs({ "Forest", "Lake", "Jungle", "Snow", "Desert", "Volcano", "Prehistoric", "Abyss Ocean", "Abyss", "Cosmic" }) do
                    if name:lower():find(a:lower()) then
                        area = a
                        break
                    end
                end
                curr = curr.Parent
            end

            local discoveredUid, uidSource = findEggUid(key)
            -- Also scan all attributes for FirstAreaSlotKey / SlotKey
            local slotKey = key:GetAttribute("FirstAreaSlotKey") or key:GetAttribute("SlotKey")
            if not slotKey then
                local ok2, attrs2 = pcall(function() return key:GetAttributes() end)
                if ok2 and attrs2 then
                    for attrName, attrVal in pairs(attrs2) do
                        if type(attrVal) == "string" and attrName:lower():find("slot") then
                            slotKey = attrVal
                            break
                        end
                    end
                end
            end
            EggCache.Eggs[key] = {
                Part = key,
                Prompt = prompt,
                Name = key.Name,
                Rarity = tostring(rarity),
                Area = area,
                Position = pos,
                Uid = discoveredUid,        -- found via findEggUid (any attribute name)
                UidSource = uidSource,      -- which attribute it came from (for debugging)
                FirstAreaSlotKey = slotKey,
            }
            applyEggESP(key, key.Name, rarity, area)
        end
    end
end

local function removeEggFromCache(inst)
    if EggCache.Eggs[inst] then
        clearEggESP(inst)
        EggCache.Eggs[inst] = nil
    end
    for part, data in pairs(EggCache.Eggs) do
        if data.Prompt == inst or data.Part == inst then
            clearEggESP(part)
            EggCache.Eggs[part] = nil
        end
    end
end

function EggCache.GetBestEgg(targetArea, minRarityFilter, eggTypeFilter, myPos)
    local bestData = nil
    local shortestDist = math.huge

    for key, data in pairs(EggCache.Eggs) do
        local inst = data.Part
        if inst and inst.Parent then
            local areaMatch = (targetArea == "ALL" or data.Area == "ALL" or data.Area:lower():find(targetArea:lower()) or matchesArea(inst, targetArea))
            if areaMatch and MeetsStealFilter(data.Rarity, data.Name, data.Area) then
                local eggPos = data.Position
                local dist = myPos and (eggPos - myPos).Magnitude or 0
                if dist < shortestDist then
                    shortestDist = dist
                    bestData = data
                end
            end
        else
            EggCache.Eggs[key] = nil
        end
    end

    return bestData
end

local function initEggCache()
    if EggCache.Initialized then return end
    EggCache.Initialized = true

    local searchContainers = {
        Workspace:FindFirstChild("Map"),
        Workspace:FindFirstChild("AreaEggs"),
        Workspace:FindFirstChild("WildEggs"),
        Workspace:FindFirstChild("Eggs"),
        Workspace
    }

    for _, container in ipairs(searchContainers) do
        if container then
            for _, obj in pairs(container:GetDescendants()) do
                pcall(function() addEggToCache(obj) end)
            end
            table.insert(EggCache.Listeners, container.DescendantAdded:Connect(function(desc)
                pcall(function() addEggToCache(desc) end)
            end))
            table.insert(EggCache.Listeners, container.DescendantRemoving:Connect(function(desc)
                pcall(function() removeEggFromCache(desc) end)
            end))
        end
    end
end

task.spawn(initEggCache)

