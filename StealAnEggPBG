Guardless.SlotIdentity = safeRequire((Shared and Shared:FindFirstChild("Util") and Shared.Util:FindFirstChild("AreaEggSlotIdentity")) or findModule("AreaEggSlotIdentity"))

function Guardless.slotKey(rec)
    if not (Guardless.SlotIdentity and rec and rec.Uid) then return nil end
    local ok, isFirst = pcall(Guardless.SlotIdentity.IsFirstAreaUid, rec.Uid)
    if not (ok and isFirst) then return nil end
    local okk, key = pcall(Guardless.SlotIdentity.BuildSlotKey, rec.AreaId, rec.NestId)
