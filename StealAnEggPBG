----------------------------------------------------------------
-- SpeedBypass — getgc hook ล้าง metatable anti-speed check
-- เทคนิคเดียวกับค่าย paid hub:
--   1. getgc() → scan closures ทั้งหมดใน VM
--   2. หา anti-speed closure โดย upvalue signature (nups=19, line=3)
--   3. hookfunction → ใส่ setmetatable({}) บน table ที่ anti-cheat ส่งมา
--      → ทำให้ __index / __newindex check ล้มเหลว → ไม่ kick
-- ถ้า executor ไม่รองรับ getgc หรือบน มือถือ → fallback Heartbeat enforce
----------------------------------------------------------------
do
    local bypassOk = false

    if not isMobileDevice and typeof(getgc) == "function" and typeof(hookfunction) == "function"
        and typeof(islclosure) == "function" then

        local function findAntiSpeedFunc(nups, linedef)
            local ok, gc = pcall(getgc)
            if not ok or not gc then return nil end
            for _, f in next, gc do
                if typeof(f) == "function" and islclosure(f) then
                    local okUp, upvs = pcall(debug.getupvalues, f)
                    local okInfo, line = pcall(debug.info, f, "l")
                    if okUp and okInfo and upvs and type(upvs) == "table" and #upvs == nups and line == linedef then
                        -- extra check: upvalue 3 เป็น table ที่มี Humanoid key
                        if nups == 19 then
                            local okUp3, t = pcall(debug.getupvalue, f, 3)
                            if okUp3 and typeof(t) == "table" and rawget(t, "Humanoid") then
                                return f
                            end
                        else
                            return f
                        end
                    end
                end
            end
            return nil
        end

        local okTarget, target = pcall(findAntiSpeedFunc, 19, 3)
        if okTarget and target then
            local okInner, inner = pcall(debug.getupvalue, target, 2)
            if okInner and inner and typeof(inner) == "function" then
                local okHook = pcall(function()
                    local original; original = hookfunction(inner, newlclosure(function(p1, p2)
                        -- ล้าง metatable ของ velocity/state table → speed check ผ่าน
                        if p2 and typeof(p2) == "table" then
                            pcall(setmetatable, p2, {})
                        end
                        return original(p1, p2)
                    end))
                end)
                if okHook then
                    bypassOk = true
                    logLine("init", "SpeedBP: hookfunction anti-speed สำเร็จ (gc scan)")
                end
            end
        end
    end

    if not bypassOk then
        -- fallback: Heartbeat enforce เหมือน SpeedBP แต่ไม่ hook
        -- ใช้กับ executor ที่ไม่มี getgc หรืออุปกรณ์มือถือ
        RunService.Heartbeat:Connect(function()
            local hum = humanoid()
            if hum and hum.WalkSpeed < (Cfg.BoostWalkSpeed or 16) then
                pcall(function() hum.WalkSpeed = Cfg.BoostWalkSpeed or 16 end)
            end
        end)
        logLine("init", "SpeedBP: fallback Heartbeat enforce (safe mode)")
    end
end

