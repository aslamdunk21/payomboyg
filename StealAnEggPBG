local function GetAreaEggRecordsList()
    local snap
    local ok = false
    if EggCmds and type(EggCmds.GetAreaEggSnapshot) == "function" then
        ok, snap = pcall(EggCmds.GetAreaEggSnapshot)
    end
    if not (ok and type(snap) == "table") and EggCmds and type(EggCmds.GetAreaEggRecords) == "function" then
        ok, snap = pcall(EggCmds.GetAreaEggRecords)
    end
    if not (ok and type(snap) == "table") and Network and NETMAP and NETMAP.Eggs and NETMAP.Eggs.REQUEST_AREA_EGG_SNAPSHOT then
        local okInv, s = pcall(Network.Invoke, NETMAP.Eggs.REQUEST_AREA_EGG_SNAPSHOT)
        if okInv and type(s) == "table" then snap = s end
    end
    if type(snap) ~= "table" then return {} end
    local src = (type(snap.Records) == "table") and snap.Records or snap
    if type(src) ~= "table" then return {} end

    local list = {}
    for uid, rec in pairs(src) do
        if type(rec) == "table" then
            if rec.Uid == nil and type(uid) == "string" then rec.Uid = uid end
            list[#list + 1] = rec
        end
    end
    return list
end

local function GetEggRecord(uid)
