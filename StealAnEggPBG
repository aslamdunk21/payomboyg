    local HOP_FILE = CFG_DIR .. "/hopstate.json"

    local function readHopState()
        local data = hasFS and readJson and readJson(HOP_FILE) or nil
        if type(data) ~= "table" then return { count = 0, at = 0 } end
        if (os.time() - (tonumber(data.at) or 0)) > 300 then return { count = 0, at = 0 } end
        return { count = tonumber(data.count) or 0, at = tonumber(data.at) or 0 }
    end

    local function writeHopState(count)
        if not hasFS then return end
        pcall(function()
            writefile(HOP_FILE, HttpService:JSONEncode({ count = count, at = os.time() }))
        end)
    end

    Runtime.hopChain = readHopState().count

    local function zoneHasWanted()
        pcall(EggCmds.RequestAreaEggSnapshot)
        task.wait(0.25)

        local seen = 0
        for _ in pairs(areaEggRecords()) do seen += 1 end
        if seen == 0 then return nil end

        return matchingEggCount() > 0, seen
    end

    local function hopIfTrulyEmpty()
        if not Cfg.AutoHop then return false end
        if Runtime.carryUid then return false end
        if Runtime.hopStopped then return false end

        if os.clock() - (Runtime.stats.startedAt or 0) < 12 then return false end
        if Runtime.lastHopAt and os.clock() - Runtime.lastHopAt < 20 then return false end

        local checks = math.clamp(tonumber(Cfg.HopChecks) or 3, 2, 6)
        local seenAny = 0
        for i = 1, checks do
            local has, seen = zoneHasWanted()
            if has == nil then return false end
            if has then return false end
            seenAny = math.max(seenAny, seen or 0)
            if i < checks then task.wait(1) end
        end

        local chain = (Runtime.hopChain or 0) + 1
        Runtime.hopChain = chain
        writeHopState(chain)

        local maxTries = math.clamp(tonumber(Cfg.HopMaxTries) or 6, 1, 30)
        if chain > maxTries then
            Runtime.hopStopped = true
            logLine("hop", ("ย้ายเซิร์ฟ %d ครั้งติดยังไม่เจอไข่ตรงตัวกรอง — หยุดย้าย"):format(chain - 1))
            Notify("ย้ายเซิร์ฟเวอร์", ("ย้ายมา %d ครั้งติดยังไม่เจอไข่ที่ตั้งไว้เลย — หยุดย้ายแล้ว"):format(chain - 1), 8)
            return false
        end

        Runtime.lastHopAt = os.clock()
        logLine("hop", ("โซนนี้ไม่มีไข่ตรงตัวกรอง — ย้ายเซิร์ฟ ครั้งที่ %d"):format(chain))
        return serverHop()
    end

    function serverHop()
        local ok, servers = pcall(function()
            return HttpService:JSONEncode(game:HttpGet(
                ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100"):format(game.PlaceId)))
        end)
        if ok and servers and servers.data then
            for _, s in ipairs(servers.data) do
                if s.playing and s.maxPlayers and s.playing < s.maxPlayers and s.id ~= game.JobId then
                    pcall(TeleportService.TeleportToPlaceInstance, TeleportService, game.PlaceId, s.id, LocalPlayer)
                    return true
                end
            end
        end
        pcall(TeleportService.Teleport, TeleportService, game.PlaceId, LocalPlayer)
        return false
    end

