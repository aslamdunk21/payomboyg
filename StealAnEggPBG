-- NETWORK RATE LIMITER & THROTTLE HELPERS
---------------------------------------------------------
local RemoteCooldowns = {}

local function ThrottledInvoke(remote, args, cooldown)
    if not remote or not remote:IsA("RemoteFunction") then return end
    local now = os.clock()
    local key = remote:GetFullName()
    if RemoteCooldowns[key] and (now - RemoteCooldowns[key] < (cooldown or 0.1)) then
        return
    end
    RemoteCooldowns[key] = now
    pcall(function()
        if args and type(args) == "table" and #args > 0 then
            remote:InvokeServer(unpack(args))
        else
            remote:InvokeServer()
        end
    end)
end

local function ThrottledFire(remote, args, cooldown)
    if not remote or not remote:IsA("RemoteEvent") then return end
    local now = os.clock()
    local key = remote:GetFullName()
    if RemoteCooldowns[key] and (now - RemoteCooldowns[key] < (cooldown or 0.1)) then
        return
    end
    RemoteCooldowns[key] = now
    pcall(function()
        if args and type(args) == "table" and #args > 0 then
            remote:FireServer(unpack(args))
        else
            remote:FireServer()
        end
    end)
end

---------------------------------------------------------
-- EGG UID DISCOVERY ENGINE
-- Scans ALL instance attributes for a UUID-pattern string.
-- Smarter than hardcoding attribute names — works regardless
-- of what the developer named the field (Uid, EggId, Guid...).
-- A UUID is identified as a hex string of 20+ chars.
-- Returns (uid, attrName) so you know where it came from.
---------------------------------------------------------
local UUID_PATTERN = "^[0-9a-f%-]+$"
local KNOWN_UID_ATTRS = { "Uid", "UID", "Guid", "EggId", "EggID", "Id", "ID", "uuid", "UUID", "Key", "ItemKey" }

local function findEggUid(inst)
    if not inst then return nil, nil end

    -- Pass 1: check known attribute names (fast path)
    for _, attrName in ipairs(KNOWN_UID_ATTRS) do
        local val = inst:GetAttribute(attrName)
        if val and type(val) == "string" and #val >= 20 and val:lower():match(UUID_PATTERN) then
            return val, attrName
        end
    end

    -- Pass 2: scan ALL attributes for any UUID-like string (no name guessing)
    local ok, attrs = pcall(function() return inst:GetAttributes() end)
    if ok and attrs then
        for attrName, attrVal in pairs(attrs) do
            if type(attrVal) == "string" and #attrVal >= 20 and attrVal:lower():match(UUID_PATTERN) then
                return attrVal, attrName
            end
        end
    end

    -- Pass 3: check ValueBase children (some games store UID in a StringValue child)
    for _, child in pairs(inst:GetChildren()) do
        if child:IsA("ValueBase") then
            local val = tostring(child.Value)
            if #val >= 20 and val:lower():match(UUID_PATTERN) then
                return val, "ValueChild:" .. child.Name
            end
        end
    end

    return nil, nil
end

local function matchesArea(inst, targetArea)
    if not targetArea or targetArea == "ALL" then return true end
    if not inst then return false end
    local filterLower = tostring(targetArea):lower()
    local curr = inst
    while curr and curr ~= Workspace do
        local name = curr.Name:lower()
        if name:find(filterLower) then
            return true
        end
        curr = curr.Parent
    end
    return false
end

