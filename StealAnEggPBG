    end
    if TreadmillUtil and sp ~= nil then
        local okWs, ws = pcall(TreadmillUtil.SpeedPowerToWalkSpeed, sp)
        if okWs and type(ws) == "number" then
            return math.max(16, ws)
        end
    end
    local chr = LocalPlayer and LocalPlayer.Character
    local hum = chr and chr:FindFirstChildOfClass("Humanoid")
    if hum and type(hum.WalkSpeed) == "number" and hum.WalkSpeed > 0 then
        return math.max(16, hum.WalkSpeed)
    end
    return 16
end

local speedMultiplier = 3

local function GetTargetStealSpeed()
    local baseSpeed = GetLegalWalkSpeed()
    local mult = speedMultiplier or 3
    return math.max(baseSpeed * mult, 48)
end

-- MoveTo-based walk: uses the game's pathfinding (respects walls/navmesh).
-- Sets WalkSpeed to 3x of player's current/legal walk speed.
local function FastWalk(targetPos, timeout)
    local chr = LocalPlayer.Character
    if not chr then return false end
    local hrp = chr:FindFirstChild("HumanoidRootPart")
    local hum = chr:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    local speed = GetTargetStealSpeed()
    hum.WalkSpeed = speed
    local t0 = os.clock()
    local maxTime = timeout or 60
    local lastPos = hrp.Position
    local stuckCount = 0
    local lastMoveCall = 0

    while not HUB.dead do
        if not (chr.Parent and hrp.Parent) then break end

        local dx = targetPos.X - hrp.Position.X
        local dz = targetPos.Z - hrp.Position.Z
        local dist = math.sqrt(dx*dx + dz*dz)

        if dist <= 5 then hum.WalkSpeed = 16; return true end
        if os.clock() - t0 > maxTime then hum.WalkSpeed = 16; return false end

        -- Periodically re-trigger MoveTo every 0.4s to prevent Roblox 8s internal timeout
        if os.clock() - lastMoveCall >= 0.4 then
            lastMoveCall = os.clock()
            hum.WalkSpeed = GetTargetStealSpeed()
            hum:MoveTo(targetPos)
        end

        -- Advanced Anti-Stuck & Wall-Bypass recovery logic
        if (hrp.Position - lastPos).Magnitude < 1.5 then
            stuckCount = stuckCount + 1
            if stuckCount >= 4 then
                pcall(function() hum.Jump = true end)
            end
            if stuckCount >= 6 then
                -- Nudge / Detour sideways away from the obstacle
                local forwardDir = (targetPos - hrp.Position)
                if forwardDir.Magnitude > 0.5 then
                    local unitForward = forwardDir.Unit
                    local rightVec = Vector3.new(-unitForward.Z, 0, unitForward.X)
                    local detourSide = (stuckCount % 2 == 0) and 1 or -1
                    local detourTarget = hrp.Position + (rightVec * 8 * detourSide) + (unitForward * 2)
                    hum:MoveTo(detourTarget)
                    task.wait(0.18)
                end
            end
            if stuckCount >= 10 then
                -- If stuck for ~0.8s, micro CFrame step forward/upward to bypass wall geometry
                local dirVec = (targetPos - hrp.Position)
                if dirVec.Magnitude > 0.1 then
                    local stepDist = math.min(dist, 6)
                    hrp.CFrame = CFrame.new(hrp.Position + (dirVec.Unit * stepDist) + Vector3.new(0, 2.5, 0))
                end
                stuckCount = 0
            end
        else
            stuckCount = 0
        end
        lastPos = hrp.Position
        task.wait(0.08)
    end
    hum.WalkSpeed = 16
    return false
end

