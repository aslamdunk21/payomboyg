local function nearestCarryPrompt(pos)
    local best, bestDistance = nil, math.huge
    for _, prompt in ipairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local pName = prompt.Name
            if pName == "CarryAreaEgg" or string.find(pName, "Egg", 1, true) or string.find(pName, "Steal", 1, true) or string.find(pName, "Carry", 1, true) then
                local parent = prompt.Parent
                local promptPos
                if parent and parent:IsA("Attachment") then
                    promptPos = parent.WorldPosition
                elseif parent and parent:IsA("BasePart") then
                    promptPos = parent.Position
                elseif parent and parent:IsA("Model") then
                    promptPos = parent:GetPivot().Position
                end
                if promptPos then
                    local distance = (promptPos - pos).Magnitude
                    if distance < bestDistance then
                        best, bestDistance = prompt, distance
                    end
                end
            end
        end
    end
    return best
end

local function HookProximityPrompts()
    pcall(function()
        local PPS = game:GetService("ProximityPromptService")
        for _, pp in ipairs(Workspace:GetDescendants()) do
            if pp:IsA("ProximityPrompt") then
                pp.HoldDuration = 0
                pp.MaxActivationDistance = 9999
                pp.RequiresLineOfSight = false
                pp.Enabled = true
            end
        end
        PPS.PromptShown:Connect(function(pp)
            if pp and pp:IsA("ProximityPrompt") then
                pp.HoldDuration = 0
                pp.MaxActivationDistance = 9999
                pp.RequiresLineOfSight = false
                pp.Enabled = true
            end
        end)
    end)
end
HookProximityPrompts()

local function triggerPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    pcall(function()
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = 9999
        prompt.RequiresLineOfSight = false
        prompt.Enabled = true
    end)

    local firePP = (typeof(fireproximityprompt) == "function" and fireproximityprompt)
        or (typeof(getgenv) == "function" and getgenv().fireproximityprompt)

    if firePP then
        pcall(firePP, prompt, 0)
        pcall(firePP, prompt)
    end
    return true
end

