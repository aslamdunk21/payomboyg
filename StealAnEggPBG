function approachPlot(tries)
    local pd   = plotData()
    local spot = pd and pd.PetArea and (pd.PetArea.CFrame.Position + Vector3.new(0, 4, 0))
    if not spot then return false end

    for _ = 1, tries or 3 do
        if instantOK() then
            -- the gate is crossed first: stepping straight out of the zone is
            -- what left the character short of the plot
            if insideGameplay() then stepTo(GATE_IN, 8) end
            stepTo(spot, 12)
        else
            goHome()
        end
        task.wait(0.1)
        if atHome() then return true end
        local root = hrp()
        if root and (root.Position - spot).Magnitude < 30 then return true end
    end
    return false
end

function placeEggs()
    local queue = {}
    for _, egg in ipairs(unplacedEggs()) do
        if Cfg.PlaceRarities[egg.rarity] then queue[#queue + 1] = egg end
    end
    if #queue == 0 then return 0 end
    table.sort(queue, function(a, b) return rankOf(a.cat) > rankOf(b.cat) end)

    if not approachPlot(3) then
        logLine("place", "ไปฐานไม่ถึง — ยังวางไข่ไม่ได้ รอบหน้าลองใหม่")
        return 0
    end

    local taken, placed = occupiedSpots(), 0
    local closeFails, otherFails = 0, 0

    for _, egg in ipairs(queue) do
        local lcf = nextFreeSpot(taken)
        if not lcf then break end

        local ok, err = EggCmds.RequestPlaceEgg(egg.uid, lcf)

        if not ok and tostring(err):find("closer") then
            -- walk back and retry the SAME egg on the SAME spot; the spot is
            -- only marked taken once the server has actually rejected it for a
            -- reason other than distance
            closeFails += 1
            if closeFails > 2 or not approachPlot(2) then break end
            ok, err = EggCmds.RequestPlaceEgg(egg.uid, lcf)
        end

        if ok then
            placed += 1
            closeFails, otherFails = 0, 0
            table.insert(taken, lcf.Position)
            task.wait(0.08)
        elseif tostring(err):find("closer") then
            break
        else
            table.insert(taken, lcf.Position)
            otherFails += 1
            if otherFails >= 3 then break end
        end
    end

    if placed > 0 then
        logLine("place", ("วางไข่ %d ใบ"):format(placed))
        toAnchor()
    end
    return placed
end

function eggSellPlan()
    local plan = {}
    local limit = tonumber(Cfg.SellEggBelow) or 0
    for _, egg in ipairs(unplacedEggs()) do
        local byRarity = Cfg.SellEggRarities[egg.rarity] == true
        local byPrice  = limit > 0 and egg.price < limit
        if byRarity or byPrice then plan[#plan + 1] = egg end
    end
    table.sort(plan, function(a, b) return a.price < b.price end)
    return plan
end

-- selling an egg needs it in our hands first: equip the tool, then fire the sale
function sellEggsOnce(count)
    local plan = eggSellPlan()
    if #plan == 0 then return 0 end

    local sold = 0
    for i = 1, math.min(count or 1, #plan) do
        local egg = plan[i]
        if invoke(NET.Eggs.REQUEST_EQUIP_TOOL, egg.uid) then
            fire(NET.AssetInventory.SELL_ASSET, { egg.uid })
            sold += 1
            Runtime.stats.soldEggs += 1
            task.wait(0.04)
        end
    end
    if sold > 0 then
        pcall(function() invoke(NET.Eggs.REQUEST_UNEQUIP_TOOL) end)
        saveCache = nil
        logLine("sell", ("ขายไข่ %d ใบ"):format(sold))
    end
    return sold
end

function sellEggs(maxCount)
    local total = 0
    for _ = 1, math.min(maxCount or (Cfg.SellMaxPerRun or 60), 200) do
        local n = sellEggsOnce(1)
        if n == 0 then break end
        total += n
        task.wait(0.04)
    end
    return total
end

