local function triggerPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end

    -- STRICT SAFETY EXCLUSION: Prevent random trading & treadmill snapping!
    local actionText = (prompt.ActionText or ""):lower()
    local objectText = (prompt.ObjectText or ""):lower()
    local parentName = (prompt.Parent and prompt.Parent.Name or ""):lower()
    local fullText = actionText .. " " .. objectText .. " " .. parentName

    if fullText:find("trade") or fullText:find("treadmill") or fullText:find("train") or fullText:find("hop on") or fullText:find("speed") then
        return
    end

    -- Do not trigger prompts attached to other players' characters!
    if prompt.Parent and (prompt.Parent:FindFirstChildOfClass("Humanoid") or (prompt.Parent.Parent and prompt.Parent.Parent:FindFirstChildOfClass("Humanoid"))) then
        return
    end

    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt, 0)
            fireproximityprompt(prompt, prompt.HoldDuration or 0)
        end
        if prompt.InputHoldBegan then prompt:InputHoldBegan() end
        if prompt.InputHoldEnded then prompt:InputHoldEnded() end
    end)
end

local function getMyPlot()
    local plotsFolder = Workspace:FindFirstChild("Plots") 
        or (Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Plots"))
        or Workspace:FindFirstChild("PlayerPlots")

    if plotsFolder then
        local myName = LocalPlayer.Name:lower()
        local myUserId = tostring(LocalPlayer.UserId)

        for _, plot in pairs(plotsFolder:GetChildren()) do
            local plotName = plot.Name:lower()
            if plotName:find(myName) or plotName:find(myUserId) then
                return plot
            end

            local ownerAttr = plot:GetAttribute("Owner") or plot:GetAttribute("Player") or plot:GetAttribute("UserId") or plot:GetAttribute("OwnerName")
            if ownerAttr then
                local ownerStr = tostring(ownerAttr):lower()
                if ownerStr == myName or ownerStr == myUserId then
                    return plot
                end
            end

            local ownerVal = plot:FindFirstChild("Owner") or plot:FindFirstChild("Player") or plot:FindFirstChild("OwnerName")
            if ownerVal and ownerVal:IsA("ValueBase") then
                local valStr = tostring(ownerVal.Value):lower()
                if valStr == myName or valStr == myUserId then
                    return plot
                end
            end

            local sign = plot:FindFirstChild("Sign", true) or plot:FindFirstChild("PlotSign", true)
            if sign then
                for _, label in pairs(sign:GetDescendants()) do
                    if label:IsA("TextLabel") and (label.Text:lower():find(myName) or label.Text:lower():find("claimed")) then
                        return plot
                    end
                end
            end
        end

        return plotsFolder:GetChildren()[1]
    end
    return nil
end

local function getPlotSpawnPos(plot)
    plot = plot or getMyPlot()
    if plot then
        local targetPart = plot:FindFirstChild("SpawnPoint", true) 
            or plot:FindFirstChild("PlotSign", true) 
            or plot:FindFirstChild("PlayerPlotSign", true)
            or plot:FindFirstChild("Spawn", true)
            or plot:FindFirstChild("Sign", true)
            or plot.PrimaryPart
            or plot:FindFirstChildWhichIsA("BasePart", true)

        if targetPart then
            return targetPart:IsA("Model") and targetPart:GetPivot().Position or targetPart.Position
        end
        return plot:GetPivot().Position
    end
    return nil
end

local function isAtMyPlot()
    local root = getRootPart()
    if not root then return false end
    local spawnPos = getPlotSpawnPos()
    if spawnPos then
        return (root.Position - spawnPos).Magnitude < 50
