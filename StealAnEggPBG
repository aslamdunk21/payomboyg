            local inst = findRemote(endpoint)
            if inst and inst:IsA("RemoteFunction") then
                return inst:InvokeServer(...)
            end
            return false, "remote not found"
        end,
        Fire = function(endpoint, ...)
            local inst = findRemote(endpoint)
            if inst and inst:IsA("RemoteEvent") then
                inst:FireServer(...)
            elseif inst and inst:IsA("RemoteFunction") then
                inst:InvokeServer(...)
            end
        end
