-- Event-Driven Chained Steal Loop
----------------------------------------------------------------
Runtime.eggTick = 0
do
    local eggEvs = { "AreaEggSnapshotUpdated", "AreaEggUpdated", "AreaEggRemoved" }
    for i = 1, #eggEvs do
        local sig = EggCmds and EggCmds[eggEvs[i]]
        if type(sig) == "table" and sig.Connect then
            pcall(function()
                Runtime.conns["egg_" .. eggEvs[i]] = sig:Connect(function() Runtime.eggTick = Runtime.eggTick + 1 end)
            end)
        end
    end
end

local function waitForEggChange(timeout)
    local mark = Runtime.eggTick
    local t0 = os.clock()
    repeat
        task.wait(0.05)
    until Runtime.eggTick ~= mark or os.clock() - t0 > timeout or not alive() or not Cfg.AutoSteal
end

task.spawn(function()
    while alive() do
        if Cfg.AutoSteal and not Runtime.stealing and not Runtime.lock then
            Runtime.stealing = true
            local misses, chain, empty = 0, 0, false
            repeat
                local target = bestEgg()
                local ok, err
                if not target then
                    ok, err = false, "ไม่มีไข่ตรงตัวกรอง"
                else
                    -- Immediately interrupt treadmill if on one
                    if Nav.onTreadmill() then Nav.leaveTreadmill() end
                    
                    if instantOK() or Cfg.MoveMode == "Instant" then
                        ok, err = instantSteal(target)
                    elseif Cfg.MoveMode == "Warp" then
                        ok, err = warpSteal(target)
                    else
                        ok, err = stealOnce(target)
                    end
                end

                misses = ok and 0 or (misses + 1)
                chain += 1
                if not ok then
                    Runtime.lastError = tostring(err)
                    empty = tostring(err):find("ตัวกรอง") ~= nil
                    if tostring(err):find("เต็ม") then relieveBag(true) misses = 0 end
                    -- the server refuses a new grab while a stolen egg is still
                    -- in hand; walking it home banks it, dropping is the last
                    -- resort. Without this the chain jams on one error forever.
                    if tostring(err):find("carrying") or tostring(err):find("Already") then
                        Runtime.carryUid = nil
                        stepTo(GATE_IN, 6)
                        stepTo(ANCHOR, 6)
                        task.wait(0.25)
                        if tostring(err):find("carrying") then pcall(EggCmds.RequestDropHeldAreaEgg) end
                        misses = 0
                    end
                    if empty then Runtime.hopIfTrulyEmpty() end
                else
                    empty = false
                    if (Runtime.hopChain or 0) > 0 then
                        Runtime.hopChain = 0
                        Runtime.writeHopState(0)
                    end
                    Runtime.hopStopped = false
                end
            until misses >= 3 or chain >= 20 or eggUpkeepDue() or not Cfg.AutoSteal or not alive()
            Runtime.stealing = false
            toAnchor()

            -- the handover: the lock is free for exactly this call, so hatching
            -- and placing get a guaranteed turn after every chain
            if eggUpkeepDue() then withLock(eggUpkeep) end

            if empty then
                waitForEggChange(2)
            else
                task.wait(0.35)
            end
        end
        task.wait(0.15)
    end
end)

