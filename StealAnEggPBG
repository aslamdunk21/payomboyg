ENV[K_CLEANUP] = function()
    for _, c in pairs(Runtime.conns) do pcall(function() c:Disconnect() end) end
    Runtime.conns = {}
    for _, c in ipairs(Runtime.pinConns or {}) do pcall(function() c:Disconnect() end) end
    Runtime.pinConns = nil
    Guardless.reattach()
    pcall(function() if UIWindow then UIWindow:Destroy() end end)
    UIWindow = nil
    pcall(function() if Runtime.floatGui then Runtime.floatGui:Destroy() end end)
    Runtime.floatGui, Runtime.floatIcon = nil, nil
    -- the AFK panel is a plain ScreenGui and outlives the WindUI window, so it
    -- has to be named here or a re-execute leaves a dead panel on screen
    pcall(function() if Runtime.afkGui then Runtime.afkGui:Destroy() end end)
    Runtime.afkGui, Runtime.afkOpen, Runtime.afkClose, Runtime.afkOn = nil, nil, nil, false
end
