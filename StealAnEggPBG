local PriorityQueue = {
    P1 = {}, -- Priority 1 (Critical: Steal / Carry / Place / Safe Return)
    P2 = {}, -- Priority 2 (High: Hatch / EquipBest)
    P3 = {}, -- Priority 3 (Background: Upgrades / Pet Sell / Trails)
    Processing = false
}

local function PushPriorityTask(priority, name, fn)
    if not fn then return end
    name = name or "Task"

    if priority == 3 then
        for _, t in ipairs(PriorityQueue.P3) do
            if t.Name == name then return end
        end
    elseif priority == 2 then
        for _, t in ipairs(PriorityQueue.P2) do
            if t.Name == name then return end
        end
    end

    local taskObj = { Name = name, Fn = fn, Time = os.clock() }
    if priority == 1 then
        table.insert(PriorityQueue.P1, taskObj)
    elseif priority == 2 then
        table.insert(PriorityQueue.P2, taskObj)
    else
        table.insert(PriorityQueue.P3, taskObj)
    end
end

function PriorityQueue.GetQueueCount()
    return #PriorityQueue.P1 + #PriorityQueue.P2 + #PriorityQueue.P3
end

task.spawn(function()
    while true do
        task.wait(0.03)
        local taskToRun = nil
        if #PriorityQueue.P1 > 0 then
            taskToRun = table.remove(PriorityQueue.P1, 1)
        elseif #PriorityQueue.P2 > 0 then
            taskToRun = table.remove(PriorityQueue.P2, 1)
        elseif #PriorityQueue.P3 > 0 then
            taskToRun = table.remove(PriorityQueue.P3, 1)
        end

        if taskToRun and taskToRun.Fn then
            pcall(function()
                taskToRun.Fn()
            end)
        end
    end
end)

