        -- 🎚️ SLIDER WIDGET
        function TabObj:AddSlider(id, sCfg)
            if type(id) == "table" then
                sCfg = id
                id = sCfg.Flag or sCfg.Name or ("slider_" .. tostring(#pageScroll:GetChildren()))
            end
            sCfg = sCfg or {}
            local title = sCfg.Title or sCfg.Name or id
            local minVal = sCfg.Min or 0
            local maxVal = sCfg.Max or 100
            local defaultVal = sCfg.Default or minVal
            local suffix = sCfg.Suffix or ""
            local flag = sCfg.Flag or id

            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, -10, 0, 52)
            frame.BackgroundColor3 = COLORS.glassDeep
            frame.BackgroundTransparency = 0.18
