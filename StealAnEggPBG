local AREAS = { "Lake", "Forest", "Desert", "Jungle", "Snow", "Volcano", "Prehistoric", "Abyss Ocean", "Cosmic" }

local function raritySet(list)
    local t = {}
    for _, r in ipairs(list or {}) do t[r] = true end
    return t
end

local function setToList(set)
    local out = {}
    for _, r in ipairs(RARITY_ORDER) do if set[r] then out[#out + 1] = r end end
    return out
end

local function shortNum(n)
    n = tonumber(n) or 0
    for _, u in ipairs({ { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }) do
        if n >= u[1] then return ("%.2f%s"):format(n / u[1], u[2]) end
    end
    return ("%.0f"):format(n)
end

local function isOptionSelected(v, key)
    if type(v) ~= "table" then return false end
    if v[key] == true then return true end
    for k, val in pairs(v) do
        if val == key or (k == key and val == true) then return true end
    end
    return false
end

