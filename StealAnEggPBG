                stuckT = stuckT + 1
                if stuckT >= 4 then pcall(function() hum.Jump = true end) end
                if stuckT >= 8 then
                    hrp.CFrame = CFrame.new(580, gy + 2, -366)
                    stuckT = 0
                end
            else
                stuckT = 0
            end
            lastP = hrp.Position
            task.wait(0.15)
        end
        crossed = hrp.Position.X > 570
    end

    if wasFake then SetFakeDeath(true) end
    return crossed
end

