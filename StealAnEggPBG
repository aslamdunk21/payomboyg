    ----------------------------------------------------------------
    -- Stealing Engine
    ----------------------------------------------------------------
    local function areaReachable(areaId)
        local need = AREA_SPEED[areaId]
        if not need then return true end
        local hum = humanoid()
        return (hum and hum.WalkSpeed or 16) > need + 1
    end

    local function guardState(areaId)
        local model = GuardAreasFolder and GuardAreasFolder:FindFirstChild(areaId)
        local guard = model and model:FindFirstChild("Guard")
        return guard and guard:GetAttribute("GuardState") or nil
    end

    local function eggPasses(rec)
        if not rec or not rec.AssetCategory then return false end
        if rec.State ~= "Slot" and rec.State ~= "Dropped" then return false end
        local until_ = Runtime.skip[rec.Uid]
        if until_ and os.clock() < until_ then return false end
        if tostring(rec.Uid):find("FirstAreaEgg") then return false end
        if not Cfg.StealAreas[rec.AreaId] then return false end
        if not areaReachable(rec.AreaId) then return false end
        if not Cfg.StealRarities[rarityOf(rec.AssetCategory)] then return false end
        local muts = 0
        if type(rec.Mutations) == "table" then for _ in pairs(rec.Mutations) do muts += 1 end end
        if muts < Cfg.MinMutations then return false end
        return true
    end

    local function matchingEggCount()
        local n = 0
        for _, rec in pairs(areaEggRecords()) do
            if rec and rec.AssetCategory
                and (rec.State == "Slot" or rec.State == "Dropped")
                and not tostring(rec.Uid):find("FirstAreaEgg")
                and Cfg.StealAreas[rec.AreaId]
                and Cfg.StealRarities[rarityOf(rec.AssetCategory)] then
                local muts = 0
                if type(rec.Mutations) == "table" then for _ in pairs(rec.Mutations) do muts += 1 end end
                if muts >= Cfg.MinMutations then n += 1 end
            end
        end
        return n
    end

    local function bestEgg()
        local hum = humanoid()
        local speed = math.max((hum and hum.WalkSpeed or 16) * (Cfg.WarpPct or 0.8), 50)
        local guards = guardPositions()

        local best, bestScore
        for _, rec in pairs(areaEggRecords()) do
            if eggPasses(rec) then
                local value = rankOf(rec.AssetCategory) * 1e6 + earnRate(rec.AssetCategory) / 1e3
                if type(rec.Mutations) == "table" then
                    for _ in pairs(rec.Mutations) do value *= 1.5 end
                end
                if guardState(rec.AreaId) == "Chasing" then value *= 0.5 end
                if rec.BottomCFrame and nearestGuardDist(rec.BottomCFrame.Position, guards) < 8 then value *= 0.1 end

                local score = value
                if Cfg.PickMode == "Efficient" then
                    local dist = rec.BottomCFrame and (rec.BottomCFrame.Position - ANCHOR).Magnitude or 3000
                    score = value / (dist * 2 / speed + 4)
                end
                if not bestScore or score > bestScore then best, bestScore = rec, score end
            end
        end
        return best
    end

    local function instantSteal(rec)
        local egg = rec.BottomCFrame and rec.BottomCFrame.Position
        if not egg then return false, "ไม่มีตำแหน่งไข่" end

        blinkExact(ANCHOR)

        local claimed = false
        local conn = EggCmds.AreaEggClaimed:Connect(function() claimed = true end)
        local unpin = nil
        local function release()
            if unpin then
                local f = unpin
                unpin = nil
                pcall(f)
            end
        end
        local function finish(ok, err)
            release()
            conn:Disconnect()
            Runtime.carryUid = nil
            if not ok then Runtime.skip[rec.Uid] = os.clock() + 8 end
            blinkHold(ANCHOR, 0.1)
            return ok, err
        end

        for _, live in pairs(areaEggRecords()) do
            if live.Uid == rec.Uid and live.BottomCFrame then egg = live.BottomCFrame.Position break end
        end

        if nearestGuardDist(egg) < 5 then return finish(false, "ยามเฝ้ารังอยู่") end

        local stand = egg + Vector3.new(0, 3, 0)
        unpin = pin(stand)
        waitPinned(stand, 8, 0.35)

        local grabbed, gerr, bagFull, gone = false, nil, false, false
        local inflight, done = 0, false
        local deadline = os.clock() + 1.5

        while not done and not grabbed and os.clock() < deadline do
            if inflight < 4 then
                inflight += 1
                task.spawn(function()
                    local ok2, res, err2 = pcall(EggCmds.RequestCarryAreaEgg, rec.Uid)
                    inflight -= 1
                    if not ok2 then gerr = res return end
                    if res then grabbed = true return end
                    gerr = err2
                    local msg = tostring(err2)
                    if msg:find("full") then bagFull, done = true, true
                    elseif msg:find("not found") or msg:find("unavailable") then gone, done = true, true end
                end)
            end
            task.wait(0.04)
        end

        if bagFull then
            release()
            conn:Disconnect()
            blinkHold(ANCHOR, 0.1)
            return false, "กระเป๋าไข่เต็ม"
        end
        if gone then
            task.spawn(function() pcall(EggCmds.RequestAreaEggSnapshot) end)
        end

        release()
        if not grabbed then return finish(false, tostring(gerr)) end
        Runtime.carryUid = rec.Uid

        unpin = pin(ANCHOR)

        local function bankedByRecord()
            for _, live in pairs(areaEggRecords()) do
                if live.Uid == rec.Uid then return live.State == "Claimed" end
            end
            return true
        end

        local t0 = os.clock()
        while not claimed and os.clock() - t0 < 3 do
            task.wait(0.03)
            if os.clock() - t0 > 0.25 and bankedByRecord() then claimed = true end
        end
        release()
        conn:Disconnect()
        Runtime.carryUid = nil
        if not claimed then blinkHold(ANCHOR, 0.1) return false, "ไข่หลุดระหว่างทาง" end

        Runtime.stats.eggs += 1
        local cat = rec.AssetCategory
        logLine("steal", ("ขโมย %s (%s)"):format(cat, RARITY_TH[rarityOf(cat)] or rarityOf(cat)))
        if Cfg.WebhookSteal then
            webhook("🥷 ขโมยไข่สำเร็จ", ("**%s** (%s) — โซน %s"):format(cat, RARITY_TH[rarityOf(cat)] or rarityOf(cat), rec.AreaId))
        end
        blinkExact(ANCHOR)
        return true
    end

    local function warpSteal(rec)
        local egg = rec.BottomCFrame and rec.BottomCFrame.Position
        if not egg then return false, "ไม่มีตำแหน่งไข่" end
        toAnchor()

        local claimed = false
        local conn = EggCmds.AreaEggClaimed:Connect(function() claimed = true end)
        local function finish(ok, err)
            conn:Disconnect()
            Runtime.carryUid = nil
            if not ok then Runtime.skip[rec.Uid] = os.clock() + 8 end
            toAnchor()
            return ok, err
        end

        local root = hrp()
        if root and math.abs(root.Position.Z - ANCHOR.Z) > 18 then
            warpTo(Vector3.new(root.Position.X, root.Position.Y, ANCHOR.Z), 4, { ignoreGuards = true, timeout = 6 })
        end
        warpTo(GATE_IN, 4, { ignoreGuards = true, timeout = 8 })
        settleFeet(0.12)
        if not insideGameplay() then return finish(false, "เข้าโซนไม่สำเร็จ") end

        pcall(EggCmds.RequestAreaEggSnapshot)
        task.wait(0.1)
        for _, live in pairs(areaEggRecords()) do
            if live.Uid == rec.Uid and live.BottomCFrame then egg = live.BottomCFrame.Position break end
        end
        if nearestGuardDist(egg) < 10 then return finish(false, "ยามเฝ้ารังอยู่") end

        local moved, moveErr = warpChain(egg, 2, { guardGap = Cfg.GuardSafeGap })
        if not moved then return finish(false, moveErr or "ไปไม่ถึงไข่") end
        settleFeet(0.08)

        local grabbed, gerr
        local deadline = os.clock() + 2.5
        repeat
            grabbed, gerr = EggCmds.RequestCarryAreaEgg(rec.Uid)
            if grabbed then break end
            local msg = tostring(gerr)
            if msg:find("not found") or msg:find("unavailable") or msg:find("full") then break end
            task.wait(0.1)
        until os.clock() > deadline
        if not grabbed then return finish(false, tostring(gerr)) end

        Runtime.carryUid = rec.Uid
        warpChain(GATE_IN, 4, { guardGap = 14 })
        toAnchor()

        local t0 = os.clock()
        while not claimed and os.clock() - t0 < 4 do task.wait(0.05) end
        conn:Disconnect()
        Runtime.carryUid = nil
        if not claimed then toAnchor() return false, "ไข่หลุดระหว่างทาง" end

        Runtime.stats.eggs += 1
        logLine("steal", ("ขโมย %s"):format(rec.AssetCategory))
        toAnchor()
        return true
    end

    local function stealOnce()
        local rec = bestEgg()
        if not rec then return false, "ไม่มีไข่ตรงตัวกรอง" end
        if instantOK() then return instantSteal(rec) end
        return warpSteal(rec)
    end

