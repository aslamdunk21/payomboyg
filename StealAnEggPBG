local function ResolveAreaName(areaId, assetCategory)
    -- 1. Direct string matching with MAP_OPTIONS
    if type(areaId) == "string" then
        for _, mapName in ipairs(MAP_OPTIONS) do
            if string.find(areaId:lower(), mapName:lower(), 1, true) then
                return mapName
            end
        end
    end

    -- 2. Index number matching (e.g. 1 -> Lake, 6 -> Volcano)
    local numId = tonumber(areaId)
    if not numId and type(areaId) == "string" then
        numId = tonumber(areaId:match("%d+"))
    end
    if numId and MAP_OPTIONS[numId] then
        return MAP_OPTIONS[numId]
    end

    -- 3. Check assetCategory (e.g., "Egg_Volcano_SuperRare")
    if type(assetCategory) == "string" then
        for _, mapName in ipairs(MAP_OPTIONS) do
            if string.find(assetCategory:lower(), mapName:lower(), 1, true) then
                return mapName
            end
        end
    end

    -- 4. Try ReplicatedStorage Directory.Areas lookup if available
    pcall(function()
        if ReplicatedStorage:FindFirstChild("Directory") and ReplicatedStorage.Directory:FindFirstChild("Areas") then
            local ok, AreasModule = pcall(require, ReplicatedStorage.Directory.Areas)
            if ok and type(AreasModule) == "table" then
                local dir = AreasModule.Directory or AreasModule.Areas or AreasModule
                if type(dir) == "table" then
                    local aInfo = dir[areaId] or (numId and dir[numId])
                    if type(aInfo) == "table" and (aInfo.Name or aInfo.Title) then
                        local n = tostring(aInfo.Name or aInfo.Title)
                        for _, mapName in ipairs(MAP_OPTIONS) do
                            if string.find(n:lower(), mapName:lower(), 1, true) then
                                return mapName
                            end
                        end
                    end
                end
            end
        end
    end)

    return nil
end

local function IsAreaSelected(areaId, assetCategory)
    if not stealAreaSet or CountTable(stealAreaSet) == 0 then return true end

    -- Check if ALL maps are selected in UI
    local allSelected = true
    for _, opt in ipairs(MAP_OPTIONS) do
        if not stealAreaSet[opt] then
            allSelected = false
            break
        end
    end
    if allSelected then return true end

    local mapName = ResolveAreaName(areaId, assetCategory)
    if not mapName then
        -- Fallback safety: If area cannot be identified, allow it so stealing never breaks!
        return true
    end

    return stealAreaSet[mapName] == true
end

