----------------------------------------------------------------
-- 100% SAE_Nyx Backend Engine (Asynchronous & Optimized Execution)
----------------------------------------------------------------
task.spawn(function()
    local function safeRequire(inst)
        if not inst then return nil end
        local ok, mod = pcall(require, inst)
        return ok and mod or nil
    end

    local Lib       = ReplicatedStorage:WaitForChild("Library", 20)
    local ClientLib = Lib and Lib:WaitForChild("Client", 20)
    local LibUtil   = Lib and Lib:FindFirstChild("Util")
    local Directory = ReplicatedStorage:FindFirstChild("Directory")

    local EggCmds  = safeRequire(ClientLib and ClientLib:FindFirstChild("EggCmds"))
    local AssetCmds= safeRequire(ClientLib and ClientLib:FindFirstChild("AssetCmds"))
    local PlotCmds = safeRequire(ClientLib and ClientLib:FindFirstChild("PlotCmds"))
    local Save     = safeRequire(ClientLib and ClientLib:FindFirstChild("Save"))
    local Network  = safeRequire(ClientLib and ClientLib:FindFirstChild("Network"))

    local AssetSer  = safeRequire(LibUtil and LibUtil:FindFirstChild("AssetItemSerialization"))
    local AssetGen  = safeRequire(LibUtil and LibUtil:FindFirstChild("AssetGenerationUtil"))
    local PriceOf   = safeRequire(LibUtil and LibUtil:FindFirstChild("GetPriceValueForItem"))
    local EggUtil   = safeRequire(LibUtil and LibUtil:FindFirstChild("EggItemUtil"))
    local AreaLookup= safeRequire(LibUtil and LibUtil:FindFirstChild("GuardAreaLookupUtil"))

    local AssetsDir = safeRequire(Directory and Directory:FindFirstChild("Assets"))
    local BasesDir  = safeRequire(Directory and Directory:FindFirstChild("Bases"))
    local TreadDir  = safeRequire(Directory and Directory:FindFirstChild("Treadmills"))
    local TrailsDir = safeRequire(Directory and Directory:FindFirstChild("Trails"))
    local GuardsDir = safeRequire(Directory and Directory:FindFirstChild("Guards"))

    if not (EggCmds and PlotCmds and Network and Save) then
        warn("[PayomboyZ] โหลดโมดูลเกมไม่สำเร็จ")
        return
    end

    local NET = Network.NET_MAP
    local NetworkFolder = ReplicatedStorage:FindFirstChild("Network")

    ----------------------------------------------------------------
    -- Event-Driven Egg Snapshot Change Listener
    ----------------------------------------------------------------
    for _, name in ipairs({ "AreaEggSnapshotUpdated", "AreaEggUpdated", "AreaEggRemoved" }) do
        local sig = EggCmds[name]
        if type(sig) == "table" and sig.Connect then
            local ok, conn = pcall(function()
                return sig:Connect(function() Runtime.eggTick += 1 end)
            end)
            if ok then Runtime.conns["egg_" .. name] = conn end
        end
    end

    local function waitForEggChange(timeout)
        local mark = Runtime.eggTick
        local t0 = os.clock()
        repeat
            task.wait(0.05)
        until Runtime.eggTick ~= mark or os.clock() - t0 > timeout or not alive() or not Cfg.AutoSteal
    end

    local function remoteKind(endpoint)
        local inst = NetworkFolder and NetworkFolder:FindFirstChild(tostring(endpoint))
        if not inst then return nil end
        return inst:IsA("RemoteFunction") and "function" or "event"
    end

    local function invoke(endpoint, ...)
        local args = table.pack(...)
        if remoteKind(endpoint) == "event" then
            local ok = pcall(function() Network.Fire(endpoint, table.unpack(args, 1, args.n)) end)
            return ok
        end
        local ok, a, b = pcall(function() return Network.Invoke(endpoint, table.unpack(args, 1, args.n)) end)
        if not ok then return false, tostring(a) end
        return a, b
    end

    local function fire(endpoint, ...)
        local args = table.pack(...)
        pcall(function() Network.Fire(endpoint, table.unpack(args, 1, args.n)) end)
    end

    local function char()     return LocalPlayer.Character end
    local function hrp()      local c = char() return c and c:FindFirstChild("HumanoidRootPart") end
    local function humanoid() local c = char() return c and c:FindFirstChildOfClass("Humanoid") end

    local AREA_SPEED = {}
    if GuardsDir and GuardsDir.Directory then
        for id, cfg in pairs(GuardsDir.Directory) do
            if type(cfg) == "table" and tonumber(cfg.WalkSpeed) then AREA_SPEED[id] = tonumber(cfg.WalkSpeed) end
        end
    end

    local CategoryRarity, RarityRank = {}, {}
    do
        for i, r in ipairs(RARITY_ORDER) do RarityRank[r] = i end
        if AssetsDir and AssetsDir.ByRarity then
            for rarity, list in pairs(AssetsDir.ByRarity) do
                if type(list) == "table" then
                    for k, v in pairs(list) do
                        CategoryRarity[(type(v) == "string") and v or tostring(k)] = rarity
                    end
                end
            end
        end
        if AssetsDir and AssetsDir.Directory then
            for id, cfg in pairs(AssetsDir.Directory) do
                if type(cfg) == "table" and type(cfg.Rarity) == "table" and cfg.Rarity._id then
                    CategoryRarity[id] = cfg.Rarity._id
                    if cfg.Rarity.RarityNumber and not RarityRank[cfg.Rarity._id] then
                        RarityRank[cfg.Rarity._id] = cfg.Rarity.RarityNumber
                    end
                end
            end
        end
    end

    local function rarityOf(cat) return CategoryRarity[cat] or "Common" end
    local function rankOf(cat)   return RarityRank[rarityOf(cat)] or 0 end
    local function earnRate(cat)
        local cfg = AssetsDir and AssetsDir.Directory and AssetsDir.Directory[cat]
        return (cfg and cfg.EarningRate) or 0
    end

    ----------------------------------------------------------------
    -- Client Integrity & Anti-Cheat Mute
    ----------------------------------------------------------------
    local function muteCorrectionReport()
        if ENV.PayomboyZCorrectionMuted or ENV.NyxCorrectionMuted then return true end
        if typeof(getrawmetatable) ~= "function" or typeof(setreadonly) ~= "function"
            or typeof(getnamecallmethod) ~= "function" then
            return false
        end

        local ok = pcall(function()
            local mt = getrawmetatable(game)
            setreadonly(mt, false)
            local oldNamecall = mt.__namecall
            local wrap = (typeof(newcclosure) == "function") and newcclosure or function(f) return f end

            mt.__namecall = wrap(function(self, ...)
                local method = getnamecallmethod()
                if method == "FireServer" or method == "InvokeServer" then
                    local okn, name = pcall(function() return self.Name end)
                    if okn and type(name) == "string" and string.find(name, "CorrectionStarted", 1, true) then
                        return
                    end
                end
                return oldNamecall(self, ...)
            end)
            setreadonly(mt, true)

            ENV.PayomboyZRestoreMT = function()
                pcall(function()
                    setreadonly(mt, false)
                    mt.__namecall = oldNamecall
                    setreadonly(mt, true)
                end)
            end
            ENV.NyxRestoreMT = ENV.PayomboyZRestoreMT
        end)
        ENV.PayomboyZCorrectionMuted = ok
        ENV.NyxCorrectionMuted = ok
        return ok
    end

    local function killClientIntegrity()
        muteCorrectionReport()
        return true
    end

    ----------------------------------------------------------------
    -- Spatial Movement Engine
    ----------------------------------------------------------------
    local ANCHOR  = Vector3.new(536.4492797851562, 70.28306579589844, -365.0294189453125)
    local GATE_IN = Vector3.new(578, 70.3, -365.03)
    local MIN_HOVER = 3

    local SEP_LINE = (function()
        local objs = Workspace:FindFirstChild("__OBJECTS")
        local areas = objs and objs:FindFirstChild("Areas")
        return areas and areas:FindFirstChild("SeparationLine")
    end)()

    local GuardAreasFolder = (function()
        local objs = Workspace:FindFirstChild("__OBJECTS")
        local areas = objs and objs:FindFirstChild("Areas")
        return areas and areas:FindFirstChild("GuardAreas")
    end)()

    local function instantOK()
        return Runtime.instantReady and Cfg.MoveMode == "Instant"
    end

    local function blinkExact(pos)
        local root = hrp()
        if not root then return false end
        root.CFrame = CFrame.new(pos)
        root.AssemblyLinearVelocity = Vector3.zero
        return true
    end

    local function pin(pos)
        local stopped = false
        local conns = {}

        local function apply()
            if stopped then return end
            local root = hrp()
            if root then
                root.CFrame = CFrame.new(pos)
                root.AssemblyLinearVelocity = Vector3.zero
            end
        end

        conns[#conns + 1] = RunService.Heartbeat:Connect(apply)
        pcall(function() conns[#conns + 1] = RunService.PreSimulation:Connect(apply) end)
        pcall(function() conns[#conns + 1] = RunService.PostSimulation:Connect(apply) end)
        if RunService:IsClient() then
            pcall(function() conns[#conns + 1] = RunService.RenderStepped:Connect(apply) end)
        end

        apply()
        Runtime.pinConns = conns
        return function()
            if stopped then return end
            stopped = true
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            if Runtime.pinConns == conns then Runtime.pinConns = nil end
        end
    end

    local function waitPinned(pos, tol, timeout)
        tol = tol or 8
        local deadline = os.clock() + (timeout or 0.35)
        repeat
            RunService.Heartbeat:Wait()
            local root = hrp()
            if root and (root.Position - pos).Magnitude <= tol then return true end
        until os.clock() > deadline
        return false
    end

    local function blinkHold(pos, seconds)
        if not hrp() then return false end
        local unpin = pin(pos)
        local landed = waitPinned(pos, 6, math.max(seconds or 0.12, 0.3))
        for _ = 1, 3 do RunService.Heartbeat:Wait() end
        unpin()
        return landed
    end

    local function insideGameplay()
        local root = hrp()
        if not (root and SEP_LINE and AreaLookup and AreaLookup.IsInGameplaySide) then return false end
        local ok, inside = pcall(AreaLookup.IsInGameplaySide, SEP_LINE, root.Position)
        return ok and inside == true
    end

    local function enforceWalkSpeed()
        local want = Cfg.BoostWalkSpeed
        if not want or want <= 0 then return end
        local hum = humanoid()
        if hum and hum.WalkSpeed < want then hum.WalkSpeed = want end
    end

    local function guardPositions()
        local list = {}
        if not GuardAreasFolder then return list end
        for _, model in ipairs(GuardAreasFolder:GetChildren()) do
            local guard = model:FindFirstChild("Guard")
            if guard then
                local ok, gp = pcall(function() return guard:GetPivot().Position end)
                if ok and gp then list[#list + 1] = Vector3.new(gp.X, 0, gp.Z) end
            end
        end
        return list
    end

    local function nearestGuardDist(pos, list)
        local flat, best = Vector3.new(pos.X, 0, pos.Z), math.huge
        for _, gp in ipairs(list or guardPositions()) do
            local d = (gp - flat).Magnitude
            if d < best then best = d end
        end
        return best
    end

    ----------------------------------------------------------------
    -- Warp Fallback Engine
    ----------------------------------------------------------------
    local groundParams = RaycastParams.new()
    groundParams.FilterType = Enum.RaycastFilterType.Exclude
    groundParams.IgnoreWater = true

    local function groundYAt(pos)
        local ignore = { char() }
        local origin = pos + Vector3.new(0, 4, 0)
        for _ = 1, 10 do
            groundParams.FilterDescendantsInstances = ignore
            local hit = Workspace:Raycast(origin, Vector3.new(0, -600, 0), groundParams)
            if not hit then return nil end
            if hit.Instance.CanCollide and hit.Instance.Transparency < 1 then return hit.Position.Y end
            table.insert(ignore, hit.Instance)
        end
        return nil
    end

    local function settleFeet(seconds)
        local t0 = os.clock()
        while os.clock() - t0 < (seconds or 0.08) do
            task.wait()
            local r = hrp()
            if r then r.AssemblyLinearVelocity = Vector3.zero end
        end
    end

    local function steerAroundGuards(pos, gap, list)
        local out = pos
        for _ = 1, 3 do
            local worst, worstGap
            for _, gp in ipairs(list) do
                local d = (gp - Vector3.new(out.X, 0, out.Z)).Magnitude
                if d < gap and (not worstGap or d < worstGap) then worst, worstGap = gp, d end
            end
            if not worst then return out, true end
            local away = Vector3.new(out.X, 0, out.Z) - worst
            if away.Magnitude < 0.1 then away = Vector3.new(0, 0, 1) end
            away = away.Unit * (gap - worstGap + 6)
            out = out + Vector3.new(away.X, 0, away.Z)
        end
        return out, false
    end

    local function warpTo(dest, arriveDist, opts)
        opts = opts or {}
        arriveDist = arriveDist or 2.5
        local gap      = opts.guardGap or Cfg.GuardSafeGap or 26
        local deadline = os.clock() + (opts.timeout or 14)

        while os.clock() < deadline do
            if not alive() then return false, "เซสชันถูกแทนที่" end
            enforceWalkSpeed()
            local dt = RunService.Heartbeat:Wait()
            local root = hrp()
            if not root then return false, "ไม่มีตัวละคร" end

            local delta = dest - root.Position
            local flat  = Vector3.new(delta.X, 0, delta.Z)
            if flat.Magnitude <= arriveDist then return true end

            local hum   = humanoid()
            local speed = math.max(60, (hum and hum.WalkSpeed or 16) * (Cfg.WarpPct or 0.8))
            local step  = math.min(speed * dt, flat.Magnitude)
            local nextPos = root.Position + flat.Unit * step

            if not opts.ignoreGuards then
                local guards = guardPositions()
                local effGap = flat.Magnitude < 40 and math.min(gap, 12) or gap
                local steered, clear = steerAroundGuards(nextPos, effGap, guards)
                if not clear and nearestGuardDist(root.Position, guards) < 8 then return false, "ยามขวางทาง" end
                nextPos = steered
            end

            local gy = groundYAt(nextPos)
            if gy then nextPos = Vector3.new(nextPos.X, gy + MIN_HOVER, nextPos.Z) end

            root.CFrame = CFrame.new(nextPos)
            root.AssemblyLinearVelocity = Vector3.zero
        end
        return false, "วาปไม่ทันเวลา"
    end

    local function warpChain(dest, arriveDist, opts)
        opts = opts or {}
        local root = hrp()
        if not root then return false, "ไม่มีตัวละคร" end

        local hop  = math.max(60, Cfg.ZoneHopStep or 260)
        local from = root.Position
        local flat = Vector3.new(dest.X - from.X, 0, dest.Z - from.Z)
        local legs = math.max(1, math.ceil(flat.Magnitude / hop))

        for i = 1, legs - 1 do
            local wp = from + flat * (i / legs)
            local ok, err = warpTo(Vector3.new(wp.X, from.Y, wp.Z), 4, opts)
            if not ok then return false, err end
            settleFeet(0.08)
        end
        return warpTo(dest, arriveDist or 2.5, opts)
    end

    local function toAnchor()
        if instantOK() then return blinkHold(ANCHOR, 0.1) end
        local root = hrp()
        if not root then return false end
        if (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(ANCHOR.X, 0, ANCHOR.Z)).Magnitude < 4 then
            return blinkExact(ANCHOR)
        end
        if insideGameplay() then warpChain(GATE_IN, 4, { guardGap = 14 }) end
        warpChain(ANCHOR, 3, { ignoreGuards = true })
        return blinkExact(ANCHOR)
    end

    local function moveTo(pos)
        if instantOK() then
            local gy = groundYAt(pos)
            return blinkHold(gy and Vector3.new(pos.X, gy + MIN_HOVER, pos.Z) or (pos + Vector3.new(0, 3, 0)), 0.12)
        end
        return warpChain(pos, 5, { ignoreGuards = true })
    end

    ----------------------------------------------------------------
    -- Fly System Engine (ระบบบิน)
    ----------------------------------------------------------------
    local flyBV, flyBG, flyConn

    function stopFlying()
        if flyConn then pcall(function() flyConn:Disconnect() end) flyConn = nil end
        if flyBV then pcall(function() flyBV:Destroy() end) flyBV = nil end
        if flyBG then pcall(function() flyBG:Destroy() end) flyBG = nil end
        local hum = humanoid()
        if hum then hum.PlatformStand = false end
    end

    function startFlying()
        stopFlying()
        if not Cfg.FlyEnabled then return end

        local character = char()
        local root = hrp()
        local hum = humanoid()
        if not (character and root and hum) then return end

        hum.PlatformStand = true

        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        flyBV.Velocity = Vector3.zero
        flyBV.Parent = root

        flyBG = Instance.new("BodyGyro")
        flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        flyBG.P = 9e4
        flyBG.CFrame = root.CFrame
        flyBG.Parent = root

        flyConn = RunService.RenderStepped:Connect(function()
            if not (alive() and Cfg.FlyEnabled) then
                stopFlying()
                return
            end
            local cRoot = hrp()
            local cHum = humanoid()
            local cam = Workspace.CurrentCamera
            if not (cRoot and cHum and cam) then return end

            cHum.PlatformStand = true
            local speed = Cfg.FlySpeed or 50
            local moveDir = cHum.MoveDirection

            local flyVec = Vector3.zero
            if moveDir.Magnitude > 0 then
                local camCF = cam.CFrame
                local forward = camCF.LookVector
                local right = camCF.RightVector
                flyVec = (forward * -moveDir.Z + right * moveDir.X).Unit * speed
            end

            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                flyVec = flyVec + Vector3.new(0, speed, 0)
            elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                flyVec = flyVec + Vector3.new(0, -speed, 0)
            end

            if flyBV and flyBV.Parent then flyBV.Velocity = flyVec end
            if flyBG and flyBG.Parent then flyBG.CFrame = cam.CFrame end

            if Cfg.FlyNoclip then
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end

