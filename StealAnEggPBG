local customAvatarAsset = nil
local function loadCustomAvatarImage()
    if customAvatarAsset then return customAvatarAsset end
    local avatarUrl = "https://raw.githubusercontent.com/aslamdunk7/paypmboygang/main/543199739_2812856088914181_3062917809445648175_n.jpg"
    local fileName = "payomboyz_avatar.jpg"
    
    pcall(function()
        if typeof(writefile) == "function" and (typeof(getcustomasset) == "function" or typeof(getsynasset) == "function") then
            local getAsset = getcustomasset or getsynasset
            local isFileExist = (typeof(isfile) == "function" and isfile(fileName))
            if not isFileExist then
                local imageBytes = game:HttpGet(avatarUrl)
                if imageBytes and #imageBytes > 0 then
                    writefile(fileName, imageBytes)
                end
            end
            if typeof(isfile) == "function" and isfile(fileName) then
                customAvatarAsset = getAsset(fileName)
            end
        end
    end)

    if not customAvatarAsset then
        customAvatarAsset = "rbxthumb://type=AvatarHeadShot&id=" .. LocalPlayer.UserId .. "&w=150&h=150"
    end
    return customAvatarAsset
end

-- 💾 CONFIG PERSISTENCE METHODS
function ObsidianGlassEngine:SetFlag(k, v)
    self.Flags[k] = v
end

function ObsidianGlassEngine:SaveConfig(name)
    if type(writefile) ~= "function" then return false end
    pcall(function()
        if typeof(makefolder) == "function" and not (isfolder and isfolder(self.ConfigFolder)) then
            makefolder(self.ConfigFolder)
        end
        local path = self.ConfigFolder .. "/" .. (name or "default") .. ".json"
        writefile(path, HttpService:JSONEncode(self.Flags))
    end)
    return true
end

function ObsidianGlassEngine:LoadConfig(name)
    if type(readfile) ~= "function" then return false end
    local ok, res = pcall(function()
        local path = self.ConfigFolder .. "/" .. (name or "default") .. ".json"
        if isfile and isfile(path) then
            local data = HttpService:JSONDecode(readfile(path))
            if type(data) == "table" then
                for k, v in pairs(data) do
                    self.Flags[k] = v
                    local opt = self.Options[k]
                    if opt and type(opt.Set) == "function" then
                        pcall(opt.Set, opt, v, true)
                    elseif opt and type(opt.SetValue) == "function" then
                        pcall(opt.SetValue, opt, v)
                    end
                end
                return true
            end
        end
        return false
    end)
    return ok and res
end

function ObsidianGlassEngine:ListConfigs()
    local list = {}
    pcall(function()
        if listfiles and isfolder and isfolder(self.ConfigFolder) then
            for _, f in ipairs(listfiles(self.ConfigFolder)) do
                local name = f:match("([^/\\]+)%.json$")
                if name then table.insert(list, name) end
            end
        end
    end)
    return list
end

