local function getMyPlot()
    local userId = LocalPlayer.UserId
    local userName = LocalPlayer.Name:lower()
    local displayName = LocalPlayer.DisplayName:lower()
    
    local plotsFolder = Workspace:FindFirstChild("Plots") 
        or (Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Plots"))
        or Workspace:FindFirstChild("PlayerPlots")

    if plotsFolder then
        for _, plot in pairs(plotsFolder:GetChildren()) do
            local ownerAttr = plot:GetAttribute("Owner") or plot:GetAttribute("UserId") or plot:GetAttribute("OwnerUserId")
            if ownerAttr then
                if tostring(ownerAttr) == tostring(userId) or tostring(ownerAttr):lower() == userName then
                    return plot
                end
            end

            local sign = plot:FindFirstChild("PlotSign", true) or plot:FindFirstChild("Sign", true) or plot:FindFirstChild("OwnerSign", true)
            if sign then
                local text = ""
                for _, child in pairs(sign:GetDescendants()) do
                    if child:IsA("TextLabel") then text = text .. " " .. child.Text:lower() end
                end
                if text:find(userName) or text:find(displayName) then
                    return plot
                end
            end

            local ownerVal = plot:FindFirstChild("Owner") or plot:FindFirstChild("OwnerUserId")
            if ownerVal and ownerVal:IsA("ValueObject") then
                if tostring(ownerVal.Value) == tostring(userId) or tostring(ownerVal.Value):lower() == userName then
                    return plot
                end
            end
        end
    end

    for _, plot in pairs(Workspace:GetChildren()) do
        if plot.Name:lower():find("plot") then
            local ownerAttr = plot:GetAttribute("Owner") or plot:GetAttribute("UserId")
            if ownerAttr and (tostring(ownerAttr) == tostring(userId) or tostring(ownerAttr):lower() == userName) then
                return plot
            end
        end
    end

    return nil
end

local function getPlotSpawnPos(plot)
    plot = plot or getMyPlot()
    if not plot then return nil end

    local spawnPart = plot:FindFirstChild("SpawnPoint", true) 
        or plot:FindFirstChild("PlotSign", true) 
        or plot:FindFirstChild("PlayerPlotSign", true)
        or plot:FindFirstChild("Spawn", true)
        or plot:FindFirstChild("Pad", true)
        or plot.PrimaryPart

    if spawnPart then
        return spawnPart:IsA("Model") and spawnPart:GetPivot().Position or spawnPart.Position
    end

    return plot:GetPivot().Position
end

local function isAtMyPlot()
    local char = LocalPlayer.Character
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
    local plot = getMyPlot()
    if not root or not plot then return false end
    local spawnPos = getPlotSpawnPos(plot)
    if not spawnPos then return false end

    return (root.Position - spawnPos).Magnitude <= 35
end

local function teleportToMyPlot()
    local char = LocalPlayer.Character
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
    local plot = getMyPlot()
    if not root then return false end

    local destPos = getPlotSpawnPos(plot)
    if destPos then
        root.CFrame = CFrame.new(destPos + Vector3.new(0, 3, 0))
        return true
    end
    return false
end

local function MeetsFilter(rarityInput, nameInput, minRarityFilter, selectedTypeFilter, areaInput)
    if minRarityFilter and minRarityFilter ~= "ALL" then
        local targetVal = RarityLevels[minRarityFilter] or 1
        local itemVal = GetRarityVal(rarityInput or nameInput)
        if itemVal < targetVal then
            return false
        end
    end

    if selectedTypeFilter and selectedTypeFilter ~= "ALL" then
        local searchKey = tostring(selectedTypeFilter):lower():gsub(" egg", ""):gsub(" pet", "")
        local rStr = tostring(rarityInput or ""):lower()
        local nStr = tostring(nameInput or ""):lower()
        local aStr = tostring(areaInput or ""):lower()

        if nStr == "egg" or nStr == "wildegg" or nStr == "model" or nStr:find("egg") then
            return true
        end

        if not (rStr:find(searchKey) or nStr:find(searchKey) or aStr:find(searchKey)) then
            return false
        end
    end

    return true
end

local function MeetsStealFilter(rarity, name, area)
    return MeetsFilter(rarity, name, Config.MinRarityStealFilter, Config.TargetEggTypeSteal, area)
end

local function MeetsPlaceFilter(rarity, name)
    return MeetsFilter(rarity, name, Config.MinRarityPlaceFilter, Config.TargetEggTypePlace)
end

local function MeetsHatchFilter(rarity, name)
    return MeetsFilter(rarity, name, Config.MinRarityHatchFilter, Config.TargetEggTypeHatch)
end

local function MeetsSellFilter(rarity, name)
    return MeetsFilter(rarity, name, Config.MinRaritySellFilter, Config.TargetPetTypeSell)
end

