-- SAE_Nyx reads the pushed snapshot; the Uid is backfilled from the table key so
-- both shapes the game has shipped (snap.Records and a flat map) answer the same
-- Helper for flexible area ID matching (handles numbers, strings, names, and attributes)
local function checkAreaAllowed(areaId)
    if areaId == nil then return true end
    if not Cfg.StealAreas then return true end

    -- Direct key match (e.g. Cfg.StealAreas["Lake"] or Cfg.StealAreas["Area 1"])
    if Cfg.StealAreas[areaId] ~= nil then return Cfg.StealAreas[areaId] == true end

    -- Index match if areaId is numeric (1 -> AREAS[1])
    if type(areaId) == "number" and AREAS[areaId] then
        local name = AREAS[areaId]
        if Cfg.StealAreas[name] ~= nil then return Cfg.StealAreas[name] == true end
    end

    -- Match string with area number pattern (e.g. "Area1", "Area_1", "1")
    local str = tostring(areaId)
    if Cfg.StealAreas[str] ~= nil then return Cfg.StealAreas[str] == true end

    local num = tonumber(str:match("%d+"))
    if num and AREAS[num] and Cfg.StealAreas[AREAS[num]] ~= nil then
        return Cfg.StealAreas[AREAS[num]] == true
    end

    -- Fuzzy name match against AREAS table
    for idx, areaName in ipairs(AREAS) do
        if str:find(areaName, 1, true) or areaName:find(str, 1, true) then
            if Cfg.StealAreas[areaName] ~= nil then return Cfg.StealAreas[areaName] == true end
        end
    end

    return true
end

local function detectAreaFromInstance(inst)
    if not inst then return nil end
    local a = inst:GetAttribute("AreaId") or inst:GetAttribute("Area") or inst:GetAttribute("AreaName")
    if a then return a end

    local curr = inst
    for _ = 1, 6 do
        if not curr or curr == Workspace then break end
        if curr:GetAttribute("AreaId") then return curr:GetAttribute("AreaId") end
        if curr:GetAttribute("Area") then return curr:GetAttribute("Area") end

        local cName = curr.Name
        for idx, areaName in ipairs(AREAS) do
            if cName:find(areaName, 1, true) then return areaName end
        end
        local num = cName:match("Area%s*(%d+)") or cName:match("Zone%s*(%d+)")
        if num then return tonumber(num) end

        curr = curr.Parent
    end
    return nil
end

local function areaEggRecords()
    local list = {}
    local seenPositions = {}

    -- 1. Parse module snapshot if available
    local snap
    local ok = false
    local modulesToTry = { EggRecords, EggState, EggCmds }

    for _, mod in ipairs(modulesToTry) do
        if mod and type(mod) == "table" then
            for _, fnName in ipairs({ "GetAreaEggSnapshot", "GetAreaEggRecords", "GetAreaEggRecordsList", "GetSnapshot", "GetRecords", "GetState" }) do
                if type(mod[fnName]) == "function" then
                    ok, snap = pcall(mod[fnName])
                    if ok and type(snap) == "table" then break end
                end
            end
        end
        if ok and type(snap) == "table" then break end
    end

    if ok and type(snap) == "table" then
        local src = (type(snap.Records) == "table") and snap.Records or snap
        for uid, rec in pairs(src) do
            if type(rec) == "table" then
                if rec.Uid == nil and type(uid) == "string" then rec.Uid = uid end
                rec.BottomCFrame = rec.BottomCFrame or rec.CFrame or (rec.Position and CFrame.new(rec.Position))
                if rec.BottomCFrame then
                    local pos = rec.BottomCFrame.Position
                    local key = ("%.1f_%.1f_%.1f"):format(pos.X, pos.Y, pos.Z)
                    if not seenPositions[key] then
                        seenPositions[key] = true
                        list[#list + 1] = rec
                    end
                end
            end
        end
    end

    -- 2. Always scan ProximityPrompts across Workspace to capture all physical eggs
    for _, prompt in ipairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local pName = prompt.Name
            if pName == "CarryAreaEgg" or string.find(pName, "Egg", 1, true) or string.find(pName, "Steal", 1, true) or string.find(pName, "Carry", 1, true) then
                local parent = prompt.Parent
                local promptPos = nil
                if parent then
                    if parent:IsA("Attachment") then promptPos = parent.WorldPosition
                    elseif parent:IsA("BasePart") then promptPos = parent.Position
                    elseif parent:IsA("Model") then promptPos = parent:GetPivot().Position end
                end

                if promptPos then
                    local key = ("%.1f_%.1f_%.1f"):format(promptPos.X, promptPos.Y, promptPos.Z)
                    if not seenPositions[key] then
                        seenPositions[key] = true
                        local model = parent and (parent:IsA("Model") and parent or parent.Parent)
                        local nameStr = (model and model.Name) or prompt.Name
                        local cat = (model and (model:GetAttribute("AssetCategory") or model:GetAttribute("Category"))) or nameStr
                        local areaId = detectAreaFromInstance(model) or detectAreaFromInstance(prompt) or 1

                        table.insert(list, {
                            Uid = (model and model:GetAttribute("Uid")) or ("Egg_" .. tostring(#list + 1)),
                            AssetCategory = cat,
                            AreaId = areaId,
                            State = "Slot",
                            BottomCFrame = CFrame.new(promptPos),
                            Instance = model,
                            Prompt = prompt
                        })
                    end
                end
            end
        end
    end

    -- 3. Workspace model scan fallback
    local objs = Workspace:FindFirstChild("__OBJECTS") or Workspace
    local candidates = { objs:FindFirstChild("Eggs"), objs:FindFirstChild("AreaEggs"), Workspace:FindFirstChild("AreaEggs"), objs:FindFirstChild("Areas") }
    for _, folder in ipairs(candidates) do
        if folder then
            for _, model in ipairs(folder:GetDescendants()) do
                if model:IsA("Model") and (model:GetAttribute("AssetCategory") or string.find(model.Name, "Egg", 1, true)) then
                    local cf = model:GetPivot()
                    local pos = cf.Position
                    local key = ("%.1f_%.1f_%.1f"):format(pos.X, pos.Y, pos.Z)
                    if not seenPositions[key] then
                        seenPositions[key] = true
                        local uid = model:GetAttribute("Uid") or model.Name
                        local cat = model:GetAttribute("AssetCategory") or model:GetAttribute("Category") or model.Name
                        local areaId = detectAreaFromInstance(model) or 1
                        table.insert(list, {
                            Uid = uid,
                            AssetCategory = cat,
                            AreaId = areaId,
                            State = "Slot",
                            BottomCFrame = cf,
                            Instance = model
                        })
                    end
                end
            end
        end
    end

    return list
end

-- every egg row carries the pet it will hatch into, so what is in the bag or
-- growing in the pen is knowable before it cracks
local function eggRoster()
    local recs = myRuntimeRecords()
    local now  = os.time()
    local list = {}

    for uid, raw in pairs(eggInventory()) do
        if type(raw) == "table" and raw.AssetCategory then
            local rec    = recs[uid]
            local placed = rec and rec.Placement or nil
            local ready, remain = false, nil

            if placed then
                local ok, r = false, false
                if EggCmds and EggCmds.IsLocalEggReady then ok, r = pcall(EggCmds.IsLocalEggReady, uid) end
                ready = ok and r == true

                if not ready and EggUtil and EggUtil.GetGrowthDuration then
                    local okd, dur = pcall(EggUtil.GetGrowthDuration, rec)
                    if okd and tonumber(dur) then
                        local credit = (tonumber(placed.GrowthCreditSeconds) or 0)
                            + (tonumber(placed.NightGrowthCreditSeconds) or 0)
                        local elapsed = now - (tonumber(placed.PlacedAt) or now) + credit
                        remain = math.max(0, math.floor(tonumber(dur) - elapsed))
                    end
                end
            end

            list[#list + 1] = {
                uid = uid, cat = raw.AssetCategory, rarity = rarityOf(raw.AssetCategory),
                placed = placed ~= nil, ready = ready, remain = remain,
            }
        end
    end
    return list
end

local function clockText(sec)
    if not sec then return "?" end
    if sec <= 0 then return "พร้อม" end
    if sec < 60 then return ("%ds"):format(sec) end
    if sec < 3600 then return ("%dm"):format(math.floor(sec / 60)) end
    return ("%dh %dm"):format(math.floor(sec / 3600), math.floor(sec % 3600 / 60))
end

function unplacedEggs()
    local recs = myRuntimeRecords()
    local out = {}
    for uid, raw in pairs(eggInventory()) do
        if not (recs[uid] and recs[uid].Placement) and type(raw) == "table" and raw.AssetCategory then
            local price = 0
            if EggUtil and EggUtil.GetSellPrice then
                local ok, p = pcall(EggUtil.GetSellPrice, raw)
                if ok then price = tonumber(p) or 0 end
            end
            if price == 0 then price = earnRate(raw.AssetCategory) * 100 end
            out[#out + 1] = { uid = uid, cat = raw.AssetCategory, rarity = rarityOf(raw.AssetCategory), price = price }
        end
    end
    return out
end

function occupiedSpots()
    local spots = {}
    for _, rec in pairs(myRuntimeRecords()) do
        if rec.Placement and rec.Placement.LocalCFrame then
            local lcf = rec.Placement.LocalCFrame
            if typeof(lcf) == "CFrame" then
                table.insert(spots, lcf.Position)
            elseif typeof(lcf) == "Vector3" then
                table.insert(spots, lcf)
            elseif type(lcf) == "table" then
                if lcf.Position then
                    table.insert(spots, lcf.Position)
                elseif lcf.X and lcf.Y and lcf.Z then
                    table.insert(spots, Vector3.new(lcf.X, lcf.Y, lcf.Z))
                elseif lcf[1] and lcf[2] and lcf[3] then
                    table.insert(spots, Vector3.new(lcf[1], lcf[2], lcf[3]))
                end
            end
        end
    end
    return spots
end

function nextFreeSpot(taken)
    local pd = plotData()
    if not pd or not pd.PetArea then return nil end
    local pa = pd.PetArea
    local center = (pd.CenterPoint and pd.CenterPoint.CFrame) or pa.CFrame
    local halfX = math.max(pa.Size.X * 0.5 - 4, 2)
    local halfZ = math.max(pa.Size.Z * 0.5 - 4, 2)
    local spacing = 4.5

    for radius = 0, math.max(halfX, halfZ), spacing do
        for dx = -radius, radius, spacing do
            for dz = -radius, radius, spacing do
                if math.abs(dx) == radius or math.abs(dz) == radius or radius == 0 then
                    if math.abs(dx) <= halfX and math.abs(dz) <= halfZ then
                        local world = pa.CFrame * CFrame.new(dx, 0, dz)
                        local flat  = CFrame.new(world.Position.X, pa.CFrame.Position.Y, world.Position.Z)
                        local lcf   = center:ToObjectSpace(flat)
                        local free  = true
                        for _, p in ipairs(taken) do
                            if (Vector3.new(p.X, 0, p.Z) - Vector3.new(lcf.X, 0, lcf.Z)).Magnitude < spacing - 0.5 then
                                free = false break
                            end
                        end
                        if free then return lcf end
                    end
                end
            end
        end
    end
    return nil
end

function atHome()
