local function GetRemote(category, name)
    if not Network then return nil end
    local nameWithSpace = category .. ": " .. name
    local remote = Network:FindFirstChild(nameWithSpace)
    if not remote then
        local nameNoSpace = category .. ":" .. name
        remote = Network:FindFirstChild(nameNoSpace)
    end
    if not remote then
        local folder = Network:FindFirstChild(category)
        if folder then
            remote = folder:FindFirstChild(name)
        end
    end
    return remote
end

