-- ADVANCED HIGH-SPEED MOVEMENT ENGINE (STEP / FLY / TWEEN)
---------------------------------------------------------
local isMovingToTarget = false

local function MoveToTarget(targetPos, options)
    local root = getRootPart()
    if not root then return false end
    
    options = options or {}
    local moveMode = options.MoveMode or Config.MoveMode or "step"
    local stepDist = math.clamp(options.Step or Config.Step or 55, 10, 120)
    local gapDelay = math.max(options.Gap or Config.Gap or 0.10, 0.02)
    local warmupSteps = options.WarmupSteps or Config.WarmupSteps or 8
    local warmupMul = options.WarmupGapMul or Config.WarmupGapMul or 2.5
    local flyHeight = options.FlyHeight or Config.FlyHeight or 12
    local flyMaxSpeed = options.FlyMaxSpeed or Config.FlyMaxSpeed or 500

    isMovingToTarget = true

    if moveMode == "step" then
        local startPos = root.Position
        local delta = targetPos - startPos
        local totalDist = delta.Magnitude
        if totalDist < 2 then
            isMovingToTarget = false
            return true
        end

        local direction = delta.Unit
        local numSteps = math.ceil(totalDist / stepDist)

        for i = 1, numSteps do
            if not isMovingToTarget or not root or not root.Parent then break end
            local nextDist = math.min(i * stepDist, totalDist)
            local nextPos = startPos + direction * nextDist

            if Config.GroundSnap then
                local groundPos = raycastGround(nextPos)
                nextPos = Vector3.new(nextPos.X, groundPos.Y + 3, nextPos.Z)
            end

            -- Preserve character rotation so user right-click mouse camera controls remain 100% unlocked
            local rotCFrame = root.CFrame - root.CFrame.Position
            root.CFrame = CFrame.new(nextPos) * rotCFrame
            
            -- Apply Noclip during step movement
            if Config.Noclip then
                local char = getCharacter()
                if char then
                    for _, p in pairs(char:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
            end

            -- Step delay with warmup multiplier for takeoff safety
            local delayTime = gapDelay
            if i <= warmupSteps then
                delayTime = gapDelay * warmupMul
            end
            task.wait(delayTime)
        end
    elseif moveMode == "fly" then
        local startPos = root.Position
        local targetFlyPos = Vector3.new(targetPos.X, targetPos.Y + flyHeight, targetPos.Z)
        local delta = targetFlyPos - root.Position
        local totalDist = delta.Magnitude
        local duration = math.max(totalDist / flyMaxSpeed, 0.05)

        local startTime = os.clock()
        while os.clock() - startTime < duration and isMovingToTarget and root and root.Parent do
            local alpha = (os.clock() - startTime) / duration
            local currentPos = startPos:Lerp(targetFlyPos, math.min(alpha, 1))

            if Config.GroundSnap then
                local groundPos = raycastGround(currentPos)
                currentPos = Vector3.new(currentPos.X, groundPos.Y + flyHeight, currentPos.Z)
            end

            -- Preserve character rotation so camera dragging is completely smooth & unlocked
            local rotCFrame = root.CFrame - root.CFrame.Position
            root.CFrame = CFrame.new(currentPos) * rotCFrame

            if Config.Noclip then
                local char = getCharacter()
                if char then
                    for _, p in pairs(char:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
            end
            task.wait()
        end
        if root and root.Parent then
            local rotCFrame = root.CFrame - root.CFrame.Position
            root.CFrame = CFrame.new(targetPos) * rotCFrame
        end
    elseif moveMode == "tween" then
        local startPos = root.Position
        local totalDist = (targetPos - startPos).Magnitude
        local speed = 75
        local duration = math.max(totalDist / speed, 0.1)

        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(root, tweenInfo, { CFrame = CFrame.new(targetPos) })
        tween:Play()

        local startTime = os.clock()
        while os.clock() - startTime < duration and isMovingToTarget and root and root.Parent do
            if Config.Noclip then
                local char = getCharacter()
                if char then
                    for _, p in pairs(char:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
            end
            task.wait()
        end
    end

    isMovingToTarget = false
    return true
end

