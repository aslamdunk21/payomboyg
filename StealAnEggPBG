        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.F) then
            moveDir = moveDir - Vector3.new(0, 1, 0)
        end

        local speed = Config.FlySpeed or 120
        if moveDir.Magnitude > 0 then
            flyBodyVel.Velocity = moveDir.Unit * speed
        else
            flyBodyVel.Velocity = Vector3.zero
        end
        flyBodyGyro.CFrame = camCF
    else
        if flyBodyVel then
            flyBodyVel:Destroy()
            flyBodyVel = nil
