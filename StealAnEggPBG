                local optPadding = Instance.new("UIPadding")
                optPadding.PaddingBottom = UDim.new(0, 35)
                optPadding.PaddingTop = UDim.new(0, 2)
                optPadding.PaddingLeft = UDim.new(0, 2)
                optPadding.PaddingRight = UDim.new(0, 4)
