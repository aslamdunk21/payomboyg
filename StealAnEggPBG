    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        for _, label in pairs(playerGui:GetDescendants()) do
            if (label:IsA("TextLabel") or label:IsA("TextButton")) and label.Visible then
                local txt = label.Text:upper()
                if txt:find("RUN!!") or txt == "DROP" or txt:find("DROP") then
