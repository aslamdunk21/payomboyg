local _LocalPlayer = game:GetService("Players").LocalPlayer

----------------------------------------------------------------
-- 1. Humanoid Clone Bypass (Bypass Humanoid State / Anti-Death)
----------------------------------------------------------------
local function doHumanoidBypass()
    local char = _LocalPlayer.Character or _LocalPlayer.CharacterAdded:Wait()
    if not char then return end

    local origHum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
    if not origHum then return end

    pcall(function()
        local cloneHum = origHum:Clone()
        cloneHum.WalkSpeed  = origHum.WalkSpeed
        cloneHum.JumpPower  = origHum.JumpPower
        cloneHum.MaxHealth  = origHum.MaxHealth
        cloneHum.Health     = origHum.Health
        cloneHum.AutoRotate = origHum.AutoRotate
        cloneHum.Parent     = char

        task.wait(0.05)
        origHum:Destroy()

        task.wait(0.05)
        workspace.CurrentCamera.CameraSubject = cloneHum
        print("[SAE] Humanoid bypass OK")
    end)
end

doHumanoidBypass()

_LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.3)
    doHumanoidBypass()
end)

----------------------------------------------------------------
-- 2. Constant Scan & Hook Bypass ("X-14" Scan)
----------------------------------------------------------------
task.spawn(function()
    pcall(function()
        if typeof(getgc) ~= "function" or typeof(hookfunction) ~= "function" then return end

        local getconstants = getconstants or (debug and debug.getconstants)
        local islclosure = islclosure or function(Function)
            return type(Function) == "function" and not pcall(setfenv, Function, getfenv(Function))
        end
        if not getconstants then return end

        local gcList = getgc()
        for _, getgcResult in next, gcList do
            if type(getgcResult) == "function" and islclosure(getgcResult) then
                local okConst, constants = pcall(getconstants, getgcResult)
                if okConst and type(constants) == "table" then
                    local hasX14 = false
                    for _, constantVal in next, constants do
                        if constantVal == "X-14" then
                            hasX14 = true
                            break
                        end
                    end

                    if hasX14 then
                        local OldHook
                        OldHook = hookfunction(getgcResult, function(...)
                            local getstack = debug and debug.getstack
                            local setstack = debug and debug.setstack
                            if getstack and setstack then
                                local Level = 1
                                local okStack, stack = pcall(getstack, Level)
                                if okStack and type(stack) == "table" then
                                    for idx, val in next, stack do
                                        if val == "X-14" then
                                            pcall(setstack, Level, idx, nil)
                                        end
                                    end
                                end
                            end
                            return OldHook(...)
                        end)
                    end
                end
            end
        end
    end)
end)

----------------------------------------------------------------
-- 3. Detection Function Metatable Bypass ("gmatch", "GetFullName")
----------------------------------------------------------------
task.spawn(function()
    pcall(function()
        if typeof(filtergc) ~= "function" then return end

        local detectionFunctions = filtergc("function", {
            Constants = { "gmatch", "GetFullName" }
        }, true)

        local fnList = (type(detectionFunctions) == "table") and detectionFunctions or { detectionFunctions }

        for _, fn in ipairs(fnList) do
            if type(fn) == "function" and debug and debug.getupvalues then
                local okUp, upvalues = pcall(debug.getupvalues, fn)
                if okUp and type(upvalues) == "table" then
                    for _, upvalueValue in next, upvalues do
                        if typeof(upvalueValue) == "table" and setrawmetatable then
                            pcall(setrawmetatable, upvalueValue, {
                                __newindex = function(self, key, newValue)
                                    warn(("[Bypass] Blocked detection: %s = %s"):format(tostring(key), tostring(newValue)))
                                end,
                            })
                        end
                    end
                end
            end
        end
        print("[SAE] Detection bypass loaded")
    end)
end)

