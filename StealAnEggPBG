        end
        local eggCarryRemote2 = GetRemote("Eggs", "RequestAreaEggCarry")
        local unequipRemote2 = GetRemote("Eggs", "RequestUnequipTool")
        if eggCarryRemote2 then
            PushPriorityTask(1, "RequestAreaEggCarry", function()
                -- Unequip current tool first
                if unequipRemote2 then
                    local char = getCharacter()
                    if char then
                        for _, item in pairs(char:GetChildren()) do
                            if item:IsA("Tool") then
                                local toolUid = findEggUid(item)
                                if toolUid then
                                    pcall(function() unequipRemote2:InvokeServer(toolUid) end)
                                end
                            end
                        end
                    end
                end
                task.wait(0.05)
                -- Correct payload: {Uid = ...} only
                local eggUid = findEggUid(targetEggPart) or (targetEggData and targetEggData.Uid)
                local slotKey = targetEggPart:GetAttribute("FirstAreaSlotKey") or targetEggPart:GetAttribute("SlotKey") or (targetEggData and targetEggData.FirstAreaSlotKey)
                if eggUid then
                    local payload = { Uid = eggUid }
                    if slotKey then payload.FirstAreaSlotKey = slotKey end
                    ThrottledInvoke(eggCarryRemote2, { payload }, 0.05)
                else
                    ThrottledInvoke(eggCarryRemote2, { { Uid = targetEggPart.Name } }, 0.05)
                end
            end)
        end
        task.wait(0.2)

        SetState(States.RETURN_HOME, "Steal successful! Flying back to plot...")
        local plot = getMyPlot()
        if plot then
            local destPos = getPlotSpawnPos(plot)
            if destPos then
                MoveToTarget(destPos + Vector3.new(0, 15, 0), { MoveMode = "fly", FlyHeight = 15 })
            else
                teleportToMyPlot()
            end
        else
            teleportToMyPlot()
        end

        SetState(States.REST, string.format("Resting at plot (%.1fs)...", Config.SafeZonePause))
        task.wait(Config.SafeZonePause)
    end
end

-- TASK 2: EGG PLACEMENT SEQUENCE (WHO: Character -> WHERE: Plot Pen -> WHAT: Equip then Place -> HOW: RequestEquipTool + RequestPlaceEgg with LocalCFrame)
local function Task_PlaceEggSequence()
    if not Config.AutoPlaceEgg then return end

    SetState(States.PLACE_EGG, "Checking eggs in backpack to place on plot...")
    if Config.AutoTPHomeToPlace and not isAtMyPlot() then
        teleportToMyPlot()
        task.wait(0.3)
    end

    pcall(function()
        local placeEggRemote = GetRemote("Eggs", "RequestPlaceEgg")
        local equipToolRemote = GetRemote("Eggs", "RequestEquipTool")
        if not placeEggRemote then return end

        local char = getCharacter()
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        local placedAny = false

        -- Collect all egg items from backpack and character
        local items = {}
        if backpack then
            for _, item in pairs(backpack:GetChildren()) do
                if item:IsA("Tool") and item.Name:lower():find("egg") then
                    table.insert(items, item)
                end
            end
        end
        if char then
            for _, item in pairs(char:GetChildren()) do
                if item:IsA("Tool") and item.Name:lower():find("egg") then
                    table.insert(items, item)
                end
            end
        end

        -- Resolve plot pen grid center for LocalCFrame calculation
        local myPlot = getMyPlot()
        local penCenter = nil
        if myPlot then
            -- Look for StarterPen or any Pen model, then find GridCenter within it
            local pen = myPlot:FindFirstChild("StarterPen", true)
                or myPlot:FindFirstChild("Pen", true)
                or myPlot:FindFirstChild("ToUpdate", true)
            if pen then
                local gc = pen:FindFirstChild("GridCenter", true)
                if gc and gc:IsA("BasePart") then
                    penCenter = gc.Position
                end
            end
            -- Fallback: use CenterPoint of plot
            if not penCenter then
                local cp = myPlot:FindFirstChild("CenterPoint", true)
                if cp and cp:IsA("BasePart") then
                    penCenter = cp.Position
                end
            end
            -- Last resort: plot pivot
            if not penCenter then
                pcall(function() penCenter = myPlot:GetPivot().Position end)
            end
        end

        -- Generate a simple grid of slot offsets (local to pen), spacing 5 studs
        -- Pattern: rows of 5, Y fixed at -0.5 (ground level within pen)
        local slotIndex = 0
        local slotSpacing = 5
        local slotsPerRow = 5
        local function getNextSlotLocalCFrame()
            local row = math.floor(slotIndex / slotsPerRow)
            local col = slotIndex % slotsPerRow
            slotIndex = slotIndex + 1
            local lx = (col - math.floor(slotsPerRow / 2)) * slotSpacing
            local lz = row * slotSpacing
            return CFrame.new(lx, -0.5, lz)
        end

        for _, tool in pairs(items) do
            local rarity = tool:GetAttribute("Rarity") or tool.Name
            if MeetsPlaceFilter(rarity, tool.Name) then
                local capturedTool = tool
                local toolUid, uidSource = findEggUid(capturedTool)

                if toolUid then
                    placedAny = true
                    local slotLocalCFrame = getNextSlotLocalCFrame()
                    SetState(States.PLACE_EGG, string.format("Placing [%s] (UID via %s: %s) on plot...", capturedTool.Name, tostring(uidSource), tostring(toolUid):sub(1, 8)))

                    PushPriorityTask(1, "RequestEquipThenPlace_" .. tostring(toolUid):sub(1, 6), function()
                        -- Step 1: Equip the egg tool (confirmed required by remote spy)
                        if equipToolRemote then
                            pcall(function() equipToolRemote:InvokeServer(toolUid) end)
                            task.wait(0.15)
                        end
                        -- Step 2: Place with Uid + LocalCFrame
                        pcall(function()
                            placeEggRemote:InvokeServer({
                                Uid = toolUid,
                                LocalCFrame = slotLocalCFrame
                            })
                        end)
                    end)
                    task.wait(0.3)
                else
                    warn(string.format("[PlaceEgg Warning] Could not find UUID attribute on tool [%s]. Available attributes: ", capturedTool.Name))
                    pcall(function()
                        for k, v in pairs(capturedTool:GetAttributes()) do
                            warn("  - " .. tostring(k) .. " = " .. tostring(v))
                        end
                    end)
                end
            end
        end

        if not placedAny then
            SetState(States.PLACE_EGG, "No eligible eggs in backpack to place.")
        end
    end)
end

-- TASK 3: EGG HATCHING SEQUENCE (WHO: Character -> WHERE: Placed Eggs on Plot -> WHAT: Hatch & Claim -> HOW: RequestEquipTool + RequestHatchEgg + RequestCompleteHatchEgg)
local function Task_HatchPetSequence()
    if not (Config.AutoHatch or Config.AutoHatchEgg) then return end

    local myPlot = getMyPlot()
    if not myPlot then
        SetState(States.HATCH_EGG, "Searching for player plot/home...")
        return
    end

    SetState(States.HATCH_EGG, "Scanning plot for hatchable eggs & timers...")

    -- 1. Trigger proximity prompts for hatching on workspace & plot
    for _, prompt in pairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local actionText = (prompt.ActionText or ""):lower()
            local objectText = (prompt.ObjectText or ""):lower()
            local parentName = (prompt.Parent and prompt.Parent.Name or ""):lower()
            if actionText:find("hatch") or objectText:find("hatch") or parentName:find("hatch")
               or actionText:find("claim") or objectText:find("claim")
               or actionText:find("open") or objectText:find("open") then
                triggerPrompt(prompt)
            end
        end
    end

    -- 2. Build list of egg containers to scan on my plot
    local userIdStr = tostring(LocalPlayer.UserId)
    local searchFolders = {}

    local placedEggRenders = Workspace:FindFirstChild("PlacedEggRenders")
    if placedEggRenders then table.insert(searchFolders, placedEggRenders) end

    table.insert(searchFolders, myPlot)
    for _, subName in ipairs({ "PlacedEggs", "Eggs", "ToUpdate", "StarterPen", "Pen", "PetArea" }) do
        local sub = myPlot:FindFirstChild(subName, true)
        if sub then table.insert(searchFolders, sub) end
    end

    local hatchRemote = GetRemote("Eggs", "RequestHatchEgg")
    local completeHatchRemote = GetRemote("Eggs", "RequestCompleteHatchEgg")
    local equipToolRemote = GetRemote("Eggs", "RequestEquipTool")

    local scannedEggCount = 0

    for _, folder in ipairs(searchFolders) do
        for _, eggModel in pairs(folder:GetChildren()) do
            if eggModel:IsA("Model") or eggModel:IsA("BasePart") then
                -- Check ownership
                local ownerAttr = eggModel:GetAttribute("Owner")
                    or eggModel:GetAttribute("UserId")
                    or eggModel:GetAttribute("Player")
                    or eggModel:GetAttribute("OwnerName")
                local isMyEgg = false

                if ownerAttr then
                    local ownerStr = tostring(ownerAttr):lower()
                    if ownerStr == userIdStr or ownerStr == LocalPlayer.Name:lower() then
                        isMyEgg = true
                    end
                elseif myPlot and eggModel:IsDescendantOf(myPlot) then
                    isMyEgg = true
                elseif eggModel.Name:lower():find("egg") then
                    isMyEgg = true
                end

                if isMyEgg then
                    scannedEggCount = scannedEggCount + 1

                    -- Smart UUID discovery scan across all attributes and ValueBase objects
                    local eggId, uidSource = findEggUid(eggModel)

                    -- Scan for timer / ready status attributes
                    local readyAttr = eggModel:GetAttribute("Ready")
                        or eggModel:GetAttribute("IsReady")
                        or eggModel:GetAttribute("CanHatch")
                    local timerAttr = eggModel:GetAttribute("HatchTime")
                        or eggModel:GetAttribute("TimeLeft")
                        or eggModel:GetAttribute("Timer")
                        or eggModel:GetAttribute("RemainingTime")

                    -- Check TextLabels inside BillboardGui for "READY", "0s", "HATCH", "TAP"
                    local isGuiReady = false
                    for _, desc in pairs(eggModel:GetDescendants()) do
                        if desc:IsA("TextLabel") then
                            local txt = desc.Text:lower()
                            if txt:find("ready") or txt:find("0s") or txt:find("hatch") or txt:find("open") or txt:find("claim") or txt == "0" then
                                isGuiReady = true
                                break
                            end
                        end
                    end

                    -- Determine if egg is ready to hatch (default true if no timer attribute found)
                    local isReadyToHatch = true
                    if readyAttr ~= nil then
                        isReadyToHatch = (readyAttr == true or tostring(readyAttr):lower() == "true")
                    elseif timerAttr ~= nil and type(timerAttr) == "number" then
                        isReadyToHatch = (timerAttr <= 0)
                    elseif isGuiReady then
                        isReadyToHatch = true
                    end

                    -- Trigger all proximity prompts on the egg
                    for _, desc in pairs(eggModel:GetDescendants()) do
                        if desc:IsA("ProximityPrompt") then
                            triggerPrompt(desc)
                        end
                    end

                    if eggId and isReadyToHatch then
                        local capturedId = eggId
                        SetState(States.HATCH_EGG, string.format("Hatching egg [%s] (UID: %s...)...", eggModel.Name, capturedId:sub(1, 8)))

                        PushPriorityTask(2, "RequestHatchEgg_" .. capturedId:sub(1, 6), function()
                            -- Step 1: Equip the egg tool (if required by server)
                            if equipToolRemote then
                                pcall(function() equipToolRemote:InvokeServer(capturedId) end)
                                task.wait(0.05)
                            end
                            -- Step 2: Invoke RequestHatchEgg
                            if hatchRemote then
                                pcall(function() hatchRemote:InvokeServer(capturedId) end)
                                task.wait(0.1)
                            end
                            -- Step 3: Invoke RequestCompleteHatchEgg (claim hatched pet)
                            if completeHatchRemote then
                                pcall(function() completeHatchRemote:InvokeServer(capturedId) end)
                                task.wait(0.05)
                                pcall(function() completeHatchRemote:InvokeServer(capturedId) end)
                            end
                        end)
                        task.wait(0.2)
                    end
                end
            end
        end
    end

    if scannedEggCount == 0 then
        SetState(States.HATCH_EGG, "No placed eggs found on plot.")
    end
end

