function remoteKind(endpoint)
    local inst = findRemote(endpoint)
    if not inst then return nil end
    return inst:IsA("RemoteFunction") and "function" or "event"
end

function invoke(endpoint, ...)
    if not endpoint then return false, "no endpoint" end
    local args = table.pack(...)
    if type(Network) == "table" and type(Network.Invoke) == "function" and Network.Invoke ~= Network.SyntheticInvoke then
        local ok, a, b = pcall(function() return Network.Invoke(endpoint, table.unpack(args, 1, args.n)) end)
        if ok and a ~= false then return a, b end
    end
    local inst = findRemote(endpoint)
    if inst then
        if inst:IsA("RemoteFunction") then
            local ok, res = pcall(inst.InvokeServer, inst, table.unpack(args, 1, args.n))
            return ok and res or false
        elseif inst:IsA("RemoteEvent") then
            pcall(inst.FireServer, inst, table.unpack(args, 1, args.n))
            return true
        end
    end
    return false, "no network endpoint"
end

function fire(endpoint, ...)
    if not endpoint then return end
    local args = table.pack(...)
    if type(Network) == "table" and type(Network.Fire) == "function" and Network.Fire ~= Network.SyntheticFire then
        local ok = pcall(function() Network.Fire(endpoint, table.unpack(args, 1, args.n)) end)
        if ok then return end
    end
    local inst = findRemote(endpoint)
    if inst then
        if inst:IsA("RemoteEvent") then
            pcall(inst.FireServer, inst, table.unpack(args, 1, args.n))
        elseif inst:IsA("RemoteFunction") then
            pcall(inst.InvokeServer, inst, table.unpack(args, 1, args.n))
        end
    end
end

