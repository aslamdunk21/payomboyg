----------------------------------------------------------------
-- Config Persistence (PayomboyZ_SAE / NyxSAE)
----------------------------------------------------------------
local CFG_DIR    = "PayomboyZ_SAE"
local CFG_FILE   = CFG_DIR .. "/payomboyz_config.json"
local CFG_BACKUP = CFG_DIR .. "/payomboyz_config.bak.json"
local CFG_LEGACY_NYX = "NyxSAE/nyx_config.json"
local CFG_LEGACY = "NyxSAE/config.json"

local hasFS = (typeof(writefile) == "function") and (typeof(readfile) == "function")
if hasFS and typeof(makefolder) == "function" and not (isfolder and isfolder(CFG_DIR)) then
    pcall(makefolder, CFG_DIR)
end

Runtime.cfgStatus = "ยังไม่ได้อ่านไฟล์"

local function fileExists(path)
    if not hasFS then return false end
    if typeof(isfile) ~= "function" then
        local ok, body = pcall(readfile, path)
        return ok and type(body) == "string" and #body > 0
    end
    local ok, yes = pcall(isfile, path)
    return ok and yes == true
end

local function readJson(path)
    if not fileExists(path) then return nil end
    local okr, body = pcall(readfile, path)
    if not okr or type(body) ~= "string" or #body < 2 then return nil end
    local okd, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not okd or type(data) ~= "table" then return nil end
    return data
end

local uiBuilding = false

local function saveConfig()
    if uiBuilding then return false end
    if not hasFS then
        Runtime.cfgStatus = "executor นี้เขียนไฟล์ไม่ได้ — ค่าจะหายเมื่อออกเกม"
        return false
    end

    local okEnc, body = pcall(function() return HttpService:JSONEncode(Cfg) end)
    if not okEnc or type(body) ~= "string" then
        Runtime.cfgStatus = "แปลงค่าเป็น JSON ไม่ได้"
        return false
    end

    if fileExists(CFG_FILE) then
        pcall(function()
            local old = readfile(CFG_FILE)
            if type(old) == "string" and #old > 2 then writefile(CFG_BACKUP, old) end
        end)
    end

    local okW = pcall(writefile, CFG_FILE, body)
    if not okW then
        Runtime.cfgStatus = "เขียนไฟล์ไม่สำเร็จ"
        return false
    end

    if readJson(CFG_FILE) == nil then
        Runtime.cfgStatus = "เขียนแล้วอ่านกลับไม่ได้ — ไฟล์อาจถูกทับ"
        return false
    end

    Runtime.cfgSavedAt = os.clock()
    Runtime.cfgStatus  = ("บันทึกแล้ว %s"):format(os.date("%H:%M:%S"))
    return true
end

local cfgSavePending = false
local function saveConfigSoon()
    if cfgSavePending then return end
    cfgSavePending = true
    task.delay(0.4, function()
        cfgSavePending = false
        saveConfig()
    end)
end

local function applyConfigTable(data)
    for k, v in pairs(data) do
        if Cfg[k] ~= nil then Cfg[k] = v end
    end
    local function emptySet(t) return type(t) ~= "table" or next(t) == nil end
    if emptySet(Cfg.StealAreas) then
        Cfg.StealAreas = {}
        for _, a in ipairs(AREAS) do Cfg.StealAreas[a] = true end
    end
    if emptySet(Cfg.StealRarities) then Cfg.StealRarities = raritySet(RARITY_ORDER) end
    if emptySet(Cfg.PlaceRarities) then Cfg.PlaceRarities = raritySet(RARITY_ORDER) end
end

local function loadConfig()
    if not hasFS then
        Runtime.cfgStatus = "executor นี้อ่านไฟล์ไม่ได้ — ใช้ค่าเริ่มต้น"
        return false
    end

    local data, from = readJson(CFG_FILE), CFG_FILE
    if not data then data, from = readJson(CFG_BACKUP), CFG_BACKUP end
    if not data then data, from = readJson(CFG_LEGACY_NYX), CFG_LEGACY_NYX end
    if not data then data, from = readJson(CFG_LEGACY), CFG_LEGACY end

    if not data then
        Runtime.cfgStatus = "ยังไม่มีไฟล์ค่าที่บันทึกไว้ — ใช้ค่าเริ่มต้น"
        return false
    end

    applyConfigTable(data)
    local n = 0
    for _ in pairs(data) do n += 1 end
    Runtime.cfgStatus = ("โหลด %d ค่าจาก %s"):format(n, from)
    if from ~= CFG_FILE then saveConfig() end
    return true
end
loadConfig()

