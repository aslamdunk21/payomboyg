    ----------------------------------------------------------------
    -- Window Toggle & Floating Icon
    ----------------------------------------------------------------
    local UserInput = game:GetService("UserInputService")

    local function toggleWindow()
        pcall(function()
            if UIWindow and UIWindow.Closed then UIWindow:Open() elseif UIWindow then UIWindow:Close() end
        end)
    end
    Runtime.toggleUI = toggleWindow
    Runtime.window   = UIWindow

    do
        local oldGui = game:GetService("CoreGui"):FindFirstChild(HUB_TAG .. "Float")
            or (LocalPlayer and LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild(HUB_TAG .. "Float"))
        if oldGui then oldGui:Destroy() end

        local gui = Instance.new("ScreenGui")
        gui.Name = HUB_TAG .. "Float"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 999999
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        pcall(function() gui.Parent = (typeof(gethui) == "function") and gethui() or (LocalPlayer and LocalPlayer:WaitForChild("PlayerGui")) end)

        local btn = Instance.new("TextButton")
        btn.Name = "Open"
        btn.Size = UDim2.fromOffset(44, 44)
        btn.Position = UDim2.fromOffset(tonumber(Cfg.FloatX) or 18, tonumber(Cfg.FloatY) or 260)
        btn.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
        btn.BackgroundTransparency = 0.15
        btn.BorderSizePixel = 0
        btn.Text = "🥚"
        btn.TextSize = 22
        btn.TextColor3 = Color3.fromRGB(235, 235, 245)
        btn.AutoButtonColor = true
        btn.Visible = Cfg.ShowFloatIcon
        btn.Parent = gui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = btn

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(139, 92, 246)
        stroke.Thickness = 1.5
        stroke.Transparency = 0.25
        stroke.Parent = btn

        local dragging, dragStart, startPos, moved = false, nil, nil, false

        local function beginDrag(input)
            dragging, moved = true, false
            dragStart, startPos = input.Position, btn.Position
        end

        local function endDrag()
            if not dragging then return end
            dragging = false
            if moved then
                Cfg.FloatX = math.floor(btn.Position.X.Offset)
                Cfg.FloatY = math.floor(btn.Position.Y.Offset)
                saveConfig()
            else
                toggleWindow()
            end
        end

        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                beginDrag(input)
            end
        end)

        btn.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                endDrag()
            end
        end)

        Runtime.conns.dragMove = UserInput.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                local d = input.Position - dragStart
                if math.abs(d.X) > 3 or math.abs(d.Y) > 3 then moved = true end
                btn.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)

        Runtime.conns.dragEnd = UserInput.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                endDrag()
            end
        end)

        Runtime.floatIcon = btn
        Runtime.floatGui  = gui
    end

    local rebinding = false

    Runtime.conns.hotkey = UserInput.InputBegan:Connect(function(input, processed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        if rebinding then
            rebinding = false
            Cfg.ToggleKey = input.KeyCode.Name
            saveConfig()
            if Runtime.refreshKeyBox then Runtime.refreshKeyBox() end
            Notify("ปุ่มลัด", ("ตั้งเป็น %s แล้ว"):format(input.KeyCode.Name), 4)
            return
        end

        if processed then return end
        if input.KeyCode == keyFromName(Cfg.ToggleKey) then toggleWindow() end
    end)

