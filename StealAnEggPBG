local function isCarryingEgg()
    local char = getCharacter()
    if char then
        for _, child in pairs(char:GetChildren()) do
            if child:IsA("Tool") and (child.Name:lower():find("egg") or child:GetAttribute("IsEgg")) then
                return true
            end
        end
        if char:GetAttribute("CarryingEgg") or char:GetAttribute("IsCarrying") or char:GetAttribute("Carrying") then
            return true
