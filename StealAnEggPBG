-- TASK 5: PET SELLING & ECONOMY SEQUENCE (SELECTIVE GARDEN SELLING ONLY - NO MASS SELL ALL)
local function Task_SellPetSequence()
    autoDismissSellAllGui()

    if not Config.AutoSell then return end

    SetState(States.SELL_PETS, string.format("Selling pets in plot (Filter: %s)...", Config.MinRaritySellFilter))
    
    local myPlot = getMyPlot()
    if myPlot then
        local petsFolder = myPlot:FindFirstChild("Pets") or myPlot:FindFirstChild("ActivePets") or myPlot
        for _, petModel in pairs(petsFolder:GetChildren()) do
            if petModel:IsA("Model") and not petModel.Name:lower():find("egg") and not petModel.Name:lower():find("sign") then
                local rarity = petModel:GetAttribute("Rarity") or petModel.Name
                local meetsFilter = MeetsSellFilter(rarity, petModel.Name)

                if meetsFilter then
                    local sellPrompt = petModel:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if sellPrompt then
                        local actionText = (sellPrompt.ActionText or ""):lower()
                        if actionText:find("sell") or actionText:find("ขาย") or actionText:find("remove") or actionText:find("ลบ") then
                            triggerPrompt(sellPrompt)
                        end
                    end

                    local petId = petModel:GetAttribute("PetId") or petModel:GetAttribute("Guid") or petModel.Name
                    local sellSingleRemote = GetRemote("ActiveAssets", "RequestSellSingle")
                    local sellPetRemote = GetRemote("ActiveAssets", "SellPet")
                    if sellSingleRemote or sellPetRemote then
                        PushPriorityTask(3, "SellPetSingle", function()
                            if sellSingleRemote then
                                ThrottledInvoke(sellSingleRemote, { petId }, 0.5)
                            elseif sellPetRemote then
                                ThrottledFire(sellPetRemote, { petId }, 0.5)
                            end
                        end)
                    end
                end
            end
        end
    end
end

