local carryBusy = false
function Guardless.carry(rec)
    if carryBusy then return false, "carry request already pending" end
    if not (rec and rec.BottomCFrame) then return false, "egg has no position" end

    unequipCharacterTools()
    carryBusy = true
    HookProximityPrompts()

    local root = hrp()
    local eggPos = rec.BottomCFrame.Position

    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if (root.Position - eggPos).Magnitude > 50 then
            warpChain(eggPos, 4, { guardGap = Cfg.GuardSafeGap })
        else
            root.CFrame = CFrame.new(eggPos.X, eggPos.Y + 2, eggPos.Z)
        end
        task.wait(0.08)
    end

    local carried = false
    for attempt = 1, 12 do
        if carried then break end

        local prompt = (rec and rec.Prompt) or nearestCarryPrompt(eggPos)
        if prompt then
            triggerPrompt(prompt)
        end

        local t0 = os.clock()
        while os.clock() - t0 < 0.3 do
            if isCarryingEgg() then carried = true break end
            task.wait(0.04)
        end
        local r = hrp()
        if not carried and attempt % 4 == 0 and r and (r.Position - eggPos).Magnitude > 6 then
            r.CFrame = CFrame.new(eggPos.X, eggPos.Y + 2, eggPos.Z)
            r.AssemblyLinearVelocity = Vector3.zero
        end
    end

    carryBusy = false
    return carried
end

local function stealRoutine(rec)
    unequipCharacterTools()
    local conn
    local claimed = false
    pcall(function() conn = EggCmds.AreaEggClaimed:Connect(function() claimed = true end) end)

    local function finish(ok, err)
        if conn then pcall(function() conn:Disconnect() end) end
        Runtime.carryUid = nil
        if not ok then Runtime.skip[rec.Uid] = os.clock() + 8 end
        toAnchor()
        unequipCharacterTools()
        return ok, err
    end

    if not Nav.waitCurtain(90) then return finish(false, "ม่านยังไม่เปิด") end

    local root = hrp()
    if root and math.abs(root.Position.Z - ANCHOR.Z) > 18 then
        warpTo(Vector3.new(root.Position.X, root.Position.Y, ANCHOR.Z), 4, { ignoreGuards = true, timeout = 6 })
    end
    warpTo(GATE_IN, 4, { ignoreGuards = true, timeout = 8 })
    if not insideGameplay() then return finish(false, "เข้าโซนไม่สำเร็จ") end

    if EggCmds and EggCmds.RequestAreaEggSnapshot then pcall(EggCmds.RequestAreaEggSnapshot) end
    task.wait(0.05)
    for _, live in pairs(areaEggRecords()) do
        if live.Uid == rec.Uid and live.BottomCFrame then egg = live.BottomCFrame.Position break end
    end
    if nearestGuardDist(egg) < 10 then return finish(false, "ยามเฝ้ารังอยู่") end

    local moved, moveErr = warpChain(egg, 2, { guardGap = Cfg.GuardSafeGap })
    if not moved then return finish(false, moveErr or "ไปไม่ถึงไข่") end

    local unpin = pin(egg + Vector3.new(0, 3, 0))
    if not waitPinned(egg + Vector3.new(0, 3, 0), 8, 0.35) then
        unpin()
        return finish(false, "egg position was reset")
    end

    local grabbed, gerr
    local deadline = os.clock() + 2.5
    repeat
        grabbed, gerr = Guardless.carry(rec)
        if grabbed then break end
        local msg = tostring(gerr)
        if msg:find("not found") or msg:find("unavailable") or msg:find("full") then break end
        task.wait(0.1)
    until os.clock() > deadline
    unpin()
    if not grabbed then return finish(false, tostring(gerr)) end

    Runtime.carryUid = rec.Uid
    warpChain(GATE_IN, 4, { guardGap = 14 })
    toAnchor()
    unequipCharacterTools()

    local homeUnpin = pin(ANCHOR)
    waitPinned(ANCHOR, 8, 0.35)

    local t0 = os.clock()
    while not claimed and os.clock() - t0 < 4 do task.wait(0.05) end
    homeUnpin()
    if conn then pcall(function() conn:Disconnect() end) end
    Runtime.carryUid = nil
    if not claimed then toAnchor() return false, "ไข่หลุดระหว่างทาง" end

    Runtime.stats.eggs += 1
    local cat = rec.AssetCategory
    logLine("steal", ("ขโมย %s"):format(cat))
    if Cfg.WebhookSteal then
        webhook("🥷 ขโมยไข่สำเร็จ", ("**%s** (%s)"):format(cat, RARITY_TH[rarityOf(cat)] or rarityOf(cat)))
    end
    toAnchor()
    unequipCharacterTools()
    return true
end

local function GetLegalWalkSpeed()
    local defaultSpeed = 16
    local chr = char()
    if not chr then return defaultSpeed end
    local hum = chr:FindFirstChildOfClass("Humanoid")
    if not hum then return defaultSpeed end

    local okSave, save = pcall(Save.Get, LocalPlayer)
    if okSave and type(save) == "table" then
        local sp = save.SpeedPower or 0
        if TreadmillUtil and type(TreadmillUtil.SpeedPowerToWalkSpeed) == "function" then
            local okCalc, ws = pcall(TreadmillUtil.SpeedPowerToWalkSpeed, sp)
            if okCalc and type(ws) == "number" and ws > 0 then return ws end
        end
    end
    return hum.WalkSpeed > 0 and hum.WalkSpeed or defaultSpeed
end

local function GetTargetStealSpeed()
    local legal = GetLegalWalkSpeed()
    return math.max(legal * 3, 48)
end

local function FastWalk(targetPos, timeout, speedOverride)
    local chr = char()
    if not chr then return false end
    local root = hrp()
    local hum = humanoid()
    if not root or not hum then return false end

    local maxSpeed = speedOverride or GetTargetStealSpeed()
    local t0 = os.clock()
    local maxTime = timeout or 30

    while os.clock() - t0 < maxTime do
        if not chr.Parent or not root.Parent or hum.Health <= 0 then return false end
        local pos = root.Position
        local dist = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude

        if dist <= 4.5 then
            hum:MoveTo(pos)
            root.AssemblyLinearVelocity = Vector3.zero
            hum.WalkSpeed = math.min(maxSpeed, 40)
            return true
        end

        local speed = (dist < 25) and math.clamp(dist * 7, 24, maxSpeed) or maxSpeed
        hum.WalkSpeed = speed
        hum:MoveTo(targetPos)
        task.wait(0.03)
    end

    local finalPos = root.Position
    local finalDist = (Vector3.new(finalPos.X, 0, finalPos.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude
    if finalDist <= 6 then
        hum:MoveTo(finalPos)
        root.AssemblyLinearVelocity = Vector3.zero
        return true
    end
    return false
end

