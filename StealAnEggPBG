-- Measured 2026-08-17: `ActiveAssets: MoneyCollected` fires once per payout as
-- `({ {uid = <pet uid>, amount = <number>}, ... }, isLocal)`. Listening is the
-- only way to know real earnings without calling Save.Get on a timer, which is
-- exactly the polling an all-night AFK session must not do.
Runtime.income = { total = 0, since = os.clock(), last = 0, lastAt = 0 }

do
    local eventName = (type(NET.ActiveAssets) == "table" and NET.ActiveAssets.MONEY_COLLECTED_EVENT) or "ActiveAssets: MoneyCollected"
    local ev = NetworkFolder and NetworkFolder:FindFirstChild(tostring(eventName))
    if ev and ev:IsA("RemoteEvent") then
        Runtime.conns.money = ev.OnClientEvent:Connect(function(list, isLocal)
            if isLocal ~= true or type(list) ~= "table" then return end
            local sum = 0
            for _, row in pairs(list) do
                if type(row) == "table" then sum += tonumber(row.amount) or 0 end
            end
            if sum <= 0 then return end
            local inc = Runtime.income
            inc.total += sum
            inc.last   = sum
            inc.lastAt = os.clock()
        end)
    end
end

function incomePerSec()
    local inc = Runtime.income
    local dt  = os.clock() - inc.since
    if dt < 2 then return 0 end
    return inc.total / dt
end

