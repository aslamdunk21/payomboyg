-- `yieldEvery` spreads the rebuild across frames, so unpacking two hundred pets
-- never lands inside a single frame
function petItems(fresh, yieldEvery)
    local now = os.clock()
    if not fresh and petCache and now - petCacheAt < 2 then return petCache end

    local data = saveData()
    local inv  = data.Inventory or {}
    local equipped = {}
    for _, uid in ipairs(data.EquippedAssets or {}) do equipped[uid] = true end

    local list = {}
    if not AssetSer then return list end
    local seen = 0
    for uid, raw in pairs(inv) do
        seen += 1
        if yieldEvery and seen % yieldEvery == 0 then task.wait() end
        local ok, item = pcall(AssetSer.Deserialize, raw)
        if ok and type(item) == "table" and item.Category then
            local rate = 0
            if AssetGen then
                local okr, r = pcall(AssetGen.GetRateWithoutBoosts, item)
                if okr then rate = tonumber(r) or 0 end
            end
            local price = rate * 100
            if PriceOf then
                local okp, p = pcall(PriceOf, item)
                if okp and tonumber(p) then price = tonumber(p) end
            end
            list[#list + 1] = {
                uid = uid, cat = item.Category, rarity = rarityOf(item.Category),
                rate = rate, price = price,
                favorite = item.IsFavorite == true,
                inFuse   = item.InFuse == true,
                equipped = equipped[uid] == true,
            }
        end
    end
    petCache, petCacheAt = list, now
    Runtime.petCount = #list
    return list
end

