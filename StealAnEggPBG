----------------------------------------------------------------
-- Job Scheduler Engine
----------------------------------------------------------------
local Jobs = {}

-- each job opens on its own slot so the first scheduler pass does not run all of
-- them inside one frame
function job(name, interval, fn)
    local slot = #Jobs
    Jobs[slot + 1] = {
        name = name, interval = interval, fn = fn,
        nextAt = os.clock() + 0.45 * slot,
    }
end

function withLock(fn, ...)
    if Runtime.lock or Runtime.stealing then return false end
    Runtime.lock = true
    local ok, err = pcall(fn, ...)
    Runtime.lock = false
    if not ok then Runtime.lastError = tostring(err) end
    return ok
end

job("respawn", 3, function()
    local c = char()
    local orphan = (c == nil) or (c.Parent == nil) or (not c:IsDescendantOf(Workspace))
    if not orphan then
        Runtime.orphanSince = nil
        return
    end

    Runtime.orphanSince = Runtime.orphanSince or os.clock()
    local stuckFor = os.clock() - Runtime.orphanSince

    local askedAgo = Runtime.resetAskedAt and (os.clock() - Runtime.resetAskedAt) or math.huge
    if stuckFor > 5 and askedAgo > 10 then
        Runtime.resetAskedAt = os.clock()
        logLine("move", ("ตัวละครหาย %ds — ขอเกิดใหม่"):format(math.floor(stuckFor)))
        pcall(function()
            local net = ReplicatedStorage:FindFirstChild("Network")
            local rr  = net and net:FindFirstChild("ClientCharacter: RequestCharacterReset")
            if rr then rr:FireServer() end
        end)
    end

    if stuckFor > 30 and not Runtime.orphanHopped then
        Runtime.orphanHopped = true
        logLine("hop", "ตัวละครไม่เกิดใหม่ — ย้ายเซิร์ฟ")
        pcall(Runtime.serverHop)
    end
end)

job("upkeep", 2, function()
    if Cfg.AutoSteal and Nav.onTreadmill() then
        logLine("move", "ติดลู่วิ่ง — ออกจากลู่")
        Nav.leaveTreadmill()
    end
    enforceWalkSpeed()
    if Cfg.GodMode then
        local hum = humanoid()
        if hum and hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
        if hum and not Runtime.conns.health then hardenCharacter() end
    end
    Runtime.instantReady = killClientIntegrity()
end)

-- Hatching and placing were starving. The steal thread holds Runtime.stealing
-- for a chain of up to 20 grabs and only drops it for ~0.35s between chains, so
-- a 4 second timer almost never found the lock free — measured 2026-08-17 with
-- 14 eggs in the bag and exactly 1 of them placed. The work is now a named
-- function that BOTH the timer and the steal thread can run, and the steal
-- thread hands the lock over itself at the end of every chain.
Runtime.eggsPending = false
Runtime.eggsRanAt   = 0

function eggUpkeep()
    if Cfg.AutoHatch then
        if hatchReady() > 0 then markSellDirty() end
    end
    if Cfg.AutoPlace then placeEggs() end
    if Cfg.AutoEquipBest then equipBest() end
    toAnchor()
    Runtime.eggsPending, Runtime.eggsRanAt = false, os.clock()
end

function eggUpkeepDue()
    if not (Cfg.AutoHatch or Cfg.AutoPlace or Cfg.AutoEquipBest) then return false end
    return Runtime.eggsPending or (os.clock() - Runtime.eggsRanAt) >= 20
end

job("eggs", 4, function()
    if not (Cfg.AutoHatch or Cfg.AutoPlace or Cfg.AutoEquipBest) then return end
    -- lock busy means the steal chain owns it; flag it and let that thread run
    -- the upkeep on its own way out instead of silently skipping the tick
    if not withLock(eggUpkeep) then Runtime.eggsPending = true end
end)

job("bag", 6, function()
    if not Cfg.AutoSteal then return end
    if bagCount() >= EGG_BAG_CAP - 3 then withLock(relieveBag, true) end
end)

-- the queue is rebuilt on change, not on a timer; this keeps it honest
job("sellScan", 4, function()
    if #Runtime.sellQueue == 0 or os.clock() - Runtime.sellLastScan > 12 then markSellDirty() end
end)

job("progress", 1, function()
    if Cfg.AutoBaseUpgrade then pcall(baseUpgradeStep) end
    if Cfg.AutoTreadmillUp then pcall(treadmillUpgradeStep) end
end)

-- ESP background job disabled to optimize game performance and remove lag

job("slowProgress", 15, function()
    if Cfg.AutoTrails then pcall(trailsStep) end
    if Cfg.AutoClaim then pcall(claimStep) end
    if Cfg.AutoFuse then withLock(fuseStep) end
end)

job("antilag", 30, function() pcall(antiLagSweep) end)
job("gc", 60, gcSweep)

task.spawn(function()
    while alive() do
        local now = os.clock()
        for _, j in ipairs(Jobs) do
            if not alive() then return end
            if now >= j.nextAt then
                j.nextAt = now + j.interval
                local ok, err = pcall(j.fn)
                if not ok then Runtime.lastError = j.name .. ": " .. tostring(err) end
                -- one job per frame: two of these landing together is the stutter
                RunService.Heartbeat:Wait()
                now = os.clock()
            end
        end
        task.wait(0.3)
    end
end)

----------------------------------------------------------------
-- Seller Thread (self-tuning pace)
----------------------------------------------------------------
task.spawn(function()
    local eggQueue, eggQueueAt = {}, 0

    local frameMax, frameConn = 0, nil
    local pace  = math.max(Cfg.SellPace or 0.05, 0.03)
    local lanes = math.clamp(Cfg.SellLanes or 3, 1, 6)
    local nextTune = 0
    local baseline, launched = nil, 0

    local function watchFrames(on)
        if on and not frameConn then
            frameConn = RunService.Heartbeat:Connect(function(dt)
                if dt > frameMax then frameMax = dt end
            end)
            Runtime.conns.frameWatch = frameConn
        elseif not on and frameConn then
            frameConn:Disconnect()
            frameConn = nil
            Runtime.conns.frameWatch = nil
            frameMax = 0
        end
    end

    while alive() do
        local paced = false

        if Runtime.sellDirty and Runtime.sellFlight == 0 then
            local ok, err = pcall(refillSellQueue)
            if not ok then
                Runtime.sellDirty = false
                Runtime.lastError = "sell: " .. tostring(err)
            end
        end

        if Cfg.AutoSellPets and #Runtime.sellQueue > 0 then
            if Runtime.sellFlight < lanes then
                local p = table.remove(Runtime.sellQueue)
                if p then
                    Runtime.sellFlight += 1
                    paced = true
                    launched += 1
                    task.spawn(function()
                        local ok = invoke(NET.ActiveAssets.REQUEST_SELL, p.uid)
                        Runtime.sellFlight -= 1
                        if ok then
                            Runtime.stats.soldPets += 1
                            Runtime.sellEarned = (Runtime.sellEarned or 0) + (p.price or 0)
                        end
                    end)
                end
            end
        end

        -- never mid-steal: holding an egg tool while carrying a stolen one is
        -- asking for a dropped egg
        if Cfg.AutoSellEggs and not Runtime.stealing then
            if #eggQueue == 0 and os.clock() - eggQueueAt > 3 then
                eggQueueAt = os.clock()
                local ok, plan = pcall(eggSellPlan)
                if ok and plan then
                    for i = #plan, 1, -1 do eggQueue[#eggQueue + 1] = plan[i] end
                end
            end
            if #eggQueue > 0 and not paced then
                local egg = table.remove(eggQueue)
                if egg and invoke(NET.Eggs.REQUEST_EQUIP_TOOL, egg.uid) then
                    fire(NET.AssetInventory.SELL_ASSET, { egg.uid })
                    Runtime.stats.soldEggs += 1
                    paced = true
                    launched += 1
                    if #eggQueue == 0 then
                        pcall(function() invoke(NET.Eggs.REQUEST_UNEQUIP_TOOL) end)
                        saveCache = nil
                    end
                end
            end
        elseif #eggQueue > 0 then
            table.clear(eggQueue)
        end

        local armed = Cfg.AutoSellPets or Cfg.AutoSellEggs
        watchFrames(armed)

        if armed and os.clock() >= nextTune then
            nextTune = os.clock() + 0.5
            local worst = frameMax
            frameMax = 0

            if worst > 0 then
                if launched == 0 then
                    baseline = baseline and (baseline * 0.8 + worst * 0.2) or worst
                elseif baseline then
                    local floorPace = math.max(Cfg.SellPace or 0.05, 0.03)
                    local hitch  = worst > math.max(baseline * 1.8, baseline + 0.03)
                    local smooth = worst <= baseline * 1.25

                    if hitch then
                        pace  = math.min(pace * 1.7, 0.8)
                        lanes = 1
                    elseif smooth then
                        pace  = math.max(pace * 0.8, floorPace)
                        lanes = math.min(lanes + 1, math.clamp(Cfg.SellLanes or 3, 1, 6))
                    end
                end
            end

            launched = 0
            Runtime.sellPace     = pace
            Runtime.sellLanes    = lanes
            Runtime.sellWorstMs  = math.floor(worst * 1000)
            Runtime.sellBaseMs   = baseline and math.floor(baseline * 1000) or nil
        end

        task.wait(paced and pace or 0.25)
    end
end)

