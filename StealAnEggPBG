-- HELPER: MAP AREA POSITION DISCOVERY (EXACT NEGATIVE Z MAP RUNWAY)
local function getAreaDestination(areaName)
    local mapFolder = Workspace:FindFirstChild("Map") or Workspace:FindFirstChild("Areas") or Workspace
    local areaLower = tostring(areaName or ""):lower()

    if areaLower ~= "" and areaLower ~= "all" then
        for _, child in pairs(mapFolder:GetDescendants()) do
            if (child:IsA("Model") or child:IsA("Folder") or child:IsA("BasePart")) and child.Name:lower():find(areaLower) then
                local pos = child:IsA("Model") and child:GetPivot().Position or (child:IsA("BasePart") and child.Position or nil)
                if pos then return pos end
            end
        end
    end

    local zoneMap = {
        ["forest"] = Vector3.new(0, 10, -250),
        ["lake"] = Vector3.new(0, 10, -650),
        ["jungle"] = Vector3.new(0, 10, -1050),
        ["snow"] = Vector3.new(0, 10, -1500),
        ["desert"] = Vector3.new(0, 10, -2000),
        ["volcano"] = Vector3.new(0, 10, -2600),
        ["prehistoric"] = Vector3.new(0, 10, -3300),
        ["abyss"] = Vector3.new(0, 10, -4100),
        ["abyss ocean"] = Vector3.new(0, 10, -4100),
        ["cosmic"] = Vector3.new(0, 10, -5000)
    }

    return zoneMap[areaLower] or Vector3.new(0, 10, -250)
end

-- TASK 1: STEAL EGG SEQUENCE (WHO: Character -> WHERE: Wild Area -> WHAT: Physical Steal & Carry -> HOW: Move-Interact-Return)
local function Task_StealEggSequence()
    if not Config.AutoStealMapEggs then return end

    -- PRIORITY 1: Carrying Egg Check (RUN!! Banner) -> Teleport home IMMEDIATELY!
    if isCarryingEgg() then
        SetState(States.RETURN_HOME, "Carrying Egg (RUN!!) -> Teleporting back to plot...")
        teleportToMyPlot()
        task.wait(0.2)
        Task_PlaceEggSequence()
        return
    end

    -- PRIORITY 2: Night Time Safety Guard
    if isNightTime() then
        SetState(States.IDLE, "Night Time -> Pausing wild farming for safety...")
        if not isAtMyPlot() then
            teleportToMyPlot()
        end
        return
    end

    SetState(States.SEARCH, string.format("Searching for eggs in area (%s)...", Config.Area))
    
    local targetEggPart = nil
    local targetPrompt = nil
    local targetEggData = nil

    local rootPart = getRootPart()
    local myPos = rootPart and rootPart.Position or Vector3.zero

    -- 1. High-Speed Spatial Cache Lookup
    local cachedTarget = EggCache.GetBestEgg(Config.Area, Config.MinRarityStealFilter, Config.TargetEggTypeSteal, myPos)
    if cachedTarget then
        targetEggPart = cachedTarget.Part
        targetPrompt = cachedTarget.Prompt
        targetEggData = {
            Position = cachedTarget.Position,
            Name = cachedTarget.Name,
            Rarity = cachedTarget.Rarity
        }
    end

    -- 2. Direct Fallback Workspace Search
    if not targetEggPart then
        local plotsFolder = Workspace:FindFirstChild("Plots") or (Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Plots"))
        local rendersFolder = Workspace:FindFirstChild("PlacedEggRenders")
        local closestDist = math.huge

        for _, desc in pairs(Workspace:GetDescendants()) do
            local isPlot = plotsFolder and desc:IsDescendantOf(plotsFolder)
            local isRender = rendersFolder and desc:IsDescendantOf(rendersFolder)
            if not isPlot and not isRender then
                if desc:IsA("ProximityPrompt") then
                    local parent = desc.Parent
                    if parent then
                        local pos = parent:IsA("Model") and parent:GetPivot().Position or (parent:IsA("BasePart") and parent.Position or nil)
                        if pos then
                            local dist = (pos - myPos).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                targetEggPart = parent
                                targetPrompt = desc
                                local foundUid = findEggUid(parent)
                                targetEggData = { Position = pos, Name = parent.Name, Rarity = "Common", Uid = foundUid, FirstAreaSlotKey = parent:GetAttribute("FirstAreaSlotKey") or parent:GetAttribute("SlotKey") }
                            end
                        end
                    end
                end
            end
        end
    end

    -- 3. Area Streaming Teleport: If no wild egg found nearby, warp directly to target zone (Negative Z Runway)
    if not targetEggPart then
        local areaPos = getAreaDestination(Config.Area)
        if areaPos and rootPart then
            SetState(States.MOVE_TO_EGG, string.format("Streaming Area [%s] (Z: %.0f)...", Config.Area, areaPos.Z))
            rootPart.CFrame = CFrame.new(areaPos)
            task.wait(0.3)

            local newPos = rootPart.Position
            local plotsFolder = Workspace:FindFirstChild("Plots") or (Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Plots"))
            local rendersFolder = Workspace:FindFirstChild("PlacedEggRenders")
            local closestDist = math.huge

            for _, desc in pairs(Workspace:GetDescendants()) do
                local isPlot = plotsFolder and desc:IsDescendantOf(plotsFolder)
                local isRender = rendersFolder and desc:IsDescendantOf(rendersFolder)
                if not isPlot and not isRender and desc:IsA("ProximityPrompt") then
                    local parent = desc.Parent
                    if parent then
                        local pos = parent:IsA("Model") and parent:GetPivot().Position or (parent:IsA("BasePart") and parent.Position or nil)
                        if pos then
                            local dist = (pos - newPos).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                targetEggPart = parent
                                targetPrompt = desc
                                local foundUid = findEggUid(parent)
                                targetEggData = { Position = pos, Name = parent.Name, Rarity = "Common", Uid = foundUid, FirstAreaSlotKey = parent:GetAttribute("FirstAreaSlotKey") or parent:GetAttribute("SlotKey") }
                            end
                        end
                    end
                end
            end
        end
    end

    -- 4. If wild egg target found: Execute Physical Navigation, Prompt Trigger & Instant Home Teleport
    if targetEggPart and rootPart then
        local eggPos = targetEggData and targetEggData.Position or (targetEggPart:IsA("Model") and targetEggPart:GetPivot().Position or targetEggPart.Position)
        if not eggPos then return end

        SetState(States.MOVE_TO_EGG, string.format("Moving to egg at coordinates X:%.0f Y:%.0f Z:%.0f", eggPos.X, eggPos.Y, eggPos.Z))
        rootPart.CFrame = CFrame.new(eggPos + Vector3.new(0, 3, 0))
        task.wait(0.1)

        if targetPrompt then
            triggerPrompt(targetPrompt)
        end

        local eggCarryRemote = GetRemote("Eggs", "RequestAreaEggCarry")
        local unequipToolRemote = GetRemote("Eggs", "RequestUnequipTool")
        if eggCarryRemote then
            PushPriorityTask(1, "RequestAreaEggCarry", function()
                -- Unequip current tool first (send current tool UID if available)
                if unequipToolRemote then
                    local char = getCharacter()
                    if char then
                        for _, item in pairs(char:GetChildren()) do
                            if item:IsA("Tool") then
                                local toolUid = findEggUid(item)
                                if toolUid then
                                    pcall(function() unequipToolRemote:InvokeServer(toolUid) end)
                                end
                            end
                        end
                    end
                end
                task.wait(0.05)
                -- Build correct payload: {Uid = ...} optionally with FirstAreaSlotKey
                local eggUid = findEggUid(targetEggPart) or (targetEggData and targetEggData.Uid)
                local slotKey = targetEggPart:GetAttribute("FirstAreaSlotKey") or targetEggPart:GetAttribute("SlotKey") or (targetEggData and targetEggData.FirstAreaSlotKey)
                if eggUid then
                    local payload = { Uid = eggUid }
                    if slotKey then payload.FirstAreaSlotKey = slotKey end
                    ThrottledInvoke(eggCarryRemote, { payload }, 0.05)
                else
                    -- Fallback: try with just the name as UID (may fail server-side)
                    ThrottledInvoke(eggCarryRemote, { { Uid = targetEggPart.Name } }, 0.05)
                end
            end)
        end
        task.wait(0.2)

        SetState(States.RETURN_HOME, "Steal successful! Returning home to place egg...")
        teleportToMyPlot()
        task.wait(0.2)
        Task_PlaceEggSequence()
    end
end

