    ----------------------------------------------------------------
    -- Tab: System
    ----------------------------------------------------------------

    ----------------------------------------------------------------
    -- AFK Mode overlay ("ไก่ตัน")
    --
    -- A full-screen iOS-styled panel meant to be left running for hours, so
    -- every part of it obeys three rules:
    --   1. Nothing polls. Logs arrive through the existing logLine() call, money
    --      arrives through ActiveAssets: MoneyCollected, and the only per-frame
    --      work is one integer compare inside the pump.
    --   2. Every repeated row is pooled. Log rows, pet cards and egg rows are
    --      created once and reused, so an eight-hour session holds the same
    --      Instance count as the first minute.
    --   3. Opening it drops render load — 3D rendering off, quality floor, FPS
    --      cap — and closing it puts all three back exactly as they were.
    ----------------------------------------------------------------
    local AFK_MAX_LOGS      = 40  -- log pool size; also the hard cap on visible rows
    local AFK_MAX_EGGROWS   = 40  -- egg pool size
    local AFK_MAX_PETS      = 150 -- pet card pool size; allocated once at build
    local AFK_GRID_DEBOUNCE = 2   -- seconds between pet rebuilds, even on a hatch burst
    local AFK_GRID_REFRESH  = 15  -- safety re-read, in case an inventory change logs nothing
    local AFK_EGG_REFRESH   = 5   -- egg roster re-read; the countdown itself ticks locally
    local AFK_FPS_CAP       = 10

    -- iOS dark system palette: one flat black ground, two elevated greys, and a
    -- hairline separator. Colour is carried by text and 1px strokes only —
    -- filled accent blocks are what makes a panel stop looking like iOS.
    local AFK_COLOR = {
        bg        = Color3.fromRGB(0, 0, 0),
        panel     = Color3.fromRGB(28, 28, 30),
        raised    = Color3.fromRGB(44, 44, 46),
        separator = Color3.fromRGB(56, 56, 58),
        label     = Color3.fromRGB(255, 255, 255),
        label2    = Color3.fromRGB(152, 152, 158),
        label3    = Color3.fromRGB(110, 110, 115),
        blue      = Color3.fromRGB(10, 132, 255),
        green     = Color3.fromRGB(48, 209, 88),
        red       = Color3.fromRGB(255, 69, 58),
        orange    = Color3.fromRGB(255, 159, 10),
        yellow    = Color3.fromRGB(255, 214, 10),
        teal      = Color3.fromRGB(100, 210, 255),
    }

    local AFK_RARITY_COLOR = {
        Common    = Color3.fromRGB(152, 152, 158),
        Uncommon  = Color3.fromRGB(48, 209, 88),
        Rare      = Color3.fromRGB(10, 132, 255),
        Epic      = Color3.fromRGB(191, 90, 242),
        Legendary = Color3.fromRGB(255, 159, 10),
        Mythic    = Color3.fromRGB(255, 55, 95),
        Divine    = Color3.fromRGB(100, 210, 255),
        Secret    = Color3.fromRGB(255, 214, 10),
        Cosmic    = Color3.fromRGB(94, 92, 230),
        Eternal   = Color3.fromRGB(255, 69, 58),
    }

    -- Touch-only clients get a smaller scale and a warning strip. The mode still
    -- runs there; it is simply not what it was built for (see the toggle text).
    local AFK_TOUCH = (function()
        local ok, touch = pcall(function()
            local uis = game:GetService("UserInputService")
            return uis.TouchEnabled and not uis.KeyboardEnabled
        end)
        return ok and touch == true
    end)()

    local AFK = {
        on         = false,
        gui        = nil,
        conns      = {},
        startAt    = 0,
        lastSec    = -1,
        wantShow   = false,-- state changes are queued for the pump, never applied
        wantHide   = false,-- by whatever thread happened to call open/close
        wantSeed   = false,
        logDirty   = false,-- set by logLine, drained by the pump on our own thread
        gridDirty  = false,
        eggDirty   = false,
        pool       = {},   -- log rows, index 1..AFK_MAX_LOGS
        poolHead   = 0,    -- ring cursor
        cards      = {},   -- pet cards
        strokes    = {},   -- UIStroke per pet card, kept beside the frame not on it
        eggRows    = {},   -- egg rows
        eggStrokes = {},   -- band-coloured UIStroke per egg row
        eggData    = {},   -- per-row countdown state, parallel to eggRows
        eggAt      = 0,
        gridAt     = 0,
        toggleRef  = nil,
        hooked     = false,
        prevFps    = nil,
        prev3D     = nil,
        prevQuality= nil,
        stat       = {},   -- the four header value labels
        petTitle   = nil,
        eggTitle   = nil,
        logList    = nil,
        gridList   = nil,
        eggList    = nil,
        gridLayout = nil,
    }

    ----------------------------------------------------------------
    -- Small builders
    ----------------------------------------------------------------
    local function afkCorner(parent, r)
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, r or 12)
        c.Parent = parent
        return c
    end

    local function afkStroke(parent, color, thickness, transparency)
        local s = Instance.new("UIStroke")
        s.Color = color or AFK_COLOR.separator
        s.Thickness = thickness or 1
        s.Transparency = transparency or 0
        s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        s.Parent = parent
        return s
    end

    local function afkPad(parent, all)
        local p = Instance.new("UIPadding")
        p.PaddingTop    = UDim.new(0, all)
        p.PaddingBottom = UDim.new(0, all)
        p.PaddingLeft   = UDim.new(0, all)
        p.PaddingRight  = UDim.new(0, all)
        p.Parent = parent
        return p
    end

    local function afkText(parent, props)
        local t = Instance.new("TextLabel")
        t.BackgroundTransparency = 1
        t.RichText = false
        t.Font = props.font or Enum.Font.Gotham
        t.TextSize = props.size or 13
        t.TextColor3 = props.color or AFK_COLOR.label
        t.TextXAlignment = props.align or Enum.TextXAlignment.Left
        t.TextYAlignment = Enum.TextYAlignment.Center
        t.Text = props.text or ""
        t.Size = props.sizeUDim or UDim2.new(1, 0, 1, 0)
        if props.pos then t.Position = props.pos end
        if props.truncate then t.TextTruncate = Enum.TextTruncate.AtEnd end
        t.Parent = parent
        return t
    end

    -- one elevated card, the shape every iOS grouped list is made of
    local function afkCard(parent, props)
        local f = Instance.new("Frame")
        f.BackgroundColor3 = props.color or AFK_COLOR.panel
        f.BorderSizePixel = 0
        f.Size = props.size or UDim2.new(1, 0, 1, 0)
        if props.pos then f.Position = props.pos end
        if props.anchor then f.AnchorPoint = props.anchor end
        afkCorner(f, props.radius or 14)
        if props.stroke ~= false then afkStroke(f, AFK_COLOR.separator, 1, 0.35) end
        f.Parent = parent
        return f
    end

    local function afkClock(sec)
        sec = math.max(0, math.floor(sec))
        return ("%02d:%02d:%02d"):format(math.floor(sec / 3600), math.floor(sec % 3600 / 60), sec % 60)
    end

    local function afkShort(sec)
        sec = math.floor(sec)
        if sec <= 0 then return "พร้อมฟัก" end
        if sec < 60 then return ("%d วิ"):format(sec) end
        if sec < 3600 then return ("%d:%02d"):format(math.floor(sec / 60), sec % 60) end
        return ("%d ชม %d น"):format(math.floor(sec / 3600), math.floor(sec % 3600 / 60))
    end

    local function afkAssetCfg(cat)
        return AssetsDir and AssetsDir.Directory and AssetsDir.Directory[cat] or nil
    end

    -- the egg has its own art and its own name in the directory (`cfg.Egg`);
    -- using the pet icon here showed the hatched animal instead of the shell
    local function afkEggArt(cat)
        local cfg = afkAssetCfg(cat)
        local egg = cfg and cfg.Egg
        local icon = (egg and egg.Icon) or (cfg and cfg.Icon) or ""
        local name = (egg and egg.DisplayName)
            or ((cfg and cfg.DisplayName) and (cfg.DisplayName .. " Egg"))
            or tostring(cat)
        return icon, name
    end

    -- Countdown bands, the same ones the legend explains to the player.
    -- green  : 10s or less  — about to hatch
    -- yellow : 11s .. 60s   — nearly there
    -- red    : over 60s     — still a long wait
    local function afkBandColor(remain, ready, placed)
        if ready then return AFK_COLOR.green end
        if not placed then return AFK_COLOR.label3 end
        if remain == nil then return AFK_COLOR.label2 end
        if remain <= 10 then return AFK_COLOR.green end
        if remain <= 60 then return AFK_COLOR.yellow end
        return AFK_COLOR.red
    end

    ----------------------------------------------------------------
    -- Render throttle
    ----------------------------------------------------------------
    -- Every call is guarded: executors disagree wildly about which of these
    -- exist, and a missing setfpscap must never take the overlay down with it.
    local function afkEnterLowPower()
        pcall(function()
            if getfpscap then AFK.prevFps = getfpscap() end
            if setfpscap then setfpscap(AFK_FPS_CAP) end
        end)
        pcall(function()
            AFK.prevQuality = settings().Rendering.QualityLevel
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
        pcall(function()
            if RunService.Set3dRenderingEnabled then
                AFK.prev3D = true
                RunService:Set3dRenderingEnabled(false)
            end
        end)
    end

    local function afkExitLowPower()
        pcall(function()
            if setfpscap then setfpscap((AFK.prevFps and AFK.prevFps > 0) and AFK.prevFps or 240) end
        end)
        pcall(function()
            if AFK.prevQuality then settings().Rendering.QualityLevel = AFK.prevQuality end
        end)
        pcall(function()
            if AFK.prev3D and RunService.Set3dRenderingEnabled then
                RunService:Set3dRenderingEnabled(true)
            end
        end)
        AFK.prevFps, AFK.prevQuality, AFK.prev3D = nil, nil, nil
    end

    ----------------------------------------------------------------
    -- Column 1: activity log (ring buffer, zero allocation)
    ----------------------------------------------------------------
    -- The newest line overwrites the oldest row's text and LayoutOrder alone
    -- re-sorts the list. No Instance is created or destroyed while running,
    -- which is what stops an all-night session from leaking rows.
    local function afkPushLog(text)
        if not AFK.on or not AFK.logList or not text then return end
        AFK.poolHead = AFK.poolHead % AFK_MAX_LOGS + 1
        local row = AFK.pool[AFK.poolHead]
        if not row then return end
        row.Text = text
        row.Visible = true
        for i = 1, AFK_MAX_LOGS do
            local r = AFK.pool[i]
            if r and r.Visible then
                r.LayoutOrder = (AFK.poolHead - i) % AFK_MAX_LOGS
            end
        end
    end

    local function afkSeedLogs()
        for i = 1, AFK_MAX_LOGS do
            local r = AFK.pool[i]
            if r then r.Visible = false end
        end
        AFK.poolHead = 0
        -- Runtime.log is already newest-first and already capped at 40
        for i = math.min(#Runtime.log, AFK_MAX_LOGS), 1, -1 do
            afkPushLog(Runtime.log[i])
        end
    end

    ----------------------------------------------------------------
    -- Column 2: pet inventory
    ----------------------------------------------------------------
    -- Both grids are fully preallocated in afkBuild and only ever have their
    -- properties written afterwards. That is not just a performance choice:
    -- creating or reparenting an Instance after the panel is up was throwing
    -- "lacking capability Plugin" whenever the call arrived on a thread other
    -- than the one that built the GUI, and a hidden executor container cannot be
    -- written to from a normal game thread at all. Allocate once, paint forever.
    local function afkPaintPets(force)
        if not AFK.on or not AFK.gridList then return end
        local now = os.clock()
        if not force and now - AFK.gridAt < AFK_GRID_DEBOUNCE then return end
        AFK.gridAt = now

        local list = {}
        for _, p in ipairs(petItems(false)) do list[#list + 1] = p end
        table.sort(list, function(a, b)
            local ra, rb = a.rate or 0, b.rate or 0
            if ra == rb then return tostring(a.cat) < tostring(b.cat) end
            return ra > rb
        end)

        local slots = #AFK.cards
        local shown = math.min(#list, slots)

        for i = 1, shown do
            local p      = list[i]
            local card   = AFK.cards[i]
            local stroke = AFK.strokes[i]
            local cfg    = afkAssetCfg(p.cat)
            local col    = AFK_RARITY_COLOR[p.rarity] or AFK_COLOR.label2

            card.Icon.Image      = (cfg and cfg.Icon) or ""
            card.PetName.Text    = (cfg and cfg.DisplayName) or tostring(p.cat)
            card.Tier.Text       = RARITY_TH[p.rarity] or tostring(p.rarity)
            card.Tier.TextColor3 = col
            card.Income.Text     = ("%s/วิ"):format(shortNum(p.rate or 0))
            if stroke then stroke.Color = col end
            card.Visible = true
        end

        for i = shown + 1, slots do AFK.cards[i].Visible = false end

        if AFK.petTitle then
            AFK.petTitle.Text = (#list > slots)
                and ("สัตว์เลี้ยง · แสดง %d จาก %d ตัว"):format(slots, #list)
                or  ("สัตว์เลี้ยง · %d ตัว"):format(#list)
        end
    end

    ----------------------------------------------------------------
    -- Column 3: eggs and countdowns
    ----------------------------------------------------------------
    -- The roster is re-read every few seconds; the countdown itself is local
    -- arithmetic against a stored end time, so the clock stays real-time without
    -- asking the game anything in between.
    local function afkPaintEggs(force)
        if not AFK.on or not AFK.eggList then return end
        local now = os.clock()
        if not force and now - AFK.eggAt < AFK_EGG_REFRESH then return end
        AFK.eggAt = now

        local ok, roster = pcall(eggRoster)
        if not ok or type(roster) ~= "table" then return end

        -- ready first, then the shortest wait, then everything not placed yet
        local function rank(e)
            if e.ready then return 0 end
            if e.placed then return 1 end
            return 2
        end
        table.sort(roster, function(a, b)
            local ra, rb = rank(a), rank(b)
            if ra ~= rb then return ra < rb end
            local wa = a.remain or math.huge
            local wb = b.remain or math.huge
            if wa ~= wb then return wa < wb end
            return tostring(a.cat) < tostring(b.cat)
        end)

        local slots = #AFK.eggRows
        local ready, growing, idle = 0, 0, 0
        local stamp = os.time()

        for i, e in ipairs(roster) do
            if e.ready then ready += 1
            elseif e.placed then growing += 1
            else idle += 1 end

            if i <= slots then
                local row = AFK.eggRows[i]
                local icon, name = afkEggArt(e.cat)
                local col = AFK_RARITY_COLOR[e.rarity] or AFK_COLOR.label2

                row.Icon.Image      = icon
                row.EggName.Text    = name
                row.Tier.Text       = RARITY_TH[e.rarity] or tostring(e.rarity)
                row.Tier.TextColor3 = col
                row.Visible         = true

                -- state, not text: afkPaintCountdowns repaints from this every
                -- second without touching the game again
                AFK.eggData[i] = {
                    ready  = e.ready,
                    placed = e.placed,
                    endAt  = (e.remain and (stamp + e.remain)) or nil,
                }
            end
        end

        for i = math.min(#roster, slots) + 1, slots do
            AFK.eggRows[i].Visible = false
            AFK.eggData[i] = nil
        end

        -- an empty column and a broken column used to look identical; now they
        -- do not, which is the difference between "no eggs" and "go read a log"
        if AFK.eggEmpty then AFK.eggEmpty.Visible = (#roster == 0) end

        if AFK.eggTitle then
            AFK.eggTitle.Text = ("ไข่ · พร้อม %d · ฟักอยู่ %d · ว่าง %d"):format(ready, growing, idle)
        end

        -- eggs finishing is worth a log line: it is the one thing that happens
        -- in this column that the activity log never mentioned before
        if AFK.lastReady and ready > AFK.lastReady then
            logLine("egg", ("ไข่พร้อมฟัก %d ใบ"):format(ready))
        end
        AFK.lastReady = ready
    end

    -- Called once a second from the pump. This is the real-time part: the roster
    -- is only re-read every few seconds, but the number on screen and the band
    -- colour are recomputed from the stored end time every single second.
    local function afkPaintCountdowns()
        local stamp = os.time()
        for i = 1, #AFK.eggRows do
            local row    = AFK.eggRows[i]
            local d      = AFK.eggData[i]
            local stroke = AFK.eggStrokes[i]
            if row and row.Visible and d then
                local remain, text

                if d.ready then
                    remain, text = 0, "พร้อมฟัก"
                elseif not d.placed then
                    remain, text = nil, "ยังไม่วาง"
                elseif d.endAt then
                    remain = d.endAt - stamp
                    text = (remain <= 0) and "พร้อมฟัก" or afkShort(remain)
                else
                    remain, text = nil, "กำลังฟัก"
                end

                local col = afkBandColor(remain, d.ready or (remain ~= nil and remain <= 0), d.placed)
                row.Status.Text = text
                row.Status.TextColor3 = col
                if stroke then stroke.Color = col end
            end
        end
    end

    ----------------------------------------------------------------
    -- Guarded entry points: one bad row can never blank a panel
    ----------------------------------------------------------------
    local function afkSafeGrid(force)
        local ok, err = pcall(afkPaintPets, force)
        if not ok then warn("[AFK] pets: " .. tostring(err)) end
    end

    local function afkSafeEggs(force)
        local ok, err = pcall(afkPaintEggs, force)
        if not ok then warn("[AFK] eggs: " .. tostring(err)) end
    end

    ----------------------------------------------------------------
    -- The pump: the ONLY place the panel is ever written to
    ----------------------------------------------------------------
    -- A GUI parented into the executor's hidden container can only be written
    -- to by a thread with the same reach as the one that built it. Opening the
    -- panel from a WindUI button, from a log callback, or from a remote handler
    -- all run on different threads, and every write from those died with
    -- "lacking capability Plugin" — which is exactly why the egg column stayed
    -- empty while the data behind it was fine.
    --
    -- So nothing outside this function touches an Instance. afkOpen, afkClose
    -- and the logLine hook only raise flags; this pump runs on one connection
    -- created at build time by the script's own thread and applies them.
    local function afkPump()
        -- a re-executed script leaves the old panel's pump running, and it keeps
        -- painting a GUI nobody owns any more; the session check retires it
        if not alive() then
            pcall(function() if AFK.gui then AFK.gui:Destroy() end end)
            for k, c in pairs(AFK.conns) do
                pcall(function() c:Disconnect() end)
                AFK.conns[k] = nil
            end
            AFK.on = false
            return
        end

        if AFK.wantShow then
            AFK.wantShow = false
            if AFK.gui then AFK.gui.Enabled = true end
            afkEnterLowPower()
        end
        if AFK.wantHide then
            AFK.wantHide = false
            if AFK.gui then AFK.gui.Enabled = false end
            afkExitLowPower()
        end

        if not AFK.on then return end

        if AFK.wantSeed then
            AFK.wantSeed = false
            afkSeedLogs()
        end

        -- log rows are cheap and must feel live, so they are flushed on any
        -- frame they are dirty; everything else waits for the second boundary
        if AFK.logDirty then
            AFK.logDirty = false
            afkPushLog(Runtime.log[1])
        end

        local sec = math.floor(os.clock() - AFK.startAt)
        if sec == AFK.lastSec then return end   -- one write per second, not per frame
        AFK.lastSec = sec

        if AFK.gridDirty then AFK.gridDirty = false afkSafeGrid(false) end
        if AFK.eggDirty  then AFK.eggDirty  = false afkSafeEggs(false) end

        local s = AFK.stat
        if s.eggs   then s.eggs.Text   = tostring(Runtime.stats.eggs) end
        if s.hatch  then s.hatch.Text  = tostring(Runtime.stats.hatched) end
        if s.income then s.income.Text = shortNum(incomePerSec()) end
        if s.time   then s.time.Text   = afkClock(sec) end
        if s.total  then s.total.Text  = ("รวม " .. shortNum(Runtime.income.total)) end

        afkPaintCountdowns()

        if sec > 0 and sec % AFK_EGG_REFRESH  == 0 then afkSafeEggs(true) end
        if sec > 0 and sec % AFK_GRID_REFRESH == 0 then afkSafeGrid(true) end
    end

    local afkOpen, afkClose  -- forward declaration for UI header button & API exports

    local function setAfkResume()
        pcall(function()
            if typeof(getgenv) == "function" then getgenv().SAE_AfkResume = true end
        end)
    end

    local function clearAfkResume()
        pcall(function()
            if typeof(getgenv) == "function" then getgenv().SAE_AfkResume = nil end
        end)
    end

    local function consumeAfkResume()
        local res = false
        pcall(function()
            if typeof(getgenv) == "function" and getgenv().SAE_AfkResume then
                res = true
                getgenv().SAE_AfkResume = nil
            end
        end)
        return res
    end

    local function afkSetToggle(val)
        if AFK.toggleRef then
            for _, m in ipairs({ "SetValue", "Set", "UpdateValue" }) do
                if pcall(function() AFK.toggleRef[m](AFK.toggleRef, val) end) then break end
            end
        end
    end

    ----------------------------------------------------------------
    -- Construction
    ----------------------------------------------------------------
    local function afkBuild()
        -- a re-executed script leaves its old panel behind: it is a ScreenGui,
        -- not a WindUI window, so the normal cleanup never touched it and the
        -- screen ended up with a dead panel stacked over the live one
        -- The previous panel is reached through a reference we kept, never by
        -- searching CoreGui: scanning a protected container raises a capability
        -- error on some threads, and an executor's hidden GUI folder cannot be
        -- enumerated at all. Holding the handle in getgenv() survives a
        -- re-execute, which is the only case that ever leaves a panel behind.
        pcall(function()
            local old = ENV[HUB_KEY .. "AfkGui"]
            if typeof(old) == "Instance" then old:Destroy() end
        end)

        local gui = Instance.new("ScreenGui")
        gui.Name = "SAE_AFK"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 9999
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

        -- PlayerGui on purpose, NOT gethui(). A GUI inside the executor's hidden
        -- container can only be written to by a thread holding the executor's
        -- own capability: the WindUI toggle, the game's remote callbacks and the
        -- log hook all run on other threads, and every write from them died with
        -- "lacking capability Plugin" — which is exactly why the egg column kept
        -- coming up empty while its data was fine. PlayerGui has no such gate,
        -- and mobile executors that ship no gethui at all get the same path.
        local parented = false
        pcall(function()
            gui.Parent = LocalPlayer:WaitForChild("PlayerGui", 10)
            parented = gui.Parent ~= nil
        end)
        if not parented then
            pcall(function() if gethui then gui.Parent = gethui() parented = true end end)
        end
        if not parented then
            pcall(function() gui.Parent = game:GetService("CoreGui") end)
        end

        -- flat black ground: it covers the 3D view completely, which is what
        -- makes Set3dRenderingEnabled(false) invisible to the eye
