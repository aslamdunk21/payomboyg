    ----------------------------------------------------------------
    local function baseUpgradeStep()
        if not BasesDir or not BasesDir.BASES then return end
        local data = saveData()
        local lvl  = tonumber(data.BaseUpgradeLevel) or 0
        local maxLvl = 99
        if BasesDir.GetMaxBaseLevel then
            local ok, m = pcall(BasesDir.GetMaxBaseLevel)
            if ok and tonumber(m) then maxLvl = tonumber(m) end
        end
        if lvl >= maxLvl then return end

        local nextCfg = BasesDir.BASES[lvl + 1]
        local cost = nextCfg and tonumber(nextCfg.Cost)
        if not cost or moneyNow() < cost then return end

        fire(NET.Plots.REQUEST_BASE_UPGRADE)
        logLine("base", ("อัปฐานเป็นเลเวล %d (%s)"):format(lvl + 1, shortNum(cost)))
        saveCache, petCache = nil, nil
    end

    local function treadmillUpgradeStep()
        if not TreadDir or not TreadDir.GetByUpgradeLevel then return end
        local data = saveData()
        local lvl  = tonumber(data.TreadmillUpgradeLevel) or 0

        local ok, nextTm = pcall(TreadDir.GetByUpgradeLevel, lvl + 1)
        if not ok or type(nextTm) ~= "table" then return end
        local price = tonumber(nextTm.Price) or math.huge
        if moneyNow() < price then return end

        invoke(NET.Treadmills.REQUEST_UPGRADE, nextTm._id)
        logLine("treadmill", ("อัปลู่วิ่งเป็น %s (%s)"):format(nextTm.DisplayName or nextTm._id, shortNum(price)))
        saveCache, petCache = nil, nil
    end

    local function trailsStep()
        if not TrailsDir or not TrailsDir.Directory then return end
        local data  = saveData()
        local owned = data.TrailInventory or {}
        local money = tonumber(data.Money) or 0

        local list = {}
        for id, cfg in pairs(TrailsDir.Directory) do
            if type(cfg) == "table" then
                list[#list + 1] = { id = cfg._id or id, price = tonumber(cfg.Price) or math.huge, speed = tonumber(cfg.SpeedMultiplier) or 0 }
            end
        end
        table.sort(list, function(a, b) return a.speed > b.speed end)

        for _, item in ipairs(list) do
            if not owned[item.id] and item.price > 0 and item.price <= money then
                invoke(NET.Trails.REQUEST_PURCHASE, item.id)
                logLine("trail", ("ซื้อเทรล %s"):format(item.id))
                saveCache, petCache = nil, nil
                task.wait(0.3)
                owned = saveData(true).TrailInventory or owned
                break
            end
        end

        for _, item in ipairs(list) do
            if owned[item.id] then
                if data.EquippedTrail ~= item.id then invoke(NET.Trails.REQUEST_SELECT, item.id) end
                return
            end
        end
    end

    local function fuseFinish(label)
        local ok, err = invoke(NET.FuseMachine.START_FUSE)
        if not ok then return false, err end
        task.wait(0.4)
        invoke(NET.FuseMachine.COMPLETE_REVEAL)
        invoke(NET.FuseMachine.ACKNOWLEDGE_INFO)
        logLine("fuse", ("ผสม %s"):format(label))
        saveCache, petCache = nil, nil
        markSellDirty()
        return true
    end

    local function fuseStep()
        if bagCount() >= EGG_BAG_CAP - 1 then relieveBag(true) end

        local pets = petItems()
        local loaded, byCat = {}, {}
        for _, p in ipairs(pets) do
            if p.inFuse then
                loaded[#loaded + 1] = p
            elseif not (p.equipped or p.favorite) then
                byCat[p.cat] = byCat[p.cat] or {}
                table.insert(byCat[p.cat], p.uid)
            end
        end

        if #loaded >= 3 then
            local ok, err = fuseFinish(loaded[1].cat)
            if ok then return true end
            Runtime.lastError = "ผสมไม่ได้: " .. tostring(err)
            return false
        elseif #loaded > 0 then
            for _, p in ipairs(loaded) do invoke(NET.FuseMachine.REMOVE_MOB, p.uid) end
            saveCache, petCache = nil, nil
        end

        for cat, uids in pairs(byCat) do
            if #uids >= 3 then
                local inserted = 0
                for i = 1, 3 do
                    if invoke(NET.FuseMachine.INSERT_MOB, uids[i]) then inserted += 1 end
                end
                if inserted == 3 then
                    local ok, err = fuseFinish(cat .. " x3")
                    if ok then return true end
                    for i = 1, 3 do invoke(NET.FuseMachine.REMOVE_MOB, uids[i]) end
                    Runtime.lastError = "ผสมไม่ได้: " .. tostring(err)
                    return false
                end
                for i = 1, 3 do invoke(NET.FuseMachine.REMOVE_MOB, uids[i]) end
                return false
            end
        end
        return false
    end

    local function claimStep()
        invoke(NET.OfflineAssets.REQUEST_REDEEM)
        invoke(NET.Index.REQUEST_CLAIM_ALL)
    end

    ----------------------------------------------------------------
    -- Anti-Lag Engine
    ----------------------------------------------------------------
    local KILL_CLASSES = {
        ParticleEmitter = true, Trail = true, Smoke = true, Fire = true,
        Sparkles = true, Beam = true, Explosion = true, Highlight = true,
    }

    local function stripInstance(inst)
        local cls = inst.ClassName
        if KILL_CLASSES[cls] then
            inst:Destroy()
            return
        end
        if Cfg.LowFXOnly then return end
        if cls == "Texture" or cls == "Decal" then
            inst:Destroy()
        elseif inst:IsA("BasePart") then
            inst.Material = Enum.Material.SmoothPlastic
            inst.Reflectance = 0
            inst.CastShadow = false
            if inst:IsA("MeshPart") then inst.RenderFidelity = Enum.RenderFidelity.Performance end
        end
    end

    local function antiLagGlobals()
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 1e6
            Lighting.Brightness = 1
            for _, fx in ipairs(Lighting:GetChildren()) do
                if fx:IsA("PostEffect") or fx:IsA("Atmosphere") then fx:Destroy() end
            end
            local terrain = Workspace:FindFirstChildOfClass("Terrain")
            if terrain then
                terrain.WaterWaveSize = 0
                terrain.WaterWaveSpeed = 0
                terrain.WaterReflectance = 0
                terrain.WaterTransparency = 0
            end
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
        end)
    end

    local fullPassRunning = false
    local FULL_PASS_MS = 0.004

    local function antiLagFullPass()
        if fullPassRunning then return end
        fullPassRunning = true
        task.spawn(function()
            antiLagGlobals()
            local all = Workspace:GetDescendants()
            local slice = os.clock()
            for i = 1, #all do
                local inst = all[i]
                if inst.Parent then pcall(stripInstance, inst) end
                if os.clock() - slice > FULL_PASS_MS then
                    task.wait()
                    slice = os.clock()
                end
            end
            all = nil
            Runtime.lastError = nil
            logLine("lag", "แก้แลค: กวาดครบทั้งแมพแล้ว")
            fullPassRunning = false
        end)
    end

    local fxQueue = {}
    Runtime.conns.fx = Workspace.DescendantAdded:Connect(function(inst)
        if not Cfg.AntiLag then return end
        fxQueue[#fxQueue + 1] = inst
    end)

    local function hideOtherPlayers()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                for _, part in ipairs(p.Character:GetDescendants()) do
                    if part:IsA("BasePart") or part:IsA("Decal") then
                        pcall(function() part.LocalTransparencyModifier = 1 end)
                    elseif part:IsA("ParticleEmitter") or part:IsA("Trail") then
                        pcall(function() part:Destroy() end)
                    end
                end
            end
        end
    end

    local function antiLagSweep()
        if not Cfg.AntiLag then
            if #fxQueue > 0 then table.clear(fxQueue) end
            return
        end

        antiLagGlobals()
        local slice    = os.clock()
        local deadline = slice + 0.75
        while #fxQueue > 0 and os.clock() < deadline do
            local inst = table.remove(fxQueue)
            if inst and inst.Parent then pcall(stripInstance, inst) end
            if os.clock() - slice > 0.003 then
                RunService.Heartbeat:Wait()
                slice = os.clock()
            end
        end
        if #fxQueue > 4000 then table.clear(fxQueue) end
        if Cfg.HideOtherPlayers then pcall(hideOtherPlayers) end
    end

