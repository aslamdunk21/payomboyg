function Guardless.detach()
    local net = ReplicatedStorage:FindFirstChild("Network")
    if not net then return false end

    ENV.NyxDetached = ENV.NyxDetached or {}
    local held = ENV.NyxDetached
    local ok = true

    for _, name in ipairs(Guardless.Reports) do
        local live = net:FindFirstChild(name)
        if live then
            if typeof(getconnections) == "function" then
                pcall(function()
                    for _, conn in ipairs(getconnections(live.OnClientEvent)) do
                        conn:Disconnect()
                    end
                end)
            end
            held[name] = { remote = live, parent = net }
            local okd = pcall(function()
                live.Parent = nil
            end)
            if not okd then ok = false end
        elseif not (held[name] or net:FindFirstChild("ClientCharacter: IntegrityHeartbeat")) then
            ok = false
        end
    end

    ENV.NyxCorrectionMuted = ok
    ENV.NyxMuteJobId = ok and game.JobId or nil
    return ok
end

function Guardless.reattach()
    local held = ENV.NyxDetached
    if not held then return end
    for _, entry in pairs(held) do
        pcall(function()
            if entry.remote and not entry.remote.Parent and entry.parent then
                entry.remote.Parent = entry.parent
            end
        end)
    end
    ENV.NyxDetached = nil
    ENV.NyxCorrectionMuted = false
    ENV.NyxMuteJobId = nil
end

