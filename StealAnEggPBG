    ----------------------------------------------------------------
    -- Open / close
    ----------------------------------------------------------------
    -- Both of these are callable from ANY thread: they only raise flags, and the
    -- pump applies them from the thread that owns the GUI.
    local function afkOpen()
        if AFK.on then return end
        AFK.on = true
        Runtime.afkOn = true   -- serverHop reads this and writes the resume flag
        AFK.startAt = os.clock()
        AFK.lastSec = -1
        AFK.gridAt, AFK.eggAt = 0, 0
        AFK.wantShow, AFK.wantHide = true, false
        AFK.wantSeed = true
        AFK.gridDirty, AFK.eggDirty, AFK.logDirty = true, true, false
        logLine("afk", "เปิดโหมด AFK")
    end

    afkClose = function(fromButton)
        if not AFK.on then return end
        AFK.on = false
        Runtime.afkOn = false
        clearAfkResume()   -- pressing the button ends it for good, hops included

        AFK.wantHide, AFK.wantShow = true, false

        if fromButton and AFK.toggleRef then
            -- WindUI exposes different setters across versions; try them quietly
            for _, m in ipairs({ "SetValue", "Set", "UpdateValue" }) do
                if pcall(function() AFK.toggleRef[m](AFK.toggleRef, false) end) then break end
            end
        end
        Notify("โหมด AFK", "ปิดโหมด AFK แล้ว — คืนค่ากราฟิกเรียบร้อย", 4)
    end

    ----------------------------------------------------------------
    -- Event feed
    ----------------------------------------------------------------
    -- logLine is rebound exactly once, so every existing caller in the script
    -- feeds the panel without a single polling loop being added anywhere.
    if not AFK.hooked then
        AFK.hooked = true
        local baseLogLine = logLine
        -- Only flags are set here. logLine is called from game callbacks and
        -- remote handlers, and those threads run at normal game identity, which
        -- cannot touch a GUI living in the executor's hidden container — every
        -- rebuild attempted from one of them died with "lacking capability
        -- Plugin". The pump owns every rebuild instead.
        logLine = function(kind, text)
            baseLogLine(kind, text)
            if AFK.on then
                AFK.logDirty = true
                if kind == "hatch" or kind == "sell" or kind == "fuse" then AFK.gridDirty = true end
                if kind == "hatch" or kind == "place" or kind == "steal" then AFK.eggDirty = true end
            end
        end
    end

    -- handles for the exported API, so the panel can be driven without the tab
    Runtime.afkOpen  = afkOpen
    Runtime.afkClose = afkClose
    Runtime.afkDiag  = function()
        return {
            gui = typeof(AFK.gui), eggList = typeof(AFK.eggList),
            eggRows = #AFK.eggRows, eggShown = #AFK.eggData,
            petCards = #AFK.cards, logRows = #AFK.pool, on = AFK.on,
        }
    end

    -- Built and connected HERE, on the script's own UI thread, not on first
    -- open. Every Instance in the panel is therefore created by one thread, and
    -- the pump that writes to them runs on a connection made by that same
    -- thread — the fix for the empty egg column. While the panel is off the
    -- pump costs one boolean test per frame.
    afkBuild()
    AFK.gui.Enabled = false
    AFK.conns.pump = RunService.Heartbeat:Connect(function() pcall(afkPump) end)
    Runtime.conns.afkPump = AFK.conns.pump

