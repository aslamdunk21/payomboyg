            end
            sCfg = sCfg or {}
            local title = sCfg.Title or id
            local minVal = sCfg.Min or (type(sCfg.Value) == "table" and sCfg.Value.Min) or 0
            local maxVal = sCfg.Max or (type(sCfg.Value) == "table" and sCfg.Value.Max) or 100
            local defaultVal = sCfg.Default or (type(sCfg.Value) == "table" and sCfg.Value.Default) or minVal

