    local ok, inside = pcall(AreaLookup.IsInGameplaySide, SEP_LINE, root.Position)
    return ok and inside == true
end

function enforceWalkSpeed()
    local want = Cfg.BoostWalkSpeed
    if not want or want <= 0 then return end
    local hum = humanoid()
    if hum and hum.WalkSpeed < want then hum.WalkSpeed = want end
end

function guardPositions()
    local list = {}
    if not GuardAreasFolder then return list end
    for _, model in ipairs(GuardAreasFolder:GetChildren()) do
        local guard = model:FindFirstChild("Guard")
        if guard then
            local ok, gp = pcall(function() return guard:GetPivot().Position end)
            if ok and gp then list[#list + 1] = Vector3.new(gp.X, 0, gp.Z) end
        end
    end
    return list
end

function nearestGuardDist(pos, list)
    local flat, best = Vector3.new(pos.X, 0, pos.Z), math.huge
    for _, gp in ipairs(list or guardPositions()) do
        local d = (gp - flat).Magnitude
        if d < best then best = d end
    end
    return best
end

----------------------------------------------------------------
-- Warp Fallback & Steer Engine
----------------------------------------------------------------
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.IgnoreWater = true

function groundYAt(pos)
    local ignore = { char() }
    local origin = pos + Vector3.new(0, 4, 0)
    for _ = 1, 10 do
        groundParams.FilterDescendantsInstances = ignore
        local hit = Workspace:Raycast(origin, Vector3.new(0, -600, 0), groundParams)
        if not hit then return nil end
        if hit.Instance.CanCollide and hit.Instance.Transparency < 1 then return hit.Position.Y end
        table.insert(ignore, hit.Instance)
    end
    return nil
end

function settleFeet(seconds)
    local t0 = os.clock()
    while os.clock() - t0 < (seconds or 0.08) do
        task.wait()
        local r = hrp()
        if r then r.AssemblyLinearVelocity = Vector3.zero end
    end
end

function steerAroundGuards(pos, gap, list)
    local out = pos
    for _ = 1, 3 do
        local worst, worstGap
        for _, gp in ipairs(list) do
            local d = (gp - Vector3.new(out.X, 0, out.Z)).Magnitude
            if d < gap and (not worstGap or d < worstGap) then worst, worstGap = gp, d end
        end
        if not worst then return out, true end
        local away = Vector3.new(out.X, 0, out.Z) - worst
        if away.Magnitude < 0.1 then away = Vector3.new(0, 0, 1) end
        away = away.Unit * (gap - worstGap + 6)
        out = out + Vector3.new(away.X, 0, away.Z)
    end
    return out, false
end

local function warpTo(dest, arriveDist, opts)
    opts = opts or {}
    arriveDist = arriveDist or 2.5
    local gap      = opts.guardGap or Cfg.GuardSafeGap or 26
    local deadline = os.clock() + (opts.timeout or 14)

    while os.clock() < deadline do
        if not alive() then return false, "เซสชันถูกแทนที่" end
        enforceWalkSpeed()
        local dt = RunService.Heartbeat:Wait()
        local root = hrp()
        if not root then return false, "ไม่มีตัวละคร" end

        local delta = dest - root.Position
        local flat  = Vector3.new(delta.X, 0, delta.Z)
        if flat.Magnitude <= arriveDist then return true end

        local hum   = humanoid()
        local speed = math.max(300, (hum and hum.WalkSpeed or 16) * (Cfg.WarpPct or 2.0))
        local step  = math.min(speed * dt, flat.Magnitude, 14)
        local nextPos = root.Position + flat.Unit * step

        if not opts.ignoreGuards then
            local guards = guardPositions()
            local effGap = flat.Magnitude < 40 and math.min(gap, 12) or gap
            local steered, clear = steerAroundGuards(nextPos, effGap, guards)
            if not clear and nearestGuardDist(root.Position, guards) < 8 then return false, "ยามขวางทาง" end
            nextPos = steered
        end

        local gy = groundYAt(nextPos)
        if gy then nextPos = Vector3.new(nextPos.X, gy + MIN_HOVER, nextPos.Z) end

        root.CFrame = CFrame.new(nextPos)
        root.AssemblyLinearVelocity = Vector3.zero
    end
    return false, "วาปไม่ทันเวลา"
end

local function warpChain(dest, arriveDist, opts)
    opts = opts or {}
    local root = hrp()
    if not root then return false, "ไม่มีตัวละคร" end

    local hop  = math.max(300, Cfg.ZoneHopStep or 500)
    local from = root.Position
    local flat = Vector3.new(dest.X - from.X, 0, dest.Z - from.Z)
    local legs = math.max(1, math.ceil(flat.Magnitude / hop))

    for i = 1, legs - 1 do
        local wp = from + flat * (i / legs)
        local ok, err = warpTo(Vector3.new(wp.X, from.Y, wp.Z), 4, opts)
        if not ok then return false, err end
    end
    return warpTo(dest, arriveDist or 2.5, opts)
end

-- every trip that ends in a request to the server is walked at step speed:
-- feet on the ground, velocity zeroed, ~300 studs a second
Guardless.StepSpeed = 300
Guardless.rayParams = RaycastParams.new()
Guardless.rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function stepGroundY(pos)
    Guardless.rayParams.FilterDescendantsInstances = { char() }
    local hit = Workspace:Raycast(pos + Vector3.new(0, 60, 0), Vector3.new(0, -400, 0), Guardless.rayParams)
    return hit and hit.Position.Y or nil
end

local Nav = { GuardRing = 26 }

function Nav.guardPivots()
    local list = {}
    if not GuardAreasFolder then return list end
    for _, model in ipairs(GuardAreasFolder:GetChildren()) do
        local guard = model:FindFirstChild("Guard")
        if guard then
            local ok, pivot = pcall(function() return guard:GetPivot().Position end)
            if ok then list[#list + 1] = Vector3.new(pivot.X, 0, pivot.Z) end
        end
    end
    return list
end

function Nav.dodge(pos, guards)
    local flat = Vector3.new(pos.X, 0, pos.Z)
    for _, g in ipairs(guards) do
        local away = flat - g
        local d    = away.Magnitude
        if d < Nav.GuardRing and d > 0.1 then
            local pushed = g + away.Unit * Nav.GuardRing
            return Vector3.new(pushed.X, pos.Y, pushed.Z)
        end
    end
    return pos
end

-- Measured 2026-08-17 on this build: a stepped trip covers ~85 studs a second,
-- not the 800 the step size asks for, because the corrector drags every frame
-- back. The fixed 8s/15s budgets were written for the fast case, so a nest 700
-- studs out reported "ไปไม่ถึงไข่" while the character was still walking. The
-- caller's number is now a floor, and the real budget comes from the distance.
local function stepTo(target, timeout)
    local start = hrp()
    local budget = timeout or 12
    if start then
        local flat0 = Vector3.new(target.X - start.Position.X, 0, target.Z - start.Position.Z).Magnitude
        budget = math.max(budget, flat0 / 60 + 4)
    end
    local deadline = os.clock() + budget
    local guards   = Nav.guardPivots()
    local refresh  = os.clock() + 0.5
    while os.clock() < deadline do
        local dt   = RunService.Heartbeat:Wait()
        local root = hrp()
        if not root then return false end
        if os.clock() > refresh then guards = Nav.guardPivots() refresh = os.clock() + 0.5 end
        local pos  = root.Position
        local flat = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
        local dist = flat.Magnitude
        if dist < 6 then return true end
        local nxt = pos + flat.Unit * math.min(Guardless.StepSpeed * dt, dist)
        if dist > 35 then nxt = Nav.dodge(nxt, guards) end
        local gy  = stepGroundY(nxt)
        if gy then nxt = Vector3.new(nxt.X, gy + MIN_HOVER, nxt.Z) end
        root.CFrame = CFrame.new(nxt)
        root.AssemblyLinearVelocity = Vector3.zero
    end
    return false
end

function Nav.curtainClosed()
    local objs  = Workspace:FindFirstChild("__OBJECTS")
    local areas = objs and objs:FindFirstChild("Areas")
    local wall  = areas and areas:FindFirstChild("WallStartCollision")
    return wall ~= nil and wall.CanCollide == true
end

function Nav.waitCurtain(timeout)
    if not Nav.curtainClosed() then return true end
    local deadline = os.clock() + (timeout or 90)
    while os.clock() < deadline do
        task.wait(0.25)
        if not Nav.curtainClosed() then
            task.wait(0.15)
            return true
        end
    end
    return false
end

function Nav.treadmillPlates()
    if Nav.plates and os.clock() < (Nav.platesAt or 0) then return Nav.plates end
    local list = {}
    local plots = Workspace:FindFirstChild("Plots")
    if plots then
        for _, plot in ipairs(plots:GetChildren()) do
            local plate = plot:FindFirstChild("TreadmillBottom")
            if plate and plate:IsA("BasePart") then list[#list + 1] = plate end
        end
    end
    Nav.plates, Nav.platesAt = list, os.clock() + 10
    return list
end

function Nav.onTreadmill()
    local root = hrp()
    if not root then return false end
    for _, plate in ipairs(Nav.treadmillPlates()) do
        if plate.Parent then
            local local_ = plate.CFrame:PointToObjectSpace(root.Position)
            local half   = plate.Size * 0.5
            if math.abs(local_.X) <= half.X + 3
                and math.abs(local_.Z) <= half.Z + 3
                and local_.Y > -4 and local_.Y < 14
            then
                return true, plate
            end
        end
    end
    return false
end

-- never jumps: an airborne frame is not counted by the server and costs the trip
function Nav.leaveTreadmill()
    local on, plate = Nav.onTreadmill()
    if not on then return true end
    local h = humanoid()
    if h then pcall(function() h.Sit = false end) end

    for i = 1, 6 do
        local root = hrp()
        if not root then return false end
        local dir  = plate and plate.CFrame.LookVector or Vector3.new(0, 0, -1)
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, -1) else dir = dir.Unit end
        local away = root.Position + dir * (14 * i)
        local gy   = stepGroundY(away)
        root.CFrame = CFrame.new(gy and Vector3.new(away.X, gy + MIN_HOVER, away.Z) or away)
        root.AssemblyLinearVelocity = Vector3.zero
        RunService.Heartbeat:Wait()
        if not Nav.onTreadmill() then return true end
    end
    stepTo(ANCHOR, 6)
    return not Nav.onTreadmill()
end

local function toAnchor()
    if instantOK() then
        if insideGameplay() then stepTo(GATE_IN, 8) end
        return stepTo(ANCHOR, 8)
    end
    local root = hrp()
    if not root then return false end
    if (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(ANCHOR.X, 0, ANCHOR.Z)).Magnitude < 4 then
        return blinkExact(ANCHOR)
    end
    if insideGameplay() then warpChain(GATE_IN, 4, { guardGap = 14 }) end
    warpChain(ANCHOR, 3, { ignoreGuards = true })
    return blinkExact(ANCHOR)
end

local function moveTo(pos)
    if instantOK() then
        local gy = groundYAt(pos)
        return stepTo(gy and Vector3.new(pos.X, gy + MIN_HOVER, pos.Z) or (pos + Vector3.new(0, 3, 0)), 12)
    end
    return warpChain(pos, 5, { ignoreGuards = true })
end

