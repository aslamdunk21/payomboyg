local function GetRarityVal(nameOrRarity)
    if not nameOrRarity then return 1 end
    local str = tostring(nameOrRarity):lower()
    for rarity, val in pairs(RarityLevels) do
        if rarity ~= "ALL" and str:find(rarity:lower()) then
            return val
        end
    end
    return 1
end

