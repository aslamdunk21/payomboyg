    -- Resume after a hop, never after a manual rejoin: the flag only exists
    -- because serverHop wrote it on the way out, and it is eaten on read.
    if consumeAfkResume() then
        task.spawn(function()
            -- wait for the world to actually be there before drawing over it,
            -- so auto-steal picks up exactly as it did in the old server
            local deadline = os.clock() + 45
            repeat task.wait(0.5) until (hrp() and plotData()) or os.clock() > deadline or not alive()
            if not alive() then return end
            task.wait(1.5)
            afkOpen()
            afkSetToggle(true)
        end)
    end

