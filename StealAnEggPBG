-- Server Hop Engine (SAE_Nyx)
----------------------------------------------------------------
do
    local HOP_FILE = CFG_DIR .. "/hopstate.json"
    local AFK_FILE = CFG_DIR .. "/afkstate.json"
    local HOP_MEMORY_WINDOW = 300

    function Runtime.readHopState()
        local data = hasFS and readJson(HOP_FILE) or nil
        if type(data) ~= "table" then
            return { count = 0, at = 0, seen = {}, resetAt = os.time() }
        end

        local now     = os.time()
        local resetAt = tonumber(data.resetAt) or 0
        local raw     = type(data.seen) == "table" and data.seen or {}

        if resetAt <= 0 or (now - resetAt) >= HOP_MEMORY_WINDOW then
            return { count = tonumber(data.count) or 0, at = tonumber(data.at) or 0, seen = {}, resetAt = now }
        end

        local seen = {}
        for jobId, stamp in pairs(raw) do
            if type(jobId) == "string" and jobId ~= "" and type(stamp) == "number" then
                seen[jobId] = stamp
            end
        end

        local count = tonumber(data.count) or 0
        if (now - (tonumber(data.at) or 0)) > HOP_MEMORY_WINDOW then count = 0 end
        return { count = count, at = tonumber(data.at) or 0, seen = seen, resetAt = resetAt }
    end

    function Runtime.writeHopState(count, seen, resetAt)
        if not hasFS then return end
        local cur = Runtime.readHopState()
        pcall(function()
            writefile(HOP_FILE, HttpService:JSONEncode({
                count   = count or cur.count,
                at      = os.time(),
                seen    = seen or cur.seen,
                resetAt = resetAt or cur.resetAt or os.time(),
            }))
        end)
    end

    function Runtime.rememberServer(seen, jobId)
        seen  = seen or Runtime.readHopState().seen
        jobId = jobId or game.JobId
        if type(jobId) == "string" and jobId ~= "" then seen[jobId] = os.time() end
        return seen
    end

    function Runtime.hopMemorySize()
        local n = 0
        for _ in pairs(Runtime.readHopState().seen) do n += 1 end
        return n
    end

    function Runtime.writeAfkResume()
        if not hasFS then return end
        pcall(function() writefile(AFK_FILE, HttpService:JSONEncode({ at = os.time() })) end)
    end

    function Runtime.clearAfkResume()
        if not hasFS then return end
        pcall(function()
            if typeof(delfile) == "function" then delfile(AFK_FILE) else writefile(AFK_FILE, "{}") end
        end)
    end

    function Runtime.consumeAfkResume()
        if not hasFS then return false end
        local data = readJson(AFK_FILE)
        Runtime.clearAfkResume()
        if type(data) ~= "table" then return false end
        return (os.time() - (tonumber(data.at) or 0)) <= 180
    end

    function Runtime.zoneHasWanted()
        pcall(EggCmds.RequestAreaEggSnapshot)
        task.wait(0.25)

        local seen = 0
        for _ in pairs(areaEggRecords()) do seen += 1 end

        if seen > 0 then
            Runtime.lastEggsSeenAt = os.clock()
            return matchingEggCount() > 0, seen
        end

        local quietFor = os.clock() - (Runtime.lastEggsSeenAt or Runtime.stats.startedAt or 0)
        if (Runtime.eggTick or 0) > 0 and quietFor > 15 then
            return false, 0
        end
        return nil
    end

    function Runtime.hopIfTrulyEmpty()
        if not Cfg.AutoHop then return false end
        if Runtime.carryUid then return false end
        if Runtime.hopStopped then return false end
        if Runtime.hopRestUntil and os.clock() < Runtime.hopRestUntil then return false end

        if os.clock() - (Runtime.stats.startedAt or 0) < 12 then return false end
        if Runtime.lastHopAt and os.clock() - Runtime.lastHopAt < 20 then return false end

        local checks = math.clamp(tonumber(Cfg.HopChecks) or 3, 2, 6)
        local seenAny = 0
        for i = 1, checks do
            local has, seen = Runtime.zoneHasWanted()
            if has == nil then return false end
            if has then return false end
            seenAny = math.max(seenAny, seen or 0)
            if i < checks then task.wait(1) end
        end

        local chain = (Runtime.hopChain or 0) + 1
        Runtime.hopChain = chain
        Runtime.writeHopState(chain)

        local maxTries = math.clamp(tonumber(Cfg.HopMaxTries) or 6, 1, 30)
        if chain > maxTries then
            Runtime.hopRestUntil = os.clock() + 180
            Runtime.hopChain = 0
            Runtime.writeHopState(0)
            logLine("hop", ("ย้ายเซิร์ฟ %d ครั้งติดยังไม่เจอไข่ตรงตัวกรอง — พัก 3 นาทีแล้วค่อยย้ายต่อ"):format(chain - 1))
            Notify("ย้ายเซิร์ฟเวอร์",
                ("ย้ายมา %d ครั้งติดยังไม่เจอไข่ที่ตั้งไว้ — พัก 3 นาทีแล้วเริ่มย้ายใหม่ (ถ้าอยากได้เร็วกว่านี้ เพิ่มระดับไข่หรือโซนในตัวกรอง)"):format(chain - 1), 8)
            return false
        end

        Runtime.lastHopAt = os.clock()
        logLine("hop", ("โซนนี้ไม่มีไข่ตรงตัวกรอง (เช็ค %d ครั้ง, เห็นไข่ในแมพ %d ใบ) — ย้ายเซิร์ฟ ครั้งที่ %d")
            :format(checks, seenAny, chain))
        return Runtime.serverHop()
    end

    function Runtime.serverHop()
        if Runtime.afkOn then Runtime.writeAfkResume() end

        local state = Runtime.readHopState()
        local seen  = Runtime.rememberServer(state.seen)
        Runtime.writeHopState(state.count, seen, state.resetAt)

        local candidates = {}
        local pages, cursor = 0, nil

        repeat
            local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)
            if cursor then url = url .. "&cursor=" .. cursor end

            local ok, body = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
            if not (ok and body and body.data) then break end

            for _, s in ipairs(body.data) do
                if s.id and s.id ~= game.JobId and not seen[s.id]
                    and s.playing and s.maxPlayers and s.playing < s.maxPlayers
                then
                    candidates[#candidates + 1] = s.id
                end
            end

            cursor = body.nextPageCursor
            pages += 1
        until not cursor or pages >= 3 or #candidates >= 60

        if #candidates == 0 then
            logLine("hop", "เซิร์ฟที่ยังไม่เคยเข้าหมดแล้ว — ล้างรายชื่อที่เคยไปแล้วเริ่มจำใหม่")
            Runtime.writeHopState(state.count, {}, os.time())
            pcall(TeleportService.Teleport, TeleportService, game.PlaceId, LocalPlayer)
            return false
        end

        local pick = candidates[math.random(1, #candidates)]
        Runtime.writeHopState(state.count, Runtime.rememberServer(seen, pick), state.resetAt)
        logLine("hop", ("ย้ายเซิร์ฟ: เลือกจาก %d ห้องที่ยังไม่เคยเข้า (จำไว้แล้ว %d ห้อง)")
            :format(#candidates, Runtime.hopMemorySize()))
        local ok = pcall(TeleportService.TeleportToPlaceInstance, TeleportService, game.PlaceId, pick, LocalPlayer)
        if not ok then
            pcall(TeleportService.Teleport, TeleportService, game.PlaceId, LocalPlayer)
            return false
        end
        return true
    end
end

do
