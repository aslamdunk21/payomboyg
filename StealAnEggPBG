function fileExists(path)
    if not hasFS then return false end
    if typeof(isfile) ~= "function" then
        local ok, body = pcall(readfile, path)
        return ok and type(body) == "string" and #body > 0
    end
    local ok, yes = pcall(isfile, path)
    return ok and yes == true
end

function readJson(path)
    if not fileExists(path) then return nil end
    local okr, body = pcall(readfile, path)
    if not okr or type(body) ~= "string" or #body < 2 then return nil end
    local okd, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not okd or type(data) ~= "table" then return nil end
    return data
end

function saveConfig()
    if uiBuilding then return false end
    if not hasFS then
        Runtime.cfgStatus = "executor นี้เขียนไฟล์ไม่ได้ — ค่าจะหายเมื่อออกเกม"
        return false
