local function normalizeMulti(val)
	local map = {}
	if type(val) == "table" then
		for k, v in pairs(val) do
			if type(k) == "number" and type(v) == "string" and v ~= "" then
				map[v] = true
			elseif type(k) == "string" and v == true then
				map[k] = true
			end
		end
	elseif type(val) == "string" and val ~= "" then
		map[val] = true
	end
	return map
end

local function formatShort(n, prefix)
	n = tonumber(n) or 0
	prefix = prefix or ""
	local sign = n < 0 and "-" or ""
	n = math.abs(n)
	if n < 1000 then
		return string.format("%s%s%d", sign, prefix, math.floor(n + 0.5))
	end
	local index = 0
	while n >= 1000 and index < #SUFFIXES - 1 do
		n /= 1000
		index += 1
	end
	return string.format("%s%s%.2f%s", sign, prefix, n, SUFFIXES[index + 1])
end

local function formatWeight(kg)
	kg = tonumber(kg) or 0
	if kg >= 1000 then
		return formatShort(kg) .. "kg"
	end
	return string.format("%.1fkg", kg)
end

local function formatDistance(studs)
	studs = tonumber(studs) or 0
	if studs >= 1000 then
		return string.format("%.1fkm", studs / 1000)
	end
	return string.format("%dm", math.floor(studs + 0.5))
end

local function formatLuck(score)
	local pct = (tonumber(score) or 0) * 100
	if pct <= 0 then
		return "+0%"
	end
	if pct < 1 then
		return string.format("+%.2f%%", pct)
	end
	if pct < 10 then
		return string.format("+%.1f%%", pct)
	end
	return string.format("+%.0f%%", pct)
end

local function parseValue(text)
	if type(text) == "number" then
		return text
	end
	if type(text) ~= "string" then
		return nil
	end
	local cleaned = text:lower():gsub("[%s,%$_]", "")
	if cleaned == "" then
		return 0
	end
	local direct = tonumber(cleaned)
	if direct then
		return direct
	end
	local numberStr, suffix = cleaned:match("^([%d%.]+)(%a*)$")
	if not numberStr then
		numberStr, suffix = cleaned:match("^([%d%.]+e?[%+%-%d]*)(%a*)$")
	end
	if not numberStr then
		return nil
	end

	local dotCount = 0
	for _ in numberStr:gmatch("%.") do
		dotCount += 1
	end
	if dotCount > 1 then
		numberStr = numberStr:gsub("%.", "")
	end

	local base = tonumber(numberStr)
	if not base then
		return nil
	end
	if suffix == "" then
		return base
	end
	local multiplier = PARSE_MULTIPLIERS[suffix]
	if not multiplier then
		if suffix:sub(1, 2) == "qa" or suffix:sub(1, 2) == "qd" then
			multiplier = 1e15
		elseif suffix:sub(1, 2) == "qi" or suffix:sub(1, 2) == "qn" then
			multiplier = 1e18
		elseif suffix:sub(1, 1) == "t" then
			multiplier = 1e12
		elseif suffix:sub(1, 1) == "b" then
			multiplier = 1e9
		elseif suffix:sub(1, 1) == "m" then
			multiplier = 1e6
		elseif suffix:sub(1, 1) == "k" then
			multiplier = 1e3
		end
	end
	if not multiplier then
		return base
	end
	return base * multiplier
