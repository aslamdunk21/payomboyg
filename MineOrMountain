	if r and g and b then
		return Color3.fromRGB(r, g, b)
	end
	return COLORS.default
end

local function getMutationsList(inst)
	local mutations = {}
	local seen = {}

	local function add(m)
		if type(m) == "string" and m ~= "" then
			m = m:match("^%s*(.-)%s*$")
			if m ~= "" and not seen[m] then
				seen[m] = true
				mutations[#mutations + 1] = m
			end
		end
	end

	for _, attrName in ipairs({ "Mutation", "MutationName", "ExtraMutations", "AdminMutation" }) do
		local val = getAttr(inst, attrName)
		if type(val) == "string" and val ~= "" then
			for part in string.gmatch(val, "[^,%+%/]+") do
				add(part)
			end
		end
	end

	if inst and inst.Name then
		for brack in inst.Name:gmatch("%[(.-)%]") do
			add(brack)
		end
		for paren in inst.Name:gmatch("%((.-)%)") do
			add(paren)
		end
		for mutName in pairs(MUTATION_LUCK) do
			if inst.Name:find(mutName, 1, true) then
				add(mutName)
			end
		end
	end

	if #mutations == 0 and inst and (inst:IsA("Model") or inst:IsA("BasePart")) then
		local hover = inst:FindFirstChild("CrystalHover") or inst:FindFirstChild("CrystalHover", true)
		if hover then
			for _, child in ipairs(hover:GetChildren()) do
				if child:IsA("TextLabel") and child.Text and child.Text ~= "" then
					for mutName in pairs(MUTATION_LUCK) do
						if child.Text:find(mutName, 1, true) then
							add(mutName)
						end
					end
				end
			end
		end
	end

	return mutations
end

local function mutationLuck(name)
	if type(name) ~= "string" or name == "" then
		return 1
	end
	return MUTATION_LUCK[name] or 1
end

local function combinedLuckMult(inst)
	local multiplier = 1
	local mutations = getMutationsList(inst)

	for _, mut in ipairs(mutations) do
		local luckVal = MUTATION_LUCK[mut]
		if luckVal then
			multiplier *= luckVal
		end
	end

	local roll = tonumber(getAttr(inst, "MutationLuckRoll"))
	if roll and roll > 1 then
		multiplier = math.max(multiplier, roll)
	end

	if getAttr(inst, "IsBloodCrystal") == true then
		multiplier *= LUCK.blood
	end

	return multiplier
end

local function computeLuck(inst)
	local tier = crystalTier(inst)
	if tier <= 0 then
		return 0
	end

	local weight = math.max(0, crystalWeight(inst))
	local base = (LUCK.rarity[tier] or LUCK.rarity[#LUCK.rarity] or LUCK.rarity[1]) * math.min(weight, LUCK.cap) ^ LUCK.exponent * LUCK.base

	if getAttr(inst, "BombCrystal") == true then
		base *= LUCK.bomb
	end

	return base * combinedLuckMult(inst)
end

