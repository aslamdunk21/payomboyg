local function sortedByScore(scoreFn)
	local scored = {}
	local seen = {}

	local function consider(inst)
		if not inst or seen[inst] or not inst.Parent then
			return
		end

		if getAttr(inst, "Collected") == true then
			return
		end

		if not meetsFilter(inst) then
			return
		end

		seen[inst] = true
		local ok, score = pcall(scoreFn, inst)
		if ok and score and score > 0 then
			scored[#scored + 1] = { inst = inst, score = score }
		end
	end

	for inst in pairs(Storage.registry) do
		consider(inst)
	end

	table.sort(scored, function(a, b)
		return a.score > b.score
	end)

	return scored
end

