end

local function tierFromValue(val)
	if not val or val <= 0 then return 0 end
	if val >= 1e19 then return 14 end
	if val >= 1e18 then return 13 end
	if val >= 1e17 then return 12 end
	if val >= 1e16 then return 11 end
	if val >= 1e15 then return 10 end
	if val >= 1e14 then return 9 end
	if val >= 1e13 then return 8 end
	if val >= 1e12 then return 7 end
	if val >= 1e7  then return 6 end
	if val >= 1e6  then return 5 end
	if val >= 1e5  then return 4 end
	if val >= 1e4  then return 3 end
	if val >= 1e3  then return 2 end
	return 1
end

local function rawCrystalValue(inst)
	for _, attrName in ipairs({ "Value", "ValueText", "ValueString", "Money", "Price", "Val", "BaseValue", "Worth" }) do
		local raw = getAttr(inst, attrName)
		if raw ~= nil then
			local p = parseValue(raw)
			if p and p > 0 then return p end
		end
	end
	if inst:IsA("Model") or inst:IsA("BasePart") then
		local bestVal = 0
		for _, child in ipairs(inst:GetDescendants()) do
			if child:IsA("TextLabel") and child.Text and child.Text ~= "" then
				local text = child.Text
				if not text:find("%%") and not text:lower():find("kg") and not text:lower():find("tons") then
					local m = text:match("%$[%d%,%.%s]+%a*") or text:match("%f[%d][%d%,%.]+%s*[kMbBtTqQaAsSpPoOnNdD]%a*") or text:match("%f[%d][%d%,%.]{4,}")
					if m then
						local p = parseValue(m)
						if p and p > bestVal then bestVal = p end
					end
				end
			end
		end
		if bestVal > 0 then return bestVal end
	end
	return 0
end

local function crystalTier(inst)
	-- Search ALL name sources and return the HIGHEST tier found
	-- NOTE: Do NOT use numeric Tier attr directly — game's Tier numbers (e.g. 7=Empyrean)
	--       do NOT match our TIER_NAMES indices (7=Quasar). Use TierName string instead.
	local bestTier = 0
	local namesToSearch = {
		getAttr(inst, "TierName"),
		getAttr(inst, "CrystalName"),
		inst and inst.Name,
	}
	for _, nameStr in ipairs(namesToSearch) do
		if type(nameStr) == "string" and nameStr ~= "" then
			local lower = nameStr:lower()
			for index = #TIER_NAMES, 1, -1 do
				if lower:find(TIER_NAMES[index]:lower(), 1, true) then
					if index > bestTier then bestTier = index end
					break
				end
			end
		end
	end
	if bestTier > 0 then return bestTier end

	if inst and (inst:IsA("Model") or inst:IsA("BasePart")) then
		for _, child in ipairs(inst:GetChildren()) do
			local cName = child.Name:lower()
			for index = #TIER_NAMES, 1, -1 do
				if cName:find(TIER_NAMES[index]:lower(), 1, true) then
					if index > bestTier then bestTier = index end
					break
				end
			end
		end
	end
	if bestTier > 0 then return bestTier end

	-- Fallback: classify by raw value (for crystals with no tier name)
	local rawVal = rawCrystalValue(inst)
	if rawVal > 0 then return tierFromValue(rawVal) end

	return 0
end

local function crystalValue(inst)
	local val = rawCrystalValue(inst)
	if val > 0 then return val end

	local tier = crystalTier(inst)
	if tier > 0 then
		local weight = math.max(1, crystalWeight(inst))
		local tierFallback = {
			[1] = 100, [2] = 1000, [3] = 10000, [4] = 100000,
			[5] = 1000000, [6] = 10000000,
			[7] = 1000000000000, [8] = 10000000000000,
			[9] = 100000000000000, [10] = 1000000000000000,
			[11] = 10000000000000000, [12] = 100000000000000000,
			[13] = 1000000000000000000, [14] = 10000000000000000000,
			[15] = 100000000000000000000, -- Leviathan
		}
		local baseVal = tierFallback[tier] or (10 ^ (tier + 2))
		return baseVal * weight
	end
	return 0
end

local function crystalRarity(inst)
	-- Use crystalTier first (accounts for inst.Name "GIANT xxx" overriding TierName "Mythic")
	local tier = crystalTier(inst)
	if tier > 0 then
		return TIER_NAMES[tier] or "Unknown"
	end
	local name = getAttr(inst, "TierName")
	if type(name) == "string" and name ~= "" then return name end
	return "Unknown"
end

local function crystalName(inst)
