-- ── Standalone JSON Auto Config System ──────────────────────────────────
do
	local CFG_FILE = "PayomboyZ_MineAMountain.json"

	local function saveConfig()
		local data = {}
		for k, opt in pairs(ObsidianGlassEngine.Options) do
			if opt and opt.Value ~= nil then
				data[k] = opt.Value
			end
		end
		pcall(function()
			writefile(CFG_FILE, Services.HttpService:JSONEncode(data))
		end)
	end

	local function loadConfig()
		local ok, src = pcall(readfile, CFG_FILE)
		if not ok or not src then return end
		local ok2, data = pcall(function() return Services.HttpService:JSONDecode(src) end)
		if not ok2 or type(data) ~= "table" then return end
		for k, val in pairs(data) do
			local opt = ObsidianGlassEngine.Options[k]
			if opt and opt.SetValue then
				pcall(function() opt:SetValue(val) end)
			end
		end
		Notify("Loaded saved configuration (" .. CFG_FILE .. ")", 2)
	end

	task.delay(0.5, loadConfig)

	local lastSaveTime = os.clock()
	Connections.autoSaveConn = Services.RunService.Heartbeat:Connect(function()
		if os.clock() - lastSaveTime >= 3.0 then
			lastSaveTime = os.clock()
			saveConfig()
		end
	end)
end
