local function isCrystal(inst)
	if not inst or not inst.Parent then
		return false
	end

	local cached = crystalFlags[inst]
	if cached ~= nil then
		return cached
	end

	local result = false

	if inst:IsA("BasePart") or inst:IsA("Model") then
		local pName = inst.Parent and inst.Parent.Name
		if pName == "Crystals" or pName == "DroppedCrystals" then
			result = true
		elseif getAttr(inst, "Value") ~= nil or getAttr(inst, "CrystalName") ~= nil or getAttr(inst, "Tier") ~= nil then
			result = true
		elseif inst.Name:find("Crystal", 1, true) ~= nil then
			result = true
		end
	end

	crystalFlags[inst] = result
	return result
end

local function rebuildContainers()
	table.clear(Storage.containerList)
	local seen = {}

	local function push(container)
		if not container or seen[container] then
			return
		end
		seen[container] = true
		Storage.containerList[#Storage.containerList + 1] = container
	end

	push(Services.Workspace)

	for _, name in ipairs(CONTAINER_NAMES) do
		push(Services.Workspace:FindFirstChild(name))
	end

	local things = Services.Workspace:FindFirstChild("Things")
	if things then
		for _, name in ipairs(CONTAINER_NAMES) do
			push(things:FindFirstChild(name))
		end
		for _, name in ipairs(THINGS_CONTAINER_NAMES) do
			push(things:FindFirstChild(name))
		end
	end

	local mountain = Services.Workspace:FindFirstChild("MountainDecorations") or Services.Workspace:FindFirstChild("Mountain")
	if mountain then
		for _, name in ipairs(CONTAINER_NAMES) do
			push(mountain:FindFirstChild(name))
		end
	end
end

local function eachContainer(fn)
	local now = os.clock()
	local stale = #Storage.containerList == 0 or now - State.containerClock >= 1

	if not stale then
		for _, container in ipairs(Storage.containerList) do
			if not container.Parent and container ~= Services.Workspace then
				stale = true
				break
			end
		end
	end

	if stale then
		State.containerClock = now
		rebuildContainers()
	end

	for _, container in ipairs(Storage.containerList) do
		fn(container)
	end
end

