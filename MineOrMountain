local lastDigClock = 0

local function digCrystal(inst)
	if not inst or not inst.Parent then return false end
	local now = os.clock()
	if now - lastDigClock < 0.12 then return false end

	local root = getRoot()
	if not root then return false end

	local pos = crystalPosition(inst)
	if pos == Vector3.zero then return false end

	local dist = (root.Position - pos).Magnitude
	if dist > Config.PickRange then
		applyPivot(CFrame.new(pos + Vector3.new(0, 3, 0)))
		task.wait(0.05)
	end

	local ok = false
	if Remotes.DigRequest then
		ok = pcall(function()
			Remotes.DigRequest:FireServer(inst)
		end)
	end
	if not ok then return false end

	lastDigClock = now
	task.wait(0.35)

	if Remotes.HoldComplete then
		pcall(function()
			Remotes.HoldComplete:FireServer(inst)
		end)
	end

	Storage.claimed[inst] = now
	return true
end

local function autoFarmStep()
	if not State.autoFarmActive then return end

	local capacity = backpackCapacity()
	local weight = backpackWeight()

	local bagPct = (capacity > 0 and capacity ~= math.huge) and (weight / capacity) or 0
	if (State.autoSellEnabled and bagPct >= 0.5) or (capacity ~= math.huge and weight >= capacity) then
		doSell()
		task.wait(2)
		return
	end

	local scoreFn = (State.autoFarmMode == "luck") and crystalLuck or crystalValue
	local targets = getFarmTargets(scoreFn)
	if not targets or #targets == 0 then return end

	local dug = 0
	for _, entry in ipairs(targets) do
		if not State.autoFarmActive then break end
		if dug >= Config.PickBurst then break end

		local inst = entry.inst
		if inst and inst.Parent and not Storage.claimed[inst] then
			local score = entry.score
			if State.autoFarmMode == "luck" then
				if score < State.minLuckPoints then break end
			else
				if score < State.minValue then break end
			end

			if digCrystal(inst) then
				dug += 1
			end
		end
	end

	if dug >= Config.PickBurst then
		task.wait(1.5)
		farmScoreCache = nil
	end
end

