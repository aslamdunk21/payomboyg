-- ── Groupbox Adapter Shim (Obsidian UI -> ObsidianGlassEngine) ────────
local function makeGroupboxProxy(tabObj, sectionTitle)
	if sectionTitle and sectionTitle ~= "" then
		pcall(function() tabObj:AddSection(sectionTitle) end)
	end
	local proxy = {}
	function proxy:AddToggle(id, cfg)
		return tabObj:AddToggle(id, {
			Title    = cfg.Text or id,
			Desc     = cfg.Tooltip or "",
			Default  = cfg.Default or false,
			Callback = cfg.Callback,
		})
	end
	function proxy:AddSlider(id, cfg)
		return tabObj:AddSlider(id, {
			Title    = cfg.Text or id,
			Min      = cfg.Min or 0,
			Max      = cfg.Max or 100,
			Default  = cfg.Default or cfg.Min or 0,
			Rounding = cfg.Rounding,
			Callback = cfg.Callback,
		})
	end
	function proxy:AddDropdown(id, cfg)
		return tabObj:AddDropdown(id, {
			Title    = cfg.Text or id,
			Values   = cfg.Values or {},
			Value    = cfg.Default or (cfg.Values and cfg.Values[1] or ""),
			Multi    = cfg.Multi or false,
			Callback = function(val)
				if cfg.Callback then
					if cfg.Multi then
						cfg.Callback(normalizeMulti(val))
					else
						cfg.Callback(val)
					end
				end
			end,
		})
	end
	function proxy:AddButton(textOrCfg, cb)
		local title = type(textOrCfg) == "string" and textOrCfg or (textOrCfg.Text or textOrCfg.Title or "Button")
		local callback = type(textOrCfg) == "string" and cb or textOrCfg.Callback
		return tabObj:AddButton({ Title = title, Callback = callback })
	end
	function proxy:AddInput(id, cfg)
		return tabObj:AddInput(id, {
			Title    = cfg.Text or id,
			Default  = cfg.Default or cfg.Placeholder or "",
			Callback = cfg.Callback,
		})
	end
	function proxy:AddLabel(text, rich)
		local p = tabObj:AddParagraph({ Title = tostring(text or ""), Desc = "" })
		local labelObj = {}
		function labelObj:SetText(newTxt)
			pcall(function()
				for _, child in ipairs(p:GetChildren()) do
					if child:IsA("TextLabel") then
						child.Text = tostring(newTxt)
					end
				end
			end)
		end
		function labelObj:AddKeyPicker(id, kCfg)
			return labelObj
		end
		return labelObj
	end
	function proxy:AddDivider()
		-- separator shim
	end
	return proxy
end

