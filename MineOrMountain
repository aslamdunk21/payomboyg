		-- Replaced with plantPhase state machine in step()

		local function meetsFarmTierFilter(inst)
			if not farmTiers or not next(farmTiers) then
				return true
			end
			local selectedMap = normalizeMulti(farmTiers)
			if not next(selectedMap) then
				return true
			end
			local rName = crystalRarity(inst)
			local tIndex = crystalTier(inst)
			local tName = TIER_NAMES[tIndex] or rName
			if selectedMap[tName] then return true end
			local rLower = rName:lower()
			local tLower = tName:lower()
			for selName, _ in pairs(selectedMap) do
				local selLower = selName:lower()
				if rLower:find(selLower, 1, true) or tLower:find(selLower, 1, true) then
					return true
				end
			end
			return false
		end

		local function findLoot(free, origin)
			local now = os.clock()
			local best, bestScore, bestDistance
			local blocked = false
			local seen = {}

			for inst, expire in pairs(blacklistedLoot) do
				if now > expire or not inst.Parent then
					blacklistedLoot[inst] = nil
				end
			end

			local function consider(inst)
				if not inst or seen[inst] or blacklistedLoot[inst] then
					return
				end
				seen[inst] = true

				if not inst.Parent or not isCrystal(inst) or getAttr(inst, "Collected") == true then
					return
				end

				local score = 0
				if State.autoFarmMode == "luck" then
					local luckPts = math.floor(crystalLuck(inst) * 100 + 0.5)
					if luckPts < State.minLuckPoints then
						return
					end
					score = luckPts
				else
					if not meetsFarmTierFilter(inst) then
						return
					end
					local value = crystalValue(inst)
					if not meetsFilter(inst, value) then
						return
					end
					score = value
				end

				local instPos = getPosition(inst)
				if not instPos then return end
				local distance = (instPos - origin).Magnitude
				if distance > COLLECT_RANGE then
					return
				end

				if crystalWeight(inst) > free then
					blocked = true
					return
				end

				local better = false
				if not best then
					better = true
				elseif score > bestScore then
					better = true
				elseif score == bestScore and distance < bestDistance then
					better = true
				end

				if better then
					best = inst
					bestScore = score
					bestDistance = distance
				end
			end

			eachContainer(function(container)
				for _, child in ipairs(container:GetChildren()) do
					if child:IsA("BasePart") then
						consider(child)
					elseif child:IsA("Model") then
						for _, inner in ipairs(child:GetChildren()) do
							if inner:IsA("BasePart") then
								consider(inner)
							end
						end
					end
				end
			end)

			for inst in pairs(Storage.registry) do
				consider(inst)
			end

			return best, blocked
		end

		local function stop()
			active = false
			target = nil
			columnY = nil
			loaded = false
			Move.glideStop()
			scanIndex = 0
