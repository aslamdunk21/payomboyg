local function crystalLuck(inst)
	if inst and (inst:IsA("Model") or inst:IsA("BasePart")) then
		local hover = inst:FindFirstChild("CrystalHover", true)
		if hover then
			for _, label in ipairs(hover:GetDescendants()) do
				if label:IsA("TextLabel") and label.Text and label.Text ~= "" then
					local pctStr = label.Text:match("%+?([%d%.]+)%s*%%")
					if pctStr then
						local pct = tonumber(pctStr)
						if pct and pct > 0 then
							return pct / 100
						end
					end
				end
			end
		end
	end
	return computeLuck(inst)
end

local function meetsFilter(inst, value)
	local tier = crystalTier(inst)
	local rName = crystalRarity(inst)

	-- Exclude Common (Tier 1) and Uncommon (Tier 2) crystals to optimize performance and eliminate screen lag
	if tier == 1 or tier == 2 or rName == "Common" or rName == "Uncommon" then
		return false
	end

	if State.valueFilter then
		local val = value or crystalValue(inst)
		if val <= 0 then
			if not (isCrystal(inst) or getAttr(inst, "Tier") ~= nil or getAttr(inst, "TierName") ~= nil) then
				return false
			end
		elseif val < State.minValue then
			return false
		end
	end

	if State.selectedTiers and next(State.selectedTiers) ~= nil then
		local selectedMap = normalizeMulti(State.selectedTiers)
		if next(selectedMap) ~= nil then
			local tierName = TIER_NAMES[tier] or rName
			local instName = (inst and inst.Name or "")

			local matched = false
			if selectedMap[tierName] or selectedMap[rName] or selectedMap[instName] then
				matched = true
			else
				local rLower = rName:lower()
				local tLower = tierName:lower()
				local iLower = instName:lower()
				for selName, _ in pairs(selectedMap) do
					local selLower = selName:lower()
					if rLower:find(selLower, 1, true) or tLower:find(selLower, 1, true) or iLower:find(selLower, 1, true) then
						matched = true
						break
					end
				end
			end

			if not matched then
				return false
			end
		end
	end

	return true
end

