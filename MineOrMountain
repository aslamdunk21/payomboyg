	local gone
	for player in pairs(Storage.playerCache) do
		if player == LocalPlayer or not player.Parent then
			gone = gone or {}
			gone[#gone + 1] = player
		end
	end

	if gone then
		for _, player in ipairs(gone) do
			destroyPlayerEntry(player)
		end
	end
