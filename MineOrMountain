local function getAttr(inst, name)
	if not inst then
		return nil
	end
	local ok, value = pcall(inst.GetAttribute, inst, name)
	if ok and value ~= nil then
		return value
	end
	if inst:IsA("Model") then
		local primary = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
		if primary then
			local ok2, value2 = pcall(primary.GetAttribute, primary, name)
			if ok2 and value2 ~= nil then
				return value2
			end
		end
		for _, child in ipairs(inst:GetChildren()) do
			local ok3, value3 = pcall(child.GetAttribute, child, name)
			if ok3 and value3 ~= nil then
				return value3
			end
		end
	end
	return nil
end

