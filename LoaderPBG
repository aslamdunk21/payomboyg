-- 6. ตรวจสอบแมพจากในเกม (PlaceId + GameId + Marketplace In-Game Name Inspection)
local placeId = game.PlaceId
local scriptTarget = NormalRouter[placeId]
local vvipScriptTarget = VVIPRouter[placeId]

-- หากไม่เจอเลข PlaceId ตรงๆ ให้ดึงข้อมูลชื่อเกมจาก Roblox API ในเกมสดๆ เพื่อระบุแมพทันที
if not scriptTarget and not vvipScriptTarget then
    pcall(function()
        local MarketplaceService = game:GetService("MarketplaceService")
        local info = MarketplaceService:GetProductInfo(placeId)
        if info and info.Name then
            local gName = info.Name:lower()
            
            -- ค้นหาในแมพธรรมดาจาก Keyword ในชื่อเกม
            for _, data in pairs(NormalRouter) do
                if data.Keywords then
                    for _, kw in ipairs(data.Keywords) do
                        if gName:find(kw:lower()) then
                            scriptTarget = data
                            break
                        end
                    end
                end
                if scriptTarget then break end
            end
            
            -- ค้นหาในแมพ VVIP จาก Keyword ในชื่อเกม
            if not scriptTarget then
                for _, data in pairs(VVIPRouter) do
                    if data.Keywords then
                        for _, kw in ipairs(data.Keywords) do
                            if gName:find(kw:lower()) then
                                vvipScriptTarget = data
                                break
                            end
                        end
                    end
                    if vvipScriptTarget then break end
                end
            end
        end
    end)
end

