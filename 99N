local function getGameDay()
    local day = nil

    -- 1. Check workspace attributes
    pcall(function()
        day = workspace:GetAttribute("DailyQuestDay") or workspace:GetAttribute("Day") or workspace:GetAttribute("Night") or workspace:GetAttribute("Days") or workspace:GetAttribute("Nights")
    end)
    if day and type(day) == "number" and day > 0 then return math.floor(day) end

    -- 2. Check ReplicatedStorage attributes
    pcall(function()
        day = ReplicatedStorage:GetAttribute("Day") or ReplicatedStorage:GetAttribute("Night") or ReplicatedStorage:GetAttribute("Days")
    end)
    if day and type(day) == "number" and day > 0 then return math.floor(day) end

    -- 3. Check workspace.Map attributes
    pcall(function()
        local map = workspace:FindFirstChild("Map")
        if map then
            day = map:GetAttribute("Day") or map:GetAttribute("Night") or map:GetAttribute("Days") or map:GetAttribute("Nights")
        end
    end)
    if day and type(day) == "number" and day > 0 then return math.floor(day) end

    -- 4. Check Lighting attributes
    pcall(function()
        local lighting = game:GetService("Lighting")
        day = lighting:GetAttribute("Day") or lighting:GetAttribute("Night")
    end)
    if day and type(day) == "number" and day > 0 then return math.floor(day) end

    -- 5. Check LocalPlayer attributes
    pcall(function()
        day = LocalPlayer:GetAttribute("Day") or LocalPlayer:GetAttribute("Night") or LocalPlayer:GetAttribute("Days") or LocalPlayer:GetAttribute("Nights")
    end)
    if day and type(day) == "number" and day > 0 then return math.floor(day) end

    -- 6. Scan PlayerGui TextLabels for Day X or Night X
    pcall(function()
        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
        if pGui then
            for _, desc in ipairs(pGui:GetDescendants()) do
                if desc:IsA("TextLabel") and desc.Visible and desc.Text and desc.Text ~= "" then
                    local match = desc.Text:match("[Dd]ay%s*(%d+)") or desc.Text:match("[Nn]ight%s*(%d+)") or desc.Text:match("วันที่%s*(%d+)") or desc.Text:match("คืนที่%s*(%d+)")
                    if match then
                        local num = tonumber(match)
                        if num and num > 0 then
                            day = num
                            return
                        end
                    end
                end
            end
        end
    end)
    if day and type(day) == "number" and day > 0 then return math.floor(day) end

    return 1
end

local function afkPump()
    if AFK.wantShow then
        AFK.wantShow = false
        if AFK.gui then AFK.gui.Enabled = true end
        afkEnterLowPower()
    end
    if AFK.wantHide then
        AFK.wantHide = false
        if AFK.gui then AFK.gui.Enabled = false end
        afkExitLowPower()
    end

    if not AFK.on then return end

    if AFK.wantSeed then
        AFK.wantSeed = false
        afkSeedLogs()
    end

    if AFK.logDirty then
        AFK.logDirty = false
        if #AFK.logsBuffer > 0 then
            afkPushLog(AFK.logsBuffer[#AFK.logsBuffer])
        end
    end

    local sec = math.floor(os.clock() - AFK.startAt)
    if sec == AFK.lastSec then return end
    AFK.lastSec = sec

    local diamonds = LocalPlayer:GetAttribute("Diamonds") or 0
    if AFK.stat.diamonds then AFK.stat.diamonds.Text = formatNumber(diamonds) .. " Gems" end
    local dayVal = getGameDay()
    if AFK.stat.day then AFK.stat.day.Text = "วันที่ " .. tostring(dayVal) .. " / 100" end
    if AFK.stat.status then AFK.stat.status.Text = AFK.latestStatus or "กำลังทำงาน..." end
    if AFK.stat.time then AFK.stat.time.Text = afkClock(sec) end

    pcall(function()
        if AFK.telemetry.ping then
            local pingVal = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            AFK.telemetry.ping.Text = "📡 Ping: " .. tostring(pingVal) .. " ms"
        end

        local hungerVal = LocalPlayer:GetAttribute("Hunger")
        if not hungerVal and LocalPlayer.Character then
            hungerVal = LocalPlayer.Character:GetAttribute("Hunger")
        end
        if AFK.telemetry.hunger then
            AFK.telemetry.hunger.Text = hungerVal and string.format("🍔 ความหิว: %d / 200", math.floor(hungerVal)) or "🍔 ความหิว: สมบูรณ์"
        end

        local toolName = "ไม่มี"
        if LocalPlayer.Character then
            local tool = LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
            if tool then toolName = tool.Name end
        end
        if toolName == "ไม่มี" and LocalPlayer:FindFirstChild("Backpack") then
            local bpTool = LocalPlayer.Backpack:FindFirstChildWhichIsA("Tool")
            if bpTool then toolName = bpTool.Name .. " (ในเป้)" end
        end
        if AFK.telemetry.axe then
            AFK.telemetry.axe.Text = "🪓 ขวานที่ใช้: " .. toolName
        end

        local camp = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Campground")
        local wood = camp and camp:GetAttribute("TotalWood") or 0
        local maxWood = camp and camp:GetAttribute("MaxWood") or 50
        if AFK.telemetry.wood then AFK.telemetry.wood.Text = string.format("🪵 ไม้สะสม: %d / %d", wood, maxWood) end

        local scrap = camp and camp:GetAttribute("TotalScrap") or 0
        local maxScrap = camp and camp:GetAttribute("MaxScrap") or 26
        if AFK.telemetry.scrap then AFK.telemetry.scrap.Text = string.format("🔩 เศษเหล็ก: %d / %d", scrap, maxScrap) end

        local fireLvl = (typeof(getCurrentLevel) == "function" and getCurrentLevel()) or 1
        if AFK.telemetry.fire then AFK.telemetry.fire.Text = string.format("🔥 กองไฟ: Level %d", fireLvl) end

        local shTime = (typeof(getStrongholdTimeRemaining) == "function" and getStrongholdTimeRemaining())
        if AFK.telemetry.stronghold then
            AFK.telemetry.stronghold.Text = shTime and string.format("🏰 ป้อมปราการ: %02d:%02d", math.floor(shTime/60), shTime%60) or "🏰 ป้อมปราการ: รอป้อมเปิด..."
        end
    end)
end

