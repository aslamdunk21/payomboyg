    while not bp and waited < 5 do
        bp = findBlueprint(bedName)
        task.wait(0.2)
        waited += 0.2
    end

    if bp then
        local placed = false
        local attempts = 0
        while not placed do
            attempts += 1
            Client.InventoryHandler.RequestEquipItem(bp)
