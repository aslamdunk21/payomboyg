        {Vector3.new(SHIELD_SIZE, t, SHIELD_SIZE), Vector3.new(0, -half, 0)},
        {Vector3.new(t, SHIELD_SIZE, SHIELD_SIZE), Vector3.new( half, 0, 0)},
        {Vector3.new(t, SHIELD_SIZE, SHIELD_SIZE), Vector3.new(-half, 0, 0)},
        {Vector3.new(SHIELD_SIZE, SHIELD_SIZE, t), Vector3.new(0, 0,  half)},
        {Vector3.new(SHIELD_SIZE, SHIELD_SIZE, t), Vector3.new(0, 0, -half)},
    }

    for i, f in ipairs(faces) do
        local p = Instance.new("Part")
        p.Name = "Face" .. i
        p.Size = f[1]
        p.Anchored = true
        p.CanCollide = (f[2].Y == 0)
        p.CanQuery = true
        p.CanTouch = false
        p.Transparency = 1
        p.Massless = true
        p.Material = Enum.Material.SmoothPlastic
        p.Parent = shieldFolder
        table.insert(shieldParts, {part = p, offset = f[2]})
    end

    shieldFolder.Parent = workspace
end

