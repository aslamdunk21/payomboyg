local function retryUntil(label, fn, interval)
    interval = interval or 0.5
    local attempt = 0
    while true do
        attempt = attempt + 1
        local ok, result = pcall(fn)
        if ok and result then
            return result
        end
        if not ok then
            warn(("  [WARN] %s เกิดข้อผิดพลาดในครั้งที่ %d: %s"):format(label, attempt, tostring(result)))
        end
        pcall(updateStatus, ("%s... (%d)"):format(label, attempt))
        task.wait(interval)
    end
end

