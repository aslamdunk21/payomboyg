-- 5.1 RACE AUTO-REROLL ENGINE (ระบบรีเผ่า)
-- ════════════════════════════════════════════════════
local KNOWN_RACES = {
    "Demon",
    "Lucifer",
    "Night Elf",
    "Angel",
    "Vampire",
    "Fairy",
    "Sorcerer",
    "Dragonkin",
    "Undead",
    "Goblin",
    "Orc",
    "Human",
}

local function detectCurrentRace()
    local foundRace = nil

    -- 1. Check DataUtil safely (Parse string and table fields for known races)
    pcall(function()
        if DataUtil then
            local pd = DataUtil:GetPlayerData(player)
            if pd then
                local raceVal = pd.Race or pd.CurrentRace or pd.RaceData
                local candidates = {}
                if type(raceVal) == "string" then
                    table.insert(candidates, raceVal)
                elseif type(raceVal) == "table" then
                    if raceVal.ID then table.insert(candidates, tostring(raceVal.ID)) end
                    if raceVal.Name then table.insert(candidates, tostring(raceVal.Name)) end
                    if raceVal.Race then table.insert(candidates, tostring(raceVal.Race)) end
                    if raceVal.Type then table.insert(candidates, tostring(raceVal.Type)) end
                    for k, v in pairs(raceVal) do
                        if type(v) == "string" then table.insert(candidates, v) end
                    end
                end

                for _, str in ipairs(candidates) do
                    for _, r in ipairs(KNOWN_RACES) do
                        if string.find(str, r) then
                            foundRace = r
                            return
                        end
                    end
                end
            end
        end
    end)
    if foundRace then return foundRace end

    -- 2. Check Player attributes & Value instances
    pcall(function()
        local rAttr = player:GetAttribute("Race") or player:GetAttribute("CurrentRace")
        if rAttr then
            local str = tostring(rAttr)
            for _, r in ipairs(KNOWN_RACES) do
                if string.find(str, r) then foundRace = r return end
            end
        end
        local rVal = player:FindFirstChild("Race") or player:FindFirstChild("RaceValue")
        if rVal and rVal:IsA("StringValue") then
            local str = tostring(rVal.Value)
            for _, r in ipairs(KNOWN_RACES) do
                if string.find(str, r) then foundRace = r return end
            end
        end
    end)
    if foundRace then return foundRace end

    -- 3. Scan Character Head Overhead GUI (Detects "Scholar ★1 Orc" or "Orc" on head)
    pcall(function()
        local char = player.Character
        if char then
            local head = char:FindFirstChild("Head")
            if head then
                for _, desc in ipairs(head:GetDescendants()) do
                    if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                        local txt = desc.Text or ""
                        for _, rName in ipairs(KNOWN_RACES) do
                            if string.find(txt, rName) then
                                foundRace = rName
                                return
                            end
                        end
                    end
                end
            end
        end
    end)
    if foundRace then return foundRace end

    -- 4. Scan PlayerGui (MainGui, ScreenBackpack, RaceSpin, ScreenRace, etc.)
    pcall(function()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        if pg then
            local containers = {
                pg:FindFirstChild("MainGui"),
                pg:FindFirstChild("MainGuiIgnoreGuiInset"),
                pg:FindFirstChild("ScreenRace")
            }
            for _, parentObj in ipairs(containers) do
                if parentObj then
                    for _, desc in ipairs(parentObj:GetDescendants()) do
                        if desc:IsA("TextLabel") and desc.Text and desc.Text ~= "" then
                            local txt = desc.Text
                            for _, rName in ipairs(KNOWN_RACES) do
                                if string.find(txt, rName) then
                                    foundRace = rName
                                    return
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    return foundRace or "Unknown"
end

