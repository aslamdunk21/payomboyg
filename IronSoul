local StateObserver = {}

function StateObserver.GetPlayerState()
    local char = player and player.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")

    local gold = 0
    local lv   = 1
    local pwr  = 0
    local pts  = 0
    local race = "Unknown"
    local weap = "None"

    if DataUtil then
        pcall(function()
            local pd = DataUtil:GetPlayerData(player)
            if pd then
                gold = tonumber(pd.Gold or pd.Currency or 0) or 0
                lv   = tonumber(pd.Level or 1) or 1
                pts  = tonumber(pd.AttributePoints or pd.UnusedPoints or pd.StatPoints or 0) or 0
                if pd.Race then race = tostring(pd.Race) end
                if pd.Equipment and pd.Equipment.Equipped then
                    local w = pd.Equipment.Equipped.Weapon or pd.Equipment.Equipped[1]
                    if w then weap = tostring(w) end
                end
            end
        end)
    end

    pcall(function()
        local ls = player:FindFirstChild("leaderstats")
        if ls then
            local gObj = ls:FindFirstChild("Gold") or ls:FindFirstChild("Coins")
            if gObj and gold == 0 then gold = tonumber(gObj.Value) or 0 end
        end
        pwr = tonumber(player:GetAttribute("LG_PowerNew1") or player:GetAttribute("LG_Power") or 0) or 0
    end)

    return {
        Character = char,
        HRP       = hrp,
        Position  = hrp and hrp.Position or Vector3.zero,
        CFrame    = hrp and hrp.CFrame or CFrame.new(),
        HP        = hum and hum.Health or 0,
        MaxHP     = hum and hum.MaxHealth or 100,
        Level     = lv,
        Power     = pwr,
        Gold      = gold,
        Points    = pts,
        Race      = race,
        Weapon    = weap,
    }
end

function StateObserver.GetWorldState()
    local pg = player and player:FindFirstChildOfClass("PlayerGui")
    local inSettlement = false
    local inBattle = false

    if pg then
        -- Multi-signal Settlement detection in src_irs.txt
        local sGui = pg:FindFirstChild("ScreenSettlement") or pg:FindFirstChild("Settlement") or pg:FindFirstChild("ResultGui")
        if sGui then
            if sGui:IsA("ScreenGui") and sGui.Enabled then
                inSettlement = true
            elseif sGui:IsA("GuiObject") and sGui.Visible then
                inSettlement = true
            end
        end
        if not inSettlement then
            for _, child in ipairs(pg:GetDescendants()) do
                if (child:IsA("TextButton") or child:IsA("ImageButton")) and child.Visible then
