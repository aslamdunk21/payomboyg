    LastCheckReason = "All requirements satisfied"
}

function DungeonManager.PreDungeonCheck()
    local pState = StateObserver.GetPlayerState()

    -- 1. Check HP
    if pState.HP <= 0 or (pState.HP / math.max(1, pState.MaxHP)) < 0.3 then
        DungeonManager.LastCheckStatus = "🔴 NOT READY"
        DungeonManager.LastCheckReason = "Low HP / Character Dead"
        return false, DungeonManager.LastCheckReason
    end

    -- 2. Check Equipment
    if pState.Weapon == "None" and Config.AutoSelectBest then
        pcall(EquipBestAll)
    end

    -- 3. Auto Sell if inventory high
    if Config.AutoSell then
        pcall(ExecuteSellNow)
    end

    -- 4. Check Gold reserve
    if pState.Gold < (Config.MinGoldReserve or 0) then
        DungeonManager.LastCheckStatus = "⚠️ WARNING"
        DungeonManager.LastCheckReason = "Gold below reserve limit"
    else
        DungeonManager.LastCheckStatus = "🟢 READY FOR RUN"
        DungeonManager.LastCheckReason = "All pre-checks passed"
    end

    return true, DungeonManager.LastCheckReason
end

function DungeonManager.StartRun(worldId, diffNum, partySize)
    local ready, reason = DungeonManager.PreDungeonCheck()
    if not ready then
        warn("[DungeonManager] Pre-check failed: " .. tostring(reason))
        return false, reason
    end
    return StartDungeonRun(worldId, diffNum, partySize)
end

