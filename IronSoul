-- 5.5 TASK PRIORITY HIERARCHY & CHICKEN BRAIN AUTONOMOUS ENGINE
-- P0: Emergency (Dead / Stuck / GUI Frozen)
-- P1: Required (Active Quest / Dungeon Transition / Claim Reward)
-- P2: Progression (Equipment / Skills / Attribute Upgrades)
-- P3: Economy (Sell Items / Shop / Weapon Forge)
-- P4: Optional (Daily Claims / Bonus Cards / Race Reroll)
-- ════════════════════════════════════════════════════

local TaskPriority = {
    P0_EMERGENCY   = 0,
    P1_REQUIRED    = 1,
    P2_PROGRESSION = 2,
    P3_ECONOMY     = 3,
    P4_OPTIONAL    = 4,
}

local GamePlanner = {
    _lastPlanTime = 0,
    _currentPlan = nil,
}

function GamePlanner.EvaluateAndPlan()
    local level  = tonumber(PlayerState.GetLevel()) or 1
    local power  = tonumber(PlayerState.GetPower()) or 0
    local points = tonumber(PlayerState.GetAttributePoints()) or 0
    local gold   = tonumber(PlayerState.GetGold()) or 0

    -- P0 — Emergency Check (Dead / Character Missing / System Stuck)
    local char = player and player.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then
        return { Priority = TaskPriority.P0_EMERGENCY, Name = "P0_DEAD_RECOVERY", Reason = "ตัวละครตาย - กำลังรอเกิดและวาร์ปกลับเมือง" }
    end
    if State._failedRecoveryCycles and State._failedRecoveryCycles >= 3 then
        return { Priority = TaskPriority.P0_EMERGENCY, Name = "P0_STUCK_RECOVERY", Reason = "พบระบบติดขัดเกิน 3 ครั้ง - บังคับวาร์ปเข้าเมือง" }
    end

    -- P1 — Required Tasks (Dungeon Transition)
    if Config.AutoEnterDungeon and (State.Phase == "LOBBY" or State.Phase == "Lobby") then
        local rec = IronSoulKnowledgeMap.GetRecommendedWorld(level)
        local targetWorld = Config.SelectedWorldId or rec.RecommendedWorld
        local targetDiff  = Config.SelectedDifficultyNum or rec.RecommendedDiff
        return {
            Priority = TaskPriority.P1_REQUIRED,
            Name = "START_DUNGEON",
            World = targetWorld,
            Diff = targetDiff,
            Reason = "เข้าดันเจี้ยนตาม Progression เลเวล " .. tostring(level) .. " (" .. rec.Name .. ")"
        }
    end

    -- P2 — Progression Tasks (Attributes / Equipment)
    if points > 0 and Config.AutoUpgradeAttribute then
        return { Priority = TaskPriority.P2_PROGRESSION, Name = "UPGRADE_ATTRIBUTES", Reason = "มีแต้มสเตตัสคงเหลือ " .. tostring(points) .. " แต้ม" }
    end
    if Config.AutoSelectBest then
        return { Priority = TaskPriority.P2_PROGRESSION, Name = "EQUIP_BEST", Reason = "สวมใส่อุปกรณ์ที่ดีที่สุดเพื่อเพิ่มพลังต่อสู้" }
    end

    -- P3 — Economy Tasks (Sell Items)
    if Config.AutoSell then
        return { Priority = TaskPriority.P3_ECONOMY, Name = "SELL_ITEMS", Reason = "ขายไอเทมขยะเพื่อเคลียร์กระเป๋า" }
    end

    -- P4 — Optional Tasks (Daily Claim)
    if Config.AutoClaimDaily then
        return { Priority = TaskPriority.P4_OPTIONAL, Name = "CLAIM_DAILY", Reason = "รับรางวัลเช็คอินประจำวัน" }
    end

    return { Priority = 99, Name = "IDLE", Reason = "สแตนด์บายรอรอบการทำงานถัดไป" }
end

function GamePlanner.ExecuteNextStep()
    if State.Phase ~= "LOBBY" and State.Phase ~= "Lobby" then return end

    local plan = GamePlanner.EvaluateAndPlan()
    GamePlanner._currentPlan = plan

    if plan.Name == "UPGRADE_ATTRIBUTES" then
        ActionEngine.Execute("Plan_UpgradeAttr", nil, 5, 2, function()
            UpgradeAttribute(Config.AttrPreset)
            return true
        end)
    elseif plan.Name == "EQUIP_BEST" then
        ActionEngine.Execute("Plan_EquipBest", nil, 15, 3, function()
            EquipBestAll()
            return true
        end)
    elseif plan.Name == "CLAIM_DAILY" then
        ActionEngine.Execute("Plan_ClaimDaily", nil, 15, 3, function()
            ViewDailyActivity()
            task.wait(0.3)
            for _, rid in ipairs(DailyRewardIds) do ClaimDailyReward(rid) end
            return true
        end)
    elseif plan.Name == "FORGE_WEAPON" then
        NPCEngine.Interact("Furnace", FORGE_PORTAL_CF, "ScreenForge", function()
            DropForgeOres({ Sandstone = 4 }, "Weapon")
            task.wait(0.5)
            TriggerForgePerfectQTE()
            task.wait(0.3)
            ConfirmForgeResult(true)
        end)
    elseif plan.Name == "SELL_ITEMS" then
        ActionEngine.Execute("Plan_SellItems", nil, 20, 4, function()
            if ExecuteSellNow then ExecuteSellNow() end
            return true
        end)
    elseif plan.Name == "START_DUNGEON" then
        StartDungeonRun(plan.World, plan.Diff, Config.SelectedPartySizeNum or 1)
    end
end

