-- PHASE 0 & 1.3 — ACTION ENGINE (Full Lifecycle Manager)
-- IDLE -> START -> RESOLVE -> EXECUTE -> VERIFY -> SUCCESS/RETRY/RECOVER
-- ════════════════════════════════════════════════════
local ActionEngine = {
    CurrentLifecycle = "IDLE",
    CurrentAction = "None",
    ActionLogs = {},
    _history = {}
}

function ActionEngine.AddLog(actionName, stage, detail)
    local timeStr = os.date("%H:%M:%S")
    local entry = string.format("[%s] [%s] %s: %s", timeStr, stage, actionName, detail or "")
    table.insert(ActionEngine.ActionLogs, 1, entry)
    if #ActionEngine.ActionLogs > 40 then table.remove(ActionEngine.ActionLogs, #ActionEngine.ActionLogs) end
    print("⚡ [ActionEngine] " .. entry)
end

function ActionEngine.ExecuteAction(config)
    local name      = config.Name or "UnknownAction"
    local preFn     = config.Preconditions
    local execFn    = config.Execute
    local verFn     = config.Verify
    local timeout   = config.Timeout or 4
    local retries   = config.Retry or 2
    local recFn     = config.Recovery
    local cooldown  = config.Cooldown or 0.5

    ActionEngine.CurrentAction = name
    ActionEngine.CurrentLifecycle = "START"
    ActionEngine.AddLog(name, "START", "Initiating action sequence")

    -- 1. Preconditions check
    if type(preFn) == "function" then
        ActionEngine.CurrentLifecycle = "RESOLVE"
        local preOk, preResult = pcall(preFn)
        if not preOk or preResult == false then
            ActionEngine.CurrentLifecycle = "FAILED"
            ActionEngine.AddLog(name, "FAILED", "Precondition check failed")
            return false, "Preconditions failed"
        end
    end

    -- 2. Execute & Verify Loop with Retry & Recovery
    for attempt = 1, (retries + 1) do
        ActionEngine.CurrentLifecycle = "EXECUTE"
        ActionEngine.AddLog(name, "EXECUTE", string.format("Attempt #%d", attempt))

        local execOk, execErr = pcall(execFn)
        if not execOk then
            ActionEngine.AddLog(name, "WARN", "Execution error: " .. tostring(execErr))
        end

        task.wait(cooldown)

        -- 3. Verify stage
        ActionEngine.CurrentLifecycle = "VERIFY"
        local verified = false
        if type(verFn) == "function" then
            verified = waitUntil(function() return verFn() == true end, timeout, 0.2)
        else
            verified = execOk
        end

        if verified then
            ActionEngine.CurrentLifecycle = "SUCCESS"
            ActionEngine.AddLog(name, "SUCCESS", string.format("Verified on attempt #%d", attempt))
            ActionEngine._history[name] = tick()
            task.wait(0.1)
            ActionEngine.CurrentLifecycle = "IDLE"
            return true, "Success"
        end

        -- Recovery before retry
        if attempt <= retries then
            ActionEngine.CurrentLifecycle = "RETRY"
            ActionEngine.AddLog(name, "RETRY", string.format("Verification failed, executing recovery #%d", attempt))
            if type(recFn) == "function" then pcall(recFn) end
            task.wait(0.3)
        end
    end

    ActionEngine.CurrentLifecycle = "FAILED"
    ActionEngine.AddLog(name, "FAILED", "All execution attempts failed")
    task.wait(0.1)
    ActionEngine.CurrentLifecycle = "IDLE"
    return false, "Failed after retries"
end

