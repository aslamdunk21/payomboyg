local _isRollingRace = false
local function startAutoRaceRerollLoop()
    if _isRollingRace then return end
    _isRollingRace = true
    task.spawn(function()
        while Config.AutoRaceReroll and not State.Unloaded do
            local currentRace = detectCurrentRace()
            
            -- Check if current race matches selected target races
            local isTarget = false
            for _, target in ipairs(Config.SelectedTargetRaces or {}) do
                if target == currentRace or string.find(currentRace, target) then
                    isTarget = true
                    break
                end
            end

            if isTarget and currentRace ~= "Unknown" then
                Config.AutoRaceReroll = false
                saveSettings()
                ObsidianGlassEngine:Notify({
                    Title = "🎉 ได้รับเผ่าเป้าหมายแล้ว!",
                    Content = "สุ่มได้เผ่า " .. tostring(currentRace) .. " ตรงตามเป้าหมาย! หยุดระบบรีเผ่าอัตโนมัติเรียบร้อย",
                    Duration = 8
                })
                break
            end

            -- Roll Race 1 time
            RollRaceOnce()

            local newRace = detectCurrentRace()
            print("[PayomboyZ HUB] สุ่มได้เผ่า: " .. tostring(newRace))
            task.wait(0.5)
        end
        _isRollingRace = false
    end)
end

