                _questState.phase = "executing"
            else
                _questState.phase = "cooldown"
                AddQuestLog("No pending quests. Entering Cooldown.")
            end

        elseif _questState.phase == "executing" then
            _questState.currentIdx = _questState.currentIdx + 1
            local quest = _questState.pendingQuests[_questState.currentIdx]

            if quest then
                _questState.telemetry.Name = quest.Id or "DailyQuest"
                _questState.telemetry.Progress = string.format("%d / %d", quest.Progress or 0, quest.Target or 1)
