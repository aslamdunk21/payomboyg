-- per-settlement session handled state
-- reset ทุกครั้งที่ Settlement ใหม่เริ่มต้น (ผ่าน setPhase)
local _resultHandled = false  -- ทำ action ไปแล้วใน session นี้
local _bonusCardHandled = false -- เลือก bonus card ไปแล้วใน session นี้

-- ห่อ setPhase เพื่อ reset handled flags เมื่อเข้า Settlement ใหม่
local _origSetPhase = setPhase
setPhase = function(newPhase)
    if newPhase == "Settlement" and State.Phase ~= "Settlement" then
        _resultHandled   = false
        _bonusCardHandled = false
    end
    _origSetPhase(newPhase)
end

task.spawn(function()
    while task.wait(1) do
        if State.Unloaded then break end

        -- อัปเดต Phase จาก GUI ทุก tick
        detectPhaseFromGUI()

        -- Phase timeout recovery
        local timeout = PHASE_TIMEOUT[State.Phase]
        if timeout and phaseAge() > timeout then
            print(string.format("[PayomboyZ IRS] Phase '%s' timeout → Recovering", State.Phase))
            setPhase("Recovering")
        end

        if State.Phase == "Recovering" then
            State._lastRoomTime = 0
            setPhase("Lobby")
        end

        local gamePlayerRE = getRemote("ReplicatedStorage.Remotes.GamePlayerRE")
        local gameRoundRE  = getRemote("ReplicatedStorage.Remotes.GameRoundRE")
        local lobbyRE      = getRemote("ReplicatedStorage.Framework.Gameplay.WorldPlace.LobbyLocationUtil.RemoteEvent")

        -- ── DEAD / REVIVE ──
        if State.Phase == "Dead" then
            pcall(function()
                if gamePlayerRE then gamePlayerRE:FireServer("ExitSettlement") end
            end)
        end

        -- ── SETTLEMENT ── MarkHandled pattern
        if State.Phase == "Settlement" or State.Phase == "SETTLEMENT" then
            -- Record end of run evaluation
            if not _resultHandled then
                RunEvaluator.EndRun(true)
            end

            -- #5 FIX: BonusCard — fire ครั้งเดียวต่อ settlement session
            -- ตรวจว่า card frame มีอยู่จริงก่อนยิง
            if Config.AutoBonusCard and not _bonusCardHandled then
                pcall(function()
                    local pg = player and player:FindFirstChildOfClass("PlayerGui")
                    local resultGui = pg and pg:FindFirstChild("ResultGui")
                    if not resultGui then return end
                    -- ตรวจ BonusCard frame เปิดอยู่ไหม
                    local bonusFrame = resultGui:FindFirstChild("BonusCardFrame", true)
                        or resultGui:FindFirstChild("ScreenBonusCard", true)
                        or resultGui:FindFirstChild("BonusCard", true)
                    -- ถ้าเจอ frame หรือ settlement visible → ลองยิง
                    local settlement = resultGui:FindFirstChild("ScreenSettlement")
                    if (bonusFrame and (bonusFrame.Visible or (bonusFrame:IsA("ScreenGui") and bonusFrame.Enabled)))
                        or (settlement and settlement.Visible) then
                        local bonusRE = getRemote("ReplicatedStorage.Framework.Gameplay.WorldPlace.WorldBonusCardUtil.RemoteEvent")
                        if bonusRE then
                            bonusRE:FireServer("SelectCard", 1)
                            _bonusCardHandled = true
                        end
                    end
                end)
            end

            -- #4 FIX: AfterRun action — fire ครั้งเดียวต่อ settlement session
            if not _resultHandled then
                local mode = Config.AfterRunMode or "Stop"

                if mode == "PlayAgain" then
                    pcall(function()
                        local taskRE = getRemote("ReplicatedStorage.Framework.Features.TaskSystem.TaskRE")
                        if taskRE then taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", "ScreenSettlement") end
                        if gameRoundRE then
                            gameRoundRE:FireServer("VotePlayAgain")
                            _resultHandled = true  -- MarkHandled
                        end
                    end)
                    -- VerifyAction: รอ settlement หายไป (max 12 วิ) แล้ว transition
                    task.spawn(function()
                        local ok = waitUntil(function()
                            local pg = player and player:FindFirstChildOfClass("PlayerGui")
                            local rg = pg and pg:FindFirstChild("ResultGui")
                            local s  = rg and rg:FindFirstChild("ScreenSettlement")
                            return not (s and s.Visible)
                        end, 12, 0.5)
                        if ok then
                            State._lastRoomTime = 0
                            setPhase("Lobby")
                        end
                    end)

                elseif mode == "ReturnToLobby" then
                    pcall(function()
                        if lobbyRE then
                            lobbyRE:FireServer("ReturnToLobby")
                        elseif gamePlayerRE then
                            gamePlayerRE:FireServer("ExitSettlement")
                        end
                        _resultHandled = true  -- MarkHandled
                    end)
                    State._lastRoomTime = 0
                    setPhase("Lobby")

                elseif mode == "Stop" then
                    _resultHandled = true  -- MarkHandled — ไม่ทำอะไร
                    -- รอ settlement หายไปเองแล้ว transition
                    task.spawn(function()
                        waitUntil(function()
                            local pg = player and player:FindFirstChildOfClass("PlayerGui")
                            local rg = pg and pg:FindFirstChild("ResultGui")
                            local s  = rg and rg:FindFirstChild("ScreenSettlement")
                            return not (s and s.Visible)
                        end, 60, 1)
                        if State.Phase == "Settlement" then
                            setPhase("Lobby")
                        end
                    end)
                end
            end
        end
    end
end)

