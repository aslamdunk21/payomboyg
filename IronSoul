local function ExecuteSellNow()
    local MaterialRE = getRemote("ReplicatedStorage.Framework.Gameplay.EquipmentSystem.MaterialUtil.RemoteEvent")
    local ForgeRF    = getRemote("ReplicatedStorage.Framework.Gameplay.EquipmentSystem.ForgeRF")
    local EquipRE    = getRemote("ReplicatedStorage.Framework.Gameplay.EquipmentSystem.EquipmentRE")
    local totalSold  = 0

    local equippedUUIDs = {}
    pcall(function()
        if DataUtil then
            local pd = DataUtil:GetPlayerData(player)
            if pd and pd.Equipment and pd.Equipment.Equipped then
                for k, v in pairs(pd.Equipment.Equipped) do
                    if type(v) == "string" then equippedUUIDs[v] = true end
                    if type(v) == "table" and v.UUID then equippedUUIDs[v.UUID] = true end
                end
            end
        end
    end)

    if Config.Crystals_Value and type(Config.Crystals_Value) == "table" and #Config.Crystals_Value > 0 and MaterialRE then
        local crystalLoop = {}
        for _, v in pairs(GetCrystals()) do
            if table.find(Config.Crystals_Value, v.Rarity) then
                local sellable = math.max(0, (v.Amount or 0) - (Config.KeepMinCrystals or 5))
                if sellable > 0 then
                    crystalLoop[v.ID] = sellable
                    totalSold = totalSold + sellable
                end
            end
        end
        if next(crystalLoop) then MaterialRE:FireServer("Sell", crystalLoop, {}) end
    end

    if Config.Ores_Value and type(Config.Ores_Value) == "table" and #Config.Ores_Value > 0 and ForgeRF then
        local oresLoop = {}
        for _, v in pairs(GetOresWithNames()) do
            if table.find(Config.Ores_Value, v.Rarity) then
                local sellable = math.max(0, (v.Amount or 0) - (Config.KeepMinOres or 4))
                if sellable > 0 then
                    oresLoop[v.ID] = sellable
                    totalSold = totalSold + sellable
                end
            end
        end
        if next(oresLoop) then ForgeRF:InvokeServer("Sell", oresLoop) end
    end

    if Config.Equipment_Value and type(Config.Equipment_Value) == "table" and #Config.Equipment_Value > 0 and DataUtil and EquipRE then
        local owned = {}
        pcall(function() owned = DataUtil:GetPlayerData(player).Equipment.Owned end)
        for _, v in pairs(owned or {}) do
            if table.find(Config.Equipment_Value, v.ID) and not equippedUUIDs[v.UUID] then
                EquipRE:FireServer("Sell", { v.UUID })
                totalSold = totalSold + 1
            end
        end
    end

    return totalSold
end

