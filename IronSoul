-- #15: Sequential NPC Interaction Pipeline (Try Prompt -> Verify -> Try Click -> Verify -> Try Key E)
local function triggerNPCInteraction(targetCF)
    safeCall("triggerNPCInteraction", function()
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not targetCF then return end

        local verified = false

        -- Step 1: Scan & Try ProximityPrompt
        if workspace.OverlapParams then
            local params = OverlapParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            if char then params.FilterDescendantsInstances = { char } end
            local parts = workspace:GetPartBoundsInBox(targetCF, Vector3.new(25, 25, 25), params)

            for _, p in ipairs(parts) do
                local prompt = p:FindFirstChildWhichIsA("ProximityPrompt", true)
                    or (p.Parent and p.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
                if prompt then
                    if type(fireproximityprompt) == "function" then
                        fireproximityprompt(prompt, 0)
                        task.wait(0.02)
                        fireproximityprompt(prompt)
                    else
                        pcall(function() prompt:InputHoldBegin() task.wait(0.05) prompt:InputHoldEnd() end)
                    end
                    -- Verify if dialog or window opened
                    verified = waitUntil(function()
                        local pg = player and player:FindFirstChildOfClass("PlayerGui")
                        return pg and (pg:FindFirstChild("DialogNpc", true) or pg:FindFirstChild("DialogGui", true)) ~= nil
                    end, 0.8, 0.1)
                    if verified then return end
                end
            end

            -- Step 2: Try ClickDetector if ProximityPrompt didn't open dialog
            for _, p in ipairs(parts) do
                local cd = p:FindFirstChildWhichIsA("ClickDetector", true)
                if cd and type(fireclickdetector) == "function" then
                    fireclickdetector(cd)
                    verified = waitUntil(function()
                        local pg = player and player:FindFirstChildOfClass("PlayerGui")
                        return pg and (pg:FindFirstChild("DialogNpc", true) or pg:FindFirstChild("DialogGui", true)) ~= nil
                    end, 0.8, 0.1)
                    if verified then return end
                end
            end
        end

        -- Step 3: Fallback to VirtualInputManager 'E' only if previous methods didn't trigger dialog
        if not verified then
            pcall(function()
                local vim = game:GetService("VirtualInputManager")
                if vim then
                    vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                    task.wait(0.05)
                    vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                end
            end)
        end
    end)
end

