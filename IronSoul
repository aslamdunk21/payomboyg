local SkillCooldownConfig = { Q = 0.70, E = 0.70, R = 1.50 }

local function getController()
    if controller and typeof(controller) == "table" and type(controller.PerformAction) == "function" then
        return controller
    end
    pcall(function()
        local char = player.Character or character
        if not char then return end
        local mgr = char:FindFirstChild("LocalControlMgr") or char:WaitForChild("LocalControlMgr", 3)
        if not mgr then return end
        local actFolder = mgr:FindFirstChild("Action")
        local actMods = {}
        if actFolder then
            for _, m in ipairs(actFolder:GetChildren()) do
                if m:IsA("ModuleScript") then
                    pcall(function() actMods[m.Name] = require(m) end)
                end
            end
        end
        if mgr:FindFirstChild("Controller") then
            local CtrlClass = require(mgr.Controller)
            controller = CtrlClass.new(char, actMods)
        end
    end)
    return controller
end

local function activateTool()
    if not State.Character then return nil end
    local tool = State.Character:FindFirstChildOfClass("Tool")
    if not tool then
        local bp = player:FindFirstChild("Backpack")
        if bp then
            tool = bp:FindFirstChildOfClass("Tool")
            if tool and State.Humanoid then
                pcall(function() State.Humanoid:EquipTool(tool) end)
            end
        end
    end
    if tool then
        pcall(function() tool:Activate() end)
    end
    return tool
end

local function FirePlayerAction(actionName, subParam)
    pcall(function()
        local actionRE = ReplicatedStorage:FindFirstChild("Remotes")
            and ReplicatedStorage.Remotes:FindFirstChild("PlayerActionRE")
        if actionRE then
            if subParam ~= nil then
                actionRE:FireServer("SkillAction", actionName, subParam)
            else
                actionRE:FireServer("SkillAction", actionName)
            end
        end
