-- getRemote — dot-path resolver (e.g. "ReplicatedStorage.Remotes.GameMatchRE")
-- Verified against live IRSRE.lua dump
-- ────────────────────────────────────────────────────
local _remoteCache = {}
local function getRemote(dotPath)
    if _remoteCache[dotPath] then return _remoteCache[dotPath] end
    local parts = dotPath:split(".")
    local cur = game
    for i, part in ipairs(parts) do
        if i == 1 then
            -- handle top-level services
            if part == "ReplicatedStorage"  then cur = ReplicatedStorage
            elseif part == "Workspace"      then cur = workspace
            elseif part == "Players"        then cur = Players
            else pcall(function() cur = game:GetService(part) end) end
        else
            if not cur then return nil end
            cur = cur:FindFirstChild(part)
        end
        if not cur then return nil end
    end
    _remoteCache[dotPath] = cur
    return cur
end

