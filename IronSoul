                    local t = child:IsA("TextButton") and string.lower(child.Text) or ""
                    if n:find("lobby") or n:find("again") or t:find("lobby") or t:find("again") then
                        inSettlement = true
                        break
                    end
                end
            end
        end

        local battleHUD = pg:FindFirstChild("BattleHUD")
        if battleHUD and battleHUD.Visible then inBattle = true end
    end

    local curPhase = inSettlement and "Settlement" or (inBattle and "InDungeon" or State.Phase)

