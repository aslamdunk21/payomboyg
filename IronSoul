-- SYSTEM LOGGING ENGINE FOR MONITOR #02 TERMINAL
-- ════════════════════════════════════════════════
_G.IronSoul_SystemLogs = _G.IronSoul_SystemLogs or {}
local function AddSystemLog(msg, category)
    local timeStr = os.date("%H:%M:%S")
    category = category or "INFO"
    local icon = "ℹ️ "
    if category == "QUEST" then icon = "📜 "
    elseif category == "DUNGEON" then icon = "⚔️ "
    elseif category == "SELL" then icon = "💵 "
    elseif category == "SUCCESS" then icon = "✅ "
    elseif category == "ERROR" or category == "WARN" then icon = "⚠️ "
    elseif category == "PLANNER" then icon = "🧠 "
    elseif category == "WATCHDOG" then icon = "🛡️ "
    end
    local entry = { Title = string.format("[%s] %s%s", timeStr, icon, tostring(msg)), Desc = string.format("CATEGORY: %s | TIMESTAMP: %s", category:upper(), timeStr) }
    table.insert(_G.IronSoul_SystemLogs, 1, entry)
    if #_G.IronSoul_SystemLogs > 30 then table.remove(_G.IronSoul_SystemLogs, #_G.IronSoul_SystemLogs) end
    print("🖥️ [SystemLog] " .. entry.Title)
end

