local KNOWN_RACES = {
    "Demon",
    "Lucifer",
    "Night Elf",
    "Angel",
    "Vampire",
    "Fairy",
    "Sorcerer",
    "Dragonkin",
    "Undead",
    "Goblin",
    "Orc",
    "Human",
}

local function detectCurrentRace()
    local foundRace = nil

    -- 1. Check DataUtil or Player attributes / values FIRST (Fastest, 0 lag)
    pcall(function()
        if DataUtil then
            local pd = DataUtil:GetPlayerData(player)
            if pd and pd.Race then
                local rName = tostring(pd.Race)
                for _, r in ipairs(KNOWN_RACES) do
                    if string.find(rName, r) then foundRace = r return end
                end
                foundRace = rName
                return
            end
        end
        local rAttr = player:GetAttribute("Race") or player:GetAttribute("CurrentRace")
        if rAttr then foundRace = tostring(rAttr) return end
        local rVal = player:FindFirstChild("Race") or player:FindFirstChild("RaceValue")
        if rVal and rVal:IsA("StringValue") then foundRace = rVal.Value return end
    end)
    if foundRace then return foundRace end

    -- 2. Scan Character Head Overhead GUI (Scanning Head descendants is 100% accurate for overhead title/race)
    pcall(function()
        local char = player.Character
        if char then
            local head = char:FindFirstChild("Head")
            if head then
                for _, desc in ipairs(head:GetDescendants()) do
                    if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                        local txt = desc.Text or ""
                        for _, rName in ipairs(KNOWN_RACES) do
                            if string.find(txt, rName) then
                                foundRace = rName
                                return
                            end
                        end
                    end
                end
            end
        end
    end)
    if foundRace then return foundRace end

    -- 3. Check PlayerGui for ScreenRace or HUD labels
    pcall(function()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        if pg then
            for _, gui in ipairs(pg:GetChildren()) do
                if gui:IsA("ScreenGui") or gui:IsA("Frame") then
                    for _, desc in ipairs(gui:GetDescendants()) do
                        if desc:IsA("TextLabel") and desc.Visible then
                            local txt = desc.Text or ""
                            for _, rName in ipairs(KNOWN_RACES) do
                                if string.find(txt, rName) then
                                    foundRace = rName
                                    return
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    return foundRace or "Unknown"
end

