                if Config.AutoDoQuestObjective then
                    AddQuestLog(string.format("Resolving Target: %s", quest.Param))
                    _executeQuest(quest)
                    task.wait(0.5)
                    _questState.telemetry.LastAction = "Quest Objective Executed"
                end

                -- #17 FIX: Verified Claiming — Verify progress before firing ClaimDailyQuest
                local verifiedDone = waitUntil(function()
                    local updatedQuests = _getRealServerQuests()
                    for _, q in ipairs(updatedQuests) do
                        if q.Id == quest.Id then return false end
                    end
                    return true
                end, 2, 0.3)

                if Config.AutoClaimQuestReward and (verifiedDone or quest.Id) and dailyRE then
                    _questState.telemetry.Status = "🎁 Claiming Reward"
                    AddQuestLog(string.format("Claiming Reward for Quest: %s", quest.Id))
                    pcall(function() dailyRE:FireServer("ClaimDailyQuest", quest.Id) end)
                    _questState.telemetry.LastAction = "Claimed Reward for " .. tostring(quest.Id)
                    AddQuestLog(string.format("✅ Quest %s Claimed Successfully!", quest.Id))
                end

                if Config.AutoReturnNPCQuest then
                    AddQuestLog("Returning to Town/NPC...")
                    TeleportToTown()
                end

                if not Config.AutoSwitchQuest then
                    _questState.phase = "cooldown"
                end
            else
                _questState.phase = "cooldown"
                _questState.telemetry.Status = "✅ All Quests Completed"
                _questState.telemetry.NextAction = "Entering Cooldown Loop"
                AddQuestLog("All available quests completed.")
                ObsidianGlassEngine:Notify({
                    Title = "Auto Quest",
                    Content = "ทำและรับรางวัลเควสประจำวันเสร็จเรียบร้อยแล้ว!",
                    Duration = 4
                })
            end

        elseif _questState.phase == "cooldown" then
            local remaining = math.max(0, math.floor(_questState.fetchCooldown - (now - _questState.lastFetch)))
            _questState.telemetry.Status = string.format("⏳ Cooldown (%ds)", remaining)
            _questState.telemetry.NextAction = "Waiting for next cycle"

            if Config.QuestLoopMode and (now - _questState.lastFetch) >= _questState.fetchCooldown then
                _questState.phase = "idle"
                AddQuestLog("Cooldown finished. Initiating Quest Loop.")
            end
        end
    end
end)

