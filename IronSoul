-- ════════════════════════════════════════════════════
-- NPC INTERACTION ENGINE (8-Step Verified Pipeline)
-- ════════════════════════════════════════════════════
local NPCEngine = {}

function NPCEngine.VerifyNearNPC(targetCF, maxDist)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetCF then return false end
    local dist = (hrp.Position - targetCF.Position).Magnitude
    return dist <= (maxDist or 15)
end

function NPCEngine.VerifyWindowOpened(guiName)
    local pg = player and player:FindFirstChildOfClass("PlayerGui")
    if not pg then return false end
    local mainContainer = pg:FindFirstChild("MainGuiIgnoreGuiInset") or pg
    local targetGui = mainContainer:FindFirstChild(guiName) or pg:FindFirstChild(guiName, true)
    return targetGui and (targetGui.Visible or (targetGui:IsA("ScreenGui") and targetGui.Enabled))
end

function NPCEngine.Interact(npcName, targetCF, guiName, actionFn)
    return safeCall("NPCEngine.Interact(" .. tostring(npcName) .. ")", function()
        -- 1. Resolve Position if CFrame is nil
        local resolvedCF = targetCF or LocationResolver.Resolve(npcName, nil)
        if not resolvedCF then
            warn("[NPCEngine] Failed to resolve position for NPC: " .. tostring(npcName))
            return false
        end

        -- 2. Clean up open windows first
        CloseAllNPCWindows()
        task.wait(0.08)

        -- 3. Teleport & Physics Nudge
        teleportWithPhysicsNudge(resolvedCF)
        task.wait(0.12)

        -- 4. Verify Position
        local isNear = NPCEngine.VerifyNearNPC(resolvedCF, 18)
        if not isNear then
            -- Fallback secondary nudge
            teleportWithPhysicsNudge(resolvedCF)
            task.wait(0.15)
        end

        -- 5. Trigger Physical / Zone Interaction
        triggerNPCInteraction(resolvedCF)

        -- 6. Server Handshake Fire
        if guiName then
            local taskRE = getRemote("ReplicatedStorage.Framework.Features.TaskSystem.TaskRE")
            if taskRE then taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", guiName) end
        end

        -- 7. Verify UI / Window Open
        local opened = false
        if guiName then
            opened = waitUntil(function()
                return NPCEngine.VerifyWindowOpened(guiName)
            end, 2.5, 0.15)

            if not opened then
                -- Force Fallback UI toggle
                local pg = player and player:FindFirstChildOfClass("PlayerGui")
                if pg then
                    local mainContainer = pg:FindFirstChild("MainGuiIgnoreGuiInset") or pg
                    local targetGui = mainContainer:FindFirstChild(guiName) or pg:FindFirstChild(guiName, true)
                    if targetGui then
                        if targetGui:IsA("ScreenGui") then targetGui.Enabled = true
                        elseif targetGui:IsA("GuiObject") then targetGui.Visible = true end
                        opened = true
                    end
                end
            end
        else
            opened = true
        end

        -- 8. Execute Action Callback if provided
        if opened and type(actionFn) == "function" then
            task.wait(0.1)
            actionFn()
        end

        return opened
    end)
end

