-- PHASE 4 — GAME PLANNER & CHICKEN BRAIN (Autonomous Priority Engine)
-- Loop Cycle: Observe → Plan → Execute → Verify → Recover
-- Priorities:
-- P0: Emergency Recovery (Stuck/Dead/Low HP)
-- P1: Quests (If QuestPriorityMode) / Active Dungeon
-- P2: Equipment & Attribute Progression
-- P3: Inventory & Economy (Auto Sell / Forge)
-- P4: Daily Rewards & Optional Activities
-- ════════════════════════════════════════════════════
local GamePlanner = {
    _currentPlan = { Priority = 99, Name = "IDLE", Reason = "STANDBY" }
}

function GamePlanner.EvaluatePlan()
    local pState = StateObserver.GetPlayerState()
    local wState = StateObserver.GetWorldState()

    -- P0: Emergency Check
    if pState.HP <= 0 or wState.CurrentPhase == "Dead" then
        return { Priority = 0, Name = "EMERGENCY_REVIVE", Action = "Revive", Reason = "Character is dead" }
    end

    local watchdogFails = State._failedRecoveryCycles or 0
    if watchdogFails > 2 then
        return { Priority = 0, Name = "EMERGENCY_RECOVER", Action = "ReturnTown", Reason = "Watchdog detected repeated failures" }
    end

    -- P1: In Dungeon or Settlement Processing
    if wState.InBattle or wState.CurrentPhase == "IN_DUNGEON" or wState.CurrentPhase == "COMBAT" then
        return { Priority = 1, Name = "DUNGEON_COMBAT", Action = "CombatLoop", Reason = "Currently in active dungeon" }
    end

    if wState.InSettlement or wState.CurrentPhase == "Settlement" then
        return { Priority = 1, Name = "DUNGEON_SETTLEMENT", Action = "ProcessSettlement", Reason = "Post-dungeon settlement screen active" }
    end

    -- P1: Quest Priority Mode
    if Config.AutoQuest and Config.QuestPriorityMode and _questState and #_questState.pendingQuests > 0 then
        return { Priority = 1, Name = "QUEST_ACTIVE", Action = "ExecuteQuest", Reason = "Quest priority enabled with pending objectives" }
    end

    -- P2: Character Progression (Attribute Points)
    if Config.AutoUpgradeAttribute and pState.Points > 0 then
        return { Priority = 2, Name = "UPGRADE_ATTRIBUTES", Action = "UpgradeAttr", Reason = "Unassigned attribute points available (" .. tostring(pState.Points) .. ")" }
    end

    -- P3: Economy & Inventory Management (Gold below reserve or AutoSell needed)
    if Config.AutoSell and pState.Gold < (Config.MinGoldReserve or 5000) then
        return { Priority = 3, Name = "ECONOMY_SELL", Action = "AutoSell", Reason = "Maintaining gold reserve via item sale" }
    end

    -- P4: Daily Rewards
    if Config.AutoClaimDaily and not State._dailyClaimedThisSession then
        return { Priority = 4, Name = "CLAIM_DAILY", Action = "ClaimDaily", Reason = "Daily login rewards pending claim" }
    end

    -- Default P1: Continuous Dungeon Farm
    if Config.AutoEnterDungeon then
        return { Priority = 1, Name = "ENTER_DUNGEON", Action = "StartDungeon", Reason = "Standard continuous dungeon farming queue" }
    end

    return { Priority = 99, Name = "IDLE", Action = "None", Reason = "No priority active — system in standby" }
end

local ChickenBrain = {
    CurrentStage = "OBSERVE",
    LastCycle = 0,
    CycleInterval = 2.0
}

function ChickenBrain.RunLoopCycle()
    if not Config.ChickenMode then return end
    if (tick() - ChickenBrain.LastCycle) < ChickenBrain.CycleInterval then return end
    ChickenBrain.LastCycle = tick()

    -- STAGE 1: OBSERVE
    ChickenBrain.CurrentStage = "OBSERVE"
    local pState = StateObserver.GetPlayerState()
    local wState = StateObserver.GetWorldState()

    -- STAGE 2: PLAN
    ChickenBrain.CurrentStage = "PLAN"
    local plan = GamePlanner.EvaluatePlan()
    GamePlanner._currentPlan = plan

    -- STAGE 3: EXECUTE
    ChickenBrain.CurrentStage = "EXECUTE"
    if plan.Action == "Revive" then
        ActionEngine.ExecuteAction({ Name = "Chicken_Revive", Execute = function() local re = getRemote(REMOTES.GamePlayerRE); if re then re:FireServer("ExitSettlement") end end })
    elseif plan.Action == "ReturnTown" then
        ActionEngine.ExecuteAction({ Name = "Chicken_ReturnTown", Execute = NavigationManager.ReturnTown })
    elseif plan.Action == "UpgradeAttr" then
        ActionEngine.ExecuteAction({ Name = "Chicken_UpgradeAttr", Execute = function() UpgradeAttribute(Config.AttrPreset) end })
    elseif plan.Action == "AutoSell" then
        ActionEngine.ExecuteAction({ Name = "Chicken_AutoSell", Execute = ExecuteSellNow })
    elseif plan.Action == "ClaimDaily" then
        ActionEngine.ExecuteAction({
            Name = "Chicken_ClaimDaily",
            Execute = function()
                ViewDailyActivity()
                task.wait(0.3)
                for _, rid in ipairs(DailyRewardIds) do ClaimDailyReward(rid); task.wait(0.2) end
                State._dailyClaimedThisSession = true
            end
        })
    elseif plan.Action == "StartDungeon" and (wState.CurrentPhase == "LOBBY" or wState.CurrentPhase == "Lobby") then
        DungeonManager.StartRun(Config.SelectedWorldId or "World1", Config.SelectedDifficultyNum or 1, Config.SelectedPartySizeNum or 4)
    end

    -- STAGE 4: VERIFY
    ChickenBrain.CurrentStage = "VERIFY"
    task.wait(0.1)

    -- STAGE 5: RECOVER
    ChickenBrain.CurrentStage = "RECOVER"
    task.wait(0.1)

    ChickenBrain.CurrentStage = "OBSERVE"
end

