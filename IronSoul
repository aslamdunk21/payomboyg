-- poll: ตรวจว่า ScreenMatch / ScreenMatch_Endless ใน PlayerGui เปิดอยู่ไหม
local function isMatchScreenOpen(screenName)
    local pg = player and player:FindFirstChildOfClass("PlayerGui")
    if not pg then return false end
    local mainGui = pg:FindFirstChild("MainGuiIgnoreGuiInset") or pg:FindFirstChild("MainGui")
    if mainGui then
        local s = mainGui:FindFirstChild(screenName, true)
        if s and (s.Visible or (s:IsA("ScreenGui") and s.Enabled)) then return true end
    end
    -- fallback: deep search
    local s2 = pg:FindFirstChild(screenName, true)
    return s2 ~= nil and (s2.Visible or (s2:IsA("ScreenGui") and s2.Enabled))
end

local function runLobbyDungeonSelect()
    -- deduplicate: ถ้ายิงไปแล้วในรอบนี้ (< 10s) ข้ามไป
    if (tick() - State._lastRoomTime) < 10 then return end

    local worldId   = Config.SelectedWorldId or "World1"
    local diffNum   = Config.SelectedDifficultyNum or 1
    local partySize = Config.SelectedPartySizeNum or 4

    setPhase("Queue")

    pcall(function()
        local taskRE      = getRemote("ReplicatedStorage.Framework.Features.TaskSystem.TaskRE")
        local worldUtilRE = getRemote("ReplicatedStorage.Framework.Gameplay.WorldPlace.WorldUtil.RemoteEvent")
        local gameMatchRE = getRemote("ReplicatedStorage.Remotes.GameMatchRE")

        local screenName   = "ScreenMatch"
        local portalCF     = DUNGEON_PORTAL_CF
        local isEndless    = (worldId == "EndlessTower" or worldId == "Endless1")
        local isCave       = worldId:sub(1, 4) == "Cave"
        local isSeason     = (worldId == "SeasonResource1")

        if isEndless then
            screenName = "ScreenMatch_Endless"
            portalCF   = TOWER_PORTAL_CF
        elseif isCave then
            portalCF = CAVE_PORTAL_CF
        elseif isSeason then
            portalCF = CIRCUS_PORTAL_CF
        end

        -- Step 1: teleport ไปพิกัด Portal
        teleportWithPhysicsNudge(portalCF)
        task.wait(0.05)

        -- Step 2: ยิง OpenGUIWindow แล้ว poll รอให้ GUI เปิดจริง (max 4 วิ)
        if taskRE then
            taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", screenName)
        end
        local guiReady = waitUntil(function() return isMatchScreenOpen(screenName) end, 4, 0.15)
        -- ถ้า GUI ยังไม่เปิด retry อีกครั้งแล้วรอต่อ
        if not guiReady and taskRE then
            taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", screenName)
            waitUntil(function() return isMatchScreenOpen(screenName) end, 3, 0.2)
        end

        -- Step 3: SelectWorld (ถ้าไม่ใช่ Endless)
        if not isEndless then
            if worldUtilRE then worldUtilRE:FireServer("SelectWorld", worldId, diffNum) end
            -- รอเล็กน้อยให้ server process SelectWorld
            task.wait(0.2)
        end

        -- Step 4: CreatRoom
        if gameMatchRE then
            if isEndless then
                local endlessFloor = Config.SelectedEndlessStage or Config.SelectedEndlessFloor or diffNum or 1
                gameMatchRE:FireServer("CreatRoom", "Endless1", 1, partySize, endlessFloor)
            else
                gameMatchRE:FireServer("CreatRoom", worldId, diffNum, partySize)
            end
            State._lastRoomTime = tick()
            setPhase("RoomCreated")
        end
    end)
end

