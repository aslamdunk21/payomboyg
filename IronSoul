-- ── CAVE / SEASON RESOURCE (SafeTeleportUtil RF + WorldUtil + GameMatchRE) ──
-- Path: ReplicatedStorage.Framework.Gameplay.WorldPlace.*
-- SelectWorld(caveId, diffNum) + CreatRoom(caveId, diffNum, maxPlayers)
local function EnterCaveMode(caveId, diffNum, maxPlayers)
    pcall(function()
        local cId = caveId or "Cave1"
        local diff = tonumber(diffNum) or 1
        local players = tonumber(maxPlayers) or 2

        -- Open ScreenMatch window
        local taskRE = getRemote("ReplicatedStorage.Framework.Features.TaskSystem.TaskRE")
        if taskRE then taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", "ScreenMatch") end
        task.wait(0.2)
        -- Select Cave World (Cave1: Crystal, Cave2: Runes, Cave3: Courtyard, SeasonResource1)
        local worldRE = getRemote("ReplicatedStorage.Framework.Gameplay.WorldPlace.WorldUtil.RemoteEvent")
        if worldRE then worldRE:FireServer("SelectWorld", cId, diff) end
        task.wait(0.2)
        -- Leave any current room
        local matchRE = getRemote("ReplicatedStorage.Remotes.GameMatchRE")
        if matchRE then matchRE:FireServer("LeaveRoom") end
        task.wait(0.2)
        -- Create new Cave room
        if matchRE then matchRE:FireServer("CreatRoom", cId, diff, players) end
    end)
end

