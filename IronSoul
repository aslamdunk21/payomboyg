local function interactWithDoor(door)
    if not door or not door.Parent or State.DoorBusy or State.DoorCooldown or not State.Root or not State.Humanoid then
        return false
    end
    State.DoorBusy = true
    State.CurrentAction = "Opening Door"
    local succeeded = false

    pcall(function()
        local prompt = findProximityPrompt(door)
        local approachPos = door.Position - door.CFrame.LookVector * Config.DoorInteractDistance
        travelToPosition(approachPos, door.Position)
        task.wait(0.25)

        TriggerDoorRemote()

        if prompt and type(fireproximityprompt) == "function" then
            fireproximityprompt(prompt)
            succeeded = true
        else
            pressKey("F")
            succeeded = true
        end

        task.wait(Config.DoorOpenWait)

        if door.Parent and prompt == nil then
            pressKey("F")
            task.wait(0.35)
        end
    end)

    State.DoorBusy = false
    State.DoorCooldown = true
    task.delay(1.25, function() if not State.Unloaded then State.DoorCooldown = false end end)
    return succeeded
end

local function teleportNearPortal()
    if not State.Root then return end
    local portal, score = findBestPortalOnly()
    if not portal or score < 2 then return end
    State.Portal = portal
    State.PortalScore = score
    local pos = portal.Position - portal.CFrame.LookVector * 8
    travelToPosition(pos, portal.Position)
end

local function collectDragonEggs()
    if not State.Root then return end
    pcall(function()
        local eggList = {}
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Model") and (v.Name == "DragonEgg" or v.Name == "LocalDragonEgg" or string.find(v.Name, "DragonEgg")) then
                if not v:GetAttribute("Broken") then
                    table.insert(eggList, v)
                end
            end
        end

        for _, eggModel in ipairs(eggList) do
            if eggModel and eggModel.Parent and not eggModel:GetAttribute("Broken") then
                local eggRoot = eggModel.PrimaryPart or eggModel:FindFirstChild("Root") or eggModel:FindFirstChild("EggModel")
                if eggRoot then
                    State.CurrentAction = "Harvesting Dragon Egg"
                    local startT = os.clock()
                    repeat
                        if not State.Root or State.Unloaded then break end
                        local pos = (eggRoot:IsA("Model") and eggRoot:GetPivot().Position or eggRoot.Position)
                        State.Root.CFrame = CFrame.new(pos + Vector3.new(0, 2, 2), pos)

                        -- Trigger Proximity Prompts on DragonEgg
                        for _, p in ipairs(eggModel:GetDescendants()) do
                            if p:IsA("ProximityPrompt") and type(fireproximityprompt) == "function" then
                                pcall(fireproximityprompt, p)
                            end
                        end

                        -- Attack DragonEgg to break it
                        pcall(activateTool)
                        pcall(function() Attack(true) end)

                        task.wait(0.15)
                    until eggModel:GetAttribute("Broken") or not eggModel.Parent or (os.clock() - startT) > 3.5
                end
            end
        end
    end)
end

local function moveToNextStage()
    if not Config.AutoProgressStage or State.StageBusy or State.StageCooldown or State.DoorBusy or not State.Root or not State.Humanoid or not Config.AutoFarm then
        return
    end

    -- 1. IF ENEMIES ARE PRESENT / TARGET FOUND: PRIORITIZE COMBAT IMMEDIATELY
    local model, root, hum = findNearestTarget()
    if model and root and hum and hum.Health > 0 then
        State.TargetModel = model; State.TargetRoot = root; State.TargetHumanoid = hum
        State.RoomClearTimer = 0; State.CurrentAction = "Farming"
        return
    end

    local enemyNpc = workspace:FindFirstChild("EnemyNpc")
    if enemyNpc then
        for _, child in ipairs(enemyNpc:GetChildren()) do
            if child:IsA("Model") and child:FindFirstChildOfClass("Humanoid") then
                local h = child:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    State.CurrentAction = "Farming"
                    return
                end
            end
        end
    end

    -- 2. IF ROOM IS CLEARED / WAITING FOR WAVE OR BOSS SPAWN:
    State.StageBusy = true
    State.TargetModel = nil; State.TargetRoot = nil; State.TargetHumanoid = nil

    -- Priority 0: Auto Collect Dragon Eggs in current room
    pcall(collectDragonEggs)

    -- Priority 1: TRIGGER PLAYER RESPAWN / ROOM WAVE & BOSS SPAWN FIRST!
    local playerRespawn = workspace:FindFirstChild("PlayerRespawn")
    if playerRespawn then
        State.CurrentAction = "Triggering Boss/Wave Spawn"
        local respawnParts = {}
        for _, v in pairs(playerRespawn:GetChildren()) do
            if v:IsA("Part") or v:IsA("BasePart") then
                table.insert(respawnParts, v)
            end
        end

        if #respawnParts > 0 then
            pcall(function()
                for _, v in ipairs(respawnParts) do
                    if State.Root then
                        State.Root.CFrame = v.CFrame + Vector3.new(0, 3, 0)
                        task.wait(0.3)
                    end
                end
            end)

            -- Wait 0.8s to give server time to spawn Boss / next wave
            task.wait(0.8)

            -- Re-check if Boss or Mobs spawned!
            local checkModel, checkRoot, checkHum = findNearestTarget()
            if checkModel and checkRoot and checkHum then
                State.TargetModel = checkModel
                State.TargetRoot = checkRoot
                State.TargetHumanoid = checkHum
                State.StageBusy = false
                State.StageBusyTimer = 0
                return
            end
        end
    end

    -- Priority 2: Interacting with Stage Doors / Prompts if door is present
    local roundDoor = workspace:FindFirstChild("RoundDoor")
    if roundDoor then
        local door = roundDoor:FindFirstChild("Door")
        local prompt = findProximityPrompt(door or roundDoor)
        if prompt then
            State.CurrentAction = "Opening Stage Door"
            pcall(function()
                State.Root.CFrame = (door and door:GetPivot() or roundDoor:GetPivot()) + Vector3.new(0, 2, 0)
                if type(fireproximityprompt) == "function" then
                    fireproximityprompt(prompt)
                else
                    pressKey("F")
                end
                TriggerDoorAndPortalRemotes()
            end)
            task.wait(0.6)
            State.StageBusy = false
            State.StageBusyTimer = 0
            return
        end
    end

    -- Priority 3: Enter Exit Portal / RoundDoor only if wave/boss is completely finished
    rebuildPortalCandidates()
    local exitObject, score, exitType = findBestExit()
    if roundDoor or exitObject then
        State.CurrentAction = "Entering RoundDoor/Portal"
        local portalPart = (roundDoor and (roundDoor:FindFirstChild("Portal") or roundDoor:FindFirstChild("Door"))) or exitObject
        local rootPart = portalPart and (portalPart:FindFirstChild("Root") or portalPart)
        if rootPart and State.Root then
            pcall(function()
                State.Root.CFrame = rootPart.CFrame + Vector3.new(0, 3, 0)
                TriggerDoorAndPortalRemotes()
                if type(firetouchinterest) == "function" and portalPart:IsA("BasePart") then
                    firetouchinterest(State.Root, portalPart, 0)
                    task.wait(0.05)
                    firetouchinterest(State.Root, portalPart, 1)
                end
            end)
        end
    end

    State.StageBusy = false
    State.StageBusyTimer = 0
end

