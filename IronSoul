local function runLobbyDungeonSelect()
    local worldId = Config.SelectedWorldId or "World1"
    local diffNum = Config.SelectedDifficultyNum or 1
    local partySize = Config.SelectedPartySizeNum or 4

    pcall(function()
        local taskRE = getRemote("ReplicatedStorage.Framework.Features.TaskSystem.TaskRE")
        local worldUtilRE = getRemote("ReplicatedStorage.Framework.Gameplay.WorldPlace.WorldUtil.RemoteEvent")
        local gameMatchRE = getRemote("ReplicatedStorage.Remotes.GameMatchRE")

        if worldId == "EndlessTower" or worldId == "Endless1" then
            -- วาร์ปไปพิกัดหอคอย พร้อมส่งสัญญาณ Physics Nudge
            teleportWithPhysicsNudge(TOWER_PORTAL_CF)
            if taskRE then
                taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", "ScreenMatch_Endless")
                task.wait(0.1)
                taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", "ScreenMatch_Endless")
            end
            task.wait(0.15)
            local endlessFloor = Config.SelectedEndlessStage or Config.SelectedEndlessFloor or diffNum or 1
            if gameMatchRE then
                gameMatchRE:FireServer("CreatRoom", "Endless1", 1, partySize, endlessFloor)
            end
        elseif worldId == "SeasonResource1" then
            -- วาร์ปไปพิกัด Royal Circus
            teleportWithPhysicsNudge(CIRCUS_PORTAL_CF)
            if taskRE then
                taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", "ScreenMatch")
                task.wait(0.1)
                taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", "ScreenMatch")
            end
            task.wait(0.15)
            if worldUtilRE then worldUtilRE:FireServer("SelectWorld", worldId, diffNum) end
            task.wait(0.1)
            if gameMatchRE then
                gameMatchRE:FireServer("CreatRoom", worldId, diffNum, partySize)
            end
        elseif worldId:sub(1, 4) == "Cave" then
            -- วาร์ปไปพิกัดถ้ำ Cave
            teleportWithPhysicsNudge(CAVE_PORTAL_CF)
            if taskRE then
                taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", "ScreenMatch")
                task.wait(0.1)
                taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", "ScreenMatch")
            end
            task.wait(0.15)
            if worldUtilRE then worldUtilRE:FireServer("SelectWorld", worldId, diffNum) end
            task.wait(0.1)
            if gameMatchRE then
                gameMatchRE:FireServer("CreatRoom", worldId, diffNum, partySize)
            end
        else
            -- วาร์ปไปพิกัดดันเจี้ยนหลัก 4 แมพ (Starless, Frozen, Oathlost, Tartarus)
            teleportWithPhysicsNudge(DUNGEON_PORTAL_CF)
