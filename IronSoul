-- #14: Dynamic Location Resolver (Dynamic NPC/Portal Resolution)
local LocationResolver = {}
function LocationResolver.Resolve(name, fallbackCF)
    local found = nil
    pcall(function()
        for _, parentName in ipairs({ "NPC", "NPCs", "Portals", "Map", "Buildings", "Spawns" }) do
            local parent = workspace:FindFirstChild(parentName)
            if parent then
                found = parent:FindFirstChild(name, true)
                if found then break end
            end
        end
        if not found then
            found = workspace:FindFirstChild(name, true)
        end
    end)

    if found then
        if found:IsA("Model") and found.PrimaryPart then
            return found.PrimaryPart.CFrame
        elseif found:IsA("BasePart") then
            return found.CFrame
        elseif found:IsA("Model") then
            local part = found:FindFirstChildWhichIsA("BasePart", true)
            if part then return part.CFrame end
        end
    end

    return fallbackCF
end

