-- #11: Error Classifier & Structured Logger
local ErrorLog = {}
local function safeCall(contextName, fn, ...)
    local args = { ... }
    local ok, err = pcall(function()
        return fn(table.unpack(args))
    end)
    if not ok then
        local errStr = tostring(err)
        table.insert(ErrorLog, { Time = os.time(), Context = contextName, Error = errStr })
        if #ErrorLog > 50 then table.remove(ErrorLog, 1) end
        warn(string.format("⚠️ [PayomboyZ IRS Error: %s] %s", tostring(contextName), errStr))
    end
    return ok, err
end

-- #10: RemoteRegistry Manager with Validate & Invalidate
local RemoteRegistry = {
    _cache = {}
}

function RemoteRegistry.Invalidate(path)
    if path then
        RemoteRegistry._cache[path] = nil
    else
        table.clear(RemoteRegistry._cache)
    end
end

function RemoteRegistry.Get(path)
    local cached = RemoteRegistry._cache[path]
    if cached then
        -- Validate that cached instance is still alive and parented
        local ok, isAlive = pcall(function()
            return cached and cached.Parent and cached:IsDescendantOf(game)
        end)
        if ok and isAlive then
            return cached
        else
            RemoteRegistry._cache[path] = nil
        end
    end

    local ok, result = pcall(function()
        local parts = string.split(path, ".")
        local obj = game:GetService(parts[1])
        for i = 2, #parts do
            if not obj then return nil end
            obj = obj:FindFirstChild(parts[i]) or obj:WaitForChild(parts[i], 0.2)
        end
        return obj
    end)

    if ok and result then
        RemoteRegistry._cache[path] = result
        return result
    end
    return nil
end

local function getRemote(path)
    return RemoteRegistry.Get(path)
end

