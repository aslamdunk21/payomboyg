    _G.IronSoul_Phase = curPhase
    _G.IronSoul_AfterRunMode = Config.AfterRunMode or (Config.AutoPlayAgain and "Again" or "Lobby")

    return {
        CurrentWorld = Config.SelectedWorldId or "World1",
        CurrentPlace = game.PlaceId,
        CurrentPhase = curPhase,
        InSettlement = inSettlement,
        InBattle     = inBattle,
    }
end

