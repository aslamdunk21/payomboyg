-- #4: RUN EVALUATOR ENGINE
local RunEvaluator = {
    currentRun = nil,
    history = {}
}

function RunEvaluator.StartRun(worldId, diffNum)
    RunEvaluator.currentRun = {
        World = worldId,
        Diff = diffNum,
        StartTime = tick(),
        StartGold = PlayerState.GetGold(),
        Deaths = 0
    }
end

function RunEvaluator.RecordDeath()
    if RunEvaluator.currentRun then
        RunEvaluator.currentRun.Deaths = RunEvaluator.currentRun.Deaths + 1
    end
end

function RunEvaluator.EndRun(isSuccess)
    if not RunEvaluator.currentRun then return nil end
    local r = RunEvaluator.currentRun
    local duration = math.max(1, tick() - r.StartTime)
    local endGold = PlayerState.GetGold()
    local goldGained = math.max(0, endGold - r.StartGold)
    local goldPerMin = math.floor((goldGained / duration) * 60)

    local record = {
        World = r.World,
        Diff = r.Diff,
        Duration = duration,
        GoldGained = goldGained,
        GoldPerMin = goldPerMin,
        Deaths = r.Deaths,
        Success = isSuccess,
        Time = os.time()
    }

    table.insert(RunEvaluator.history, record)
    if #RunEvaluator.history > 30 then table.remove(RunEvaluator.history, 1) end

    print(string.format("📊 [RunEvaluator] Completed! World: %s | Diff: %d | Time: %.1fs | Gold/Min: %d | Deaths: %d",
        tostring(r.World), tonumber(r.Diff), duration, goldPerMin, r.Deaths))

    RunEvaluator.currentRun = nil
    return record
end

-- #5: DYNAMIC DIFFICULTY OPTIMIZER
local DifficultyOptimizer = {}

function DifficultyOptimizer.EvaluateNextDifficulty(currentWorld, currentDiff)
    if not Config.AutoAdaptiveDifficulty then return currentDiff end

    local lastRun = RunEvaluator.history[#RunEvaluator.history]
    if not lastRun or lastRun.World ~= currentWorld then return currentDiff end

    if lastRun.Success and lastRun.Deaths == 0 and lastRun.Duration < 180 then
        local nextDiff = math.min(5, currentDiff + 1)
        print(string.format("⚡ [DifficultyOptimizer] Fast Clear! Raising Difficulty: %d → %d", currentDiff, nextDiff))
        return nextDiff
    elseif not lastRun.Success or lastRun.Deaths >= 2 then
        local prevDiff = math.max(1, currentDiff - 1)
        print(string.format("⚠️ [DifficultyOptimizer] High Risk/Death! Lowering Difficulty: %d → %d", currentDiff, prevDiff))
        return prevDiff
    end

    return currentDiff
end

-- #6: DUNGEON RECOVERY TREE
local DungeonRecoveryTree = {}

function DungeonRecoveryTree.HandleFailure(errReason, worldId, diffNum, partySize)
    warn(string.format("🌲 [DungeonRecoveryTree] Executing Recovery Branch for Error: %s", tostring(errReason)))

    if errReason == "OpenMatchFailed" or errReason == "GUIMissing" then
        CloseAllNPCWindows()
        NavigationManager.GoToPosition(NPC_PORTALS.DUNGEON, 15, "DUNGEON_PORTAL")
        task.wait(0.3)
        NPCManager.Interact("ScreenMatch", NPC_PORTALS.DUNGEON, "ScreenMatch")

    elseif errReason == "CreateRoomFailed" then
        local matchRE = getRemote(REMOTES.GameMatchRE)
        if matchRE then matchRE:FireServer("LeaveRoom") end
        task.wait(0.3)

    elseif errReason == "CharacterStuck" then
        NavigationManager.ReturnTown()

    else
        NavigationManager.ReturnTown()
        State._lastRoomTime = 0
        setPhase("LOBBY")
    end
end

-- #2: GATED DUNGEON TRANSACTION PIPELINE (StartDungeonRun)
function StartDungeonRun(worldId, diffNum, partySize)
    return safeCall("StartDungeonRun", function()
        local targetDiff = DifficultyOptimizer.EvaluateNextDifficulty(worldId, diffNum or 1)

        -- Step 1: Resolve Location & Teleport via NavigationManager
        NavigationManager.GoToPosition(NPC_PORTALS.DUNGEON, 15, "DUNGEON_PORTAL")
        task.wait(0.2)

        -- Step 2: Open Match GUI & Adaptive Verification (#3)
        local matchOpened = waitUntil(function()
            local taskRE = getRemote(REMOTES.TaskRE)
            if taskRE then taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", "ScreenMatch") end
            return NPCManager.VerifyUI("ScreenMatch")
        end, 4, 0.3)

        if not matchOpened then
            DungeonRecoveryTree.HandleFailure("OpenMatchFailed", worldId, targetDiff, partySize)
            return false, "OpenMatchFailed"
        end
        setPhase("MATCH_GUI")

        -- Step 3: Select World & Verify
        local worldRE = getRemote(REMOTES.WorldUtilRE)
        if worldRE then worldRE:FireServer("SelectWorld", worldId, targetDiff) end
        task.wait(0.3)

        -- Step 4: Create Room & Verify
        local matchRE = getRemote(REMOTES.GameMatchRE)
        if matchRE then
            matchRE:FireServer("LeaveRoom")
            task.wait(0.3)
            matchRE:FireServer("CreatRoom", worldId, targetDiff, partySize or 1)
        end

        local roomCreated = waitUntil(function()
            local phase = State.Phase
            return phase == "ROOM" or phase == "RoomCreated" or phase == "LOADING" or phase == "IN_DUNGEON"
        end, 6, 0.3)

        if not roomCreated then
            DungeonRecoveryTree.HandleFailure("CreateRoomFailed", worldId, targetDiff, partySize)
            return false, "CreateRoomFailed"
        end
        setPhase("ROOM")

        -- Step 5: Wait For Dungeon Load & Verify
        RunEvaluator.StartRun(worldId, targetDiff)
        local inDungeon = waitUntil(function()
            local phase = StateObserver.GetWorldState().CurrentPhase
            return phase == "IN_DUNGEON" or phase == "InDungeon" or phase == "COMBAT"
        end, 15, 0.5)

        if inDungeon then
            setPhase("IN_DUNGEON")
            return true, "DungeonLoaded"
