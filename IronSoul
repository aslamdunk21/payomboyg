local function teleportWithPhysicsNudge(targetCF)
    if typeof(targetCF) ~= "CFrame" then return end
    pcall(function()
        local char = player.Character or player.CharacterAdded:Wait()
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        -- 1. เคลียร์ความเร็วตัวละครทันที (กันโดน Rubberband ย้อนกลับ)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        -- 2. ย้ายพิกัดตัวละครทันที (Instant Teleport แบบเดียวกับระบบสร้างห้องดันเจี้ยน)
        if char.PrimaryPart then
            char:SetPrimaryPartCFrame(targetCF)
        else
            hrp.CFrame = targetCF
        end

        task.wait(0.05)

        -- 3. ยิง TouchTransmitter กระตุ้น Zone หากมี Portal NPC ตรงจุดนั้น
        pcall(function()
            if type(firetouchinterest) == "function" and workspace.OverlapParams then
                local params = OverlapParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = { char }
                local parts = workspace:GetPartBoundsInBox(targetCF, Vector3.new(20, 20, 20), params)
                for _, p in ipairs(parts) do
                    local tt = p:FindFirstChildOfClass("TouchTransmitter")
                    if tt then
                        firetouchinterest(hrp, p, 0)
                        task.wait(0.02)
                        firetouchinterest(hrp, p, 1)
                    end
                end
            end
        end)

        -- 4. ย้ำพิกัดอีกครั้งให้มั่นใจว่าตัวไม่เด้งกลับ
        hrp.CFrame = targetCF
    end)
end

