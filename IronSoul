                local name   = TranslationUtil and TranslationUtil:TranslateByKey("K_" .. string.upper(def.ID)) or def.ID
                local rarity = RarityTiers and RarityTiers.Tiers[def.Rarity]
                table.insert(result, { ID = crystalId, Name = name, Amount = amount, Rarity = rarity and rarity.Name or "Unknown", MaterialType = materialType })
            end
        end
    end)
    return result
end

local function GetEquipment()
    local result = {}
    if not DataUtil then return result end
    pcall(function()
        local owned = DataUtil:GetPlayerData(player).Equipment.Owned
        for _, v in pairs(owned or {}) do table.insert(result, v.ID) end
    end)
    return result
end

