-- AUTO QUEST SYSTEM (Senior Dev Architecture)
-- สถาปัตยกรรม: State Machine แบบ Poll-based
-- ขั้นตอน: Fetch → Parse → Execute → Claim
-- ════════════════════════════════════════════════
--[[
  Quest Remote Paths (ยืนยันจาก IRSRE.lua dump):
    DailyQuestRE = ReplicatedStorage.Framework.Features.DailyQuestSystem.RE
    TaskRE       = ReplicatedStorage.Framework.Features.TaskSystem.TaskRE
  Actions ที่รองรับ:
    DailyQuestRE:FireServer("GetDailyQuest")   → server return quest list
    DailyQuestRE:FireServer("ClaimDailyQuest", questId)
    TaskRE:FireServer("UpdateTaskProgress", "DialogNpc", npcId)
    TaskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", windowId)
--]]

local _questState = {
    phase       = "idle",   -- idle | fetching | executing | claiming | cooldown
    lastFetch   = 0,
    fetchCooldown = 60,     -- วิ: ดึงข้อมูลเควสใหม่ทุก 60 วิ
    pendingQuests = {},
    currentIdx  = 0,
    execCooldown = 0,
}

-- ฟังก์ชัน execute quest ตาม type
local function _executeQuest(quest)
    if not quest then return end
    local taskRE = getRemote("ReplicatedStorage.Framework.Features.TaskSystem.TaskRE")
    local qType  = tostring(quest.Type or quest.QuestType or "")
    local qParam = tostring(quest.Param or quest.NpcId or quest.Target or "")

    -- Dialog NPC quest
    if qType:find("Dialog") or qType:find("NPC") or qType:find("Talk") then
        if taskRE and qParam ~= "" then
            taskRE:FireServer("UpdateTaskProgress", "DialogNpc", qParam)
            task.wait(0.3)
        end
    end

    -- Open GUI / Visit window quest
    if qType:find("Open") or qType:find("Visit") or qType:find("GUI") then
        if taskRE and qParam ~= "" then
            taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", qParam)
            task.wait(0.3)
        end
    end

    -- Generic progress bump (ยิง UpdateTaskProgress ทั่วไป)
    if taskRE then
        pcall(function()
            taskRE:FireServer("UpdateTaskProgress", qType, qParam)
        end)
    end
end

task.spawn(function()
    while task.wait(2) do
        if State.Unloaded then break end
        if not Config.AutoQuest then
            _questState.phase = "idle"
            _questState.pendingQuests = {}
            _questState.currentIdx = 0
            continue
        end

        local now = tick()
        local dailyRE = getRemote("ReplicatedStorage.Framework.Features.DailyQuestSystem.RE")

        -- Phase: idle → fetch
        if _questState.phase == "idle" then
            if (now - _questState.lastFetch) >= _questState.fetchCooldown then
                _questState.phase = "fetching"
            end

        -- Phase: fetching → request quest list จาก server
        elseif _questState.phase == "fetching" then
            _questState.lastFetch = now
            -- เปิดหน้า quest ก่อนเพื่อ trigger server sync
            pcall(function()
                local taskRE = getRemote("ReplicatedStorage.Framework.Features.TaskSystem.TaskRE")
                if taskRE then
                    taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", "ScreenDailyQuest")
                end
            end)
            -- รวบรวม quest จาก PlayerGui หรือ Attributes
            local quests = {}
            pcall(function()
                -- วิธีที่ 1: อ่านจาก PlayerGui ที่ game render ให้
                local questGui = player.PlayerGui:FindFirstChild("QuestGui")
                    or player.PlayerGui:FindFirstChild("DailyQuestGui")
                    or player.PlayerGui:FindFirstChild("UIMain")
                if questGui then
                    for _, v in ipairs(questGui:GetDescendants()) do
                        local qId = v:GetAttribute("QuestId") or v:GetAttribute("questId")
                        local isDone = v:GetAttribute("Completed") or v:GetAttribute("IsDone")
                        local qType = v:GetAttribute("QuestType") or v:GetAttribute("Type") or "DialogNpc"
                        local qParam = v:GetAttribute("QuestParam") or v:GetAttribute("Param") or ""
                        if qId and not isDone then
                            table.insert(quests, { Id = qId, Type = qType, Param = qParam })
                        end
                    end
                end
                -- วิธีที่ 2: ยิง server แบบ fire-and-read ผ่าน DailyQuestRE
                if #quests == 0 and dailyRE then
                    pcall(function() dailyRE:FireServer("GetDailyQuest") end)
                    -- fallback: สร้าง quest list จาก NPC ที่รู้จัก
                    quests = {
                        { Id = "dq_dialog1",    Type = "DialogNpc",     Param = "DialogNpcNormal1|1"    },
                        { Id = "dq_enchant",    Type = "DialogNpc",     Param = "EquipmentEnchantNpc2|0" },
                        { Id = "dq_skilltree",  Type = "OpenGUIWindow",  Param = "ScreenSkillTree"       },
                        { Id = "dq_forge",      Type = "OpenGUIWindow",  Param = "ScreenForge"           },
                        { Id = "dq_shop",       Type = "OpenGUIWindow",  Param = "ScreenShop"            },
                    }
                end
            end)
            _questState.pendingQuests = quests
            _questState.currentIdx    = 0
            _questState.phase = (#quests > 0) and "executing" or "cooldown"

        -- Phase: executing → ทำเควสทีละตัว
        elseif _questState.phase == "executing" then
            _questState.currentIdx = _questState.currentIdx + 1
            local quest = _questState.pendingQuests[_questState.currentIdx]
            if quest then
                pcall(_executeQuest, quest)
                task.wait(1.5)
                -- claim ทันทีหลัง execute
                if dailyRE then
                    pcall(function() dailyRE:FireServer("ClaimDailyQuest", quest.Id) end)
                end
            else
                -- ทำหมดแล้ว
                _questState.phase = "cooldown"
                ObsidianGlassEngine:Notify({
                    Title = "Auto Quest",
                    Content = "ทำเควสครบทั้งหมดแล้ว! รอรอบถัดไป",
                    Duration = 4
                })
            end

        -- Phase: cooldown → รอรอบถัดไป
        elseif _questState.phase == "cooldown" then
            if (now - _questState.lastFetch) >= _questState.fetchCooldown then
                _questState.phase = "idle"
            end
        end
    end
end)

