-- NPC WARP ENGINE
-- Uses LobbyLocationUtil.RemoteEvent for server-side warp
-- Falls back to direct CFrame teleport if remote fails
-- ────────────────────────────────────────────────────
local function teleportWithPhysicsNudge(targetCF)
    local char = player and player.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    -- Phase 1: server-side LobbyLocation warp (clean)
    local lobbyRE = getRemote(REMOTES.LobbyLocationRE)
    if lobbyRE then
        pcall(function() lobbyRE:FireServer("Warp", targetCF.Position) end)
        task.wait(0.3)
    end

    -- Phase 2: client-side CFrame nudge (fallback / correction)
    for _ = 1, 3 do
        pcall(function() hrp.CFrame = targetCF end)
        task.wait(0.05)
    end

    return true
end

local function WarpToNPC(npcKey)
    local cf = NPC_PORTALS[npcKey]
    if not cf then
        warn("[WarpToNPC] Unknown NPC key: " .. tostring(npcKey))
        return false
    end
    print(string.format("[WarpToNPC] Warping to %s...", tostring(npcKey)))
    return teleportWithPhysicsNudge(cf)
end

local function TeleportToTown()
    -- Warp to dungeon portal area (default recovery point)
    teleportWithPhysicsNudge(NPC_PORTALS.DUNGEON)
end

