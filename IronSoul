local function GetRarities()
    local result = {}
    if not RarityTiers then return { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" } end
    pcall(function()
        for _, v in pairs(RarityTiers.Tiers) do
            table.insert(result, v.Name)
        end
    end)
    if #result == 0 then result = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" } end
    return result
end

local function GetOresWithNames()
    local result = {}
    if not DataUtil or not ForgeUtil then return result end
    pcall(function()
        local oresData = DataUtil:GetPlayerData(player).Ores
        for oreId, amount in pairs(oresData or {}) do
            local def = ForgeUtil:GetDef(oreId)
            if def then
                local name   = TranslationUtil and TranslationUtil:TranslateByKey("K_" .. string.upper(def.ID)) or def.ID
                local rarity = RarityTiers and RarityTiers.Tiers[def.Rarity]
                table.insert(result, {
                    ID     = oreId,
                    Name   = name,
                    Amount = amount,
                    Rarity = rarity and rarity.Name or "Unknown"
                })
            end
        end
    end)
    return result
end

