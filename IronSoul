-- ────────────────────────────────────────────────────
-- waitUntil — MUST be defined before VerificationEngine
-- ────────────────────────────────────────────────────
local function waitUntil(condFn, timeout, interval)
    timeout  = timeout  or 5
    interval = interval or 0.1
    local t0 = tick()
    while (tick() - t0) < timeout do
        if pcall(condFn) and condFn() then return true end
        task.wait(interval)
    end
    return false
end

