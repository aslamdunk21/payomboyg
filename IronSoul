local NavigationManager = {
    LastStatus = "🟢 IDLE",
    CurrentTarget = "-",
    LastDistance = 0
}

function NavigationManager.GoToPosition(targetCF, maxDist, npcName)
    maxDist = maxDist or 15
    local targetName = npcName or string.format("(%.1f, %.1f, %.1f)", targetCF.Position.X, targetCF.Position.Y, targetCF.Position.Z)
    NavigationManager.CurrentTarget = targetName

    return ActionEngine.ExecuteAction({
        Name = "NavigateTo_" .. targetName,
        Preconditions = function()
            local pState = StateObserver.GetPlayerState()
            return pState.Character ~= nil and pState.HRP ~= nil
        end,
        Execute = function()
            local pState = StateObserver.GetPlayerState()
            local hrp = pState.HRP
            if not hrp then return end

            -- Reset Linear & Angular Velocity to prevent rubberband
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero

            -- Phase 1: Server LobbyLocation warp
            local lobbyRE = getRemote(REMOTES.LobbyLocationRE)
            if lobbyRE then
                pcall(function() lobbyRE:FireServer("Warp", targetCF.Position) end)
                task.wait(0.2)
            end

            -- Phase 2: Client CFrame nudge
            for _ = 1, 3 do
                pcall(function() hrp.CFrame = targetCF end)
                task.wait(0.04)
            end

            -- Trigger touch zone if available
            pcall(function()
                if type(firetouchinterest) == "function" and workspace.OverlapParams then
                    local params = OverlapParams.new()
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    params.FilterDescendantsInstances = { pState.Character }
                    local parts = workspace:GetPartBoundsInBox(targetCF, Vector3.new(15, 15, 15), params)
                    for _, p in ipairs(parts) do
                        if p:FindFirstChildOfClass("TouchTransmitter") then
                            firetouchinterest(hrp, p, 0)
                            task.wait(0.02)
                            firetouchinterest(hrp, p, 1)
                        end
                    end
                end
            end)
        end,
        Verify = function()
            local pState = StateObserver.GetPlayerState()
            if not pState.HRP then return false end
            local dist = (pState.HRP.Position - targetCF.Position).Magnitude
            NavigationManager.LastDistance = dist
            if dist <= maxDist then
                NavigationManager.LastStatus = string.format("🟢 ARRIVED (%.1fs)", dist)
                return true
            else
                NavigationManager.LastStatus = string.format("⚠️ OUT OF RANGE (%.1fs)", dist)
                return false
            end
        end,
        Timeout = 2.5,
        Retry = 3,
        Recovery = function()
            -- Reset velocity and re-nudge
            local pState = StateObserver.GetPlayerState()
            if pState.HRP then
                pState.HRP.AssemblyLinearVelocity = Vector3.zero
                pState.HRP.CFrame = targetCF
            end
        end,
        Cooldown = 0.1
    })
end

