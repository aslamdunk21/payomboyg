local portalCandidates = {}

local function getExitType(part)
    if not part or not part:IsA("BasePart") then return nil end
    local names = { string.lower(part.Name) }
    local ancestor = part.Parent
    local depth = 0
    while ancestor and depth < 4 do
        if ancestor:IsA("Model") or ancestor:IsA("Folder") then table.insert(names, string.lower(ancestor.Name)) end
        ancestor = ancestor.Parent; depth += 1
    end
    local hasPortalName, hasDoorName = false, false
    for _, name in ipairs(names) do
        if name:find("portal", 1, true) or name:find("teleport", 1, true) or name:find("portalexit", 1, true) or name:find("warp", 1, true) or name:find("next", 1, true) or name:find("finish", 1, true) then
            hasPortalName = true
        end
        if name:find("door", 1, true) or name:find("gate", 1, true) or name:find("exit", 1, true) or name:find("entrance", 1, true) or name:find("rounddoor", 1, true) then
            hasDoorName = true
        end
    end
    if hasPortalName then return "portal" end
    if hasDoorName then return "door" end
    return nil
end

local function isPortalCandidate(part) return getExitType(part) ~= nil end

local function rebuildPortalCandidates()
    State.Stats.PortalScans += 1
    table.clear(portalCandidates)
    for _, object in ipairs(workspace:GetDescendants()) do
        if isPortalCandidate(object) then table.insert(portalCandidates, object) end
    end
end

local function registerPortalCandidate(object)
    if isPortalCandidate(object) and not table.find(portalCandidates, object) then
        table.insert(portalCandidates, object)
    end
end

local function unregisterPortalCandidate(object)
    for index = #portalCandidates, 1, -1 do
        if portalCandidates[index] == object then
            table.remove(portalCandidates, index); break
        end
    end
end

connect(workspace.DescendantAdded, registerPortalCandidate)
connect(workspace.DescendantRemoving, unregisterPortalCandidate)

local function scorePortal(part, origin)
    if not part or not part.Parent then return -math.huge, nil end
    local exitType = getExitType(part)
    if not exitType then return -math.huge, nil end
    local name = string.lower(part.Name)
    local parentName = part.Parent and string.lower(part.Parent.Name) or ""
    local score = 0

    if exitType == "portal" then
        score += 8
        if name:find("portal", 1, true) or parentName:find("portal", 1, true) then score += 5 end
        if name:find("teleport", 1, true) or parentName:find("teleport", 1, true) then score += 3 end
    else
        score += 2
        if name:find("door", 1, true) then score += 2 end
        if name:find("gate", 1, true) then score += 2 end
    end
    if name:find("next", 1, true) or name:find("finish", 1, true) or name:find("exit", 1, true) then score += 2 end
    if part:FindFirstChildOfClass("TouchTransmitter") then score += 3 end
    if part:FindFirstChildOfClass("ProximityPrompt") then score += 4 end
    if part.Material == Enum.Material.Neon then score += 3 end
    if part.Size.Y > 5 and part.Size.X > 5 then score += 2 end

    local distSq = (origin - part.Position):Dot(origin - part.Position)
    score += math.max(0, 1 - distSq / (50 * 50))
    return score, exitType
end

findBestExit = function()
    if not State.Root then return nil, 0, nil end
    local origin = State.Root.Position
    local maxDistSq = Config.ExitSearchRadius * Config.ExitSearchRadius
    local bestPortal, bestPortalScore = nil, -math.huge
    local bestDoor, bestDoorScore = nil, -math.huge

    for index = #portalCandidates, 1, -1 do
        local part = portalCandidates[index]
        if not part or not part.Parent then
            table.remove(portalCandidates, index)
        else
            local distSq = (origin - part.Position):Dot(origin - part.Position)
            if distSq <= maxDistSq then
                local score, exitType = scorePortal(part, origin)
                if exitType == "portal" and score > bestPortalScore then
                    bestPortal = part; bestPortalScore = score
                elseif exitType == "door" and score > bestDoorScore then
                    bestDoor = part; bestDoorScore = score
                end
            end
        end
    end
    if bestPortal then return bestPortal, bestPortalScore, "portal" end
    if bestDoor then return bestDoor, bestDoorScore, "door" end
    return nil, 0, nil
end

local function findBestPortalOnly()
    if not State.Root then return nil, 0 end
    local origin = State.Root.Position
    local maxDistSq = Config.ExitSearchRadius * Config.ExitSearchRadius
    local bestPortal, bestScore = nil, -math.huge

    for index = #portalCandidates, 1, -1 do
        local part = portalCandidates[index]
        if not part or not part.Parent then
            table.remove(portalCandidates, index)
        else
            local distSq = (origin - part.Position):Dot(origin - part.Position)
            if distSq <= maxDistSq then
                local score, exitType = scorePortal(part, origin)
                if exitType == "portal" and score > bestScore then
                    bestPortal = part; bestScore = score
                end
            end
        end
    end
    return bestPortal, bestScore
end

local function findProximityPrompt(rootObject)
    if not rootObject then return nil end
    if rootObject:IsA("ProximityPrompt") then return rootObject end
    return rootObject:FindFirstChildOfClass("ProximityPrompt") or rootObject:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function TriggerDoorAndPortalRemotes()
    pcall(function()
        local roundDoor = workspace:FindFirstChild("RoundDoor")
        if roundDoor then
            local door = roundDoor:FindFirstChild("Door")
            local doorRoot = door and door:FindFirstChild("Root")
            local doorRE = doorRoot and doorRoot:FindFirstChild("RE")
            if doorRE then pcall(function() doorRE:FireServer() end) end

            local portal = roundDoor:FindFirstChild("Portal")
            local portalRoot = portal and portal:FindFirstChild("Root")
            local portalRF = portalRoot and portalRoot:FindFirstChild("RF")
            if portalRF then pcall(function() portalRF:InvokeServer() end) end
        end

        for _, v in pairs(workspace:GetDescendants()) do
            if v.Name == "RE" and v.Parent and v.Parent.Name == "Root" and v.Parent.Parent and (v.Parent.Parent.Name == "Door" or v.Parent.Parent.Name == "RoundDoor") then
                pcall(function() v:FireServer() end)
            elseif v.Name == "RF" and v.Parent and v.Parent.Name == "Root" and v.Parent.Parent and (v.Parent.Parent.Name == "Portal" or v.Parent.Parent.Name == "RoundDoor") then
                pcall(function() v:InvokeServer() end)
            end
        end
    end)
    return true
end
