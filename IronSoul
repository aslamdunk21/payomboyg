                local val = math.floor(rawVal + 0.5)
                OptionObj.Value = val
                valLabel.Text = tostring(val)
                local newPct = (val - minVal) / math.max(1, (maxVal - minVal))
                sliderFill.Size = UDim2.new(newPct, 0, 1, 0)
                knob.Position = UDim2.new(newPct, 0, 0.5, 0)
                pcall(function() OptionObj.Callback(val) end)
