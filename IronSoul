local function syncUIElements()
    if not ObsidianGlassEngine.Options then return end
    pcall(function()
        if ObsidianGlassEngine.Options.AutoFarm then ObsidianGlassEngine.Options.AutoFarm:SetValue(Config.AutoFarm) end
        if ObsidianGlassEngine.Options.AutoSkill then ObsidianGlassEngine.Options.AutoSkill:SetValue(Config.AutoSkill) end
        if ObsidianGlassEngine.Options.AutoAttack then ObsidianGlassEngine.Options.AutoAttack:SetValue(Config.AutoAttack) end
        if ObsidianGlassEngine.Options.AutoAvoid then ObsidianGlassEngine.Options.AutoAvoid:SetValue(Config.AutoAvoid) end
        if ObsidianGlassEngine.Options.AutoProgressStage then ObsidianGlassEngine.Options.AutoProgressStage:SetValue(Config.AutoProgressStage) end
        if ObsidianGlassEngine.Options.UndergroundMode then ObsidianGlassEngine.Options.UndergroundMode:SetValue(Config.UndergroundMode) end
        if ObsidianGlassEngine.Options.AboveHeight then ObsidianGlassEngine.Options.AboveHeight:SetValue(tostring(Config.AboveHeight)) end
        if ObsidianGlassEngine.Options.UndergroundHeight then ObsidianGlassEngine.Options.UndergroundHeight:SetValue(tostring(Config.UndergroundHeight)) end
        if ObsidianGlassEngine.Options.OrbitRadius then ObsidianGlassEngine.Options.OrbitRadius:SetValue(Config.OrbitRadius) end
        if ObsidianGlassEngine.Options.OrbitSpeed then ObsidianGlassEngine.Options.OrbitSpeed:SetValue(Config.OrbitSpeed) end
        if ObsidianGlassEngine.Options.KillAuraRadius then ObsidianGlassEngine.Options.KillAuraRadius:SetValue(Config.KillAuraRadius) end
        if ObsidianGlassEngine.Options.PerformanceMode then ObsidianGlassEngine.Options.PerformanceMode:SetValue(Config.PerformanceMode) end
        if ObsidianGlassEngine.Options.SafeMode then ObsidianGlassEngine.Options.SafeMode:SetValue(Config.SafeMode) end
        if ObsidianGlassEngine.Options.EmergencyEscape then ObsidianGlassEngine.Options.EmergencyEscape:SetValue(Config.EmergencyEscape) end
        if ObsidianGlassEngine.Options.SaveSettings then ObsidianGlassEngine.Options.SaveSettings:SetValue(Config.SaveSettings) end
        if ObsidianGlassEngine.Options.Debug then ObsidianGlassEngine.Options.Debug:SetValue(Config.Debug) end
    end)
end

local function updateStatusPanel()
    pcall(function()
        local distanceText =
            State.LastTargetDistance < math.huge
            and string.format("%.1f Studs", State.LastTargetDistance)
            or "-"

        local hpPct = math.clamp(State.TargetHealthPercent or 0, 0, 100)
        local dangerText =
            State.DangerDistance < math.huge
            and string.format("%.1f Studs", State.DangerDistance)
            or "-"

        local rawName = tostring(State.LastTargetName or "-")
        local cleanTargetName = rawName
        if rawName ~= "-" then
            local clean = string.gsub(rawName, "%-%x+.*$", "")
            if clean ~= "" then cleanTargetName = clean end
            if #cleanTargetName > 28 then
                cleanTargetName = string.sub(cleanTargetName, 1, 25) .. "..."
            end
        end

        targetNameLabel.Text = "🎯 ศัตรูเป้าหมาย: " .. cleanTargetName

        if State.TargetHealthPercent > 0 then
            hpBarFill.Size = UDim2.new(hpPct / 100, 0, 1, 0)
            hpBarText.Text = string.format("❤️ HP: %.0f%%", hpPct)
            if hpPct > 50 then
                hpBarFill.BackgroundColor3 = COLORS.success
            elseif hpPct > 20 then
                hpBarFill.BackgroundColor3 = COLORS.warning
            else
                hpBarFill.BackgroundColor3 = COLORS.danger
            end
        else
            hpBarFill.Size = UDim2.new(0, 0, 1, 0)
            hpBarText.Text = "❤️ HP: -"
        end

        local posModeText = Config.UndergroundMode and "มุดใต้ดิน (Underground)" or "ลอยเหนือหัว (Above)"
        targetDetailsLabel.Text = string.format("📏 ระยะห่าง: %s  |  🛡️ โหมดตำแหน่ง: %s\n⚠️ ระยะอันตราย: %s",
            distanceText, posModeText, dangerText)

        local actStr = tostring(State.CurrentAction or "Idle")
        local icon = "🌾"
        if actStr == "Farming" then
            icon = "🌾"
            actStr = "กำลังฟาร์มมอนสเตอร์ (Farming)"
        elseif actStr == "Portal" then
            icon = "🌀"
            actStr = "กำลังเคลื่อนที่เข้าประตูทางออก (Portal Exit)"
        elseif actStr == "Recovering" then
            icon = "⚡"
            actStr = "กำลังฟื้นฟูระบบ (Recovering)"
        elseif actStr == "Emergency Escape" then
            icon = "🚨"
            actStr = "ถอยหลบฉุกเฉิน (Emergency Escape)"
        else
            icon = "💤"
            actStr = "สแตนด์บาย (Idle)"
        end
        actionStatusBadge.Text = icon .. " สถานะ: " .. actStr

        if State.Portal and State.Portal.PrimaryPart then
            local distP = (State.Root.Position - State.Portal.PrimaryPart.Position).Magnitude
            portalStatusLabel.Text = string.format("🌀 ประตูทางออก: สแกนพบประตู (ระยะ %.1f Studs)", distP)
        else
            portalStatusLabel.Text = "🌀 ประตูทางออก: กำลังสแกนหาประตูใกล้เคียง..."
        end

        diagGridLabel.Text = string.format("💓 Ticks (Heartbeat): %d  |  🎯 Target Scans: %d\n🌀 Portal Scans: %d  |  ⚠️ Danger Scans: %d",
            State.Stats.Heartbeats, State.Stats.TargetScans, State.Stats.PortalScans, State.Stats.DangerScans)
    end)
end

connect(RunService.Heartbeat, function(dt)
    if State.Unloaded then
        return
    end

    State.Stats.Heartbeats += 1

    State.StatusTimer += dt
    if State.StatusTimer >= Config.StatusInterval then
        State.StatusTimer = 0
        updateStatusPanel()
    end

    if not Config.AutoFarm then
        State.WatchdogTimer = 0
        State.StageBusyTimer = 0
        State.CurrentAction = "Idle"
        return
    end

    if not State.Character
        or not State.Root
        or not State.Humanoid
        or State.Humanoid.Health <= 0 then
        return
    end

    State.WatchdogTimer += dt

    if State.StageBusy then
        State.StageBusyTimer += dt

        if State.StageBusyTimer >= 6 then
            State.StageBusy = false
            State.DoorBusy = false
            State.StageBusyTimer = 0
            State.RoomClearTimer = 0
            State.CurrentAction = "Recovering"
        end
    else
        State.StageBusyTimer = 0
    end

    if State.WatchdogTimer >= 2 then
        State.WatchdogTimer = 0

        if Config.AutoProgressStage and not State.StageBusy then
            rebuildPortalCandidates()
        end

        if not State.TargetRoot or not targetIsValid() then
            local model, root, humanoid = findNearestTarget()

            State.TargetModel = model
            State.TargetRoot = root
            State.TargetHumanoid = humanoid

            if model and root and humanoid then
                State.RoomClearTimer = 0
            end
        end
    end

    if not State.TargetRoot or not targetIsValid() then
        State.RoomClearTimer += dt
    end

    if State.FallbackTargetTimer > 0 then
        State.FallbackTargetTimer = math.max(
            0,
            State.FallbackTargetTimer - dt
        )
    end

    State.TargetTimer += dt

    local targetInterval =
        Config.PerformanceMode
        and math.max(Config.TargetRefresh, 0.25)
        or math.min(Config.TargetRefresh, 0.50)

    if State.TargetTimer >= targetInterval then
        State.TargetTimer = 0
        refreshTarget()
    end

    State.PortalTimer += dt

    local portalInterval =
        Config.PerformanceMode
        and math.max(Config.PortalRefresh, 1.0)
        or math.min(Config.PortalRefresh, 1.5)

    if State.PortalTimer >= portalInterval then
        State.PortalTimer = 0

        if Config.AutoProgressStage and not State.StageBusy then
            task.spawn(function()
                local ok, err = pcall(moveToNextStage)

                if not ok then
                    State.StageBusy = false
                    State.DoorBusy = false
                    State.RoomClearTimer = 0
                    State.CurrentAction = "Recovering"

                    if Config.Debug then
                        warn("[IronSoul] stage error:", err)
                    end
                end
            end)
        end
    end

    if State.EmergencyBusy then
        State.CurrentAction = "Emergency Escape"
    elseif Config.AutoAvoid and State.DangerPart then
        updateAutoAvoid(dt)
    elseif Config.AutoProgressStage and State.StageBusy then
        if State.CurrentAction == "Farming" then
            State.CurrentAction = "Portal"
        end
    else
        lockCombatPosition()

        State.AttackTimer += dt
        if State.AttackTimer >= Config.AttackInterval then
            State.AttackTimer = 0
            updateKillAura()
        end

        State.CurrentAction = "Farming"
    end

    State.SkillTimer += dt

    if State.SkillTimer >= Config.SkillInterval then
        State.SkillTimer = 0

        if Config.AutoSkill and targetIsValid() then
            task.spawn(useSkills)
        end
    end
end)

local function unload()
    if State.Unloaded then
        return
    end

    State.Unloaded = true
    Config.AutoFarm = false
    _G.AutoFarm = false

    disconnectList(CharacterConnections)
    disconnectList(Connections)

    pcall(function()
        local pGui = (typeof(gethui) == "function") and gethui() or CoreGui
        if not pGui then pGui = playerGui end
        if pGui:FindFirstChild("ObsidianGlass2_UI") then
            pGui.ObsidianGlass2_UI:Destroy()
        end
        if pGui:FindFirstChild("ObsidianGlass_NotifHolder") then
            pGui.ObsidianGlass_NotifHolder:Destroy()
        end
    end)

    State.Character = nil
    State.Humanoid = nil
    State.Root = nil
    State.TargetModel = nil
    State.TargetRoot = nil
    State.TargetHumanoid = nil
    State.Portal = nil

    debugPrint("Unloaded")
end

_G.IronSoulUnload = unload

