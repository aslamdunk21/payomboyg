-- 🔁 CORE HEARTBEAT DRIVE (COMBAT + STAGE ENTRY + AVOIDANCE + RECOVERY)
RunService.Heartbeat:Connect(function(dt)
    if State.Unloaded then return end
    State.Stats.Heartbeats += 1

    if not (Config.AutoFarm or Autofarm) then
        State.TargetModel = nil
        State.TargetRoot = nil
        State.TargetHumanoid = nil
        State.WatchdogTimer = 0
        State.StageBusyTimer = 0
        State.CurrentAction = "Idle"
        if type(SetCurrentEnemy) == "function" then pcall(SetCurrentEnemy, nil) end
        return
    end

    if not State.Character or not State.Root or not State.Humanoid or State.Humanoid.Health <= 0 then return end

    -- Clear WhiteEffect UI overlay if present
    pcall(function()
        local screenDesign = player.PlayerGui:FindFirstChild("ScreenDesign")
        if screenDesign then
            local we = screenDesign:FindFirstChild("WhiteEffect")
            if we then we:Destroy() end
        end
    end)

    -- Watchdog Timer: auto-recover if stuck in stage transition > 6 seconds
    State.WatchdogTimer += dt
    if State.StageBusy then
        State.StageBusyTimer += dt
        if State.StageBusyTimer >= 6 then
            State.StageBusy = false
            State.DoorBusy = false
            State.StageBusyTimer = 0
            State.RoomClearTimer = 0
            State.CurrentAction = "Recovering"
        end
    else
        State.StageBusyTimer = 0
    end

    if State.WatchdogTimer >= 2 then
        State.WatchdogTimer = 0
        if Config.AutoProgressStage and not State.StageBusy then rebuildPortalCandidates() end
        if not State.TargetRoot or not targetIsValid() then
            local model, root, hum = findNearestTarget()
            State.TargetModel = model; State.TargetRoot = root; State.TargetHumanoid = hum
            if model and root and hum then State.RoomClearTimer = 0 end
        end
    end

    if not State.TargetRoot or not targetIsValid() then State.RoomClearTimer += dt end
    if State.FallbackTargetTimer > 0 then State.FallbackTargetTimer = math.max(0, State.FallbackTargetTimer - dt) end

    -- Target Scan Cadence
    State.TargetTimer += dt
    local targetInterval = Config.PerformanceMode and 0.25 or 0.15
    if State.TargetTimer >= targetInterval then
        State.TargetTimer = 0
        refreshTarget()
    end

    -- Portal / Door Auto-Entry Cadence
    State.PortalTimer += dt
    local portalInterval = Config.PerformanceMode and 1.0 or 0.8
    if State.PortalTimer >= portalInterval then
        State.PortalTimer = 0
        if Config.AutoProgressStage and not State.StageBusy then
            task.spawn(function()
                local ok, err = pcall(moveToNextStage)
                if not ok then
                    State.StageBusy = false; State.DoorBusy = false; State.RoomClearTimer = 0
                    State.CurrentAction = "Recovering"
                end
            end)
        end
    end

    -- Combat Position Lock / Auto Avoid / Emergency Escape
    if State.EmergencyBusy then
        State.CurrentAction = "Emergency Escape"
    elseif Config.AutoAvoid and State.DangerPart then
        updateAutoAvoid(dt)
    elseif Config.AutoProgressStage and State.StageBusy then
        if State.CurrentAction == "Farming" then State.CurrentAction = "Portal" end
    else
        lockCombatPosition()
        State.AttackTimer += dt
        if State.AttackTimer >= Config.AttackInterval then
            State.AttackTimer = 0
            updateKillAura()
        end
        State.CurrentAction = "Farming"
    end

    -- Skill Cadence
    State.SkillTimer += dt
    if State.SkillTimer >= Config.SkillInterval then
        State.SkillTimer = 0
        if Config.AutoSkill and targetIsValid() then task.spawn(useSkills) end
    end
end)

