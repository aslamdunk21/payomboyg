-- ── REMOTE PATH CACHE (WaitForChild-based, called once) ──
local _RC = {}
local function getRemote(path)
    if _RC[path] then return _RC[path] end
    local ok, result = pcall(function()
        local parts = string.split(path, ".")
        local obj = game:GetService(parts[1])
        for i = 2, #parts do
            obj = obj:WaitForChild(parts[i], 8)
            if not obj then return nil end
        end
        return obj
    end)
    if ok and result then _RC[path] = result end
    return ok and result or nil
end
