local QuestLogs = {}
local function AddQuestLog(msg, isError)
    local timeStr = os.date("%H:%M:%S")
    local icon = isError and "❌ " or "ℹ️ "
    local entry = string.format("[%s] %s%s", timeStr, icon, tostring(msg))
    table.insert(QuestLogs, 1, entry)
    if #QuestLogs > 30 then table.remove(QuestLogs, #QuestLogs) end
    print("📜 [QuestLog] " .. entry)
    pcall(function() AddSystemLog(msg, isError and "ERROR" or "QUEST") end)
end

local _questState = {
    phase         = "idle",
    lastFetch     = 0,
    fetchCooldown = 60,
    pendingQuests = {},
    currentIdx    = 0,
    telemetry     = {
        Name       = "-",
        Progress   = "0 / 0",
        Type       = "-",
        Target     = "-",
        Status     = "🟢 Idle",
        NextAction = "-",
        LastAction = "System Initialized"
    }
}

local function _getRealServerQuests()
    local quests = {}

    -- Method 1: DataUtil PlayerData
    pcall(function()
        if DataUtil then
            local pd = DataUtil:GetPlayerData(player)
            if pd and pd.DailyQuest then
                for qId, qData in pairs(pd.DailyQuest) do
                    if type(qData) == "table" then
                        local isDone = qData.Completed or qData.IsDone or (qData.Progress and qData.Target and qData.Progress >= qData.Target)
                        if not isDone then
                            table.insert(quests, {
                                Id = qId,
                                Type = qData.Type or qData.QuestType or "DialogNpc",
                                Param = qData.Param or qData.NpcId or qData.TargetWindow or "",
                                Target = qData.Target or 1,
                                Progress = qData.Progress or 0,
                            })
                        end
                    end
                end
            end
        end
    end)

    -- Method 2: GUI Attributes
    if #quests == 0 then
        pcall(function()
            local pg = player and player:FindFirstChildOfClass("PlayerGui")
            local questGui = pg and (pg:FindFirstChild("QuestGui") or pg:FindFirstChild("DailyQuestGui") or pg:FindFirstChild("ScreenDailyQuest", true))
            if questGui then
                for _, v in ipairs(questGui:GetDescendants()) do
                    local qId = v:GetAttribute("QuestId") or v:GetAttribute("questId")
                    local isDone = v:GetAttribute("Completed") or v:GetAttribute("IsDone")
                    local qType = v:GetAttribute("QuestType") or v:GetAttribute("Type") or "DialogNpc"
                    local qParam = v:GetAttribute("QuestParam") or v:GetAttribute("Param") or ""
                    if qId and not isDone then
                        table.insert(quests, { Id = qId, Type = qType, Param = qParam, Target = 1, Progress = 0 })
                    end
                end
            end
        end)
    end

    return quests
end

local function _executeQuest(quest)
    if not quest then return end
    safeCall("_executeQuest", function()
        local taskRE = getRemote("ReplicatedStorage.Framework.Features.TaskSystem.TaskRE")
        local qType  = tostring(quest.Type or "")
        local qParam = tostring(quest.Param or "")

        AddQuestLog(string.format("Executing Task Progress: %s (%s)", qType, qParam))
        if qType:find("Dialog") or qType:find("NPC") or qType:find("Talk") then
            if taskRE and qParam ~= "" then
                taskRE:FireServer("UpdateTaskProgress", "DialogNpc", qParam)
                task.wait(0.3)
            end
        elseif qType:find("Open") or qType:find("Visit") or qType:find("GUI") then
            if taskRE and qParam ~= "" then
                taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", qParam)
                task.wait(0.3)
            end
        elseif taskRE then
            taskRE:FireServer("UpdateTaskProgress", qType, qParam)
        end
    end)
end

