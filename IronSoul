-- #29 & #30: RECOVERY MANAGER & SYSTEM WATCHDOG ENGINE
-- ════════════════════════════════════════════════════

local RecoveryManager = {
    failureCount = 0
}

function RecoveryManager.Diagnose()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if not hrp or not hum or hum.Health <= 0 then
        return "CharacterDead"
    end

    if State.Phase == "Queue" and phaseAge() > 30 then
        return "StuckInQueue"
    end

    if State.Phase == "RoomCreated" and phaseAge() > 20 then
        return "StuckInRoom"
    end

    return "OK"
end

function RecoveryManager.Recover(issue)
    warn(string.format("🔄 [PayomboyZ IRS Recovery] Issue Detected: %s | Failure Count: %d", tostring(issue), RecoveryManager.failureCount + 1))
    RecoveryManager.failureCount = RecoveryManager.failureCount + 1

    safeCall("RecoveryManager.Recover", function()
        -- 1. Leave Stale Room
        local matchRE = getRemote("ReplicatedStorage.Remotes.GameMatchRE")
        if matchRE then matchRE:FireServer("LeaveRoom") end

        -- 2. Close All Windows
        CloseAllNPCWindows()

        -- 3. Teleport to Safe Town Center
        TeleportToTown()

        -- 4. Reset Global State to Lobby
        State._lastRoomTime = 0
        setPhase("Lobby")

        -- 5. If repeated failures >= 3, force character reload / reset
        if RecoveryManager.failureCount >= 3 then
            warn("⚠️ [PayomboyZ IRS] Repeated 3+ Failures! Initiating Character Reset...")
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = 0 end
            task.wait(4)
            RecoveryManager.failureCount = 0
        end
    end)
end

-- #30 System Watchdog Engine (Periodic Healthcheck Every 5s)
task.spawn(function()
    while task.wait(5) do
        if State.Unloaded then break end
        safeCall("SystemWatchdog", function()
            local issue = RecoveryManager.Diagnose()
            if issue ~= "OK" then
                RecoveryManager.Recover(issue)
            else
                -- Action succeeded naturally, decay failure count
                if RecoveryManager.failureCount > 0 then
                    RecoveryManager.failureCount = math.max(0, RecoveryManager.failureCount - 0.2)
                end
            end
        end)
    end
end)

