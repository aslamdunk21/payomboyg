local function getAvatarImage()
    if customAvatarAsset then return customAvatarAsset end
    local uid = (player and player.UserId) or 1
    return "rbxthumb://type=AvatarHeadShot&id=" .. uid .. "&w=150&h=150"
end

local function registerAvatarLabel(imgLabel)
    if not imgLabel then return end
    table.insert(registeredAvatarLabels, imgLabel)
    imgLabel.Image = getAvatarImage()
end

