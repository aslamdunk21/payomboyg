local function findLobbyRoomForWorld(worldId)
    local matchFolder = workspace:FindFirstChild("MatchRoom")
    if not matchFolder then return nil end
    for _, room in ipairs(matchFolder:GetChildren()) do
        local clientScript = room:FindFirstChild("ClientMatchRoom")
        local valObj = clientScript and clientScript:FindFirstChild("Value")
        if valObj and valObj:IsA("StringValue") and valObj.Value == worldId then
            return room
        end
    end
    if worldId == "World1" then return matchFolder:FindFirstChild("Room2") or matchFolder:FindFirstChild("Room1") end
    if worldId == "World2" then return matchFolder:FindFirstChild("Room5") or matchFolder:FindFirstChild("Room6") end
    return matchFolder:GetChildren()[1]
end

local function runLobbyDungeonSelect()
    local matchFolder = workspace:FindFirstChild("MatchRoom")
    if not matchFolder then return end -- Inside dungeon, do nothing

    if State.StageBusy or State.DoorBusy then return end

    -- Step 1: Open ScreenMatch Window via TaskRE
    pcall(function()
        local taskRE = ReplicatedStorage:FindFirstChild("Framework")
            and ReplicatedStorage.Framework:FindFirstChild("Features")
            and ReplicatedStorage.Framework.Features:FindFirstChild("TaskSystem")
            and ReplicatedStorage.Framework.Features.TaskSystem:FindFirstChild("TaskRE")
        if taskRE then
            taskRE:FireServer("UpdateTaskProgress", "OpenGUIWindow", "ScreenMatch")
        end
    end)

    -- Step 2: Fire SelectWorld RemoteEvent with chosen World & Difficulty
    local worldId = Config.SelectedWorldId or SelectedWorld or "World1"
    local diffNum = Config.SelectedDifficultyNum or SelectedStageNum or 1

    pcall(function()
        local worldUtilRE = ReplicatedStorage:FindFirstChild("Framework")
            and ReplicatedStorage.Framework:FindFirstChild("Gameplay")
            and ReplicatedStorage.Framework.Gameplay:FindFirstChild("WorldPlace")
            and ReplicatedStorage.Framework.Gameplay.WorldPlace:FindFirstChild("WorldUtil")
            and ReplicatedStorage.Framework.Gameplay.WorldPlace.WorldUtil:FindFirstChild("RemoteEvent")
        if worldUtilRE then
            worldUtilRE:FireServer("SelectWorld", worldId, diffNum)
        end
    end)

    -- Step 3: Create Match Room via GameMatchRE ("CreatRoom")
    pcall(function()
        local gameMatchRE = ReplicatedStorage:FindFirstChild("Remotes")
            and ReplicatedStorage.Remotes:FindFirstChild("GameMatchRE")
        if gameMatchRE then
            gameMatchRE:FireServer("CreatRoom", worldId, diffNum, 4)
        end
    end)

    -- Step 4: Teleport player to matching lobby MatchRoom portal
    pcall(function()
        local targetRoom = findLobbyRoomForWorld(worldId)
        if targetRoom and State.Root then
            State.Root.CFrame = targetRoom:GetPivot()

            local touchFolder = targetRoom:FindFirstChild("Touch")
            if touchFolder then
                for _, part in ipairs(touchFolder:GetChildren()) do
                    if part:IsA("BasePart") and type(firetouchinterest) == "function" then
                        pcall(firetouchinterest, State.Root, part, 0)
                        task.wait(0.02)
                        pcall(firetouchinterest, State.Root, part, 1)
                    end
                end
            end
        end
    end)
end

