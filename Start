-- 🔑 ฟังก์ชันส่ง Key เข้าสู่ Luarmor Engine
-- ==============================================================================
local function PassToKeyChecker(userKey)
    if not userKey or userKey == "" then return end
    userKey = userKey:gsub("%s+", "")

    SaveKey(userKey)
    if getgenv then
        getgenv().PayomboyZ_InputKey = userKey
        getgenv().script_key = userKey
    else
        pcall(function() _G.script_key = userKey end)
    end

    -- Bypass suspicious Luarmor loader and directly invoke LoaderPBG
    local loaderLoaded = false
    pcall(function()
        local paths = {
            "loader.txt",
            "Loader.txt"
        }
        if isfile and readfile then
            for _, p in ipairs(paths) do
                if isfile(p) then
                    local code = readfile(p)
                    if code and #code > 0 then
                        local fn = loadstring(code)
                        if fn then
                            loaderLoaded = true
                            fn()
                            break
                        end
                    end
                end
            end
        end
    end)

    if not loaderLoaded then
        pcall(function()
            loadstring(safeFetch(LuarmorConfig.LoaderURL .. "?t=" .. tostring(tick())))()
        end)
    end
end

