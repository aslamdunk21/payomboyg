-- 🎮 ระบบดึงข้อมูลแมพแบบ Dynamic อ่านจาก loader.txt โดยตรงอัตโนมัติ
-- ==============================================================================
local function GetDynamicSupportedGames()
    local games = {}

    -- 1. อ่านตรงจาก GitHub LoaderPBG ล่าสุดก่อนเสมอ (ป้องกัน Cache ด้วย ?t=tick())
    local loaderCode = ""
    pcall(function()
        loaderCode = game:HttpGet(LuarmorConfig.LoaderURL .. "?t=" .. tostring(tick()))
    end)

    -- หาก HttpGet ไม่สำเร็จ (เน็ตหลุด) ค่อยดึงจาก Memory หรือไฟล์ในเครื่องเป็น Fallback
    if loaderCode == "" and isfile and readfile then
        pcall(function()
            local paths = {
                "loader.txt",
                "Loader.txt",
                "c:/Users/Dream/Desktop/Roblox Script/Login/loader.txt"
            }
            for _, p in ipairs(paths) do
                if isfile(p) then
                    local code = readfile(p)
                    if code and #code > 0 then loaderCode = code; break end
                end
            end
        end)
    end

    -- 2. แกะตาราง NormalRouter และ VVIPRouter ด้วย String Index Substring Parsing
    if loaderCode ~= "" then
        local normalStart = loaderCode:find("NormalRouter%s*=")
        local vvipStart = loaderCode:find("VVIPRouter%s*=")
        local pcallStart = loaderCode:find("pcall%s*%(") or #loaderCode

        local normalSection = (normalStart and vvipStart) and loaderCode:sub(normalStart, vvipStart - 1) or loaderCode
        local vvipSection = (vvipStart) and loaderCode:sub(vvipStart, pcallStart) or loaderCode

        for placeIdStr, name in normalSection:gmatch("%[%s*(%d+)%s*%]%s*=%s*{%s*Name%s*=%s*[\"'](.-)[\"']") do
            local pid = tonumber(placeIdStr)
            if pid then games[pid] = name end
        end

        for placeIdStr, name in vvipSection:gmatch("%[%s*(%d+)%s*%]%s*=%s*{%s*Name%s*=%s*[\"'](.-)[\"']") do
            local pid = tonumber(placeIdStr)
            if pid then games[pid] = name .. " (VVIP)" end
        end
    end

    -- 3. รวมข้อมูลจาก Memory (_G / getgenv) เผื่อมีแมพที่พึ่งโหลดเข้า Memory
    local nRouter = (getgenv and getgenv().PayomboyZ_NormalRouter) or _G.PayomboyZ_NormalRouter
    local vRouter = (getgenv and getgenv().PayomboyZ_VVIPRouter) or _G.PayomboyZ_VVIPRouter
    if type(nRouter) == "table" then
        for id, data in pairs(nRouter) do
            if data and data.Name then games[id] = data.Name end
        end
    end
    if type(vRouter) == "table" then
        for id, data in pairs(vRouter) do
            if data and data.Name then games[id] = data.Name .. " (VVIP)" end
        end
    end

    return games
end

local function resolveGameName()
    local placeId = game.PlaceId
    local supportedGames = GetDynamicSupportedGames()
    if supportedGames[placeId] then
        return supportedGames[placeId]
    end
    local gameName = nil
    pcall(function()
        local info = MarketplaceService:GetProductInfo(placeId)
        if info and info.Name then
            gameName = info.Name
        end
    end)
    return gameName or ("Place: " .. tostring(placeId))
end

