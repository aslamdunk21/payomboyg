        BackgroundTransparency = 1,
        Image = "rbxassetid://0",
        ImageTransparency = 1,
        ZIndex = 1000,
    }, introOverlay)

    task.spawn(function()
        pcall(function()
            if introLogo and introLogo.Parent then
                introLogo.Image = "rbxassetid://10723346959"
            end
        end)
    end)

    local introTitle = create("TextLabel", {
        Name = "IntroTitle",
        Size = UDim2.new(1, -160, 0, 36),
        Position = UDim2.new(0, 150, 0.5, -26),
