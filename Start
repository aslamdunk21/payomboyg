-- Safe HttpGet wrapper without suspicious global indexing or metamethod hooks
local function safeFetch(url)
    if not url or url == "" then return "" end
    local content = ""
    pcall(function()
        content = game:HttpGet(url)
    end)
    return content or ""
end

