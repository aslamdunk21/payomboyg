local function LoadSavedKey()
    local saved = ""
    pcall(function()
        if isfile and isfile(LuarmorConfig.SavedKeyFile) and readfile then
            saved = readfile(LuarmorConfig.SavedKeyFile)
        end
    end)
    if type(saved) == "string" then
        return saved:gsub("%s+", "")
    end
    return ""
end

local function GetPassedScriptKey()
    local key = nil
    pcall(function()
        if getgenv then
            local genvKey = getgenv().script_key or getgenv().PayomboyZ_InputKey
            if type(genvKey) == "string" and genvKey ~= "" then
                key = genvKey
            end
        end
        if not key and type(_G.script_key) == "string" and _G.script_key ~= "" then
            key = _G.script_key
        end
        if not key and type(shared.script_key) == "string" and shared.script_key ~= "" then
            key = shared.script_key
        end
        if not key and type(script_key) == "string" and script_key ~= "" then
            key = script_key
        end
    end)
    if key and type(key) == "string" then
        return key:gsub("%s+", "")
    end
    return ""
end

local function SaveKey(userKey)
    if not userKey or userKey == "" then return end
    userKey = userKey:gsub("%s+", "")
    pcall(function()
        if writefile then
            writefile(LuarmorConfig.SavedKeyFile, userKey)
        end
    end)
end

