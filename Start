    local busy = false
    local function redeemKey()
        if busy then return end
        if isXenoExecutor() then
            setStatus("❌ ตัวรัน Xeno ไม่รองรับ (Not Supported)", COLORS.danger)
            return
        end
        local rawKey = input.Text or ""
        local key = rawKey:gsub("%s+", "")
        if key == "" then
            setStatus("กรุณากรอก Key ก่อนกดปุ่มนี้", COLORS.warning)
            return
        end

        busy = true
        setButtonEnabled(redeem, false)

        -- 🌟 VVIP Key: bypass Luarmor โดยตรง
        if key == LuarmorConfig.SpecialKey then
            task.spawn(function()
                setButtonText(redeem, "[1/3] Verifying VVIP...")
                setStatus("👑 [1/3] Verifying VVIP Key...", COLORS.cyan)
                task.wait(0.3)

                setButtonText(redeem, "[2/3] Connecting...")
                setStatus("🚀 [2/3] Bypassing Luarmor → Loading Hub...", COLORS.cyan)
                task.wait(0.3)

                setButtonText(redeem, "[3/3] Launching!")
                setStatus("✅ [3/3] VVIP Access Granted! Launching now...", COLORS.success)
                task.wait(0.35)

                if gui and gui.Parent then gui:Destroy() end
                PassToKeyChecker(key)
            end)
            return
        end

        -- 🔒 Luarmor Key: แสดง 1/5..5/5 แล้วปิด UI → ยิง Luarmor ทันที
        -- ErrorWatcher ใน PassToKeyChecker จะจัดการถ้าคีย์ผิด/หมดอายุ
        task.spawn(function()
            setButtonText(redeem, "[1/5] Checking...")
            setStatus("🔍 [1/5] Checking Key format & length...", COLORS.cyan)
            task.wait(0.4)

            setButtonText(redeem, "[2/5] Connecting...")
            setStatus("📡 [2/5] Connecting to Luarmor API...", COLORS.cyan)
            task.wait(0.4)

            setButtonText(redeem, "[3/5] Verifying...")
            setStatus("🛡️ [3/5] Verifying HWID & Whitelist...", COLORS.cyan)
            task.wait(0.4)

            setButtonText(redeem, "[4/5] Saving...")
            setStatus("💾 [4/5] Saving key to device...", COLORS.cyan)
            task.wait(0.4)

            setButtonText(redeem, "[5/5] Launching!")
            setStatus("🚀 [5/5] Launching PayomboyZ Hub...", COLORS.success)
            task.wait(0.4)

            -- ปิด UI แล้วยิง Luarmor ทันที — ไม่ kick ผู้ใช้ออกจากเกม
            -- ถ้า Luarmor ขึ้น error, ErrorWatcher จะลบคีย์ผิด + เปิด UI ใหม่โดยอัตโนมัติ
            if gui and gui.Parent then gui:Destroy() end
            PassToKeyChecker(key)
        end)
    end

    copyError.Activated:Connect(function()
        if lastErrorDetail ~= "" and copyText(lastErrorDetail) then
