local function LoadCustomLogo(imageLabel)
    task.spawn(function()
        local loaded = false
        pcall(function()
            if isfile and not isfile(LuarmorConfig.LogoPath) and writefile then
                local rawData = game:HttpGet(LuarmorConfig.LogoURL)
                if rawData and #rawData > 0 then
                    writefile(LuarmorConfig.LogoPath, rawData)
                end
            end
            
            if getcustomasset and isfile and isfile(LuarmorConfig.LogoPath) then
                imageLabel.Image = getcustomasset(LuarmorConfig.LogoPath)
                loaded = true
            elseif getsynasset and isfile and isfile(LuarmorConfig.LogoPath) then
                imageLabel.Image = getsynasset(LuarmorConfig.LogoPath)
                loaded = true
            end
        end)
        if not loaded then
            imageLabel.Image = LuarmorConfig.LogoURL
        end
    end)
end

