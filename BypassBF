-- ตัวอย่างการใช้งาน
-- ══════════════════════════════════════════════════════════════════

-- วิธีที่ 1: ใช้ Checkpoint Chunking (แนะนำ - ปลอดภัยกว่า)
local destination1 = CFrame.new(10000, 200, -5000)
BypassCFrameSafe(destination1)

-- วิธีที่ 2: ใช้ Tween (เร็วกว่าแต่ว่าเสี่ยง detection)
local destination2 = CFrame.new(8000, 150, -3000)
TweenFlight(destination2, 400)

-- วิธีที่ 3: บินไปหาจุดหมายที่มีอยู่แล้วใน workspace
local function FlyToPart(partName, heightOffset)
    heightOffset = heightOffset or 50
    local part = workspace:FindFirstChild(partName)
    if part and part:IsA("BasePart") then
        local targetCF = CFrame.new(part.Position.X, part.Position.Y + heightOffset, part.Position.Z)
        BypassCFrameSafe(targetCF)
    end
end

