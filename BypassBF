-- 🔥 Patch: ColorShiftObjectDescendants (Missing Player Fix)
-- ============================================================
-- แก้ Error "MISSING PLAYER" ที่เกิดจาก Effect ของเกม
-- ============================================================

local function PatchColorShift()
    local replicatedStorage = game:GetService("ReplicatedStorage")
    local util = replicatedStorage:FindFirstChild("Util")
    if not util then return end

    local oldColorShift = util.ColorShiftObjectDescendants
    if not oldColorShift then return end

    util.ColorShiftObjectDescendants = function(obj, player, ...)
        -- ถ้า player เป็น nil หรือไม่ใช่ Player ให้ใช้ LocalPlayer แทน
        if not player or not player:IsA("Player") then
            player = game.Players.LocalPlayer
        end

        -- ถ้ายังไม่มี player ให้ข้ามการทำงานเพื่อไม่ให้ error
        if not player then
            return
        end

        -- เรียกฟังก์ชันเดิมด้วย player ที่ถูกต้อง
        return oldColorShift(obj, player, ...)
    end

    print("[🛡️ PayomboyZ] ColorShift Patch Applied — Missing Player Fixed!")
end

pcall(PatchColorShift)

