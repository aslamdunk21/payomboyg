-- ─── 1. ANTI-PULL SYSTEM (แทนที่ SimulationRadius แบบเก่า) ───
-- ปัญหา: sethiddenproperty("SimulationRadius") ไม่ work ใน executor บางตัว
-- แก้: ใช้ CFrame lock + BodyPosition แทน

local CharacterLock = {
    Active = false,
    TargetCFrame = nil,
    Connection = nil
}

local function LockCharacterPosition(cframe)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    CharacterLock.Active = true
    CharacterLock.TargetCFrame = cframe
    
    -- ลบ velocity เก่าที่อาจขัดแย้ง
    for _, v in ipairs(hrp:GetChildren()) do
        if v:IsA("BodyVelocity") or v:IsA("BodyPosition") or v:IsA("AlignPosition") then
            v:Destroy()
        end
    end
    
    -- ใช้ AlignPosition + AlignOrientation (work ในทุก executor)
    local alignPos = Instance.new("AlignPosition")
    alignPos.Name = "BypassLock_Pos"
    alignPos.Attachment0 = Instance.new("Attachment", hrp)
    alignPos.Attachment0.Name = "LockAttach"
    alignPos.MaxForce = 1000000
    alignPos.MaxVelocity = math.huge
    alignPos.Responsiveness = 200
    alignPos.RigidityEnabled = true
    alignPos.Parent = hrp
    
    local targetAttach = Instance.new("Attachment")
    targetAttach.Name = "TargetAttach"
    targetAttach.CFrame = cframe
    targetAttach.Parent = workspace.Terrain
    
    alignPos.Attachment1 = targetAttach
    alignPos.Enabled = true
    
    -- BodyGyro สำหรับล็อกทิศทาง
    local alignOri = Instance.new("AlignOrientation")
    alignOri.Name = "BypassLock_Ori"
    alignOri.Attachment0 = hrp:FindFirstChild("RootAttachment") or alignPos.Attachment0
    alignOri.Attachment1 = targetAttach
    alignOri.MaxTorque = 1000000
    alignOri.MaxAngularVelocity = math.huge
    alignOri.Responsiveness = 200
    alignOri.RigidityEnabled = true
    alignOri.Parent = hrp
    
    CharacterLock.Connection = RunService.Heartbeat:Connect(function()
        if not CharacterLock.Active then return end
        if not hrp.Parent then
            CharacterLock.Active = false
            CharacterLock.Connection:Disconnect()
            return
        end
        -- Force position ทุก frame (ป้องกัน server pull)
        if CharacterLock.TargetCFrame then
            targetAttach.CFrame = CharacterLock.TargetCFrame
            hrp.CFrame = CharacterLock.TargetCFrame
        end
    end)
end

local function UnlockCharacterPosition()
    CharacterLock.Active = false
    if CharacterLock.Connection then
        CharacterLock.Connection:Disconnect()
        CharacterLock.Connection = nil
    end
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local lockPos = hrp:FindFirstChild("BypassLock_Pos")
            if lockPos then lockPos:Destroy() end
            local lockOri = hrp:FindFirstChild("BypassLock_Ori")
            if lockOri then lockOri:Destroy() end
        end
    end
end

-- ─── 2. VALIDATOR RE-SCAN SYSTEM (แก้อัปเดต upvalue indices) ───
-- ปัญหา: Blox Fruits อัปเดตแล้วเปลี่ยน upvalue index ของ CombatFramework.attack
-- แก้: สแกนหา upvalues ใหม่ทุก 30 วินาที

local ValidatorCache = {
    u8_idx = nil,  -- seed
    u9_idx = nil,  -- modulus
    u7_idx = nil,  -- increment
    u10_idx = nil, -- counter
    LastScan = 0,
    ScanInterval = 30
}

local function ScanValidatorUpvalues()
    local CombatFramework = nil
    pcall(function()
        CombatFramework = require(LocalPlayer.PlayerScripts:WaitForChild("CombatFramework"))
    end)
    if not CombatFramework then return false end
    
    local cfUpvalues = getupvalues(CombatFramework)
    local CombatFrameworkR = nil
    for i, v in ipairs(cfUpvalues) do
        if typeof(v) == "table" and rawget(v, "activeController") then
            CombatFrameworkR = v
            break
        end
    end
    if not CombatFrameworkR then return false end
    
    local AC = CombatFrameworkR.activeController
    if not AC or not AC.attack then return false end
    
    -- ทดสอบ upvalue indices 3-8 (ครอบคลุมทุก version)
    for i = 3, 8 do
        local val = debug.getupvalue(AC.attack, i)
        if typeof(val) == "number" and val > 1000000 then
            -- น่าจะเป็น modulus (u9)
            ValidatorCache.u9_idx = i
        end
        if typeof(val) == "number" and val > 100 and val < 1000000 then
            -- น่าจะเป็น seed หรือ increment
            if not ValidatorCache.u8_idx then
                ValidatorCache.u8_idx = i
            elseif not ValidatorCache.u7_idx then
                ValidatorCache.u7_idx = i
            end
        end
    end
    
    -- หา counter (u10) — มักเป็นจำนวนเต็มที่เพิ่มขึ้นเรื่อยๆ
    for i = 3, 8 do
        local val = debug.getupvalue(AC.attack, i)
        if typeof(val) == "number" and math.floor(val) == val and val < 1000 then
            if i ~= ValidatorCache.u8_idx and i ~= ValidatorCache.u9_idx and i ~= ValidatorCache.u7_idx then
                ValidatorCache.u10_idx = i
                break
            end
        end
    end
    
    ValidatorCache.LastScan = tick()
    return ValidatorCache.u8_idx and ValidatorCache.u9_idx and ValidatorCache.u7_idx and ValidatorCache.u10_idx
end

-- Auto re-scan ทุก 30 วิ
task.spawn(function()
    while task.wait(ValidatorCache.ScanInterval) do
        if scriptRunning then
            pcall(ScanValidatorUpvalues)
        end
    end
end)

-- ─── 3. ENHANCED ATTACK FUNCTION (แก้ดาเมจไม่ขึ้น) ───
local LastAttackTime = 0
local AttackCount = 0
local LastAttackReset = tick()

local function BypassAttack(targets)
    if not getgenv().Configs.FastAttack then return end
    
    -- Rate limit: ป้องกัน queue l้น
    local now = tick()
    if now - LastAttackTime < 0.085 then return end
    LastAttackTime = now
    AttackCount = AttackCount + 1
    
    -- Reset counter ทุก 10 วิ (ป้องกัน overflow detection)
    if now - LastAttackReset > 10 then
        AttackCount = 0
        LastAttackReset = now
    end
    if AttackCount > 80 then return end -- Safety cap
    
    local char = LocalPlayer.Character
    if not char then return end
    
    -- 1. Activate tool ก่อน (สำคัญมาก — ถ้าไม่ activate ดาเมจไม่ขึ้น)
    local activeTool = char:FindFirstChildOfClass("Tool")
    if activeTool then
        pcall(function() activeTool:Activate() end)
    end
    
    -- 2. Simulate mouse click (บางที Remote อย่างเดียวไม่พอ)
    pcall(function()
        local VirtualUser = game:GetService("VirtualUser")
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
        task.wait(0.01)
        VirtualUser:Button1Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
    end)
    
    -- 3. เตรียม target list
    local bladehit = {}
    if type(targets) == "table" then
        for _, mob in ipairs(targets) do
            if mob and mob:FindFirstChild("HumanoidRootPart") then
                table.insert(bladehit, mob.HumanoidRootPart)
            end
        end
    elseif typeof(targets) == "Instance" and targets:FindFirstChild("HumanoidRootPart") then
        table.insert(bladehit, targets.HumanoidRootPart)
    end
    
    if #bladehit == 0 then return end
    
    -- 4. Validator bypass (หัวใจหลัก — ถ้าไม่มีอันนี้ดาเมจไม่ขึ้น)
    pcall(function()
        -- Re-scan ถ้า cache หมดอายุ
        if tick() - ValidatorCache.LastScan > ValidatorCache.ScanInterval then
            ScanValidatorUpvalues()
        end
        
        local CombatFramework = require(LocalPlayer.PlayerScripts:WaitForChild("CombatFramework"))
        local CombatFrameworkR = getupvalues(CombatFramework)[2]
        
        if CombatFrameworkR and CombatFrameworkR.activeController then
            local AC = CombatFrameworkR.activeController
            if AC and AC.attack then
                local u8 = debug.getupvalue(AC.attack, ValidatorCache.u8_idx or 5)
                local u9 = debug.getupvalue(AC.attack, ValidatorCache.u9_idx or 6)
                local u7 = debug.getupvalue(AC.attack, ValidatorCache.u7_idx or 4)
                local u10 = debug.getupvalue(AC.attack, ValidatorCache.u10_idx or 7)
                
                if u8 and u9 and u7 and u10 then
                    -- คำนวณ RNG ถัดไปตาม algorithm เกม
                    local u12 = (u8 * 798405 + u7 * 727595) % u9
                    local u13 = u7 * 798405
                    u12 = (u12 * u9 + u13) % 1099511627776
                    u8 = math.floor(u12 / u9)
                    u7 = u12 - u8 * u9
                    u10 = u10 + 1
                    
                    -- Inject ค่ากลับ
                    debug.setupvalue(AC.attack, ValidatorCache.u8_idx or 5, u8)
                    debug.setupvalue(AC.attack, ValidatorCache.u9_idx or 6, u9)
                    debug.setupvalue(AC.attack, ValidatorCache.u7_idx or 4, u7)
                    debug.setupvalue(AC.attack, ValidatorCache.u10_idx or 7, u10)
                    
                    -- ส่ง validator hash ให้เซิรฟเวอร์
                    local validator = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Validator")
                    if validator then
                        validator:FireServer(math.floor(u12 / 1099511627776 * 16777215), u10)
                    end
                end
            end
        end
    end)
    
    -- 5. ส่ง hit event
    pcall(function()
        local rigEvent = ReplicatedStorage:FindFirstChild("RigControllerEvent") or ReplicatedStorage:FindFirstChild("RigBehaviourEvent")
        if rigEvent then
            rigEvent:FireServer("hit", bladehit, 1, "")
        end
    end)
end

