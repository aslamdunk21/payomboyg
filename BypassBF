-- 🔥 PayomboyZ V6 — Network Replication Evasion Engine
-- ============================================================
-- เป้าหมาย: หลอก Server ว่าเรากำลังเคลื่อนที่แบบมีขั้นตอนจริง
-- ใช้ได้กับ Blox Fruits ทุกแมพ
-- ============================================================

local function AntiCheatBypassV6_NetworkReplication()

    local plr = game.Players.LocalPlayer
    local char = plr.Character or plr.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end

    -- ================================================================
    -- 1. ดัก NetworkOwnership — ถ้าเราเป็นเจ้าของ ให้ส่งตำแหน่งปลอม
    -- ================================================================
    local function takeOwnership()
        pcall(function()
            hrp:SetNetworkOwner(plr)
        end)
    end

    -- เรียกตอนเริ่ม
    takeOwnership()

    -- ดัก SetNetworkOwner เพื่อไม่ให้ Server แย่ง ownership
    local oldSetNetworkOwner = hrp.SetNetworkOwner
    hrp.SetNetworkOwner = function(self, player)
        if player == plr then
            return oldSetNetworkOwner(self, player)
        end
        -- ถ้าเกมพยายามเซ็ตให้ Server หรือคนอื่น ให้ข้าม
        return
    end

    -- ================================================================
    -- 2. ฟังก์ชันจำลองการเคลื่อนที่แบบ Replication-friendly
    -- ================================================================
    local moveQueue = {}
    local isMoving = false
    local lastSyncedPos = hrp.Position
    local lastSyncedCF = hrp.CFrame

    local function simulateReplication(targetPos, speed)
        if isMoving then
            table.insert(moveQueue, {targetPos, speed})
            return
        end

        isMoving = true
        local startPos = hrp.Position
        local distance = (targetPos - startPos).Magnitude

        if distance < 5 then
            isMoving = false
            return
        end

        -- คำนวณเวลา: ยิ่งไกลยิ่งใช้เวลานาน (เลียนแบบการเดินทางจริง)
        local moveDuration = distance / (speed or 280)
        if moveDuration < 0.08 then moveDuration = 0.08 end
        if moveDuration > 5 then moveDuration = 5 end -- ป้องกันนานเกิน

        local startTime = tick()
        local oldState = hum:GetState()
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)

        -- จำลองการเคลื่อนที่แบบมีขั้นตอน ทุก 0.03 วินาที (ประมาณ 33 FPS)
        while tick() - startTime < moveDuration do
            local elapsed = tick() - startTime
            local alpha = math.min(elapsed / moveDuration, 1)
            -- Ease In-Out Cubic (ดูเป็นธรรมชาติ)
            local smoothAlpha = alpha < 0.5 and 4 * alpha * alpha * alpha or 1 - math.pow(-2 * alpha + 2, 3) / 2
            local currentPos = startPos:Lerp(targetPos, smoothAlpha)

            -- อัปเดต CFrame ทีละน้อย
            hrp.CFrame = CFrame.new(currentPos)

            -- จำลอง Velocity ให้สอดคล้องกับระยะทางที่เปลี่ยนไป
            local deltaPos = currentPos - lastSyncedPos
            local dt = task.wait(0.03)
            if dt > 0 then
                local vel = deltaPos / dt
                hrp.Velocity = vel
                hrp.RotVelocity = Vector3.new(0, 0, 0)
            end

            -- อัปเดต AssemblyLinearVelocity (สำคัญมากสำหรับ Server)
            if hrp:IsA("BasePart") then
                hrp.AssemblyLinearVelocity = hrp.Velocity
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end

            lastSyncedPos = currentPos
            lastSyncedCF = hrp.CFrame

            -- แทรก Random Jitter ให้ดูเหมือน Network Delay (ป้องกัน Pattern Detection)
            if math.random(1, 20) == 1 then
                task.wait(math.random(1, 10) / 1000)
            end
        end

        -- จบ: ตั้งให้ตรงเป๊ะ
        hrp.CFrame = CFrame.new(targetPos)
        hrp.Velocity = Vector3.new(0, 0, 0)
        hrp.RotVelocity = Vector3.new(0, 0, 0)
        if hrp:IsA("BasePart") then
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end

        hum:ChangeState(oldState)
        isMoving = false
        lastSyncedPos = targetPos
        lastSyncedCF = CFrame.new(targetPos)

        -- ทำงานคิวถัดไป
        if #moveQueue > 0 then
            local next = table.remove(moveQueue, 1)
            simulateReplication(next[1], next[2])
        end
    end

    -- ================================================================
    -- 3. Override CFrame + Position (ใช้ Simulation แทนการเซ็ตตรง)
    -- ================================================================
    local mt = getrawmetatable(hrp) or {}
    local oldNewIndex = mt.__newindex

    mt.__newindex = function(self, key, value)
        if key == "CFrame" and type(value) == "userdata" and value:IsA("CFrame") then
            local dist = (value.Position - hrp.Position).Magnitude
            if dist > 20 then
                simulateReplication(value.Position, math.clamp(dist * 1.8, 200, 600))
                return
            end
        end

        if key == "Position" and type(value) == "Vector3" then
            local dist = (value - hrp.Position).Magnitude
            if dist > 20 then
                simulateReplication(value, math.clamp(dist * 1.8, 200, 600))
                return
            end
        end

        if oldNewIndex then
            return oldNewIndex(self, key, value)
        end
        rawset(self, key, value)
    end
    setrawmetatable(hrp, mt)

    -- ================================================================
    -- 4. หลอก Humanoid:MoveTo และ :SetState
    -- ================================================================
    local oldMoveTo = hum.MoveTo
    hum.MoveTo = function(self, targetPos)
        if type(targetPos) == "Vector3" then
            local dist = (targetPos - hrp.Position).Magnitude
            if dist > 20 then
                simulateReplication(targetPos, math.clamp(dist * 1.8, 200, 600))
                return
            end
        end
        return oldMoveTo(self, targetPos)
    end

    local oldSetState = hum.ChangeState
    hum.ChangeState = function(self, state)
        -- ถ้าเกมพยายามเปลี่ยนเป็น Falling หรือ Physics ที่อาจตรวจจับความผิดปกติ
        if state == Enum.HumanoidStateType.Falling then
            -- ให้เป็น GettingUp แทน (เลียนแบบการลงจอด)
            return oldSetState(self, Enum.HumanoidStateType.GettingUp)
        end
        return oldSetState(self, state)
    end

    -- ================================================================
    -- 5. ฟังก์ชัน SafeTeleport (ใช้ Simulation)
    -- ================================================================
    getgenv().SafeTeleport = function(targetPos, speed)
        if type(targetPos) == "Vector3" then
            simulateReplication(targetPos, speed or 300)
        elseif type(targetPos) == "CFrame" then
            simulateReplication(targetPos.Position, speed or 300)
        end
    end

    if _G.Teleport then
        local oldG = _G.Teleport
        _G.Teleport = function(pos, speed)
            getgenv().SafeTeleport(pos, speed or 300)
        end
    end

    -- ================================================================
    -- 6. Loop ป้องกันการโดนรีเซ็ตจาก Server
    -- ================================================================
    local targetPosBuffer = hrp.Position
    task.spawn(function()
        while task.wait(0.2) do
            if not isMoving then
                local currentPos = hrp.Position
                -- ถ้า Server ดึงกลับเกิน 50 หน่วย ให้กลับไปที่ target
                if (targetPosBuffer - currentPos).Magnitude > 50 then
                    hrp.CFrame = CFrame.new(targetPosBuffer)
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    hrp.RotVelocity = Vector3.new(0, 0, 0)
                    if hrp:IsA("BasePart") then
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end
                end
                -- อัปเดต target buffer
                targetPosBuffer = hrp.Position
            end
        end
    end)

    print("[🛡️ PayomboyZ] V6 Network Replication Evasion Loaded!")
end

pcall(AntiCheatBypassV6_NetworkReplication)
getgenv().PayomboyZ_AntiCheatBypassV6 = true

