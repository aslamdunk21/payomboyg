-- ─── 6. REPLACE BringMob FUNCTION (เวอร์ชันแก้ไข) ───
local function BypassBringMob(originMob)
    pcall(sethiddenproperty, LocalPlayer, "SimulationRadius", math.huge)
    local aname = originMob.Name
    local acf = originMob.HumanoidRootPart.CFrame
    local targets = {}
    
    table.insert(targets, {originMob, originMob:FindFirstChild("Head")})
    
    -- ดึงมอนสเตอร์ตัวที่สองมาใกล้ๆ
    if getgenv().Configs.BringMob then
        for _, v in ipairs(workspace.Enemies:GetChildren()) do
            if v ~= originMob 
            and string.find(v.Name:lower(), aname:lower(), 1, true) 
            and v:FindFirstChild("Humanoid") 
            and v:FindFirstChild("HumanoidRootPart") 
            and v.Humanoid.Health > 0 
            and (acf.Position - v.HumanoidRootPart.Position).Magnitude <= 350 then
                
                -- ใช้ CFrame โดยตรง (ไม่ใช้ BodyVelocity ที่อาจขัดแย้ง)
                v.HumanoidRootPart.CFrame = acf
                v.HumanoidRootPart.CanCollide = false
                v.Humanoid.WalkSpeed = 0
                v.Humanoid.JumpPower = 0
                
                table.insert(targets, {v, v:FindFirstChild("Head")})
                break
            end
        end
    end
    
    return targets
end

-- ─── 7. REPLACE Tween FUNCTION (เวอร์ชันแก้ไข — ไม่ขัดแย้งกับ lock) ───
local IsTweening = false
local TweenConnection = nil

local function BypassTween(targetCFrame, speed)
    speed = speed or 350
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Unlock ชั่วคราวก่อน tween
    UnlockCharacterPosition()
    IsTweening = true
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local tweenTime = distance / speed
    
    -- ใช้ Heartbeat สำหรับ movement ที่ smooth และยากต่อการ detect
    local startTime = tick()
    local startPos = hrp.CFrame
    
    if TweenConnection then TweenConnection:Disconnect() end
    
    TweenConnection = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - startTime
        local alpha = math.clamp(elapsed / tweenTime, 0, 1)
        
        -- Linear interpolation
        local newPos = startPos.Position:Lerp(targetCFrame.Position, alpha)
        local newLook = startPos.LookVector:Lerp(targetCFrame.LookVector, alpha)
        hrp.CFrame = CFrame.new(newPos, newPos + newLook)
        
        if alpha >= 1 then
            IsTweening = false
            TweenConnection:Disconnect()
            TweenConnection = nil
        end
    end)
end

