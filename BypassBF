-- ============================================================
-- 🔥 FIX: Teleport Interpolator + RemoteEvent Patch
-- ============================================================

local function TeleportFix()

    local plr = game.Players.LocalPlayer
    local char = plr.Character or plr.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end

    -- ================================================================
    -- 1. แก้ RemoteEvent หาย (RE/CollectedDragonEgg)
    -- ================================================================
    local function patchRemoteEvent()
        local replicated = game:GetService("ReplicatedStorage")
        if not replicated then return end

        -- ถ้า RemoteEvent หาย ให้สร้าง dummy ขึ้นมาเพื่อป้องกัน error
        local remotes = replicated:FindFirstChild("Remotes")
        if remotes then
            local dragonEgg = remotes:FindFirstChild("RE/CollectedDragonEgg")
            if not dragonEgg then
                local newEvent = Instance.new("RemoteEvent")
                newEvent.Name = "RE/CollectedDragonEgg"
                newEvent.Parent = remotes
                print("[🛡️] Created missing RemoteEvent: RE/CollectedDragonEgg")
            end
        end
    end
    pcall(patchRemoteEvent)

    -- ================================================================
    -- 2. แก้ Tool:Activate ตอนยังไม่ equipped
    -- ================================================================
    -- ดัก Tool:Activate ถ้า tool ไม่ได้ equipped ให้ equip ก่อน
    local oldActivate = nil
    for _, tool in ipairs(plr.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            if not oldActivate then
                oldActivate = tool.Activate
            end
            tool.Activate = function(self)
                if not self:IsA("Tool") then return end
                if self.Parent ~= char then
                    -- ถ้ายังไม่ได้ equip ให้ equips ก่อน
                    plr.Character = char
                    self.Parent = char
                    task.wait(0.05)
                end
                return oldActivate(self)
            end
        end
    end

    -- ================================================================
    -- 3. Teleport แบบลื่นไหล (ไม่กระตุก)
    -- ================================================================
    local isMoving = false
    local moveQueue = {}

    local function smoothTeleport(targetPos, speed)
        if isMoving then
            table.insert(moveQueue, {targetPos, speed})
            return
        end

        isMoving = true
        local startPos = hrp.Position
        local dist = (targetPos - startPos).Magnitude
        if dist < 3 then
            isMoving = false
            return
        end

        local duration = math.max(dist / (speed or 350), 0.05)
        local startTime = tick()

        -- หยุด Humanoid เพื่อไม่ให้ขัดกัน
        local oldState = hum:GetState()
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)

        while tick() - startTime < duration do
            local alpha = (tick() - startTime) / duration
            local smooth = alpha * alpha * (3 - 2 * alpha)
            local current = startPos:Lerp(targetPos, smooth)

            hrp.CFrame = CFrame.new(current)
            hrp.Velocity = (current - hrp.Position) / 0.03
            hrp.RotVelocity = Vector3.new(0, 0, 0)

            task.wait(0.03)
        end

        hrp.CFrame = CFrame.new(targetPos)
        hrp.Velocity = Vector3.new(0, 0, 0)
        hrp.RotVelocity = Vector3.new(0, 0, 0)

        hum:ChangeState(oldState)
        isMoving = false

        if #moveQueue > 0 then
            local next = table.remove(moveQueue, 1)
            smoothTeleport(next[1], next[2])
        end
    end

    -- ดัก CFrame
    local mt = getrawmetatable(hrp) or {}
    local oldNewIndex = mt.__newindex
    mt.__newindex = function(self, key, value)
        if key == "CFrame" and type(value) == "userdata" and value:IsA("CFrame") then
            local dist = (value.Position - hrp.Position).Magnitude
            if dist > 20 then
                smoothTeleport(value.Position, math.clamp(dist * 1.5, 200, 500))
                return
            end
        end
        if key == "Position" and type(value) == "Vector3" then
            local dist = (value - hrp.Position).Magnitude
            if dist > 20 then
                smoothTeleport(value, math.clamp(dist * 1.5, 200, 500))
                return
            end
        end
        if oldNewIndex then return oldNewIndex(self, key, value) end
        rawset(self, key, value)
    end
    setrawmetatable(hrp, mt)

    -- ฟังก์ชันให้สคริปต์หลักเรียก
    getgenv().SafeTeleport = function(pos, speed)
        if type(pos) == "Vector3" then
            smoothTeleport(pos, speed or 350)
        elseif type(pos) == "CFrame" then
            smoothTeleport(pos.Position, speed or 350)
        end
    end

    if _G.Teleport then
        local oldG = _G.Teleport
        _G.Teleport = function(pos, speed)
            getgenv().SafeTeleport(pos, speed or 350)
        end
    end

    print("[🛡️] Teleport Fix Loaded!")
end

pcall(TeleportFix)

