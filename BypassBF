-- ============================================================
-- 🔥 PayomboyZ V3 Extension — Teleport Evasion Module
-- ============================================================
-- ต่อท้าย V3 เพื่อให้วาปไกลไม่โดนดึงกลับ
-- ============================================================

local function AntiCheatBypassV3_Extension()

    local plr = game.Players.LocalPlayer
    local char = plr.Character or plr.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end

    local isTeleporting = false
    local teleportQueue = {}

    local function smoothMove(targetCF, speed)
        if isTeleporting then
            table.insert(teleportQueue, {targetCF, speed})
            return
        end
        isTeleporting = true
        local startCF = hrp.CFrame
        local distance = (targetCF.Position - startCF.Position).Magnitude
        local duration = math.max(distance / speed, 0.1)
        local startTime = tick()
        local oldState = hum:GetState()
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)

        task.spawn(function()
            while tick() - startTime < duration do
                local alpha = (tick() - startTime) / duration
                local smoothAlpha = alpha * alpha * (3 - 2 * alpha)
                local newCF = startCF:Lerp(targetCF, smoothAlpha)
                hrp.CFrame = newCF
                hrp.Velocity = Vector3.new(0, 0, 0)
                hrp.RotVelocity = Vector3.new(0, 0, 0)
                task.wait()
            end
            hrp.CFrame = targetCF
            hrp.Velocity = Vector3.new(0, 0, 0)
            hrp.RotVelocity = Vector3.new(0, 0, 0)
            isTeleporting = false
            hum:ChangeState(oldState)
            if #teleportQueue > 0 then
                local next = table.remove(teleportQueue, 1)
                smoothMove(next[1], next[2])
            end
        end)
    end

    -- ดักการเซ็ต CFrame / Position
    local mt = getrawmetatable(hrp) or {}
    local oldNewIndex = mt.__newindex
    mt.__newindex = function(self, key, value)
        if key == "CFrame" and type(value) == "userdata" and value:IsA("CFrame") then
            local dist = (value.Position - hrp.Position).Magnitude
            if dist > 50 then
                smoothMove(value, math.clamp(dist * 1.5, 150, 600))
                return
            end
        end
        if key == "Position" and type(value) == "Vector3" then
            local dist = (value - hrp.Position).Magnitude
            if dist > 50 then
                smoothMove(CFrame.new(value), math.clamp(dist * 1.5, 150, 600))
                return
            end
        end
        if oldNewIndex then return oldNewIndex(self, key, value) end
        rawset(self, key, value)
    end
    setrawmetatable(hrp, mt)

    -- ดัก SetNetworkOwner
    local oldSetNetworkOwner = hrp.SetNetworkOwner
    hrp.SetNetworkOwner = function(self, player)
        if player == plr then return oldSetNetworkOwner(self, player) end
        return
    end

    -- ดัก TeleportService
    local oldTeleport = game:GetService("TeleportService").Teleport
    game:GetService("TeleportService").Teleport = function(self, placeId, player, ...)
        local args = {...}
        if player == plr then
            task.spawn(function()
                if game:GetService("TeleportService"):GetPlaceId() ~= placeId then
                    local oldCF = hrp.CFrame
                    for i = 1, 10 do
                        hrp.CFrame = oldCF + Vector3.new(0, i * 5, 0)
                        task.wait(0.05)
                    end
                end
                return oldTeleport(self, placeId, player, unpack(args))
            end)
            return
        end
        return oldTeleport(self, placeId, player, unpack(args))
    end

    -- ฟังก์ชัน SafeTeleport
    getgenv().SafeTeleport = function(targetPos, speed)
        if type(targetPos) == "Vector3" then targetPos = CFrame.new(targetPos) end
        if type(targetPos) == "CFrame" then smoothMove(targetPos, speed or 300) end
    end

    if _G.Teleport then
        local oldG = _G.Teleport
        _G.Teleport = function(pos) getgenv().SafeTeleport(pos, 300) end
    end

    -- Loop ป้องกันการดึงกลับ
    local targetCFrame = hrp.CFrame
    task.spawn(function()
        while task.wait(0.3) do
            if not isTeleporting and targetCFrame and (targetCFrame.Position - hrp.Position).Magnitude > 100 then
                hrp.CFrame = targetCFrame
                hrp.Velocity = Vector3.new(0, 0, 0)
            end
        end
    end)

    print("[🛡️ PayomboyZ] V3 Extension Loaded!")
end

