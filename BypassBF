-- วิธีที่ 3: บินไปหาจุดหมายที่มีอยู่แล้วใน workspace
local function FlyToPart(partName, heightOffset)
    heightOffset = heightOffset or 50
    local part = workspace:FindFirstChild(partName)
    if part and part:IsA("BasePart") then
        local targetCF = CFrame.new(part.Position.X, part.Position.Y + heightOffset, part.Position.Z)
        BypassCFrameSafe(targetCF)
    end
end

