-- BLOX FRUITS PERMANENT DAMAGE PATCH v3.0
-- แก้: ดาเมจหายหลังเล่นไประยะเวลาหนึ่ง
-- สาเหตุ: CombatFramework require() คืนค่าใหม่ / upvalues เปลี่ยน
-- ══════════════════════════════════════════════════════════════

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local ValidatorCache = {}
local LastAttackTime = 0
local AttackJitter = 0

-- ─── CORE: Re-scan validator ทุกครั้งก่อน attack (ไม่มียึด cache) ───
local function GetValidAttackData()
    local success, cf = pcall(require, LocalPlayer.PlayerScripts:WaitForChild("CombatFramework"))
    if not success or not cf then return nil end
    
    local cfUpvalues = getupvalues(cf)
    local CombatFrameworkR = nil
    for i = 1, #cfUpvalues do
        local v = cfUpvalues[i]
        if typeof(v) == "table" and rawget(v, "activeController") then
            CombatFrameworkR = v
            break
        end
    end
    if not CombatFrameworkR then return nil end
    
    local AC = CombatFrameworkR.activeController
    if not AC or not AC.attack then return nil end
    
    -- สแกนหา upvalues ทังหมด (ไม่ assume index)
    local upvalues = {}
    for i = 1, 12 do
        local ok, val = pcall(debug.getupvalue, AC.attack, i)
        if ok and typeof(val) == "number" then
            upvalues[i] = val
        end
    end
    
    -- ระบุ upvalues ตามลักษณะค่า
    local seed_idx, mod_idx, inc_idx, counter_idx = nil, nil, nil, nil
    
    for i, val in pairs(upvalues) do
        if val > 100000000000 then
            mod_idx = i  -- modulus มักเป็นค่าใหญ่มาก
        elseif val > 100000 and val < 100000000000 then
            if not seed_idx then seed_idx = i
            else inc_idx = i end
        elseif math.floor(val) == val and val >= 0 and val < 10000 then
            if not counter_idx then counter_idx = i end
        end
    end
    
    -- Fallback: ถาหาไมเจอ ใช index มาตรฐาน
    if not seed_idx then seed_idx = 5 end
    if not mod_idx then mod_idx = 6 end
    if not inc_idx then inc_idx = 4 end
    if not counter_idx then counter_idx = 7 end
    
    return {
        ac = AC,
        seed_idx = seed_idx,
        mod_idx = mod_idx,
        inc_idx = inc_idx,
        counter_idx = counter_idx,
        upvalues = upvalues
    }
end

-- ─── CORE: Attack function ที่ re-scan validator ทุกครั้ง ───
local function PermanentAttack(targets)
    if not getgenv().Configs or not getgenv().Configs.FastAttack then return end
    
    local now = tick()
    local jitter = (getgenv().Configs._AttackJitter or 0) / 1000
    local minDelay = 0.085 + jitter
    if now - LastAttackTime < minDelay then return end
    LastAttackTime = now
    
    local char = LocalPlayer.Character
    if not char then return end
    
    -- Activate tool ทุกครั้ง (บังคับ)
    local activeTool = char:FindFirstChildOfClass("Tool")
    if activeTool then
        pcall(function() activeTool:Activate() end)
    end
    
    -- Mouse click simulation (backstop)
    pcall(function()
        local VirtualUser = game:GetService("VirtualUser")
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        task.wait(0.008)
        VirtualUser:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end)
    
    -- เตรียม target list
    local bladehit = {}
    if type(targets) == "table" then
        for _, mob in ipairs(targets) do
            if mob and mob:FindFirstChild("HumanoidRootPart") then
                table.insert(bladehit, mob.HumanoidRootPart)
            end
        end
    elseif typeof(targets) == "Instance" and targets:FindFirstChild("HumanoidRootPart") then
        table.insert(bladehit, targets.HumanoidRootPart)
    end
    if #bladehit == 0 then return end
    
    -- ★ KEY FIX: Re-scan validator ทุกครั้ง ไมยมึด cache ★
    local attackData = GetValidAttackData()
    if attackData then
        local u8 = debug.getupvalue(attackData.ac.attack, attackData.seed_idx)
        local u9 = debug.getupvalue(attackData.ac.attack, attackData.mod_idx)
        local u7 = debug.getupvalue(attackData.ac.attack, attackData.inc_idx)
        local u10 = debug.getupvalue(attackData.ac.attack, attackData.counter_idx)
        
        if u8 and u9 and u7 and u10 and u9 > 0 then
            -- คำนวณ RNG ถัดไป
            local u12 = (u8 * 798405 + u7 * 727595) % u9
            local u13 = u7 * 798405
            u12 = (u12 * u9 + u13) % 1099511627776
            u8 = math.floor(u12 / u9)
            u7 = u12 - u8 * u9
            u10 = u10 + 1
            
            -- Inject ค่ากลับ
            debug.setupvalue(attackData.ac.attack, attackData.seed_idx, u8)
            debug.setupvalue(attackData.ac.attack, attackData.mod_idx, u9)
            debug.setupvalue(attackData.ac.attack, attackData.inc_idx, u7)
            debug.setupvalue(attackData.ac.attack, attackData.counter_idx, u10)
            
            -- ส่ง validator
            local validator = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Validator")
            if validator then
                pcall(validator.FireServer, validator, math.floor(u12 / 1099511627776 * 16777215), u10)
            end
        end
    end
    
    -- ส่ง hit event
    local rigEvent = ReplicatedStorage:FindFirstChild("RigControllerEvent") or ReplicatedStorage:FindFirstChild("RigBehaviourEvent")
    if rigEvent then
        pcall(rigEvent.FireServer, rigEvent, "hit", bladehit, 1, "")
    end
end

-- ─── FALLBACK: Attack แบบไมง้อ validator (ใช้เมอ validator scan ไมได) ───
local function FallbackAttack(targets)
    local now = tick()
    if now - LastAttackTime < 0.12 then return end
    LastAttackTime = now
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local activeTool = char:FindFirstChildOfClass("Tool")
    if activeTool then pcall(function() activeTool:Activate() end) end
    
    -- Mouse click จําลอง (บางเคส works โดยไมตองการ validator)
    pcall(function()
        local VirtualUser = game:GetService("VirtualUser")
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        task.wait(0.01)
        VirtualUser:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end)
    
    local bladehit = {}
    if type(targets) == "table" then
        for _, mob in ipairs(targets) do
            if mob and mob:FindFirstChild("HumanoidRootPart") then
                table.insert(bladehit, mob.HumanoidRootPart)
            end
        end
    elseif typeof(targets) == "Instance" and targets:FindFirstChild("HumanoidRootPart") then
        table.insert(bladehit, targets.HumanoidRootPart)
    end
    if #bladehit == 0 then return end
    
    -- พยายามสงผาน RigControllerEvent โดยตรง
    local rigEvent = ReplicatedStorage:FindFirstChild("RigControllerEvent") or ReplicatedStorage:FindFirstChild("RigBehaviourEvent")
    if rigEvent then
        pcall(rigEvent.FireServer, rigEvent, "hit", bladehit, 1, "")
    end
    
    -- Fallback: ใช CommF_ โดยตรง (วิธีโบราณ แต works บางเซิรฟเวอร)
    local CommF_ = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
    if CommF_ then
        pcall(CommF_.FireServer, CommF_, "Attack", bladehit[1])
    end
end

-- ─── SMART ATTACK: เลือกระหวาง Validator / Fallback อัตโนมัต ───
local ConsecutiveFailures = 0
local lastHealthCheck = {}
local lastHealthTime = 0

local function SmartAttack(targets)
    -- พยายาม validator attack กอน
    local beforeHP = 0
    if type(targets) == "table" and #targets > 0 and targets[1] and targets[1]:FindFirstChild("Humanoid") then
        beforeHP = targets[1].Humanoid.Health
    end
    
    PermanentAttack(targets)
    
    -- ตรวจสอบวา ดาเมจขึ้นจริงไหม (หลัง 0.3 วิ)
    task.delay(0.3, function()
        if not targets or #targets == 0 then return end
        local mob = type(targets) == "table" and targets[1] or targets
        if not mob or not mob:FindFirstChild("Humanoid") then return end
        
        local afterHP = mob.Humanoid.Health
        if afterHP >= beforeHP then
            -- ดาเมจไมขึ้น — เพิ่ม counter
            ConsecutiveFailures = ConsecutiveFailures + 1
            
            -- ถา fail 3 ครังติด ให สแกนใหมและใช fallback
            if ConsecutiveFailures >= 3 then
                ConsecutiveFailures = 0
                -- ใช fallback แทน
                FallbackAttack(targets)
            end
        else
            -- ดาเมจขึ้น — รีเซ็ต counter
            ConsecutiveFailures = 0
        end
    end)
end

-- ─── ANTI-STUN / ANTI-KNOCKBACK ───
task.spawn(function()
    while task.wait(0.08) do
        local char = LocalPlayer.Character
        if not char then continue end
        
        for _, effect in ipairs({"Stun", "Busy", "Paralyzed", "Frozen", "Sleeping", "Knockback"}) do
            local obj = char:FindFirstChild(effect)
            if obj then
                if obj:IsA("BoolValue") then obj.Value = false end
                if obj:IsA("IntValue") then obj.Value = 0 end
                obj:Destroy()
            end
        end
        
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            if humanoid.Sit then humanoid.Sit = false end
            if humanoid.PlatformStand then humanoid.PlatformStand = false end
            -- Force state 0 (None) ถาไมใช state อืนทจําเปน
            local currentState = humanoid:GetState()
            if currentState == Enum.HumanoidStateType.Stunned 
            or currentState == Enum.HumanoidStateType.KnockedOut then
                pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.None) end)
            end
        end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, v in ipairs(hrp:GetChildren()) do
                if v:IsA("BodyVelocity") and v.Name ~= "fixvelo" and v.Name ~= "BringVelocity" then
                    v:Destroy()
                end
            end
        end
    end
end)

