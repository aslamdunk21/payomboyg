function GAG2Engine:InitStockWatcher()
    pcall(function()
        local stockValues = ReplicatedStorage:WaitForChild("StockValues", 10)
        if not stockValues then return end

        local function watchFolder(folder)
            if not folder then return end
            local items = folder:FindFirstChild("Items")
            if not items then return end

            items.ChildAdded:Connect(function(item)
                Engine:RefreshBuyDropdowns()
                GAG2Engine:AutoBuyLoop()
            end)

            for _, item in ipairs(items:GetChildren()) do
                if item:IsA("ValueBase") then
                    item.Changed:Connect(function(val)
                        Engine:RefreshBuyDropdowns()
                        if val > 0 then
                            GAG2Engine:AutoBuyLoop()
                        end
                    end)
                end
            end
        end

        watchFolder(stockValues:FindFirstChild("SeedShop"))
        watchFolder(stockValues:FindFirstChild("EventShop"))
        watchFolder(stockValues:FindFirstChild("GearShop"))
        watchFolder(stockValues:FindFirstChild("CrateShop"))

        stockValues.ChildAdded:Connect(function(child)
            task.wait(0.5)
            watchFolder(child)
            Engine:RefreshBuyDropdowns()
        end)
    end)
end

function GAG2Engine:ScanFruits(mode)
    local results = {}
    local gardens = workspace:FindFirstChild("Gardens")
    if not gardens then return results end

    for _, plot in ipairs(gardens:GetChildren()) do
        local plants = plot:FindFirstChild("Plants")
        if plants then
            for _, plant in ipairs(plants:GetChildren()) do
                local fruits = plant:FindFirstChild("Fruits")
                if fruits then
                    for _, fruit in ipairs(fruits:GetChildren()) do
                        local mut = fruit:GetAttribute("Mutation") or ""
                        local weight = fruit:FindFirstChild("Weight")
                        local weightStr = weight and string.format(" [%.1f KG]", weight.Value) or ""
                        local isMatch = false
                        if mode == "Gold" and mut:find("Gold") then isMatch = true end
                        if mode == "Rainbow" and mut:find("Rainbow") then isMatch = true end
                        if mode == "Pollinated" and mut:find("Pollinated") then isMatch = true end
                        
                        if isMatch then
                            table.insert(results, { Model = fruit, Name = plant.Name .. weightStr .. " (" .. mut .. ")" })
                        end
                    end
                end
            end
        end
    end
    return results
end

function GAG2Engine:NightStealLoop()
    if not Engine.Config.AutoNightSteal then return end
    pcall(function()
        local night = ReplicatedStorage:FindFirstChild("Night")
        if not night or night.Value ~= true then return end

        local ownerPlot = self:GetOwnerPlot()
        if not ownerPlot then return end
        local dropoff = ownerPlot:FindFirstChild("PlotSizeReference")
        if not dropoff then return end

        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hrp = char.HumanoidRootPart

        local gardens = workspace:FindFirstChild("Gardens")
        for _, plot in ipairs(gardens:GetChildren()) do
            if plot:GetAttribute("Owner") == LocalPlayer.Name then continue end
            local plants = plot:FindFirstChild("Plants")
            if plants then
                for _, plant in ipairs(plants:GetChildren()) do
                    local plantId = plant:GetAttribute("PlantId")
                    local ownerId = plant:GetAttribute("UserId")
                    local fruitId = plant:GetAttribute("FruitId") or ""
                    if plantId and ownerId then
                        local basePart = plant:FindFirstChildWhichIsA("BasePart")
                        if basePart then
                            local targetCF = basePart.CFrame + Vector3.new(0, 3, 0)
                            local oldCF = hrp.CFrame
                            
                            hrp.CFrame = targetCF
                            task.wait(0.5)

                            local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
                            if sharedModules then
                                local networkingMod = sharedModules:FindFirstChild("Networking")
                                if networkingMod then
                                    local Networking = require(networkingMod)
                                    if Networking.Steal then
                                        if Networking.Steal.BeginSteal then Networking.Steal.BeginSteal:Fire(tonumber(ownerId), plantId, fruitId) end
                                        if Networking.Steal.CompleteSteal then Networking.Steal.CompleteSteal:Fire() end
                                    end
                                end
                            end

                            task.wait(0.5)
                            hrp.CFrame = oldCF
                            Engine:Notify({ Title = "ขโมยผักสำเร็จ!", Content = "ขโมยผักจากแปลงสำเร็จเรียบร้อย" })
                            break
                        end
                    end
                end
            end
        end
    end)
end

