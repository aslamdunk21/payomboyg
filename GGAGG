                            currentSingleVal = ""
                            updateBtnText()
                            callback("")
                        else
                            currentSingleVal = opt
                            updateBtnText()
                            callback(opt)
                        end
                        isOpen = false
                        TweenService:Create(card, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 0, 52) }):Play()
                        refreshOptions(newOpts)
                    end
                end)
            end

            updateBtnText()
        end

        refreshOptions(options)

        dropBtn.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            playClickSound()
            local itemCount = #optHolder:GetChildren()
            local targetHeight = isOpen and (58 + (itemCount * 32)) or 52
