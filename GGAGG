            Default = false,
            Callback = function(val) self.Config.AutoAcceptTrade = val end
        })
        tabTrade:CreateToggle({
            Title = "🔁 เปิดใช้งาน ออโต้ส่ง Trade Mail ต่อเนื่อง (Auto Loop Send Mail)",
            Default = false,
            Callback = function(val) self.Config.AutoSendMailLoop = val end
        })

        GAG2Engine:InitAutoClaimMail()
        GAG2Engine:InitShovelAndTrowelLoops()

        -- 🐾 GAG2 Tab 5: ดัชนีสัตว์เลี้ยงหายาก (GAG2 Rarest Pets Index & Database)
        local tabPets = self:CreateTab("GAG2 Pet Index", "🐾")
        tabPets:CreateSection("🐾 ดัชนีสัตว์เลี้ยงหายาก (GAG2 Rarest Pets Database)")

        local selectedPetFilter = "all"
        local selectedPetName = ""

        local function getFilteredPetNames(filterType)
            local list = {}
            for _, pet in ipairs(GAG2_PETS_DATA) do
                local show = false
                if filterType == "all" then show = true
                elseif filterType == "normal" then show = (pet.size == "Normal" and not pet.rainbow)
                elseif filterType == "rainbow" then show = pet.rainbow
                elseif filterType == "big" then show = (pet.size == "Big")
                elseif filterType == "mega" then show = (pet.size == "Mega")
                end
                if show then
                    table.insert(list, pet.rank .. ". " .. pet.name .. " (" .. pet.rarity .. ")")
                end
            end
            return list
        end

        local petListDropdown

        tabPets:CreateDropdown({
            Title = "🔍 ตัวกรองประเภทสัตว์เลี้ยง (Pet Filter)",
            Options = { "All (ทั้งหมด)", "Mega Only", "Rainbow Only", "Big Only", "Normal Only" },
            Default = "All (ทั้งหมด)",
            Multi = false,
            Callback = function(val)
                if val:find("Mega") then selectedPetFilter = "mega"
                elseif val:find("Rainbow") then selectedPetFilter = "rainbow"
                elseif val:find("Big") then selectedPetFilter = "big"
                elseif val:find("Normal") then selectedPetFilter = "normal"
                else selectedPetFilter = "all" end

                if petListDropdown then
                    petListDropdown:SetOptions(getFilteredPetNames(selectedPetFilter))
                end
            end
        })

        petListDropdown = tabPets:CreateDropdown({
            Title = "🐾 เลือกสัตว์เลี้ยงที่ต้องการตรวจสอบ / แนบเทรด",
            Options = getFilteredPetNames("all"),
            Multi = false,
            Callback = function(val)
                local nameOnly = val:gsub("^%d+%.%s*", ""):gsub("%s*%([^%)]*%)$", "")
                selectedPetName = nameOnly
            end
        })

        tabPets:CreateButton({
            Title = "ℹ️ ดูรายละเอียด & โอกาสสุ่ม (Pet Rarity Info)",
            Callback = function()
                local petObj = nil
                for _, p in ipairs(GAG2_PETS_DATA) do
                    if p.name == selectedPetName or selectedPetName == "" then
                        petObj = p
                        if selectedPetName ~= "" then break end
                    end
                end
                if petObj then
                    self:Notify({
                        Title = "🐾 " .. petObj.name,
                        Content = string.format("อันดับ: #%s | ความแรร์: %s | โอกาส: 1 ใน %s | มีในเกม: %s ตัว",
                            petObj.rank, petObj.rarity, petObj.odds, tostring(petObj.exist))
                    })
                else
                    self:Notify({ Title = "ข้อผิดพลาด ❌", Content = "กรุณาเลือกสัตว์เลี้ยงจากดรอปดาวน์ก่อน" })
                end
            end
        })

        tabPets:CreateButton({
            Title = "📌 ตั้งเป็นไอเทมแนบใน GAG2 Trade Mail ทันที",
            Callback = function()
                if selectedPetName ~= "" then
                    self.Config.MailItemCategory = "Pets"
                    self.Config.MailItemName = selectedPetName
                    if self.UI.MailItemDropdown then
                        self.UI.MailItemDropdown:SetOptions(self:GetMasterPresetOptions("Pets"))
                    end
                    self:Notify({
                        Title = "ตั้งค่า Trade Mail สำเร็จ! 📬",
                        Content = "แนบสัตว์เลี้ยง '" .. selectedPetName .. "' เข้าช่องส่ง Trade Mail แล้ว!"
                    })
                else
                    self:Notify({ Title = "ข้อผิดพลาด ❌", Content = "กรุณาเลือกสัตว์เลี้ยงก่อนกดตั้งค่า" })
                end
            end
        })

        -- 🎁 ระบบออโต้ฟักไข่ & เปิดกล่อง (Auto Open / Hatch Suite)
        tabPets:CreateSection("🎁 ฟักไข่ & เปิดกล่องอัตโนมัติ (Auto Open & Hatch)")
        tabPets:CreateToggle({
            Title = "🥚 ออโต้เปิดฟักไข่ (Auto Hatch Eggs)",
            Default = self.Config.AutoHatchEggs or false,
            Callback = function(val) self.Config.AutoHatchEggs = val end
        })
        tabPets:CreateToggle({
            Title = "📦 ออโต้เปิดกล่องสินค้า (Auto Open Crates)",
            Default = self.Config.AutoOpenCrates or false,
            Callback = function(val) self.Config.AutoOpenCrates = val end
        })
        tabPets:CreateToggle({
            Title = "🌱 ออโต้เปิดซองเมล็ดพันธุ์ (Auto Open Seed Packs)",
            Default = self.Config.AutoOpenSeedPacks or false,
            Callback = function(val) self.Config.AutoOpenSeedPacks = val end
        })

        -- 🐾 ระบบจับสัตว์ป่า & สวมใส่อัตโนมัติ (Wild Pet Tamer & Auto Equip)
        tabPets:CreateSection("🐾 จับสัตว์ป่า & สวมใส่อัตโนมัติ (Wild Tame & Auto Equip)")
        tabPets:CreateToggle({
            Title = "🌲 เปิดใช้งาน จับสัตว์ป่าอัตโนมัติ (Auto Tame Wild Pets)",
            Default = self.Config.AutoTameWildPets or false,
            Callback = function(val) self.Config.AutoTameWildPets = val end
        })
        tabPets:CreateToggle({
            Title = "🐕 เปิดใช้งาน สวมใส่สัตว์เลี้ยงอัตโนมัติ (Auto Equip Best Pets)",
            Default = self.Config.AutoEquipPets or false,
            Callback = function(val) self.Config.AutoEquipPets = val end
        })
        tabPets:CreateButton({
            Title = "🐶 สวมใส่สัตว์เลี้ยงชุดหลักทันที (Equip Pets Now)",
            Callback = function()
                GAG2Engine:AutoEquipPetsLoop()
                self:Notify({ Title = "สวมใส่สำเร็จ 🐾", Content = "ส่งคำขอติดตั้งสัตว์เลี้ยงเข้าสู่ระบบแล้ว!" })
            end
        })


    -- Initial dropdown options update
    pcall(function()
        self:RefreshBuyDropdowns()
    end)

    -- Setup background automation loops
    GAG2Engine:InitStockWatcher()
    GAG2Engine:InitAutoStealWatcher()

    -- Setup Stepped listener for NoClip
    RunService.Stepped:Connect(function()
        if self.Config.NoClip then
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    end)

    -- Setup Panic Harvest Watcher
    GAG2Engine:PanicHarvestWatcher()

    -- Infinite Jump Listener
    UserInputService.JumpRequest:Connect(function()
        if Engine.Config.InfiniteJump then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end)

    -- WalkSpeed & JumpPower Enforcement
    RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            if Engine.Config.WalkSpeed and Engine.Config.WalkSpeed ~= 16 then
                hum.WalkSpeed = Engine.Config.WalkSpeed
            end
            if Engine.Config.JumpPower and Engine.Config.JumpPower ~= 50 then
                hum.UseJumpPower = true
                hum.JumpPower = Engine.Config.JumpPower
            end
        end
    end)

    task.spawn(function()
        while task.wait(0.5) do
            pcall(function()
                GAG2Engine:AutoHarvestLoop()
                GAG2Engine:AutoBuyLoop()
                GAG2Engine:ProcessLots()
                GAG2Engine:NightStealLoop()
                GAG2Engine:AutoOpenLoop()
                GAG2Engine:AutoTameWildPetsLoop()
                GAG2Engine:AutoEquipPetsLoop()
                if Engine.Config.EnableFruitESP then
                    GAG2Engine:UpdateFruitESP()
                end
                if Engine.Config.AutoSendMailLoop and Engine.Config.MailRecipient ~= "" then
                    GAG2Engine:SendTradeMail(
                        Engine.Config.MailRecipient,
                        Engine.Config.MailItemCategory,
                        Engine.Config.MailItemName,
                        Engine.Config.MailAmount,
                        Engine.Config.MailSheckles
                    )
                    task.wait(4)
                end
            end)
        end
    end)

    -- Anti-AFK Listener
    LocalPlayer.Idled:Connect(function()
        if self.Config.AntiAFK then
            GAG2Engine:PerformAntiAfkJump()
        end
    end)

    -- Auto Reconnect Listener
    GuiService.ErrorMessageChanged:Connect(function()
        if self.Config.AutoReconnect then
            task.wait(2)
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end
    end)

    self:Notify({
        Title = "โหลดสคริปต์ GAG 2 สำเร็จ! 🌸",
        Content = "ยินดีต้อนรับสู่ GAG 2 Master Engine (Pure Standalone Edition)"
    })
end

local ok, err = pcall(function()
    Engine:Init()
end)
if not ok then
    warn("[GAG2 Master Engine Init Error]:", tostring(err))
end
