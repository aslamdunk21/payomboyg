                            local priceLabel = card:FindFirstChild("Price") or card:FindFirstChild("Cost")
                            
                            local cardAuctionKey = card:GetAttribute("AuctionKey") or card:GetAttribute("Key") or card:GetAttribute("Id") or card.Name
                            if not (cardAuctionKey and type(cardAuctionKey) == "string" and cardAuctionKey:find("^auction:")) then
                                pcall(function()
                                    for attrName, attrVal in pairs(card:GetAttributes()) do
                                        if type(attrVal) == "string" and attrVal:find("^auction:") then
                                            cardAuctionKey = attrVal
                                            break
                                        end
                                    end
                                end)
                            end

                            if titleLabel and titleLabel.Text ~= "" and not titleLabel.Text:find("หมดอายุ") and not titleLabel.Text:find("หมดสต็อก") then
                                local cName = Engine:CleanItemName(titleLabel.Text)
                                local rawPrice = priceLabel and priceLabel.Text:gsub("[^%d]", "") or "0"
                                local numPrice = tonumber(rawPrice) or 0
                                local keyStr = (cardAuctionKey and cardAuctionKey ~= "") and cardAuctionKey or cName
                                local displayText = string.format("%s [%s] (💰 %s)", cName, keyStr, Engine:FormatMoney(numPrice))
                                
                                if not table.find(optionsList, displayText) then
                                    table.insert(optionsList, displayText)
                                    table.insert(LiveAuctionItemsCache, {
                                        AuctionKey = keyStr,
                                        RawName = titleLabel.Text,
                                        CleanName = cName,
                                        Price = numPrice,
                                        Stock = 1,
                                        DisplayText = displayText,
                                        Instance = card
