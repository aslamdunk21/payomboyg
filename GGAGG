function GAG2Engine:TryBuyLot(lot)
    if not lot then return false end
    local success = false
    pcall(function()
        local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
        if sharedModules and sharedModules:FindFirstChild("Networking") then
            local Networking = safeRequire(sharedModules.Networking) or (require and pcall(require, sharedModules.Networking) and require(sharedModules.Networking))
            if Networking and Networking.Garden then
                local buyRemote = Networking.Garden.BuyLot or Networking.Garden.PurchaseLot or Networking.Garden.BuyPlot or Networking.Garden.ClaimPlot
                if buyRemote then
                    buyRemote:Fire(lot:GetAttribute("LotId") or lot.Name or lot)
                    success = true
                end
            end
        end
        if not success then
            local packetRemote = sharedModules and sharedModules:FindFirstChild("Packet") and sharedModules.Packet:FindFirstChild("RemoteEvent")
            if packetRemote then
                packetRemote:FireServer(buffer.fromstring("BUY_LOT\000" .. tostring(lot.Name)))
                success = true
            end
        end
    end)
    return success
end

function GAG2Engine:ProcessLots()
    if not Engine.Config.AutoBuyLots and not Engine.Config.AutoBuyPlots then return end
    pcall(function()
        local gardens = workspace:FindFirstChild("Gardens") or workspace:FindFirstChild("Plots")
        if not gardens then return end

        for _, lot in ipairs(gardens:GetChildren()) do
            local isOwned = lot:GetAttribute("Owner") or lot:GetAttribute("OwnerUserId") or lot:FindFirstChild("Owner")
            if not isOwned or isOwned == "" or isOwned == 0 then
                self:TryBuyLot(lot)
                task.wait(Engine.Config.BuyDelay or 0.5)
