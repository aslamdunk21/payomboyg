function GAG1Engine:InitDataStream()
    pcall(function()
        local dataStream = ReplicatedStorage.GameEvents:FindFirstChild("DataStream")
        if dataStream then
            dataStream.OnClientEvent:Connect(function(eventType, profile, data)
                if eventType ~= "UpdateData" or type(data) ~= "table" then return end
                for _, pair in ipairs(data) do
                    if type(pair) == "table" and type(pair[2]) == "table" then
                        local path = pair[1]
                        local items = pair[2]

                        if path == "ROOT/SeedStock/Stocks" then Engine.Stocks.Seeds = items
                        elseif path == "ROOT/GearStock/Stocks" then Engine.Stocks.Gears = items
                        elseif path == "ROOT/EventShopStock/Stocks" then Engine.Stocks.Events = items
                        elseif path == "ROOT/PetEggStock/Stocks" then Engine.Stocks.Eggs = items
                        elseif path == "ROOT/CosmeticStock/ItemStocks" then Engine.Stocks.Cosmetics = items
                        end

                        Engine:RefreshBuyDropdowns()
                        
                        for itemName, info in pairs(items) do
                            local cleanName = Engine:CleanItemName(itemName)
                            local stockQty = (type(info) == "table" and info.Stock) or (type(info) == "number" and info) or 0
                            
                            if stockQty > 0 then
                                if Engine.Config.AutoBuySeeds and path == "ROOT/SeedStock/Stocks" and Engine:IsItemSelected(Engine.Config.SelectedBuySeeds, itemName) then
                                    for i = 1, stockQty do
                                        ReplicatedStorage.GameEvents.BuySeedStock:FireServer(itemName)
                                        task.wait(Engine.Config.BuyDelay)
                                    end
                                elseif Engine.Config.AutoBuyEggs and path == "ROOT/PetEggStock/Stocks" and Engine:IsItemSelected(Engine.Config.SelectedBuyEggs, itemName) then
                                    for i = 1, stockQty do
                                        local eggBuy = ReplicatedStorage.GameEvents:FindFirstChild("BuyEggStock") or ReplicatedStorage.GameEvents:FindFirstChild("BuyPetEgg")
                                        if eggBuy then eggBuy:FireServer(itemName) end
                                        task.wait(Engine.Config.BuyDelay)
                                    end
                                elseif Engine.Config.AutoBuyEvents and path == "ROOT/EventShopStock/Stocks" and Engine:IsItemSelected(Engine.Config.SelectedBuyEvents, itemName) then
                                    for i = 1, stockQty do
                                        local eventBuy = ReplicatedStorage.GameEvents:FindFirstChild("BuyEventShopStock") or ReplicatedStorage.GameEvents:FindFirstChild("BuyEventItem")
                                        if eventBuy then eventBuy:FireServer(itemName) end
                                        task.wait(Engine.Config.BuyDelay)
                                    end
                                elseif Engine.Config.AutoBuyGears and path == "ROOT/GearStock/Stocks" and Engine:IsItemSelected(Engine.Config.SelectedBuyGears, itemName) then
                                    for i = 1, stockQty do
                                        local gearBuy = ReplicatedStorage.GameEvents:FindFirstChild("BuyGearStock") or ReplicatedStorage.GameEvents:FindFirstChild("BuyGear")
                                        if gearBuy then gearBuy:FireServer(itemName) end
                                        task.wait(Engine.Config.BuyDelay)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end

        local weatherEvent = ReplicatedStorage.GameEvents:FindFirstChild("WeatherEventStarted")
