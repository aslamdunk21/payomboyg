}

function GAG1Engine:GetFarm(playerName)
    local farms = workspace:FindFirstChild("Farm")
    if not farms then return nil end
    for _, farm in ipairs(farms:GetChildren()) do
        local found = nil
        pcall(function()
            if farm:FindFirstChild("Important") and farm.Important:FindFirstChild("Data") and farm.Important.Data:FindFirstChild("Owner") then
                if farm.Important.Data.Owner.Value == playerName then
                    found = farm
                end
            end
        end)
        if found then
            return found
        end
    end
    return nil
end

function GAG1Engine:GetHarvestablePlants()
    local harvestable = {}
    local farm = self:GetFarm(LocalPlayer.Name)
    if not farm or not farm:FindFirstChild("Important") then return harvestable end
    local plantsPhysical = farm.Important:FindFirstChild("Plants_Physical")
    if not plantsPhysical then return harvestable end

    local function scanFolder(parent)
        for _, plant in ipairs(parent:GetChildren()) do
            local fruits = plant:FindFirstChild("Fruits")
            if fruits then
                scanFolder(fruits)
            end

            local variant = plant:FindFirstChild("Variant")
            local skip = false
            if variant then
                if variant.Value == "Normal" and Engine.Config.IgnoreNormal then skip = true end
                if variant.Value == "Gold" and Engine.Config.IgnoreGold then skip = true end
                if variant.Value == "Rainbow" and Engine.Config.IgnoreRainbow then skip = true end
            end

            if not skip then
                local prompt = plant:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt and prompt.Enabled then
                    table.insert(harvestable, plant)
                end
            end
        end
    end

    scanFolder(plantsPhysical)
    return harvestable
end

function GAG1Engine:GetRandomFarmPoint()
    local farm = self:GetFarm(LocalPlayer.Name)
    if not farm or not farm:FindFirstChild("Important") then return Vector3.new(0, 5, 0) end
    local plantLocations = farm.Important:FindFirstChild("Plant_Locations")
    if not plantLocations then return Vector3.new(0, 5, 0) end
    local dirt = plantLocations:FindFirstChildOfClass("Part")
    if not dirt then return Vector3.new(0, 5, 0) end

    local center = dirt.CFrame.Position
    local size = dirt.Size
    local rx = center.X + math.random(math.floor(-size.X/2 + 2), math.floor(size.X/2 - 2))
    local rz = center.Z + math.random(math.floor(-size.Z/2 + 2), math.floor(size.Z/2 - 2))
    return Vector3.new(rx, center.Y + 3, rz)
end

function GAG1Engine:AutoPlantLoop()
    if not Engine.Config.AutoPlant or self.IsSelling then return end
    local farm = self:GetFarm(LocalPlayer.Name)
    if not farm then return end

    local seedName = Engine.Config.SelectedSeed
    local backpack = LocalPlayer.Backpack
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Humanoid") then return end

    local tool = nil
    if seedName and seedName ~= "" then
        tool = backpack:FindFirstChild(seedName) or char:FindFirstChild(seedName)
    end
    if not tool then
        for _, item in ipairs(backpack:GetChildren()) do
            if item.Name:lower():find("seed") then
                tool = item
                break
            end
        end
        if not tool then
            for _, item in ipairs(char:GetChildren()) do
                if item.Name:lower():find("seed") then
                    tool = item
                    break
                end
            end
        end
    end

    if not tool then return end
    if tool.Parent == backpack then
        char.Humanoid:EquipTool(tool)
    end

    local plantLocations = farm.Important:FindFirstChild("Plant_Locations")
    if not plantLocations then return end
    local dirt = plantLocations:FindFirstChildOfClass("Part")
    if not dirt then return end

    local center = dirt.CFrame.Position
    local size = dirt.Size
    local x1, z1 = math.ceil(center.X - size.X/2), math.ceil(center.Z - size.Z/2)
    local x2, z2 = math.floor(center.X + size.X/2), math.floor(center.Z + size.Z/2)

    local targetSeed = tool.Name
    if Engine.Config.PlantMode == "Random" then
        local rx = math.random(x1, x2)
        local rz = math.random(z1, z2)
        ReplicatedStorage.GameEvents.Plant_RE:FireServer(Vector3.new(rx, 4, rz), targetSeed)
    else
        for x = x1, x2, 2 do
            for z = z1, z2, 2 do
                if not Engine.Config.AutoPlant or self.IsSelling then break end
                ReplicatedStorage.GameEvents.Plant_RE:FireServer(Vector3.new(x, 0.13, z), targetSeed)
                task.wait(0.05)
            end
        end
    end
end

function GAG1Engine:AutoHarvestLoop()
