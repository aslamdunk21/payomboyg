                obCorner.Parent = oBtn

                oBtn.MouseButton1Click:Connect(function()
                    playClickSound()
                    if isMulti then
                        local isSelNow = Engine:IsItemSelected(selectedMap, cleanName)
                        local newSelState = not isSelNow
                        selectedMap[cleanName] = newSelState
                        oBtn.BackgroundColor3 = newSelState and COLORS.primary or COLORS.surface
                        oBtn.TextColor3 = newSelState and COLORS.gold or COLORS.text
                        oBtn.Text = (newSelState and "[✓] " or "[  ] ") .. rawString
                        updateBtnText()
                        callback(selectedMap, cleanName, newSelState)
