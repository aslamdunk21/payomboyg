function Engine:GetMasterPresetOptions(categoryKey)
    local list = {}
    local added = {}

    local function addName(name)
        if not name or name == "" then return end
        local clean = self:CleanItemName(name)
        local key = clean:lower()
        if not added[key] then
            added[key] = true
            table.insert(list, clean)
        end
    end

    local function addFromDataModule(mod)
        if not mod or not mod:IsA("ModuleScript") then return end
        pcall(function()
            local data = require(mod)
            if type(data) == "table" then
                for k, v in pairs(data) do
                    if type(k) == "string" then addName(k) end
                    if type(v) == "string" then addName(v)
                    elseif type(v) == "table" and type(v.Name) == "string" then addName(v.Name)
                    elseif type(v) == "table" and type(v.name) == "string" then addName(v.name)
                    end
                end
            end
        end)
    end

    -- 1. Read directly from ReplicatedStorage.Assets (Exact Game Folders)
    pcall(function()
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
        local sharedData = ReplicatedStorage:FindFirstChild("SharedData")
        local cmdrTypes = ReplicatedStorage:FindFirstChild("CmdrClient") and ReplicatedStorage.CmdrClient:FindFirstChild("Types")

        if categoryKey == "Fruits" then
            if assets then
                local folder = assets:FindFirstChild("Fruits") or assets:FindFirstChild("Crops")
                if folder then for _, child in ipairs(folder:GetChildren()) do addName(child.Name) end end
            end
            local plantGen = ReplicatedStorage:FindFirstChild("PlantGenerationModules") and ReplicatedStorage.PlantGenerationModules:FindFirstChild("Fruits")
            if plantGen then for _, child in ipairs(plantGen:GetChildren()) do addName(child.Name) end end
            if cmdrTypes then addFromDataModule(cmdrTypes:FindFirstChild("FruitName")) end
        elseif categoryKey == "Seeds" then
            if assets then
                local folder = assets:FindFirstChild("Seeds")
                if folder then for _, child in ipairs(folder:GetChildren()) do addName(child.Name) end end
            end
            if sharedModules then addFromDataModule(sharedModules:FindFirstChild("SeedData")) end
            if cmdrTypes then addFromDataModule(cmdrTypes:FindFirstChild("SeedName")) end
        elseif categoryKey == "Pets" then
            if assets then
                local petFolders = {
                    assets:FindFirstChild("Pets"),
                    assets:FindFirstChild("Pet"),
                    assets:FindFirstChild("Animals")
                }
                for _, folder in ipairs(petFolders) do
                    if folder then for _, child in ipairs(folder:GetChildren()) do addName(child.Name) end end
                end
            end
            if sharedData then
                addFromDataModule(sharedData:FindFirstChild("PetData"))
                addFromDataModule(sharedData:FindFirstChild("Pets"))
            end
            if sharedModules then
                local petMods = sharedModules:FindFirstChild("PetModules") or sharedModules:FindFirstChild("Pets")
                if petMods then for _, child in ipairs(petMods:GetChildren()) do addName(child.Name) end end
                addFromDataModule(sharedModules:FindFirstChild("PetData"))
            end
            if cmdrTypes then
                addFromDataModule(cmdrTypes:FindFirstChild("Pet"))
                addFromDataModule(cmdrTypes:FindFirstChild("PetTypeName"))
                addFromDataModule(cmdrTypes:FindFirstChild("PetName"))
            end
            for _, petData in ipairs(GAG2_PETS_DATA) do
                if petData.name then addName(petData.name) end
            end
        elseif categoryKey == "Gears" then
            if assets then
                local gearFolders = {
                    assets:FindFirstChild("Mushrooms"),
                    assets:FindFirstChild("Sprinklers"),
                    assets:FindFirstChild("WateringCans"),
                    assets:FindFirstChild("Wateringcan"),
                    assets:FindFirstChild("Gears"),
                    assets:FindFirstChild("Gear"),
                    assets:FindFirstChild("Tools"),
                    assets:FindFirstChild("Tool"),
                    assets:FindFirstChild("Shovels"),
                    assets:FindFirstChild("Shovel"),
                    assets:FindFirstChild("Equipment")
                }
                for _, folder in ipairs(gearFolders) do
                    if folder then for _, child in ipairs(folder:GetChildren()) do addName(child.Name) end end
                end
            end
            if sharedModules then
                addFromDataModule(sharedModules:FindFirstChild("SprinklerData"))
                addFromDataModule(sharedModules:FindFirstChild("WateringcanData"))
                addFromDataModule(sharedModules:FindFirstChild("WateringCanData"))
                addFromDataModule(sharedModules:FindFirstChild("MushroomData"))
                addFromDataModule(sharedModules:FindFirstChild("ShovelData"))
                addFromDataModule(sharedModules:FindFirstChild("TrowelData"))
                addFromDataModule(sharedModules:FindFirstChild("GnomeData"))
                addFromDataModule(sharedModules:FindFirstChild("GearData"))
                addFromDataModule(sharedModules:FindFirstChild("ToolData"))
            end
            if cmdrTypes then
                addFromDataModule(cmdrTypes:FindFirstChild("SprinklerName"))
                addFromDataModule(cmdrTypes:FindFirstChild("WateringCanName"))
                addFromDataModule(cmdrTypes:FindFirstChild("MushroomName"))
                addFromDataModule(cmdrTypes:FindFirstChild("TrowelName"))
                addFromDataModule(cmdrTypes:FindFirstChild("ToolName"))
                addFromDataModule(cmdrTypes:FindFirstChild("GearName"))
            end
        elseif categoryKey == "Crates" then
            if assets then
                local folder = assets:FindFirstChild("Crates") or assets:FindFirstChild("Boxes")
                if folder then for _, child in ipairs(folder:GetChildren()) do addName(child.Name) end end
            end
            if sharedModules then
                addFromDataModule(sharedModules:FindFirstChild("CrateData"))
                addFromDataModule(sharedModules:FindFirstChild("GuildCrateData"))
            end
            if cmdrTypes then addFromDataModule(cmdrTypes:FindFirstChild("CrateName")) end
        elseif categoryKey == "Eggs" then
            if sharedModules then addFromDataModule(sharedModules:FindFirstChild("EggData")) end
            if cmdrTypes then addFromDataModule(cmdrTypes:FindFirstChild("EggName")) end
        elseif categoryKey == "Events" then
            if assets then
                local folder = assets:FindFirstChild("Events")
                if folder then for _, child in ipairs(folder:GetChildren()) do addName(child.Name) end end
            end
            if cmdrTypes then addFromDataModule(cmdrTypes:FindFirstChild("Event")) end
        end
    end)

    -- 2. Fallback to cleaned MASTER_PRESETS
    if MASTER_PRESETS[categoryKey] then
        for _, presetName in ipairs(MASTER_PRESETS[categoryKey]) do
            addName(presetName)
        end
    end

    -- 3. Add Custom Buy Items
    if self.Config.CustomBuyItems and self.Config.CustomBuyItems[categoryKey] then
        for _, customName in ipairs(self.Config.CustomBuyItems[categoryKey]) do
            addName(customName)
        end
    end

    table.sort(list)
    return list
end
