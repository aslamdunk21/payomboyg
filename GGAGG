function Engine:GetInventoryDropdownOptions(category)
    local items = {}
    local itemCounts = {}
    local catKey = tostring(category or "Fruits"):lower()

    pcall(function()
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        local char = LocalPlayer.Character

        local function scanContainer(container)
            if not container then return end
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") or item:IsA("Folder") or item:IsA("Model") then
                    local rawName = item.Name
                    local cleanName = Engine:CleanItemName(rawName)
                    local lowerName = rawName:lower()
                    local isMatch = false

                    if catKey:find("egg") or catKey:find("ไข่") then
                        if lowerName:find("egg") or lowerName:find("ไข่") or item:GetAttribute("IsEgg") then
                            isMatch = true
                        end
                    elseif catKey:find("pet") or catKey:find("สัตว์") then
                        if lowerName:find("pet") or lowerName:find("สัตว์") or (not lowerName:find("egg") and item:GetAttribute("IsPet")) then
                            isMatch = true
                        end
                    elseif catKey:find("seed") or catKey:find("เมล็ด") then
                        if lowerName:find("seed") or lowerName:find("เมล็ด") then
                            isMatch = true
                        end
                    elseif catKey:find("gear") or catKey:find("เกียร์") then
                        if lowerName:find("shovel") or lowerName:find("can") or lowerName:find("trowel") or lowerName:find("scythe") or lowerName:find("gear") then
                            isMatch = true
                        end
                    elseif catKey:find("crate") or catKey:find("กล่อง") then
                        if lowerName:find("crate") or lowerName:find("กล่อง") then
                            isMatch = true
                        end
                    elseif catKey:find("event") or catKey:find("กิจกรรม") then
                        if lowerName:find("event") or lowerName:find("honey") or lowerName:find("voucher") then
                            isMatch = true
                        end
                    else -- Fruits / Crops (Default)
                        if item:FindFirstChild("Item_String") or lowerName:find("crop") or lowerName:find("fruit") or (not lowerName:find("seed") and not lowerName:find("egg") and not lowerName:find("shovel") and not lowerName:find("can") and not lowerName:find("trowel")) then
                            isMatch = true
                        end
                    end

                    if isMatch then
                        itemCounts[cleanName] = (itemCounts[cleanName] or 0) + 1
                    end
                end
            end
        end

        scanContainer(backpack)
        scanContainer(char)

        local playerData = ReplicatedStorage:FindFirstChild("PlayerData") or ReplicatedStorage:FindFirstChild("Data")
        if playerData and playerData:FindFirstChild(LocalPlayer.Name) then
            local pFolder = playerData[LocalPlayer.Name]
            local inv = pFolder:FindFirstChild("Inventory") or pFolder:FindFirstChild("Backpack")
            if inv then scanContainer(inv) end
        end

        for categoryName, stockTable in pairs(Engine.Stocks) do
            if categoryName:lower():find(catKey) or (catKey:find("egg") and categoryName == "Eggs") or (catKey:find("seed") and categoryName == "Seeds") then
                for itemName, info in pairs(stockTable) do
                    local qty = (type(info) == "table" and (info.Count or info.Amount or info.Stock)) or (type(info) == "number" and info) or 0
                    if qty > 0 then
                        local clean = Engine:CleanItemName(itemName)
                        itemCounts[clean] = (itemCounts[clean] or 0) + qty
                    end
                end
            end
        end
    end)

    for name, count in pairs(itemCounts) do
        table.insert(items, string.format("%s (x%d)", name, count))
    end

    table.sort(items)

    if #items == 0 then
        table.insert(items, "⚠️ ไม่มีไอเทมใน Inventory (Empty)")
    end

    return items
end

