function GAG2Engine:SendTradeMail(recipient, category, itemName, amount, sheckles)
    if recipient == "" then
        Engine:Notify({ Title = "ส่ง Trade Mail ล้มเหลว ❌", Content = "กรุณาระบุชื่อผู้รับ (Recipient Username)" })
        return
    end

    pcall(function()
        local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
        if not sharedModules then
            Engine:Notify({ Title = "ส่ง Trade Mail ล้มเหลว ❌", Content = "ไม่พบ SharedModules ในแมพนี้" })
            return
        end
        local networkingMod = sharedModules:FindFirstChild("Networking")
        if not networkingMod then return end
        local Networking = require(networkingMod)

        local mailService = Networking.Mail or Networking.TradeMail or Networking.Trade or Networking.PostOffice
        if mailService and (mailService.SendMail or mailService.Send) then
            local sendRemote = mailService.SendMail or mailService.Send
            
            local payload = {
                Recipient = recipient,
                Category = category,
                ItemName = itemName,
                Amount = amount,
                Sheckles = sheckles
            }

            sendRemote:Fire(recipient, payload)
            
            local logMsg = string.format("📬 ส่งไปที่: %s | ไอเทม: %s x%d | เงิน: %d Sheckles", recipient, itemName ~= "" and itemName or "ไม่มี", amount, sheckles)
            table.insert(Engine.TradeLogs, logMsg)
            Engine:Notify({ Title = "ส่ง Trade Mail สำเร็จ! 📬", Content = logMsg })
        else
            Engine:Notify({ Title = "เกิดข้อผิดพลาด Remote ❌", Content = "ไม่พบ Remote Trade Mail ของแมพ GAG2" })
        end
    end)
end

