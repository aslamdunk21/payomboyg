function GAG2Engine:AuctionSnipeLoop()
    if not Engine.Config.AutoSnipeAuctions then return end

    pcall(function()
        local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
        if not sharedModules then return end
        local networkingMod = sharedModules:FindFirstChild("Networking")
        local Networking = networkingMod and safeRequire(networkingMod)

        local liveItems = LiveAuctionItemsCache
        if #liveItems == 0 then
            self:GetLiveAuctionItems()
            liveItems = LiveAuctionItemsCache
        end

        local maxPrice = tonumber(Engine.Config.MaxSnipePrice) or 50000

        for _, item in ipairs(liveItems) do
            local cleanName = item.CleanName
            local auctionKey = item.AuctionKey or item.RawName
            local price = item.Price

            local matchesSeed = Engine:IsItemSelected(Engine.Config.SelectedSnipeSeeds, cleanName)
            local matchesEgg = Engine:IsItemSelected(Engine.Config.SelectedSnipeEggs, cleanName)
            local matchesGear = Engine:IsItemSelected(Engine.Config.SelectedSnipeGears, cleanName)
            local matchesLiveSelected = (Engine.Config.SelectedLiveAuctionItem ~= "" and (cleanName:lower():find(Engine:CleanItemName(Engine.Config.SelectedLiveAuctionItem):lower()) or auctionKey:lower():find(Engine:CleanItemName(Engine.Config.SelectedLiveAuctionItem):lower())))

            if (matchesSeed or matchesEgg or matchesGear or matchesLiveSelected) then
                if price <= maxPrice and canAffordGAG2(cleanName) then
                    local fired = false
                    
                    if Networking then
                        local auctionService = Networking.Auction or Networking.AuctionShop or Networking.Auctions
                        if auctionService then
                            local bidFunc = auctionService.Bid or auctionService.Purchase or auctionService.PlaceBid or auctionService.Buy or auctionService.PurchaseAuction
                            if bidFunc then
                                pcall(function() bidFunc:Fire(auctionKey, price) end)
                                pcall(function() bidFunc:Fire(item.RawName, price) end)
                                fired = true
                            end
                        end
                    end

                    if not fired or true then
                        pcall(function()
                            local packetRemote = sharedModules:FindFirstChild("Packet") and sharedModules.Packet:FindFirstChild("RemoteEvent")
                            if packetRemote then
                                local args1 = { buffer.fromstring(string.format("AUCTION_BID\000%s\000%d", auctionKey, price)) }
                                local args2 = { buffer.fromstring(string.format("AUCTION_PURCHASE\000%s", auctionKey)) }
                                packetRemote:FireServer(unpack(args1))
                                packetRemote:FireServer(unpack(args2))
                                fired = true
                            end
                        end)
                    end

                    if fired then
                        Engine:Notify({
                            Title = "🔨 Snipe ประมูลสำเร็จ! (Auction Bidded)",
                            Content = string.format("ยิงประมูล '%s' [%s] ในราคา %s Sheckles เรียบร้อย!", cleanName, auctionKey, Engine:FormatMoney(price))
                        })
                        task.wait(Engine.Config.BuyDelay or 0.2)
                    end
                end
            end
        end
    end)
end

