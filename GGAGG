function Engine:CleanItemName(name)
    if not name then return "" end
    local clean = tostring(name)
    clean = clean:gsub("%[%w+%]%s*", "")
    clean = clean:gsub("%(x%d+%)", "")
    clean = clean:gsub("%s*x%d+", "")
    clean = clean:gsub("^%s*(.-)%s*$", "%1")
    return clean
end

