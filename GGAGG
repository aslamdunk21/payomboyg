-- Advanced Night Steal Engine with FruitValueCalc & Smooth Lerp Teleport (Parity with R4.lua)
local function safeRequire(mod)
    if not mod then return nil end
    local ok, res = pcall(require, mod)
    return ok and res or nil
end

local function canPlayerBeStolen(player)
    if not player then return false end
    local ok, res = pcall(function() return player:GetAttribute("IsInOwnGarden") end)
    return ok and (res or false) or false
end

local function smoothTeleport(hrp, startCF, targetCF, speed)
    if not hrp or not startCF or not targetCF or not speed or speed <= 0 then return end
    local distance = (targetCF.Position - startCF.Position).Magnitude
    local duration = distance / speed
    local elp = 0
    local con
    con = RunService.RenderStepped:Connect(function(dt)
        elp = elp + dt
        if elp >= duration then
            if hrp and hrp.Parent then hrp.CFrame = targetCF end
            if con then con:Disconnect() end
            return
        end
        local alpha = elp / duration
        if hrp and hrp.Parent then
            hrp.CFrame = startCF:Lerp(targetCF, alpha)
        else
            if con then con:Disconnect() end
        end
    end)
    local waitStart = tick()
    while con and con.Connected and tick() - waitStart < duration + 2 do
        task.wait()
    end
    if con and con.Connected then pcall(function() con:Disconnect() end) end
end

local function getPlantDecay(model, plantCycleModule)
    if not plantCycleModule or not model then return 0 end
    local ok, entries = pcall(function() return plantCycleModule:GetActiveEntries() end)
    if not ok or type(entries) ~= "table" then return 0 end
    for plantid, planttable in pairs(entries) do
        if planttable and planttable.Model == model then
            local a, b = string.match(tostring(plantid), "^(%d+)_(.+)$")
            if a and b then
                local ok2, decay = pcall(function() return plantCycleModule:GetDecayAlpha(tonumber(a), b) end)
                if ok2 then return decay or 0 end
            end
        end
    end
    return 0
end

function GAG2Engine:GetBestPlantToSteal()
    local bestModel = nil
    local bestValue = -1

    local gardens = workspace:FindFirstChild("Gardens")
    if not gardens then return nil, -1 end

    local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
    if not sharedModules then return nil, -1 end

    local flags = sharedModules:FindFirstChild("Flags")
    local stealFlags = flags and safeRequire(flags:FindFirstChild("StealFlags"))
    local fruitCalc = safeRequire(sharedModules:FindFirstChild("FruitValueCalc"))

    local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
    local controllers = playerScripts and playerScripts:FindFirstChild("Controllers")
    local plantCycleModule = controllers and safeRequire(controllers:FindFirstChild("PlantLifecycleHandler"))

    for _, plot in ipairs(gardens:GetChildren()) do
        local plants = plot:FindFirstChild("Plants")
        if plants then
            for _, model in ipairs(plants:GetChildren()) do
                if model:IsA("Model") then
                    local fruits = model:FindFirstChild("Fruits")
                    if fruits then
                        for _, fruit in ipairs(fruits:GetChildren()) do
                            local seedName = model:GetAttribute("SeedName") or model:GetAttribute("CorePartName")
                            if seedName and stealFlags and stealFlags.IsPlantStealable then
                                if stealFlags.IsPlantStealable(seedName) then
                                    local targetUserId = model:GetAttribute("UserId")
                                    if targetUserId then
                                        local targetPlayer = Players:GetPlayerByUserId(tonumber(targetUserId))
                                        if targetPlayer and not canPlayerBeStolen(targetPlayer) then
                                            local mutation = fruit:GetAttribute("Mutation") or ""
                                            local sizeMulti = fruit:GetAttribute("SizeMulti") or 1
                                            local decayAlpha = getPlantDecay(model, plantCycleModule)

                                            local calcVal = 0
                                            if fruitCalc then
                                                local ok, val = pcall(function()
                                                    return fruitCalc(seedName, sizeMulti, mutation, LocalPlayer, decayAlpha)
                                                end)
                                                if ok and val then calcVal = val end
                                            end

                                            if calcVal > bestValue then
                                                bestValue = calcVal
                                                bestModel = model
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return bestModel, bestValue
end

function GAG2Engine:NightStealLoop()
    pcall(function()
        local bestModel, bestValue = self:GetBestPlantToSteal()
        if not bestModel then
            Engine:Notify({ Title = "⚡ ระบบขโมยผัก", Content = "ไม่พบผักที่สามารถขโมยได้ในขณะนี้" })
            return
        end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local targetPart = bestModel:FindFirstChild("Stem") or bestModel:FindFirstChild("BasePart") or bestModel:FindFirstChildOfClass("BasePart") or bestModel.PrimaryPart
        if not targetPart then return end

        local oldCF = hrp.CFrame
        local targetCF = targetPart.CFrame * CFrame.new(0, 3, 0)

        Engine:Notify({
            Title = "⚡ กำลังไปขโมยผัก!",
            Content = string.format("วาร์ปไปยังผักมูลค่า %s Sheckles...", Engine:FormatMoney(bestValue))
        })

        smoothTeleport(hrp, oldCF, targetCF, 120)

        task.wait(0.5)

        -- Interact / Harvest remote trigger
        pcall(function()
            local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
            local networkingMod = sharedModules and sharedModules:FindFirstChild("Networking")
            local Networking = networkingMod and safeRequire(networkingMod)

            if Networking and Networking.Steal and Networking.Steal.StealPlant then
                Networking.Steal.StealPlant:Fire(bestModel)
            elseif Networking and Networking.Garden and Networking.Garden.Harvest then
                Networking.Garden.Harvest:Fire(bestModel)
            else
