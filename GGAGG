function GAG2Engine:SetLoop(name, interval, callback)
    if not name or not callback then return end
    self._Loops = self._Loops or {}
    if self._Loops[name] then
        pcall(function() self._Loops[name]:Disconnect() end)
        self._Loops[name] = nil
    end
    task.spawn(function()
        while task.wait(interval or 1) do
            local ok, err = pcall(callback)
            if not ok then break end
        end
    end)
end

