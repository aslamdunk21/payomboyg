function GAG2Engine:ClaimAllMailNow()
    pcall(function()
        local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
        if not sharedModules then
            Engine:Notify({ Title = "รับ Mail ล้มเหลว ❌", Content = "ไม่พบ SharedModules ในแมพนี้" })
            return
        end
        local networkingMod = sharedModules:FindFirstChild("Networking")
        if not networkingMod then return end
        local Networking = require(networkingMod)

        local mailService = Networking.Mail or Networking.TradeMail or Networking.PostOffice
        if mailService then
            local claimAll = mailService.ClaimAllMail or mailService.ClaimAll or mailService.Claim
            if claimAll then
                claimAll:Fire()
                Engine:Notify({ Title = "ออโต้กดรับ Mail 📬", Content = "กดรับของจาก Trade Mail ทั้งหมดเรียบร้อย" })
            end
        end
    end)
end

function GAG2Engine:InitAutoClaimMail()
    task.spawn(function()
        while true do
            local delayTime = Engine.Config.ClaimMailDelay or 3
            task.wait(delayTime)
            if Engine.Config.AutoClaimMail then
                self:ClaimAllMailNow()
            end
        end
    end)
end

function GAG2Engine:FormatMoney(amount)
    amount = tonumber(amount) or 0
    if amount >= 1e12 then
        return string.format("%.2fT", amount / 1e12)
    elseif amount >= 1e9 then
        return string.format("%.2fB", amount / 1e9)
    elseif amount >= 1e6 then
        return string.format("%.2fM", amount / 1e6)
    elseif amount >= 1e3 then
        return string.format("%.2fK", amount / 1e3)
    else
        return string.format("%d", amount)
    end
end

function GAG2Engine:ScanInventoryItems(categoryKey)
    local scanned = {}
    local itemCounts = {}
    
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
    local fruitCalc = sharedModules and safeRequire(sharedModules:FindFirstChild("FruitValueCalc"))

    local basePrices = {
        ["Bamboo"] = 15000, ["Dragon Fruit"] = 500000, ["Golden Apple"] = 2500000,
        ["Golden Pumpkin"] = 10000000, ["Starfruit"] = 50000000, ["Dragon's Breath"] = 500000000,
        ["Venom Spitter"] = 750000000, ["Poison Apple"] = 1000000000, ["Hypno Bloom"] = 2500000000
    }

    local function getItemAssetCategory(itemInst, cleanName, rawName)
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        if assets then
            -- 1. Fruits Folder Check (game.ReplicatedStorage.Assets.Fruits)
            local fruitsFolder = assets:FindFirstChild("Fruits") or assets:FindFirstChild("Crops")
            if fruitsFolder and (fruitsFolder:FindFirstChild(cleanName) or fruitsFolder:FindFirstChild(rawName)) then
                return "Fruits"
            end
            
            -- 2. Pets Folder Check (game.ReplicatedStorage.Assets.Pets)
            local petsFolder = assets:FindFirstChild("Pets")
            if petsFolder and (petsFolder:FindFirstChild(cleanName) or petsFolder:FindFirstChild(rawName)) then
                return "Pets"
            end
            
            -- 3. Seeds Folder Check (game.ReplicatedStorage.Assets.Seeds)
            local seedsFolder = assets:FindFirstChild("Seeds")
            if seedsFolder and (seedsFolder:FindFirstChild(cleanName) or seedsFolder:FindFirstChild(rawName)) then
                return "Seeds"
            end
            
            -- 4. Gears Folders Check (Mushrooms, Sprinklers, WateringCans, Gears, Tools, Shovels)
            local gearFolders = {
                assets:FindFirstChild("Mushrooms"),
                assets:FindFirstChild("Sprinklers"),
                assets:FindFirstChild("WateringCans"),
                assets:FindFirstChild("Gears"),
                assets:FindFirstChild("Tools"),
                assets:FindFirstChild("Shovels")
            }
            for _, gFolder in ipairs(gearFolders) do
                if gFolder and (gFolder:FindFirstChild(cleanName) or gFolder:FindFirstChild(rawName)) then
                    return "Gears"
                end
            end

            -- 5. Eggs Folder Check
            local eggsFolder = assets:FindFirstChild("Eggs")
            if eggsFolder and (eggsFolder:FindFirstChild(cleanName) or eggsFolder:FindFirstChild(rawName)) then
                return "Eggs"
            end

            -- 6. Crates Folder Check
            local cratesFolder = assets:FindFirstChild("Crates") or assets:FindFirstChild("Boxes")
            if cratesFolder and (cratesFolder:FindFirstChild(cleanName) or cratesFolder:FindFirstChild(rawName)) then
                return "Crates"
            end
        end

        -- Attribute-based precise detection
        if itemInst:GetAttribute("Fruit") or itemInst:GetAttribute("SeedName") then return "Fruits" end
        if itemInst:GetAttribute("IsSeed") then return "Seeds" end
        if itemInst:GetAttribute("Pet") or itemInst:GetAttribute("PetId") then return "Pets" end
        if itemInst:GetAttribute("IsEgg") or itemInst:GetAttribute("Egg") then return "Eggs" end
        if itemInst:GetAttribute("IsGear") then return "Gears" end

        -- Pattern matching fallback
        local lRaw = rawName:lower()
        local lClean = cleanName:lower()

        if lRaw:find("egg") or lClean:find("egg") or lRaw:find("ไข่") then
            return "Eggs"
        end
        if lRaw:find("seed") or lClean:find("seed") or lRaw:find("พันธุ์") then
            return "Seeds"
        end
        if lRaw:find("can") or lRaw:find("shovel") or lRaw:find("sprinkler") or lRaw:find("trowel") or lRaw:find("harvester") or lRaw:find("shroom") or lRaw:find("rod") or lRaw:find("shears") then
            return "Gears"
        end
        if lRaw:find("pet") or lRaw:find("raccoon") or lRaw:find("dragon") or lRaw:find("bee") or lRaw:find("turtle") or lRaw:find("unicorn") or lRaw:find("robin") or lRaw:find("bear") or lRaw:find("cat") or lRaw:find("dog") then
            return "Pets"
        end
        if lRaw:find("crate") or lRaw:find("box") or lRaw:find("chest") or lRaw:find("กล่อง") then
            return "Crates"
        end
        if itemInst:GetAttribute("Weight") or itemInst:GetAttribute("Mutation") or itemInst:GetAttribute("Variant") or lRaw:find("fruit") or lRaw:find("apple") or lRaw:find("pumpkin") or lRaw:find("bamboo") or lRaw:find("bloom") or lRaw:find("starfruit") then
            return "Fruits"
        end

        return nil
    end

    local function inspectItem(itemInst)
        if not itemInst then return end

        -- ⛔ BLACKLIST: Reject Roblox character parts, limbs, humanoid, scripts, clothes & GUI instances immediately
        if itemInst:IsA("BasePart") or itemInst:IsA("MeshPart") or itemInst:IsA("Part") or itemInst:IsA("Humanoid") 
           or itemInst:IsA("Accessory") or itemInst:IsA("Shirt") or itemInst:IsA("Pants") or itemInst:IsA("ShirtGraphic") 
           or itemInst:IsA("BodyColors") or itemInst:IsA("CharacterMesh") or itemInst:IsA("Script") or itemInst:IsA("LocalScript") 
           or itemInst:IsA("ModuleScript") or itemInst:IsA("Folder") or itemInst:IsA("Sound") or itemInst:IsA("Attachment") 
           or itemInst:IsA("WrapLayer") or itemInst:IsA("Animator") or itemInst:IsA("FaceControls") or itemInst:IsA("Decal") 
           or itemInst:IsA("Texture") or itemInst:IsA("ScreenGui") or itemInst:IsA("Frame") or itemInst:IsA("UIGridLayout") 
           or itemInst:IsA("UIListLayout") then
            return
        end

        pcall(function()
            local rawName = itemInst.Name
            
            -- Explicit character body parts name check
            local charPartNames = {
                ["head"]=true, ["humanoid"]=true, ["humanoidrootpart"]=true, ["torso"]=true,
                ["left arm"]=true, ["right arm"]=true, ["left leg"]=true, ["right leg"]=true,
                ["leftupperarm"]=true, ["rightupperarm"]=true, ["leftlowerarm"]=true, ["rightlowerarm"]=true,
                ["lefthand"]=true, ["righthand"]=true, ["leftupperleg"]=true, ["rightupperleg"]=true,
                ["leftlowerleg"]=true, ["rightlowerleg"]=true, ["leftfoot"]=true, ["rightfoot"]=true,
                ["upperbody"]=true, ["lowerbody"]=true, ["pal hair"]=true, ["pants"]=true, ["shirt"]=true,
                ["health"]=true, ["animate"]=true, ["sound"]=true
            }
            if charPartNames[rawName:lower()] then return end

            local cleanName = Engine:CleanItemName(rawName)
            if cleanName == "" then return end
            
            local detectedCategory = getItemAssetCategory(itemInst, cleanName, rawName)

            -- Fallback: ONLY real Tools default to active category, NEVER non-tool character children
            if not detectedCategory and itemInst:IsA("Tool") then
                detectedCategory = categoryKey
            end

            if detectedCategory ~= categoryKey then return end

            local qty = itemInst:GetAttribute("Amount") or itemInst:GetAttribute("Count") or itemInst:GetAttribute("Quantity") or itemInst:GetAttribute("Stack") or (itemInst:IsA("ValueBase") and itemInst.Value) or 1
            qty = math.max(1, tonumber(qty) or 1)

            if categoryKey == "Fruits" then
                local seedName = itemInst:GetAttribute("SeedName") or itemInst:GetAttribute("CorePartName") or itemInst:GetAttribute("Fruit") or cleanName
                local weight = itemInst:GetAttribute("Weight") or itemInst:GetAttribute("SizeMulti") or itemInst:GetAttribute("Size") or 1
                local variant = itemInst:GetAttribute("Variant") or itemInst:GetAttribute("Mutation") or ""
                local calcVal = itemInst:GetAttribute("Value") or itemInst:GetAttribute("Price") or itemInst:GetAttribute("Sheckles")

                if not calcVal and fruitCalc then
                    pcall(function() calcVal = fruitCalc(seedName, weight, variant, LocalPlayer, 0) end)
                end

                if not calcVal then
                    local base = basePrices[seedName] or 25000
                    local mutMulti = 1
                    if variant:find("Gold") then mutMulti = 10
                    elseif variant:find("Rainbow") then mutMulti = 50
                    end
                    calcVal = base * (weight or 1) * mutMulti
                end

                calcVal = tonumber(calcVal) or 0
                local fmt = self:FormatMoney(calcVal)
                local label = string.format("🍎 %s%s (x%.1f) - 💰 %s Sheckles [ในกระเป๋า]", variant ~= "" and "["..variant.."] " or "", seedName, weight, fmt)

                local debugId = (itemInst:IsA("Instance") and typeof(itemInst.GetDebugId) == "function") and itemInst:GetDebugId() or (cleanName .. "_" .. tostring(math.random(1000,9999)))

                table.insert(scanned, {
                    Id = debugId,
                    Label = label,
                    Value = calcVal,
                    Tool = itemInst,
                    Name = seedName,
                    Category = "Fruits",
                    InInventory = true
                })
            else
                if not itemCounts[cleanName] then
                    itemCounts[cleanName] = {
                        Name = cleanName,
                        Count = 0,
                        Tool = itemInst,
                        Details = itemInst
                    }
                end
                itemCounts[cleanName].Count = itemCounts[cleanName].Count + qty
            end
        end)
    end

    if bp then
        for _, item in ipairs(bp:GetChildren()) do inspectItem(item) end
    end
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") then
                inspectItem(item)
            end
        end
    end

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")

    local dataFolders = {
        LocalPlayer:FindFirstChild("Data"),
        LocalPlayer:FindFirstChild("Inventory"),
        LocalPlayer:FindFirstChild("Items"),
        LocalPlayer:FindFirstChild("PlayerData"),
        playerScripts and playerScripts:FindFirstChild("Controllers") and playerScripts.Controllers:FindFirstChild("InventoryController"),
        playerGui and playerGui:FindFirstChild("InventoryGui"),
        playerGui and playerGui:FindFirstChild("Inventory"),
        playerGui and playerGui:FindFirstChild("Main") and playerGui.Main:FindFirstChild("VirtualInventoryGrid")
    }
    for _, folder in ipairs(dataFolders) do
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                inspectItem(child)
            end
        end
    end

    -- 🔍 Also scan GAG2 PlayerStateClient Replica inventory (Eggs, BrownEggs, Seeds, Crates, Sprinklers, etc.)
    pcall(function()
        local pscMod = ReplicatedStorage:FindFirstChild("ClientModules") and ReplicatedStorage.ClientModules:FindFirstChild("PlayerStateClient")
        if pscMod then
            local ok, clientObj = pcall(require, pscMod)
            if ok and clientObj and clientObj.GetLocalReplica then
                local replica = clientObj:GetLocalReplica()
                if replica and replica.Data and replica.Data.Inventory then
                    local inv = replica.Data.Inventory
                    if categoryKey == "Eggs" then
                        for _, eggKey in ipairs({"Eggs", "BrownEggs"}) do
                            local eTbl = inv[eggKey]
                            if type(eTbl) == "table" then
                                for eName, count in pairs(eTbl) do
                                    local cNum = tonumber(count) or 1
                                    if cNum > 0 then
                                        local clean = Engine:CleanItemName(tostring(eName))
                                        if not itemCounts[clean] then
                                            itemCounts[clean] = { Name = clean, Count = 0, Tool = nil, Details = nil }
                                        end
                                        itemCounts[clean].Count = itemCounts[clean].Count + cNum
                                    end
                                end
                            end
                        end
                    elseif categoryKey == "Seeds" and inv.Seeds then
                        for sName, count in pairs(inv.Seeds) do
                            local cNum = tonumber(count) or 1
                            if cNum > 0 then
                                local clean = Engine:CleanItemName(tostring(sName))
                                if not itemCounts[clean] then
                                    itemCounts[clean] = { Name = clean, Count = 0, Tool = nil, Details = nil }
                                end
                                itemCounts[clean].Count = itemCounts[clean].Count + cNum
                            end
                        end
                    elseif categoryKey == "Crates" and (inv.Crates or inv.SeedPacks) then
                        for _, cKey in ipairs({"Crates", "SeedPacks"}) do
                            if inv[cKey] then
                                for cName, count in pairs(inv[cKey]) do
                                    local cNum = tonumber(count) or 1
                                    if cNum > 0 then
                                        local clean = Engine:CleanItemName(tostring(cName))
                                        if not itemCounts[clean] then
                                            itemCounts[clean] = { Name = clean, Count = 0, Tool = nil, Details = nil }
                                        end
                                        itemCounts[clean].Count = itemCounts[clean].Count + cNum
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    if categoryKey ~= "Fruits" then
        local icon = "🌱"
        if categoryKey == "Pets" then icon = "🐾"
        elseif categoryKey == "Eggs" then icon = "🥚"
        elseif categoryKey == "Gears" then icon = "⚙️"
        elseif categoryKey == "Crates" then icon = "📦"
        end

        for name, data in pairs(itemCounts) do
            local label = string.format("%s %s (จำนวน: %d ในกระเป๋า)", icon, name, data.Count)
            table.insert(scanned, {
                Id = name,
                Label = label,
                Value = 0,
                Tool = data.Tool,
                Name = name,
                Count = data.Count,
                Category = categoryKey,
                InInventory = true
            })
        end
    end

    table.sort(scanned, function(a, b)
        if a.Value and b.Value and a.Value ~= b.Value then
            return a.Value > b.Value
        end
        return a.Label < b.Label
    end)

    if #scanned == 0 then
        local catLabels = {
            Fruits = "ผัก/ผลไม้", Seeds = "เมล็ดพันธุ์", Pets = "สัตว์เลี้ยง",
            Eggs = "ไข่สัตว์เลี้ยง (Eggs)", Gears = "เกียร์/อุปกรณ์", Crates = "กล่อง Crates"
        }
        local cName = catLabels[categoryKey] or categoryKey
        table.insert(scanned, {
            Id = "EMPTY_NOTICE",
            Label = string.format("❌ ไม่พบ %s ในกระเป๋า (จำนวน: 0 ใน Inventory)", cName),
            Value = 0,
            Tool = nil,
            Category = categoryKey,
            IsEmpty = true,
            InInventory = false
        })
    end

    return scanned
end

