function Engine:GetInventoryDropdownOptions(categoryKey)
    local options = {}
    local addedMap = {}

    -- 1. Scan Backpack and Player Inventory for items owned right now
    local scanned = GAG2Engine:ScanInventoryItems(categoryKey)
    local ownedCount = 0

    for _, item in ipairs(scanned) do
        if not item.IsEmpty and item.Name then
            local clean = self:CleanItemName(item.Name)
            local key = clean:lower()
            if not addedMap[key] then
                addedMap[key] = true
                ownedCount = ownedCount + 1
                if categoryKey == "Fruits" then
                    table.insert(options, item.Label)
                else
                    table.insert(options, string.format("📦 %s (มีอยู่: %d ชิ้นในกระเป๋า)", clean, item.Count or 1))
                end
            end
        end
    end

    if ownedCount > 0 then
        table.insert(options, "-----------------------------------")
    end

    -- 2. Add full game presets below
    local masterOpts = self:GetMasterPresetOptions(categoryKey)
    for _, opt in ipairs(masterOpts) do
        local clean = self:CleanItemName(opt)
        local key = clean:lower()
        if not addedMap[key] then
            addedMap[key] = true
            table.insert(options, "🌐 " .. clean)
        end
    end

    if #options == 0 then
        table.insert(options, "-- ไม่พบไอเทม --")
    end

    return options
end

function GAG2Engine:GetInventoryDropdownOptions(categoryKey)
    return Engine:GetInventoryDropdownOptions(categoryKey)
end

function Engine:CleanItemName(rawText)
    local s = tostring(rawText)
    s = s:gsub("^%[%s*.-%s*%]%s*", "")
    s = s:gsub("%s*%([^%)]*%)", "")
    s = s:gsub("%s*%[[^%]]*%]", "")
    local clean = s:match("^%s*(.-)%s*$") or s
    return clean
end

function Engine:IsItemSelected(selectedMap, itemName)
    if not selectedMap or not itemName then return false end
    local targetClean = self:CleanItemName(itemName):lower()
    for itemKey, isSelected in pairs(selectedMap) do
        if isSelected and self:CleanItemName(itemKey):lower() == targetClean then
            return true
        end
    end
    return false
end

function Engine:RefreshBuyDropdowns()
    local buildList = function(categoryKey, currentStockMap)
        local itemSet = {}
        local list = {}

        if currentStockMap then
            for itemName, info in pairs(currentStockMap) do
                local clean = self:CleanItemName(itemName)
                local stock = type(info) == "table" and (info.Stock or 0) or tonumber(info) or 0
                itemSet[clean:lower()] = clean .. " (สต็อก: " .. tostring(stock) .. ")"
            end
        end

        if MASTER_PRESETS[categoryKey] then
            for _, presetName in ipairs(MASTER_PRESETS[categoryKey]) do
                local clean = self:CleanItemName(presetName)
                if not itemSet[clean:lower()] then
                    itemSet[clean:lower()] = clean .. " (สต็อก: 0)"
                end
            end
        end

        if self.Config.CustomBuyItems and self.Config.CustomBuyItems[categoryKey] then
            for _, customName in ipairs(self.Config.CustomBuyItems[categoryKey]) do
                local clean = self:CleanItemName(customName)
                if not itemSet[clean:lower()] then
                    itemSet[clean:lower()] = clean .. " [ตั้งค่าล่วงหน้า]"
                end
            end
        end

        for _, formattedText in pairs(itemSet) do
            table.insert(list, formattedText)
        end
        table.sort(list)
        return list
    end

    local seedList, eggList, gearList, crateList, eventList

    if IsGAG1 then
        seedList = buildList("Seeds", self.Stocks.Seeds)
        eggList = buildList("Eggs", self.Stocks.Eggs)
        gearList = buildList("Gears", self.Stocks.Gears)
        crateList = buildList("Crates", self.Stocks.Crates or {})
        eventList = buildList("Events", self.Stocks.Events)
    elseif IsGAG2 then
        local g2Seeds, g2Events, g2Gears, g2Crates = {}, {}, {}, {}
        pcall(function()
            local stockValues = ReplicatedStorage:FindFirstChild("StockValues")
            if stockValues then
                if stockValues:FindFirstChild("SeedShop") and stockValues.SeedShop:FindFirstChild("Items") then
                    for _, item in ipairs(stockValues.SeedShop.Items:GetChildren()) do
                        g2Seeds[item.Name] = item.Value
                    end
                end
                if stockValues:FindFirstChild("EventShop") and stockValues.EventShop:FindFirstChild("Items") then
                    for _, item in ipairs(stockValues.EventShop.Items:GetChildren()) do
                        g2Events[item.Name] = item.Value
                    end
                end
                if stockValues:FindFirstChild("GearShop") and stockValues.GearShop:FindFirstChild("Items") then
                    for _, item in ipairs(stockValues.GearShop.Items:GetChildren()) do
                        g2Gears[item.Name] = item.Value
                    end
                end
                if stockValues:FindFirstChild("CrateShop") and stockValues.CrateShop:FindFirstChild("Items") then
                    for _, item in ipairs(stockValues.CrateShop.Items:GetChildren()) do
                        g2Crates[item.Name] = item.Value
                    end
                end
            end
        end)
        seedList = buildList("Seeds", g2Seeds)
        eggList = buildList("Eggs", {})
        gearList = buildList("Gears", g2Gears)
        crateList = buildList("Crates", g2Crates)
        eventList = buildList("Events", g2Events)
    else
        seedList = buildList("Seeds", {})
        eggList = buildList("Eggs", {})
        gearList = buildList("Gears", {})
        crateList = buildList("Crates", {})
        eventList = buildList("Events", {})
    end

