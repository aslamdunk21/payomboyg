                saCorner.CornerRadius = UDim.new(0, 6)
                saCorner.Parent = selectAllBtn

                selectAllBtn.MouseButton1Click:Connect(function()
                    playClickSound()
                    local allSelected = true
                    for _, opt in ipairs(newOpts) do
                        local clean = Engine:CleanItemName(tostring(opt))
                        if not Engine:IsItemSelected(selectedMap, clean) then
                            allSelected = false
                            break
                        end
                    end

                    local newState = not allSelected
                    for _, opt in ipairs(newOpts) do
                        local clean = Engine:CleanItemName(tostring(opt))
                        selectedMap[clean] = newState
                    end

                    refreshOptions(newOpts)
                    updateBtnText()
                    callback(selectedMap)
                end)
            end

            for _, opt in ipairs(newOpts) do
                local rawString = tostring(opt)
                local cleanName = Engine:CleanItemName(rawString)
                local isCurrentlySel = isMulti and Engine:IsItemSelected(selectedMap, cleanName) or (currentSingleVal == opt or currentSingleVal == cleanName)

