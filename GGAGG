function GAG2Engine:GetGardenDashboardStats()
    local stats = {
        TotalPlanted = 0,
        ReadyToHarvest = 0,
        GoldFruits = 0,
        RainbowFruits = 0,
        TotalValue = 0,
        FormattedValue = "0"
    }

    pcall(function()
        local ownerPlot = self:GetOwnerPlot()
        if not ownerPlot then return end

        local plantsHolder = ownerPlot:FindFirstChild("Plants") or ownerPlot:FindFirstChild("Crops") or ownerPlot
        for _, plant in ipairs(plantsHolder:GetChildren()) do
            if plant:IsA("Model") or plant:IsA("BasePart") then
                stats.TotalPlanted = stats.TotalPlanted + 1

                local isReady = plant:GetAttribute("IsReady") or plant:GetAttribute("Harvestable") or plant:FindFirstChild("Fruit") ~= nil
                if isReady then
                    stats.ReadyToHarvest = stats.ReadyToHarvest + 1
                end

                local variant = plant:GetAttribute("Variant") or plant:GetAttribute("Mutation") or plant.Name
                if variant:find("Gold") then
                    stats.GoldFruits = stats.GoldFruits + 1
                elseif variant:find("Rainbow") then
                    stats.RainbowFruits = stats.RainbowFruits + 1
                end

                local weight = plant:GetAttribute("Weight") or 1.0
                local seedName = plant:GetAttribute("SeedName") or plant.Name
                local fruitCalc = self:GetFruitCalc()
                local val = 0
                if fruitCalc then
                    pcall(function()
                        val = fruitCalc(seedName, weight, variant, LocalPlayer, 0)
                    end)
                end
                stats.TotalValue = stats.TotalValue + (tonumber(val) or 0)
            end
        end

        stats.FormattedValue = self:FormatMoney(stats.TotalValue)
    end)

    return stats
end

