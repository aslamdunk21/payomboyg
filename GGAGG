            if isMulti then
                local count = 0
                for _, v in pairs(selectedMap) do
                    if v then count = count + 1 end
                end
                if count == 0 then
                    dropBtn.Text = "ยังไม่ได้เลือกสินค้า  ▼"
                else
                    dropBtn.Text = "เลือกแล้ว (" .. count .. ") รายการ  ▼"
                end
            else
