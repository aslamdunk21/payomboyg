                local selectAllBtn = Instance.new("TextButton")
                selectAllBtn.Size = UDim2.new(1, 0, 0, 30)
                selectAllBtn.BackgroundColor3 = COLORS.primary
                selectAllBtn.BorderSizePixel = 0
