--======================================================================================
-- 📌 GAG2 MAIL SYSTEM V2 ENGINE (SERVER & MESSAGING SERVICE WORKER POOL)
--======================================================================================
local function initServerMailSystem()
    local DataStoreService = game:GetService("DataStoreService")
    local MessagingService = game:GetService("MessagingService")

    local ok1, mailStore = pcall(function() return DataStoreService:GetDataStore("GAG2_MailStore") end)
    mailStore = ok1 and mailStore or nil

    local ok2, mailQueueStore = pcall(function() return DataStoreService:GetDataStore("GAG2_MailQueue") end)
    mailQueueStore = ok2 and mailQueueStore or nil

    local GAG2_MailEvent = ReplicatedStorage:FindFirstChild("GAG2_MailEvent") or Instance.new("RemoteEvent")
    GAG2_MailEvent.Name = "GAG2_MailEvent"
    GAG2_MailEvent.Parent = ReplicatedStorage

    local GAG2_MailResult = ReplicatedStorage:FindFirstChild("GAG2_MailResult") or Instance.new("RemoteEvent")
    GAG2_MailResult.Name = "GAG2_MailResult"
    GAG2_MailResult.Parent = ReplicatedStorage

    local MAX_WORKERS = 5
    local BATCH_SIZE = 30
    local RATE_LIMIT_DELAY = 0.5
    local MAIL_EXPIRY_SECS = 30 * 86400

    local workerQueue = {}
    local activeWorkers = 0

    local function safeDataStoreOp(opType, key, value, retries)
        if not mailStore then return false, nil end
        retries = retries or 3
        for i = 1, retries do
            local success, result = pcall(function()
                if opType == "Get" then
                    return mailStore:GetAsync(key)
                elseif opType == "Set" then
                    return mailStore:SetAsync(key, value)
                elseif opType == "Update" then
                    return mailStore:UpdateAsync(key, function(oldData)
                        oldData = oldData or {}
                        local now = os.time()
                        local cleaned = {}
                        for _, m in ipairs(oldData) do
                            if type(m) == "table" and m.Timestamp and (now - m.Timestamp < MAIL_EXPIRY_SECS) then
                                table.insert(cleaned, m)
                            end
                        end
                        table.insert(cleaned, value)
                        return cleaned
                    end)
                end
            end)
            if success then return true, result end
            task.wait(2 ^ (i - 1))
        end
        return false, nil
    end

    local function sendMailToPlayer(sender, recipientTarget, mailData)
        local recipientUserId = tonumber(recipientTarget)
        local recipientPlayer = nil
        if recipientUserId then
            recipientPlayer = Players:GetPlayerByUserId(recipientUserId)
        else
            recipientPlayer = Players:FindFirstChild(tostring(recipientTarget))
            if recipientPlayer then recipientUserId = recipientPlayer.UserId end
        end

        mailData.MailId = HttpService:GenerateGUID(false)
        mailData.Sender = sender and sender.Name or "System"
        mailData.SenderId = sender and sender.UserId or 0
        mailData.Timestamp = mailData.Timestamp or os.time()

        if recipientPlayer then
            GAG2_MailEvent:FireClient(recipientPlayer, "GAG2_NewMail", mailData)
        elseif recipientUserId then
            safeDataStoreOp("Update", tostring(recipientUserId), mailData)
        end

        pcall(function()
            MessagingService:PublishAsync("GAG2_MailUpdate", {
                RecipientId = recipientUserId or recipientTarget,
                MailData = mailData
            })
        end)
    end

    local function processQueue()
        if activeWorkers >= MAX_WORKERS or #workerQueue == 0 then return end
        activeWorkers = activeWorkers + 1

        task.spawn(function()
            while #workerQueue > 0 do
                local batch = {}
                for i = 1, math.min(BATCH_SIZE, #workerQueue) do
                    table.insert(batch, table.remove(workerQueue, 1))
                end

                for _, job in ipairs(batch) do
                    sendMailToPlayer(job.Sender, job.RecipientId, job.MailData)
                end
                task.wait(RATE_LIMIT_DELAY)
            end
            activeWorkers = activeWorkers - 1
        end)
    end

    pcall(function()
        MessagingService:SubscribeAsync("GAG2_MailUpdate", function(message)
            local data = message.Data
            if data and data.MailData then
                local recipient = nil
                if tonumber(data.RecipientId) then
                    recipient = Players:GetPlayerByUserId(tonumber(data.RecipientId))
                else
                    recipient = Players:FindFirstChild(tostring(data.RecipientId))
                end
                if recipient then
                    GAG2_MailEvent:FireClient(recipient, "GAG2_NewMail", data.MailData)
                end
            end
        end)
    end)

    Players.PlayerAdded:Connect(function(player)
        local ok, inbox = safeDataStoreOp("Get", tostring(player.UserId))
        if ok and inbox then
            local now = os.time()
            local validInbox = {}
            for _, m in ipairs(inbox) do
                if type(m) == "table" and m.Timestamp and (now - m.Timestamp < MAIL_EXPIRY_SECS) then
                    table.insert(validInbox, m)
                end
            end
            GAG2_MailEvent:FireClient(player, "GAG2_Inbox", validInbox)
        end
    end)

    GAG2_MailEvent.OnServerEvent:Connect(function(player, action, ...)
        local args = {...}
        if action == "SendMail" then
            local recipientTarget, mailData = args[1], args[2]
            table.insert(workerQueue, { Sender = player, RecipientId = recipientTarget, MailData = mailData })
            processQueue()
            GAG2_MailResult:FireClient(player, true, "Mail queued successfully")
        end
    end)
end

if RunService:IsServer() then
    pcall(initServerMailSystem)
end

