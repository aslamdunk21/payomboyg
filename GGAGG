                        RawName = rawName,
                        CleanName = cleanName,
                        Price = tonumber(price) or 0,
                        Stock = tonumber(stock) or 1,
                        DisplayText = displayText,
                        Instance = item
                    })
                end
            end
        end

        -- Fallback scan from PlayerGui / Auction UI if ReplicatedStorage stock is dynamic
        if #optionsList == 0 then
            local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            if pGui then
                local auctionGui = pGui:FindFirstChild("AuctionGui") or pGui:FindFirstChild("Auctions") or pGui:FindFirstChild("Auction") or pGui:FindFirstChild("AuctionsUI")
