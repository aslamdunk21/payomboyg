                                end
                            end
                        end
                    end
                end
            end
        end

        -- Preset fallback if server has no active auction at this exact moment
        if #optionsList == 0 then
            local defaultPresets = {
                "ไข่ธรรมดา", "ลมหายใจมังกร", "แพ็คพริกผี", "เห็ดส่องหน", "ดอกพระจันทร์บาน", 
