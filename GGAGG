                    local fmtPrice = Engine:FormatMoney(price)
                    local displayText = string.format("%s [%s] (💰 %s | สต็อก: %s)", cleanName, auctionKey, fmtPrice, tostring(stock))
                    
                    table.insert(optionsList, displayText)
                    table.insert(LiveAuctionItemsCache, {
