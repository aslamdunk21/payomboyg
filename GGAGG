function GAG1Engine:AutoWalkLoop()
    if not Engine.Config.AutoWalk or self.IsSelling then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Humanoid") then return end
    local humanoid = char.Humanoid

    local harvestable = self:GetHarvestablePlants()
    local doRandom = (#harvestable == 0 and Engine.Config.AutoWalkAllowRandom) or (Engine.Config.AutoWalkAllowRandom and math.random(1, 3) == 2)

    if doRandom then
        local pos = self:GetRandomFarmPoint()
        humanoid:MoveTo(pos)
    elseif #harvestable > 0 then
        local targetPlant = harvestable[math.random(1, #harvestable)]
        if targetPlant then
            local pos = targetPlant:GetPivot().Position
            humanoid:MoveTo(pos)
        end
    end
end

