            for _, item in ipairs(itemsFolder:GetChildren()) do
                if item:IsA("ValueBase") or item:IsA("Folder") or item:IsA("Model") then
                    local rawName = item.Name
                    local auctionKey = item:GetAttribute("AuctionKey") or item:GetAttribute("Key") or item:GetAttribute("Id") or item:GetAttribute("ItemKey") or (rawName:find("^auction:") and rawName) or rawName
                    
                    local realName = item:GetAttribute("ItemName") or item:GetAttribute("SeedName") or item:GetAttribute("GearName") or item:GetAttribute("DisplayName") or item:GetAttribute("Item") or rawName
                    if realName:find("^auction:") then
                        realName = item:GetAttribute("Title") or item:GetAttribute("Name") or rawName
                    end

                    local price = item:GetAttribute("Price") or item:GetAttribute("Cost") or item:GetAttribute("Bid") or (item:FindFirstChild("Price") and item.Price.Value) or item.Value or 0
                    local stock = item:GetAttribute("Stock") or (item:FindFirstChild("Stock") and item.Stock.Value) or 1
