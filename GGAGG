function GAG2Engine:GetGardenPlantStats()
    local stats = {
        MyTotalPlants = 0,
        MyTotalFruits = 0,
        CropBreakdown = {},
        ServerRareFruits = { Gold = 0, Rainbow = 0, Pollinated = 0 },
        ServerTotalPlants = 0
    }

    pcall(function()
        local myPlot = self:GetOwnerPlot()
        if myPlot and myPlot:FindFirstChild("Plants") then
            for _, plant in ipairs(myPlot.Plants:GetChildren()) do
                stats.MyTotalPlants = stats.MyTotalPlants + 1
                local cName = plant:GetAttribute("CorePartName") or plant:GetAttribute("SeedName") or plant.Name:gsub("^%d+_", "")
                stats.CropBreakdown[cName] = (stats.CropBreakdown[cName] or 0) + 1

                local fruitsFolder = plant:FindFirstChild("Fruits")
                if fruitsFolder then
                    stats.MyTotalFruits = stats.MyTotalFruits + #fruitsFolder:GetChildren()
                end
            end
        end

        local gardens = workspace:FindFirstChild("Gardens") or workspace:FindFirstChild("Plots")
        if gardens then
            for _, plot in ipairs(gardens:GetChildren()) do
                local plants = plot:FindFirstChild("Plants")
                if plants then
                    for _, plant in ipairs(plants:GetChildren()) do
                        stats.ServerTotalPlants = stats.ServerTotalPlants + 1
                        local fruitsFolder = plant:FindFirstChild("Fruits")
                        if fruitsFolder then
                            for _, fruit in ipairs(fruitsFolder:GetChildren()) do
                                local variant = tostring(fruit:GetAttribute("Variant") or fruit.Name)
                                if variant:find("Gold") then
                                    stats.ServerRareFruits.Gold = stats.ServerRareFruits.Gold + 1
                                elseif variant:find("Rainbow") then
                                    stats.ServerRareFruits.Rainbow = stats.ServerRareFruits.Rainbow + 1
                                elseif variant:find("Pollinated") then
                                    stats.ServerRareFruits.Pollinated = stats.ServerRareFruits.Pollinated + 1
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    return stats
end

