function GAG2Engine:NightStealLoop()
    if not Engine.Config.AutoNightSteal then return end
    pcall(function()
        local night = ReplicatedStorage:FindFirstChild("Night")
        if not night or night.Value ~= true then return end

        local ownerPlot = self:GetOwnerPlot()
        if not ownerPlot then return end
        local dropoff = ownerPlot:FindFirstChild("PlotSizeReference")
        if not dropoff then return end

        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hrp = char.HumanoidRootPart

        local bestPlant, bestValue = self:GetBestPlantToSteal()
        if not bestPlant then return end

        local ownerId = tonumber(bestPlant:GetAttribute("UserId"))
        local plantId = bestPlant:GetAttribute("PlantId")
        local fruitId = bestPlant:GetAttribute("FruitId") or ""
        if not ownerId or not plantId then return end

        local basePart = bestPlant:FindFirstChildWhichIsA("BasePart")
        if not basePart then return end

        local oldCF = dropoff.CFrame
        local targetCF = basePart.CFrame + Vector3.new(0, 3, 0)

        smoothTeleport(hrp, oldCF, targetCF, 33.8)
        task.wait(1)

        local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
        if sharedModules then
            local networkingMod = sharedModules:FindFirstChild("Networking")
            if networkingMod then
                local Networking = safeRequire(networkingMod)
                if Networking and Networking.Steal then
                    if Networking.Steal.BeginSteal then Networking.Steal.BeginSteal:Fire(ownerId, plantId, fruitId) end
                    if Networking.Steal.CompleteSteal then Networking.Steal.CompleteSteal:Fire() end
                end
            end
        end

        task.wait(1)
        smoothTeleport(hrp, targetCF, oldCF, 33.8)

        Engine:Notify({ Title = "ขโมยผักสำเร็จ! 🌙", Content = string.format("ขโมยผักสำเร็จ (มูลค่า: %.1f)", bestValue) })
    end)
end

