                    stats.ReadyToHarvest = stats.ReadyToHarvest + 1
                end

                local variant = plant:GetAttribute("Variant") or plant:GetAttribute("Mutation") or plant.Name
                if variant:find("Gold") then
                    stats.GoldFruits = stats.GoldFruits + 1
                elseif variant:find("Rainbow") then
                    stats.RainbowFruits = stats.RainbowFruits + 1
                end

                local weight = plant:GetAttribute("Weight") or 1.0
                local seedName = plant:GetAttribute("SeedName") or plant.Name
                local fruitCalc = self:GetFruitCalc()
                local val = 0
                if fruitCalc then
                    pcall(function()
                        val = fruitCalc(seedName, weight, variant, LocalPlayer, 0)
                    end)
                end
                stats.TotalValue = stats.TotalValue + (tonumber(val) or 0)
            end
        end

        stats.FormattedValue = self:FormatMoney(stats.TotalValue)
    end)

    return stats
end

function GAG2Engine:InitAutoFarmLoops()
