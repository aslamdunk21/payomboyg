function GAG2Engine:GetOwnerPlot()
    local gardens = workspace:FindFirstChild("Gardens")
    if not gardens then return nil end
    local myName = string.lower(LocalPlayer.Name)
    local myDisplayName = string.lower(LocalPlayer.DisplayName)
    local myId = tostring(LocalPlayer.UserId)
    for _, plot in ipairs(gardens:GetChildren()) do
        local owner = plot:GetAttribute("Owner")
        local ownerId = plot:GetAttribute("OwnerUserId")
        if owner then
            local lowerOwner = string.lower(tostring(owner))
            if lowerOwner == myName or lowerOwner == myDisplayName or string.find(lowerOwner, myName, 1, true) then
                return plot
            end
        end
        if ownerId and tostring(ownerId) == myId then
            return plot
        end
    end
    return nil
end

function GAG2Engine:AutoHarvestLoop()
    if not Engine.Config.AutoHarvest then return end
    pcall(function()
        local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
        if not sharedModules then return end
        local networkingMod = sharedModules:FindFirstChild("Networking")
        if not networkingMod then return end
        local Networking = require(networkingMod)

        local collectEvent = Networking and Networking.Garden and Networking.Garden.CollectFruit
        if not collectEvent then return end

        local farm = self:GetOwnerPlot()
        local plants = farm and farm:FindFirstChild("Plants")
        if plants then
            for _, plant in ipairs(plants:GetChildren()) do
                if not Engine.Config.AutoHarvest then break end
                local seedName = plant:GetAttribute("CorePartName") or plant:GetAttribute("SeedName") or plant:GetAttribute("Fruit")
                if seedName then
                    local plantId = plant:GetAttribute("PlantId") or plant.Name:match("^%d+_(.+)$")
                    if plantId then
                        pcall(function() collectEvent:Fire(plantId, "") end)
                    end
                    local fruitsFolder = plant:FindFirstChild("Fruits")
                    if fruitsFolder then
                        for _, fruit in ipairs(fruitsFolder:GetChildren()) do
                            local fruitId = fruit:GetAttribute("FruitId") or fruit.Name:match("^%d+_%d+_(.+)$") or ""
                            if plantId then
                                pcall(function() collectEvent:Fire(plantId, fruitId) end)
                            end
                        end
                    end
                end
            end
        end
    end)
end

