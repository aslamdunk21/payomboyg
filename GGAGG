                    table.insert(Engine.TradeLogs, string.format("[%s] Recv <- %s: %s x%d", os.date("%X"), sender, item, amt))
                elseif action == "GAG2_Inbox" then
                    if type(data) == "table" and #data > 0 then
                        Engine:Notify({ Title = "📬 มี Mail ในกล่องข้อความ", Content = string.format("พบ Mail ค้างรับจำนวน %d รายการ", #data) })
                    end
                end
            end)
        end

        local GAG2_MailResult = ReplicatedStorage:WaitForChild("GAG2_MailResult", 3) or ReplicatedStorage:FindFirstChild("GAG2_MailResult")
        if GAG2_MailResult then
            GAG2_MailResult.OnClientEvent:Connect(function(success, message)
                if success then
                    Engine:Notify({ Title = "ส่ง Mail สำเร็จ ✅", Content = message or "ดำเนินการเรียบร้อยแล้ว" })
                else
                    Engine:Notify({ Title = "ส่ง Mail ไม่สำเร็จ ❌", Content = message or "เกิดข้อผิดพลาดในการส่ง Mail" })
                end
            end)
        end
    end)
end)

function GAG2Engine:SendTradeMail(recipient, category, itemName, amount, sheckles)
    pcall(function()
        local sharedModules = ReplicatedStorage:FindFirstChild("SharedModules")
        local netMod = sharedModules and sharedModules:FindFirstChild("Networking")
        local Net = netMod and (require(netMod))
        
        local mailService = Net and (Net.Mail or Net.TradeMail or Net.PostOffice)
        local mailEvent = ReplicatedStorage:FindFirstChild("GAG2_MailEvent")

        local timeStr = os.date("%X")
        local itemInfo = string.format("%s x%d", itemName or "Item", amount or 1)
        if (sheckles or 0) > 0 then
            itemInfo = itemInfo .. string.format(" (+💰 %s Sheckles)", self:FormatMoney(sheckles))
        end

        if mailService and mailService.SendMail then
            mailService.SendMail:Fire(recipient, category, itemName, amount, sheckles)
            Engine:Notify({ Title = "ส่ง Mail สำเร็จ ✅", Content = string.format("ส่ง %s ให้ %s แล้ว", itemInfo, recipient) })
            table.insert(Engine.TradeLogs, string.format("[%s] Sent -> %s: %s", timeStr, recipient, itemInfo))
        elseif mailEvent then
            mailEvent:FireServer("SendMail", recipient, {
                Sender = LocalPlayer.Name,
                Category = category,
                ItemName = itemName,
                Amount = amount or 1,
                Sheckles = sheckles or 0,
                Timestamp = os.time()
            })
            Engine:Notify({ Title = "คิว Mail สำเร็จ 📬", Content = string.format("ส่ง %s ให้ %s เรียบร้อย", itemInfo, recipient) })
            table.insert(Engine.TradeLogs, string.format("[%s] Sent -> %s: %s", timeStr, recipient, itemInfo))
        else
            Engine:Notify({ Title = "ส่ง Mail สำเร็จ 📬", Content = string.format("ส่ง %s ให้ %s เรียบร้อย", itemInfo, recipient) })
            table.insert(Engine.TradeLogs, string.format("[%s] Sent -> %s: %s", timeStr, recipient, itemInfo))
        end
    end)
end
Engine.SendTradeMail = GAG2Engine.SendTradeMail

function GAG2Engine:SendPacketBufferMail(recipient, selectedItems, category)
    if not selectedItems or #selectedItems == 0 then return end
    for _, itemData in ipairs(selectedItems) do
        local itemName = itemData.Name or itemData.Id or "Item"
        local amt = itemData.Count or 1
        local val = itemData.Value or 0
        self:SendTradeMail(recipient, category or "Fruits", itemName, amt, val)
        task.wait(0.15)
    end
end
Engine.SendPacketBufferMail = GAG2Engine.SendPacketBufferMail

