                Engine:Notify({
                    Title = "⚡ กิจกรรมสภาพอากาศใหม่!",
                    Content = "เกิดสภาพอากาศ: " .. tostring(eventName) .. " (ระยะเวลา " .. tostring(duration) .. " วิ)"
                })
            end)
        end
    end)
end

