    local hum   = State.TargetHumanoid
    local root  = State.TargetRoot
    return model and model.Parent and hum and hum.Parent and hum.Health > 0 and root and root.Parent
end

local function refreshTarget()
    if not Config.AutoFarm or State.StageBusy then
        State.TargetModel = nil; State.TargetRoot = nil; State.TargetHumanoid = nil; State.RoomClearTimer = 0
        return
    end
    local model, root, hum = findNearestTarget()
