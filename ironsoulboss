-- 4. TARGET SCANNER & SCORING ENGINE (100% ต้นฉบับ.txt + Boss Priority)
-- ════════════════════════════════════════════════════
local enemyCandidates = {}

local function looksLikeEnemyModel(model)
    if not model or not model:IsA("Model") or model == State.Character or Players:GetPlayerFromCharacter(model) ~= nil then
        return false
    end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if not root or not root:IsA("BasePart") then return false end
    return true
end

local function rebuildEnemyCandidates()
    table.clear(enemyCandidates)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if looksLikeEnemyModel(obj) then table.insert(enemyCandidates, obj) end
    end
end

connect(workspace.DescendantAdded, function(obj)
    if looksLikeEnemyModel(obj) and not table.find(enemyCandidates, obj) then table.insert(enemyCandidates, obj) end
end)

connect(workspace.DescendantRemoving, function(obj)
    local idx = table.find(enemyCandidates, obj)
    if idx then table.remove(enemyCandidates, idx) end
end)

rebuildEnemyCandidates()

local function getAliveTargetParts(model)
    if not model or model == State.Character then return nil, nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil, nil end
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if not root or not root:IsA("BasePart") then return nil, nil end
    return hum, root
end

local function considerTarget(model, origin, bestDistanceSquared)
    local hum, root = getAliveTargetParts(model)
    if not hum or not root then return nil, bestDistanceSquared end
    local offset = origin - root.Position
    local distSq = offset:Dot(offset)
    if distSq < bestDistanceSquared then
        return root, distSq, hum, model
    end
    return nil, bestDistanceSquared
end

local function scoreTarget(model, humanoid, root, distanceSquared)
    local score = 0
    local name = string.lower(model.Name)

    if distanceSquared < 15 * 15 then score += 8 elseif distanceSquared < 35 * 35 then score += 5 else score += 2 end
    if name:find("boss", 1, true) or model:GetAttribute("LevelType") == "Boss" then score += 500 elseif name:find("elite", 1, true) then score += 15 end
    if humanoid.MaxHealth > 0 and (humanoid.Health / humanoid.MaxHealth) < 0.25 then score += 4 end
    if root.Position.Y < -500 then score -= 2 end
    return score
end

local function findNearestTarget()
    State.Stats.TargetScans += 1
    if not State.Root then return nil, nil, nil end

    local origin = State.Root.Position
    local maxDistSq = Config.TargetSearchRadius * Config.TargetSearchRadius
    local bestModel, bestRoot, bestHum = nil, nil, nil
    local bestScore = -math.huge

    for idx = #enemyCandidates, 1, -1 do
        local model = enemyCandidates[idx]
        local hum, root = getAliveTargetParts(model)
        if not hum or not root then
            table.remove(enemyCandidates, idx)
        else
            local offset = origin - root.Position
            local distSq = offset:Dot(offset)
            if distSq <= maxDistSq then
                local score = scoreTarget(model, hum, root, distSq)
                if score > bestScore then
                    bestScore = score; bestModel = model; bestRoot = root; bestHum = hum
                end
            end
        end
    end

    return bestModel, bestRoot, bestHum
end

local function targetIsValid()
    if not State.TargetModel or not State.TargetRoot or not State.TargetHumanoid then return false end
    if not State.TargetModel.Parent or State.TargetHumanoid.Health <= 0 then return false end
    return true
end

local function refreshTarget()
    if not Config.AutoFarm or State.StageBusy then return end
    local model, root, hum = findNearestTarget()
    State.TargetModel = model
    State.TargetRoot = root
    State.TargetHumanoid = hum
    State.LastTargetName = model and model.Name or "No target"
    State.LastTargetDistance = root and State.Root and (State.Root.Position - root.Position).Magnitude or math.huge
    State.TargetHealthPercent = hum and hum.MaxHealth > 0 and math.clamp(hum.Health / hum.MaxHealth, 0, 1) * 100 or 0
    if model and hum and hum.Health > 0 then State.RoomClearTimer = 0 end
end

