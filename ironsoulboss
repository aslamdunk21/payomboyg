-- ── TARGET SCANNER (ต้นฉบับ.txt + Boss Priority + Boss Portal Jitter Fix) ──
local enemyCandidates = {}

local function looksLikeEnemyModel(model)
    if not model or not model:IsA("Model") or model == State.Character or Players:GetPlayerFromCharacter(model) ~= nil then
        return false
    end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if not root or not root:IsA("BasePart") then return false end

    local enemyNpc = workspace:FindFirstChild("EnemyNpc")
    if enemyNpc then
        if model:IsDescendantOf(enemyNpc) then return true end
        if model.Parent == workspace or model.Parent == workspace:FindFirstChild("BossNpc") or model.Name:lower():find("boss") or model:GetAttribute("LevelType") == "Boss" then
            return true
        end
        return false
    end
    return true
end

local function addEnemyCandidate(obj)
    local m = obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model")
    if m and m ~= State.Character and looksLikeEnemyModel(m) then enemyCandidates[m] = true end
end

local function removeEnemyCandidate(obj)
    if obj:IsA("Model") then enemyCandidates[obj] = nil else
        local m = obj:FindFirstAncestorOfClass("Model")
        if m then enemyCandidates[m] = nil end
    end
end

for _, obj in ipairs(workspace:GetDescendants()) do addEnemyCandidate(obj) end
connect(workspace.DescendantAdded, addEnemyCandidate)
connect(workspace.DescendantRemoving, removeEnemyCandidate)

local function getAliveTargetParts(model)
    if not model or model == State.Character then return nil, nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil, nil end
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    if not root or not root:IsA("BasePart") then return nil, nil end
    return hum, root
end

local function scoreTarget(model, humanoid, root, distanceSquared)
    local score = 0
    local name = string.lower(model.Name)
    if distanceSquared < 15 * 15 then score += 8 elseif distanceSquared < 35 * 35 then score += 5 else score += 2 end
    if name:find("boss", 1, true) or model:GetAttribute("LevelType") == "Boss" then score += 500 elseif name:find("elite", 1, true) then score += 15 end
    if humanoid.MaxHealth > 0 and (humanoid.Health / humanoid.MaxHealth) < 0.25 then score += 4 end
    if root.Position.Y < -500 then score -= 2 end
    return score
end

local fallbackOverlapParams = OverlapParams.new()
fallbackOverlapParams.FilterType = Enum.RaycastFilterType.Exclude

local function findNearestTargetFallback()
    if not State.Root or not State.Root.Parent then return nil, nil, nil end
    fallbackOverlapParams.FilterDescendantsInstances = { State.Character }
    local origin = State.Root.Position
    local radius = Config.TargetSearchRadius
    local radiusSquared = radius * radius
    local seen, bestModel, bestRoot, bestHumanoid, bestScore = {}, nil, nil, nil, -math.huge

    local ok, parts = pcall(function() return workspace:GetPartBoundsInRadius(origin, radius, fallbackOverlapParams) end)
    if ok and parts then
        for _, part in ipairs(parts) do
            local model = part:FindFirstAncestorOfClass("Model")
            if model and model ~= State.Character and not seen[model] then
                seen[model] = true
                local hum, root = getAliveTargetParts(model)
                if hum and root then
                    local offset = origin - root.Position
                    local distSq = offset:Dot(offset)
                    if distSq <= radiusSquared then
                        local score = scoreTarget(model, hum, root, distSq)
                        if score > bestScore then
                            bestModel, bestRoot, bestHumanoid, bestScore = model, root, hum, score
                        end
                    end
                end
            end
        end
    end
    return bestModel, bestRoot, bestHumanoid
end

local findBestExit

local function findNearestTarget()
    State.Stats.TargetScans += 1
    if not State.Root or not State.Root.Parent then return nil, nil, nil end

    local exitObj, exitScore, exitType = nil, 0, nil
    if typeof(findBestExit) == "function" then pcall(function() exitObj, exitScore, exitType = findBestExit() end) end
    local exitDist = (exitObj and exitObj:IsA("BasePart")) and (State.Root.Position - exitObj.Position).Magnitude or math.huge

    local origin = State.Root.Position
    local radius = Config.TargetSearchRadius
    local radiusSq = radius * radius
    local bestModel, bestRoot, bestHumanoid, bestScore = nil, nil, nil, -math.huge

    for model in pairs(enemyCandidates) do
        if not model or not model.Parent then
            enemyCandidates[model] = nil
        else
            local hum, root = getAliveTargetParts(model)
            if hum and root then
                local distSq = (origin - root.Position):Dot(origin - root.Position)
                if distSq <= radiusSq then
                    local targetDist = math.sqrt(distSq)
                    local name = string.lower(model.Name)
                    local isBoss = name:find("boss", 1, true) or model:GetAttribute("LevelType") == "Boss"

                    if not isBoss and exitObj and exitDist < 120 and exitDist < (targetDist - 20) then
                        -- Ignore next-room regular mobs
                    else
                        local score = scoreTarget(model, hum, root, distSq)
                        if score > bestScore then
                            bestScore = score; bestModel = model; bestRoot = root; bestHumanoid = hum
                        end
                    end
                end
            end
        end
    end

    if bestModel then return bestModel, bestRoot, bestHumanoid end
    if State.FallbackTargetTimer > 0 then return nil, nil, nil end
    State.FallbackTargetTimer = 1.0
    return findNearestTargetFallback()
end

local function targetIsValid()
