local function travelToPosition(position, lookAt)
    if not State.Character or not State.Root then return false end
    beginTravel()
    local cf = lookAt and CFrame.new(position, lookAt) or CFrame.new(position)
    local ok = pcall(function()
        State.Character:PivotTo(cf)
        State.Root.CFrame = cf
        State.Root.AssemblyLinearVelocity = Vector3.zero
        State.Root.AssemblyAngularVelocity = Vector3.zero
    end)
    return ok
end

