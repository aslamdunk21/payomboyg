local controller = nil
local function getController()
    if controller and typeof(controller) == "table" and type(controller.PerformAction) == "function" then
        return controller
    end
    pcall(function()
        local char = player.Character or character
        if not char then return end
        local mgr = char:FindFirstChild("LocalControlMgr") or char:WaitForChild("LocalControlMgr", 3)
        if not mgr then return end
        local actFolder = mgr:FindFirstChild("Action")
        local actMods = {}
        if actFolder then
            for _, m in ipairs(actFolder:GetChildren()) do
                if m:IsA("ModuleScript") then pcall(function() actMods[m.Name] = require(m) end) end
            end
        end
        if mgr:FindFirstChild("Controller") then
            local CtrlClass = require(mgr.Controller)
            controller = CtrlClass.new(char, actMods)
        end
    end)
    return controller
end

local function activateTool()
    if not State.Character then return nil end
    local tool = State.Character:FindFirstChildOfClass("Tool")
    if not tool then
        local bp = player:FindFirstChild("Backpack")
        if bp then
            tool = bp:FindFirstChildOfClass("Tool")
            if tool and State.Humanoid then pcall(function() State.Humanoid:EquipTool(tool) end) end
        end
    end
    if tool then pcall(function() tool:Activate() end) end
    return tool
end

local function Attack(bool)
    if not Config.AutoFarm then return end
    bool = bool or Config.AutoSkill or false
    local ctrl = getController() or controller
    if ctrl then
        pcall(function()
            ctrl:PerformAction("BaseAttack")
            task.wait()
            ctrl:StopAction("BaseAttack")
        end)
    end

    if bool then
        task.spawn(function()
            pcall(function()
                local pgui = player:FindFirstChild("PlayerGui")
                local skillsFolder = pgui and pgui:FindFirstChild("ScreenInput")
                    and pgui.ScreenInput:FindFirstChild("PCInput")
                    and pgui.ScreenInput.PCInput:FindFirstChild("Skills")

                if skillsFolder then
                    for _, v in pairs(skillsFolder:GetChildren()) do
                        if v:IsA("ImageButton") and v:GetAttribute("OnCD") == false then
                            if v:GetAttribute("FullCharge") == true then
                                if ctrl then ctrl:PerformAction("SkillU") end
                                task.wait(0.1)
                                return
                            end
                            if ctrl then
                                ctrl:PerformAction("Skill1")
                                task.wait(0.1)
                                ctrl:PerformAction("Skill2")
                                task.wait(0.1)
                                ctrl:PerformAction("SkillAW")
                            end
                        end
                    end
                end
            end)
        end)
    end
end

local SkillCooldownConfig = { Q = 0.70, E = 0.70, R = 1.50 }
local function useSkills()
    if not Config.AutoFarm or not Config.AutoSkill or not targetIsValid() or State.StageBusy then return end
    local now = os.clock()
    for _, key in ipairs({ "E", "Q", "R" }) do
        if now >= (State.SkillCooldowns[key] or 0) then
            pressKey(key)
            State.SkillCooldowns[key] = now + (SkillCooldownConfig[key] or 1.0)
            task.wait(0.15)
        end
    end
    Attack(true)
end

local function updateKillAura()
    if not Config.AutoFarm or State.StageBusy then return end
    Attack(Config.AutoSkill)
end

local function setUndergroundPhysics(enabled)
    if not State.Humanoid or not State.Humanoid.Parent then return end
    if State.UndergroundPhysics == enabled then return end
    pcall(function()
        if enabled then
            State.Humanoid.AutoRotate = false
            State.Humanoid.PlatformStand = true
            State.Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        else
            State.Humanoid.PlatformStand = false
            State.Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            State.Humanoid.AutoRotate = true
        end
    end)
    State.UndergroundPhysics = enabled
end

local function getDesiredCombatCFrame()
    if not Config.AutoFarm or State.StageBusy or not State.Root or not State.TargetRoot or not State.Humanoid or not targetIsValid() then
        return nil
    end

    local targetPosition = State.TargetRoot.Position
    local radius = Config.OrbitRadius
    local verticalOffset = Config.UndergroundMode and math.max(0, tonumber(Config.UndergroundHeight) or 0) or math.max(0, tonumber(Config.AboveHeight) or 0)

    State.OrbitAngle += (1 / 60) * Config.OrbitSpeed
    local x = math.sin(State.OrbitAngle) * radius
    local z = math.cos(State.OrbitAngle) * radius

    local y, tilt
    if Config.UndergroundMode then
        setUndergroundPhysics(true)
        y = targetPosition.Y - verticalOffset
        tilt = 90
    else
        setUndergroundPhysics(false)
        y = targetPosition.Y + verticalOffset
        tilt = -90
    end

    return CFrame.new(targetPosition.X + x, y, targetPosition.Z + z) * CFrame.Angles(math.rad(tilt), 0, 0)
end

local function lockCombatPosition()
    local desiredCFrame = getDesiredCombatCFrame()
    if not desiredCFrame or not State.Character or not State.Root then return end
    pcall(function() State.Character:PivotTo(desiredCFrame) end)
    pcall(function()
        State.Root.CFrame = desiredCFrame
        State.Root.AssemblyLinearVelocity = Vector3.zero
        State.Root.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- ── AUTO AVOID & EMERGENCY ESCAPE ──
local function isRedAttackObject(object)
    if not object:IsA("BasePart") then return false end
    local color = object.Color
    local hue, saturation, value = Color3.toHSV(color)
    local redHue = hue < 0.055 or hue > 0.945
    return redHue and saturation > 0.55 and value > 0.35 and color.R > color.G * 1.35 and color.R > color.B * 1.35
end

local dangerOverlapParams = OverlapParams.new()
dangerOverlapParams.FilterType = Enum.RaycastFilterType.Exclude

local function findNearbyRedAttack()
    State.Stats.DangerScans += 1
    if not Config.AutoAvoid or not State.Root then return nil end
    dangerOverlapParams.FilterDescendantsInstances = { State.Character }
    local origin = State.Root.Position
    local dangerRadius = 35
    local nearest, nearestDistSq = nil, dangerRadius * dangerRadius
    local ok, parts = pcall(function() return workspace:GetPartBoundsInRadius(origin, dangerRadius, dangerOverlapParams) end)
    if ok and parts then
        for _, object in ipairs(parts) do
            if isRedAttackObject(object) then
                local distSq = (origin - object.Position):Dot(origin - object.Position)
                if distSq < nearestDistSq then nearestDistSq = distSq; nearest = object end
            end
        end
    end
    return nearest
end

local function emergencyEscape(reason)
    if not Config.EmergencyEscape or State.EmergencyBusy or not State.Root or not State.Humanoid then return end
    State.EmergencyBusy = true
    State.CurrentAction = reason or "Emergency Escape"
    local root, humanoid = State.Root, State.Humanoid
    local danger = State.DangerPart
    local direction
    if danger and danger.Parent then
        direction = Vector3.new((root.Position - danger.Position).X, 0, (root.Position - danger.Position).Z)
    end
    if not direction or direction.Magnitude < 0.05 then
        direction = Vector3.new(math.cos(State.OrbitAngle), 0, math.sin(State.OrbitAngle))
    else
        direction = direction.Unit
    end
    humanoid:MoveTo(root.Position + direction * 18)
    task.delay(0.45, function()
        if not State.Unloaded then
            State.EmergencyBusy = false
            State.CurrentAction = Config.AutoFarm and "Farming" or "Idle"
        end
    end)
end

local function updateAutoAvoid(dt)
    if not Config.AutoAvoid or State.StageBusy or State.EmergencyBusy or not State.Root or not State.Humanoid then
        State.DangerPart = nil; State.DangerDistance = math.huge; return
    end
    State.DangerTimer += dt
    local scanInterval = Config.PerformanceMode and 0.30 or 0.12
    if State.DangerTimer >= scanInterval then
        State.DangerTimer = 0; State.DangerPart = findNearbyRedAttack()
    end
    local danger = State.DangerPart
    if not danger or not danger.Parent then
        State.DangerPart = nil; State.DangerDistance = math.huge
        if Config.AutoFarm then State.CurrentAction = "Farming" end
        return
    end
    local toDanger = danger.Position - State.Root.Position
    State.DangerDistance = Vector3.new(toDanger.X, 0, toDanger.Z).Magnitude
    local predicted = danger.Position + danger.AssemblyLinearVelocity * 0.20
    local away = Vector3.new((State.Root.Position - predicted).X, 0, (State.Root.Position - predicted).Z)
    away = away.Magnitude < 0.05 and Vector3.new(1, 0, 0) or away.Unit
    local safeDistance = Config.SafeMode and 16 or 12
    State.CurrentAction = "Avoiding Attack"
    State.Humanoid:MoveTo(State.Root.Position + away * safeDistance)
    if Config.EmergencyEscape and State.DangerDistance < 6 then emergencyEscape("Emergency Escape") end
end

