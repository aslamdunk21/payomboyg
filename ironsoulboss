    if model and hum and hum.Health > 0 then State.RoomClearTimer = 0 end
end

-- ── PORTAL & DOOR ENGINE (ต้นฉบับ.txt) ──
local portalCandidates = {}

local function getExitType(part)
    if not part or not part:IsA("BasePart") then return nil end
    local names = { string.lower(part.Name) }
    local ancestor = part.Parent
    local depth = 0
    while ancestor and depth < 4 do
        if ancestor:IsA("Model") or ancestor:IsA("Folder") then table.insert(names, string.lower(ancestor.Name)) end
        ancestor = ancestor.Parent; depth += 1
    end
    local hasPortalName, hasDoorName = false, false
    for _, name in ipairs(names) do
        if name:find("portal", 1, true) or name:find("teleport", 1, true) or name:find("portalexit", 1, true) or name:find("warp", 1, true) or name:find("next", 1, true) or name:find("finish", 1, true) then
            hasPortalName = true
        end
        if name:find("door", 1, true) or name:find("gate", 1, true) or name:find("exit", 1, true) or name:find("entrance", 1, true) or name:find("rounddoor", 1, true) then
            hasDoorName = true
        end
    end
    if hasPortalName then return "portal" end
    if hasDoorName then return "door" end
    return nil
end

local function isPortalCandidate(part) return getExitType(part) ~= nil end

local function rebuildPortalCandidates()
    State.Stats.PortalScans += 1
    table.clear(portalCandidates)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isPortalCandidate(obj) then table.insert(portalCandidates, obj) end
    end
end

local function scorePortal(part, origin)
    if not part or not part.Parent then return -math.huge, nil end
    local exitType = getExitType(part)
    if not exitType then return -math.huge, nil end

    local name = string.lower(part.Name)
    local parentName = part.Parent and string.lower(part.Parent.Name) or ""
    local score = 0

    if exitType == "portal" then
        score += 8
        if name:find("portal", 1, true) or parentName:find("portal", 1, true) then score += 5 end
        if name:find("teleport", 1, true) or parentName:find("teleport", 1, true) then score += 3 end
    else
        score += 2
        if name:find("door", 1, true) then score += 2 end
        if name:find("gate", 1, true) then score += 2 end
    end

    if name:find("next", 1, true) or name:find("finish", 1, true) or name:find("exit", 1, true) then score += 2 end
    if part:FindFirstChildOfClass("TouchTransmitter") then score += 3 end
    if part:FindFirstChildOfClass("ProximityPrompt") then score += 4 end
    if part.Material == Enum.Material.Neon then score += 3 end
    if part.Size.Y > 5 and part.Size.X > 5 then score += 2 end

    local distSq = (origin - part.Position):Dot(origin - part.Position)
    score += math.max(0, 1 - distSq / (50 * 50))
    return score, exitType
end

connect(workspace.DescendantAdded, function(obj)
    if isPortalCandidate(obj) and not table.find(portalCandidates, obj) then table.insert(portalCandidates, obj) end
end)

connect(workspace.DescendantRemoving, function(obj)
    local idx = table.find(portalCandidates, obj)
    if idx then table.remove(portalCandidates, idx) end
end)

findBestExit = function()
    if not State.Root then return nil, 0, nil end
    local origin = State.Root.Position
    local maxDistSq = Config.ExitSearchRadius * Config.ExitSearchRadius
    local bestPortal, bestPortalScore = nil, -math.huge
    local bestDoor, bestDoorScore     = nil, -math.huge

    for idx = #portalCandidates, 1, -1 do
        local part = portalCandidates[idx]
        if not part or not part.Parent then
            table.remove(portalCandidates, idx)
        else
            local distSq = (origin - part.Position):Dot(origin - part.Position)
            if distSq <= maxDistSq then
                local score, exitType = scorePortal(part, origin)
                if exitType == "portal" and score > bestPortalScore then
                    bestPortal = part; bestPortalScore = score
                elseif exitType == "door" and score > bestDoorScore then
                    bestDoor = part; bestDoorScore = score
                end
            end
        end
    end

    if bestPortal then return bestPortal, bestPortalScore, "portal" end
    if bestDoor then return bestDoor, bestDoorScore, "door" end
    return nil, 0, nil
end

local function findProximityPrompt(rootObj)
    if not rootObj then return nil end
    if rootObj:IsA("ProximityPrompt") then return rootObj end
    return rootObj:FindFirstChildOfClass("ProximityPrompt") or rootObj:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function TriggerDoorAndPortalRemotes()
    pcall(function()
        if ReplicatedStorage:FindFirstChild("Remotes") then
            local gRound = ReplicatedStorage.Remotes:FindFirstChild("GameRoundRE")
            if gRound then
                gRound:FireServer("StartGame")
                gRound:FireServer("RequestNextStage")
            end
        end
    end)
end

local function moveToNextStage()
    if not Config.AutoProgressStage or State.StageBusy or State.StageCooldown or State.DoorBusy or not State.Root or not State.Humanoid or not Config.AutoFarm then
        return
    end

    local model, root, hum = findNearestTarget()
    if model and root and hum and hum.Health > 0 then
        State.TargetModel = model; State.TargetRoot = root; State.TargetHumanoid = hum; State.RoomClearTimer = 0
        State.CurrentAction = "Farming"
        return
    end

    State.TargetModel = nil; State.TargetRoot = nil; State.TargetHumanoid = nil
    if State.RoomClearTimer < Config.RoomClearDelay then
        State.CurrentAction = "Clearing"
        return
    end

    State.StageBusy = true
    State.StageBusyTimer = 0

    -- Priority 1: Trigger Wave / Boss Spawners (PlayerRespawn)
    local playerRespawnFolder = workspace:FindFirstChild("PlayerRespawn")
    if playerRespawnFolder then
        local triggerPart = playerRespawnFolder:FindFirstChildWhichIsA("BasePart", true)
        if triggerPart and State.Root then
            State.CurrentAction = "Triggering Wave/Boss Spawn"
            pcall(function()
                State.Root.CFrame = triggerPart.CFrame + Vector3.new(0, 3, 0)
                TriggerDoorAndPortalRemotes()
            end)
            task.wait(0.8)
            local checkModel, checkRoot, checkHum = findNearestTarget()
            if checkModel and checkRoot and checkHum then
                State.TargetModel = checkModel; State.TargetRoot = checkRoot; State.TargetHumanoid = checkHum
                State.StageBusy = false; State.StageBusyTimer = 0
                return
            end
        end
    end

    -- Priority 2: Stage Doors / Prompts
    local roundDoor = workspace:FindFirstChild("RoundDoor")
    if roundDoor then
        local door = roundDoor:FindFirstChild("Door")
        local prompt = findProximityPrompt(door or roundDoor)
        if prompt then
            State.CurrentAction = "Opening Stage Door"
            pcall(function()
                State.Root.CFrame = (door and door:GetPivot() or roundDoor:GetPivot()) + Vector3.new(0, 2, 0)
                if type(fireproximityprompt) == "function" then fireproximityprompt(prompt) else pressKey("F") end
                TriggerDoorAndPortalRemotes()
            end)
            task.wait(0.6)
            State.StageBusy = false; State.StageBusyTimer = 0
            return
        end
    end

    -- Priority 3: Exit Portals
    rebuildPortalCandidates()
    local exitObject, score, exitType = findBestExit()
    if roundDoor or exitObject then
        State.CurrentAction = "Entering RoundDoor/Portal"
        local portalPart = (roundDoor and (roundDoor:FindFirstChild("Portal") or roundDoor:FindFirstChild("Door"))) or exitObject
        local rootPart = portalPart and (portalPart:FindFirstChild("Root") or portalPart)
        if rootPart and State.Root then
            pcall(function()
                State.Root.CFrame = rootPart.CFrame + Vector3.new(0, 3, 0)
                TriggerDoorAndPortalRemotes()
                if type(firetouchinterest) == "function" and portalPart:IsA("BasePart") then
                    firetouchinterest(State.Root, portalPart, 0)
                    task.wait(0.05)
                    firetouchinterest(State.Root, portalPart, 1)
                end
            end)
        end
    end

    State.StageBusy = false
    State.StageBusyTimer = 0
end

