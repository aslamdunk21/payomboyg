                    State.Stats.DangerScans
                )
            else
                debugText = "Debug is disabled."
            end
            local dLabel = DebugPanelCard:FindFirstChild("TextLabel", true)
            if dLabel then dLabel.Text = debugText end
        end)
    end
end)

local function unload()
    if State.Unloaded then return end
    State.Unloaded = true
    Config.AutoFarm = false
    _G.AutoFarm = false
    disconnectList(CharacterConnections)
    disconnectList(Connections)
    local parentGui = (typeof(gethui) == "function") and gethui() or playerGui
    local ui = parentGui:FindFirstChild("PayomboyZ_Dungeon_UI")
    if ui then ui:Destroy() end
    State.Character = nil; State.Humanoid = nil; State.Root = nil
    State.TargetModel = nil; State.TargetRoot = nil; State.TargetHumanoid = nil
    State.Portal = nil
    print("✅ [PayomboyZ HUB] Dungeon Engine Unloaded.")
end

_G.IronSoulDungeonUnload = unload

