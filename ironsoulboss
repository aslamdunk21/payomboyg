local function findNearestTarget()
    State.Stats.TargetScans += 1

    if not State.Root then
        return nil, nil, nil
    end

    local origin = State.Root.Position
    local maxDistanceSquared =
        Config.TargetSearchRadius * Config.TargetSearchRadius

    local bestModel = nil
    local bestRoot = nil
    local bestHumanoid = nil
    local bestScore = -math.huge

    for index = #enemyCandidates, 1, -1 do
        local model = enemyCandidates[index]
        local humanoid, root = getAliveTargetParts(model)

        if not humanoid or not root then
            table.remove(enemyCandidates, index)
        else
            local delta = origin - root.Position
            local distanceSquared = delta:Dot(delta)

            if distanceSquared <= maxDistanceSquared then
                local score = scoreTarget(model, humanoid, root, distanceSquared)

                if score > bestScore then
                    bestScore = score
                    bestModel = model
                    bestRoot = root
                    bestHumanoid = humanoid
                end
            end
        end
    end

    return bestModel, bestRoot, bestHumanoid
end

