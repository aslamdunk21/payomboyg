function CheckQuest()
    local Level = (LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level")) and LocalPlayer.Data.Level.Value or 1
    local curSea = World1 and 1 or (World2 and 2 or 3)
    local questList = (curSea == 1 and getgenv().Sea1_Quests) or (curSea == 2 and getgenv().Sea2_Quests) or getgenv().Sea3_Quests
    if not questList then return end
    for _, item in ipairs(questList) do
        if Level <= item[1] then
            Monster = item[2]
            NameQuest = item[3]
            LevelQuest = item[4]
            NameCheckQuest = item[5]
            CFrameQ = CFrame.new(item[6], item[7], item[8])
            CFrameMon = CFrame.new(item[9], item[10], item[11])
            return
        end
    end
end

function GetNearestMob(originMob, maxDistance)
    if not originMob or not originMob:FindFirstChild("HumanoidRootPart") then
        return nil
    end
    local nearest
    local nearestDistance = math.huge
    for _, mob in ipairs(workspace.Enemies:GetChildren()) do
        if mob ~= originMob
        and mob.Name == originMob.Name
        and mob.Parent
        and mob:FindFirstChild("Humanoid")
        and mob:FindFirstChild("HumanoidRootPart")
        and mob.Humanoid.Health > 0 then
            local dist = (mob.HumanoidRootPart.Position - originMob.HumanoidRootPart.Position).Magnitude
            if dist <= maxDistance and dist < nearestDistance then
                nearest = mob
                nearestDistance = dist
            end
        end
    end
    return nearest
end

function SmartMoveAndAttack(mainMob, QuestTitle, Quest, IsCheckQuest, CustomName)
    if IsCheckQuest == nil then IsCheckQuest = true end
    CustomName = CustomName or NameCheckQuest
    pcall(sethiddenproperty, LocalPlayer, "SimulationRadius", math.huge)
    
    if not mainMob or not mainMob.Parent or not mainMob:FindFirstChild("Humanoid") or not mainMob:FindFirstChild("HumanoidRootPart") then
        return false
    end

    local humanoid = mainMob.Humanoid
    local hrp = mainMob.HumanoidRootPart
    humanoid.JumpPower = 0
    humanoid.WalkSpeed = 0
    hrp.CanCollide = false
    
    if getgenv().Configs.BringMob then
        local bv = hrp:FindFirstChild("BringVelocity")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "BringVelocity"
            bv.MaxForce = Vector3.new(100000, 100000, 100000)
            bv.Parent = hrp
        end
        bv.Velocity = Vector3.zero
    end

    local secondMob = nil
    local tween = nil

    repeat
        task.wait()
        if not mainMob or not mainMob.Parent or not hrp or humanoid.Health <= 0 then break end
        
        if IsCheckQuest then CheckQuest() end

        local dist = (hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude

        if dist > 5 then
            if MovementManager and MovementManager.MoveTo then
                MovementManager:MoveTo(hrp.CFrame * CFrame.new(0, 30, 0), 300, 1)
            end
        end

        secondMob = GetNearestMob(mainMob, 350)

        if secondMob and secondMob:FindFirstChild("HumanoidRootPart") then
            secondMob.HumanoidRootPart.CFrame = hrp.CFrame
            secondMob.HumanoidRootPart.CanCollide = false
        end

        if dist <= 40 then
            if secondMob then
                Attack({mainMob, secondMob})
            else
                Attack(mainMob)
            end
        end
    until not mainMob 
        or not mainMob.Parent 
        or not mainMob:FindFirstChild("Humanoid") 
        or (mainMob.Humanoid.Health <= 0) 
        or not getgenv().Configs.AutoFarmLevel

    if tween then
        tween:Cancel()
        tween = nil
    end

    return humanoid.Health <= 0
end

