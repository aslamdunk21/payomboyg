function GetCurrentQuestInfo()
    local lp = LocalPlayer or game:GetService("Players").LocalPlayer
    local pg = lp and lp:FindFirstChild("PlayerGui")
    if not pg then return false, "", "" end

    -- 1. Modern Blox Fruits Quest UI (TrackedQuestFrame)
    local tqf = pg:FindFirstChild("TrackedQuestFrame")
    if tqf and tqf.Enabled then
        local frame = tqf:FindFirstChild("Frame")
        if frame and frame.Visible then
            local header = frame:FindFirstChild("header")
            local textLabel = header and header:FindFirstChild("textLabel")
            local desc = frame:FindFirstChild("description")
            local titleText = (textLabel and textLabel.Text) or ""
            local descText = (desc and desc.Text) or ""
            if #titleText > 0 or #descText > 0 then
                return true, titleText, descText
            end
        end
    end

    -- 2. Legacy Blox Fruits Quest UI (Main.Quest)
    local mq = pg:FindFirstChild("Main") and pg.Main:FindFirstChild("Quest")
    if mq and mq.Visible then
        local title = ""
        pcall(function()
            title = mq.Container.QuestTitle.Title.Text
        end)
        if #title > 0 and not string.find(title:lower(), "defeat 5 bandits") then
            return true, title, title
        end
    end

    return false, "", ""
end
getgenv().GetCurrentQuestInfo = GetCurrentQuestInfo

function GetMobByName(mobName)
    if not mobName then return nil end
    local mobLower = string.lower(mobName)
    
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, v in ipairs(enemies:GetChildren()) do
            local nameLower = string.lower(v.Name)
            if (nameLower == mobLower or string.find(nameLower, mobLower, 1, true)) 
                and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 then
                return v
            end
        end
    end
    
    for _, v in ipairs(workspace:GetChildren()) do
        if v:IsA("Model") and v ~= LocalPlayer.Character then
            local nameLower = string.lower(v.Name)
            if (nameLower == mobLower or string.find(nameLower, mobLower, 1, true)) 
                and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 then
                return v
            end
        end
    end
    
    local rep = game:GetService("ReplicatedStorage")
    if rep then
        for _, v in ipairs(rep:GetChildren()) do
            local nameLower = string.lower(v.Name)
            if (nameLower == mobLower or string.find(nameLower, mobLower, 1, true)) 
                and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 then
                return v
            end
        end
    end
    return nil
end

