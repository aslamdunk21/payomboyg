-- ============================================================
-- 📜 CHECK QUEST DISPATCHER
-- ============================================================
function CheckQuest()
    local WS = getgenv().WorldState or WorldState
    local W1 = (getgenv().World1 ~= nil) and getgenv().World1 or World1
    local W2 = (getgenv().World2 ~= nil) and getgenv().World2 or World2
    
    local Level = (LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level")) and LocalPlayer.Data.Level.Value or 1
    local curSea = W1 and 1 or (W2 and 2 or 3)
    local questList = (curSea == 1 and getgenv().Sea1_Quests) or (curSea == 2 and getgenv().Sea2_Quests) or getgenv().Sea3_Quests
    
    if not questList then
        pcall(function()
            if type(readfile) == "function" and isfile("BFSub.txt") then
                loadstring(readfile("BFSub.txt"))()
            else
                loadstring(game:HttpGet("https://raw.githubusercontent.com/aslamdunk21/payomboyg/refs/heads/main/BFSub"))()
            end
        end)
        questList = (curSea == 1 and getgenv().Sea1_Quests) or (curSea == 2 and getgenv().Sea2_Quests) or getgenv().Sea3_Quests
    end
    if not questList then return end

    for _, item in ipairs(questList) do
        if Level <= item[1] then
            Monster = item[2]
            NameQuest = item[3]
            LevelQuest = item[4]
            NameCheckQuest = item[5]
            CFrameQ = CFrame.new(item[6], item[7], item[8])
            CFrameMon = CFrame.new(item[9], item[10], item[11])
            
            -- Sync to getgenv
            getgenv().Monster = Monster
            getgenv().NameQuest = NameQuest
            getgenv().LevelQuest = LevelQuest
            getgenv().NameCheckQuest = NameCheckQuest
            getgenv().CFrameQ = CFrameQ
            getgenv().CFrameMon = CFrameMon
            return
        end
    end
end

function GetNearestMob(originMob, maxDistance)
    if not originMob or not originMob:FindFirstChild("HumanoidRootPart") then return nil end
    local nearest = nil
    local nearestDistance = math.huge
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    for _, mob in ipairs(enemies:GetChildren()) do
        if mob ~= originMob
        and mob.Name == originMob.Name
        and mob.Parent
        and mob:FindFirstChild("Humanoid")
        and mob:FindFirstChild("HumanoidRootPart")
        and mob.Humanoid.Health > 0 then
            local dist = (mob.HumanoidRootPart.Position - originMob.HumanoidRootPart.Position).Magnitude
            if dist <= maxDistance and dist < nearestDistance then
                nearest = mob
                nearestDistance = dist
            end
        end
    end
    return nearest
end

-- ============================================================
-- ⚔️ SMART MOVE AND ATTACK (HOVER AT OPTIMAL MELEE RANGE 12 STUDS)
-- ============================================================
function SmartMoveAndAttack(mainMob, QuestTitle, Quest, IsCheckQuest, CustomName)
    if IsCheckQuest == nil then IsCheckQuest = true end
    CustomName = CustomName or NameCheckQuest
    pcall(sethiddenproperty, LocalPlayer, "SimulationRadius", math.huge)
    
    if not mainMob or not mainMob.Parent or not mainMob:FindFirstChild("Humanoid") or not mainMob:FindFirstChild("HumanoidRootPart") then
        return false
    end

    local humanoid = mainMob.Humanoid
    local hrp = mainMob.HumanoidRootPart
    humanoid.JumpPower = 0
    humanoid.WalkSpeed = 0
    hrp.CanCollide = false
    
    if getgenv().Configs and getgenv().Configs.BringMob then
        local bv = hrp:FindFirstChild("BringVelocity")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "BringVelocity"
            bv.MaxForce = Vector3.new(100000, 100000, 100000)
            bv.Parent = hrp
        end
        bv.Velocity = Vector3.zero
    end

    local secondMob = nil

    repeat
        task.wait()
        if not mainMob or not mainMob.Parent or not hrp or humanoid.Health <= 0 then break end
        
        -- Quest Desync Verification: If current quest is wrong, abandon to avoid getting stuck
        local hasActiveQ, curQTitle, curQDesc = GetCurrentQuestInfo()
        if IsCheckQuest and hasActiveQ then
            local fullQText = (curQTitle .. " " .. curQDesc):lower()
            local expectedText = tostring(CustomName or Monster or ""):lower()
            if #expectedText > 0 and not string.find(fullQText, expectedText, 1, true) and not string.find(fullQText, "swan") and not string.find(fullQText, "bartilo") then
                pcall(function() CommF_:InvokeServer("AbandonQuest") end)
                task.wait(0.3)
                break
            end
        end

        if IsCheckQuest then CheckQuest() end

        local playerHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not playerHrp then break end
        local dist = (hrp.Position - playerHrp.Position).Magnitude

        -- Hover at 12 studs directly above mob (Optimal Melee Reach)
        local hoverCF = hrp.CFrame * CFrame.new(0, 12, 0)
        if MovementManager and MovementManager.MoveTo then
            MovementManager:MoveTo(hoverCF, 300, 1)
        end

        secondMob = GetNearestMob(mainMob, 350)
        if secondMob and secondMob:FindFirstChild("HumanoidRootPart") then
            secondMob.HumanoidRootPart.CFrame = hrp.CFrame
            secondMob.HumanoidRootPart.CanCollide = false
        end

        -- Attack Execution
        if dist <= 35 then
            if Attack then
                if secondMob then
                    Attack({mainMob, secondMob})
                else
                    Attack(mainMob)
                end
            end
        end
    until not mainMob 
        or not mainMob.Parent 
        or not mainMob:FindFirstChild("Humanoid") 
        or (mainMob.Humanoid.Health <= 0) 
        or not (getgenv().Configs and getgenv().Configs.AutoFarmLevel)

    return humanoid.Health <= 0
end

