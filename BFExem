function SetObjective(priorityLevel, objectiveName, reason)
    if CurrentObjective ~= objectiveName then
        PreviousObjective = CurrentObjective
        CurrentObjective = objectiveName
        ObjectiveStartTime = os.clock()
        MovementManager:Stop()
        KaitunMonitor:AddLog(priorityLevel, string.format("%s: %s", objectiveName, reason or ""), priorityLevel)
    end
    ObjectiveReason = reason or ""
    title.Text = string.format("[%s] %s", priorityLevel, CurrentObjective)
    subtitle.Text = ObjectiveReason

    KaitunMonitor.State.PriorityTier = priorityLevel
    KaitunMonitor.State.ActiveObjective = objectiveName
    KaitunMonitor.State.ObjectiveReason = ObjectiveReason
    KaitunMonitor.State.EngineStatus = "🟢 " .. objectiveName
    KaitunMonitor:UpdateUI()
end
