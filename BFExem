            elseif not pProg.KilledMob then
                local mobLeader = TargetManager:GetBestTarget("Mob Leader", 500)
                if mobLeader then
                    title.Text = "Saber Quest | Defeating Mob Leader"
                    SmartMoveAndAttack(mobLeader, QuestTitle, Quest, false)
