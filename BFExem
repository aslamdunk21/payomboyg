                    for _, p in ipairs(workspace:GetPartBoundsInBox(cf, Vector3.new(6, 6, 6))) do
                        if p:IsA("BasePart") then
                            pcall(function() firetouchinterest(hrp, p, 0); firetouchinterest(hrp, p, 1) end)
                        end
                    end
                end
                task.wait(0.25)
            end
            return
        end

    -- 3. Race V2 Quest (Alchemist)
    elseif getgenv().Configs and getgenv().Configs.AutoV2_V3 and Level >= 850 then
        local alch = nil
        pcall(function() alch = CommF_:InvokeServer("Alchemist", "1") end)
        if alch == 0 then
            title.Text = "Accepting Race V2 Quest (Alchemist)"
            pcall(function() CommF_:InvokeServer("Alchemist", "2") end)
        elseif alch == 2 then
            local beli = LocalPlayer.Data and LocalPlayer.Data.Beli and LocalPlayer.Data.Beli.Value or 0
            if beli >= 500000 then
                title.Text = "Completing Race V2 (Paying Alchemist $500,000)"
                MovementManager:MoveTo(CFrame.new(480.0, 8.0, 480.0), 150, 2)
                pcall(function() CommF_:InvokeServer("Alchemist", "3") end)
                return
            end
        end
    end

    -- 4. Standard Level Farming (Sea 2)
    if not isQuestActive then
        title.Text = "Auto Farming Level | Taking Quest"
        MovementManager:MoveTo(CFrameQ, 150, 2)
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and (CFrameQ.Position - hrp.Position).Magnitude <= 15 then
            CommF_:InvokeServer("StartQuest", NameQuest, LevelQuest)
            CommF_:InvokeServer("SetSpawnPoint")
            task.wait(0.5)
        end
    else
        local targetMob = TargetManager:GetBestTarget(Monster, 600)
        if targetMob then
            SmartMoveAndAttack(targetMob, QuestTitle, Quest)
        else
            title.Text = "Waiting For " .. tostring(Monster) .. " to Spawn"
            MovementManager:MoveTo(CFrameMon, 150, 2)
        end
    end
end

