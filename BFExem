    elseif Level >= 575 and getgenv().Configs and getgenv().Configs.Pole and not IsPoleV1 then
        local thunderGod = TargetManager:GetBestTarget("Thunder God", 500)
        if thunderGod then
            title.Text = "Defeating Thunder God (Pole V1)"
            SmartMoveAndAttack(thunderGod, QuestTitle, Quest, false)
