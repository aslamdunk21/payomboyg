local function getScrapStackCount()
    local playerCharacter = localPlayer.Character
    if not playerCharacter then return 0 end
    local playerHead = playerCharacter:FindFirstChild("Head")
    if not playerHead then return 0 end
    local scrapStack = playerHead:FindFirstChild("ScrapStack")
    if not scrapStack then return 0 end

    local stackCount = 0
    for _, stackPart in ipairs(scrapStack:GetDescendants()) do
        if stackPart:IsA("BasePart") then stackCount = stackCount + 1 end
    end
    return stackCount
end

