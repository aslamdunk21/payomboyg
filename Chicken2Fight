local function upgradeRecycler()
    local ok, result = pcall(function()
        if remotesModule and remotesModule.defs and remotesModule.defs.UpgradeRecycler then
            return remotesModule.invoke(remotesModule.defs.UpgradeRecycler)
        end
        local remotesFolder = replicatedStorage:FindFirstChild("Remotes") or game:GetService("ReplicatedStorage"):WaitForChild("Remotes", 5)
        if remotesFolder then
            local remote = remotesFolder:FindFirstChild("UpgradeRecycler") or remotesFolder:WaitForChild("UpgradeRecycler", 2)
            if remote then
                if remote:IsA("RemoteFunction") then
                    return remote:InvokeServer()
                elseif remote:IsA("RemoteEvent") then
                    remote:FireServer()
                    return true
                end
            end
        end
        return game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("UpgradeRecycler"):InvokeServer()
    end)
    return ok and (result == true or (typeof(result) == "table" and result.ok == true))
end

