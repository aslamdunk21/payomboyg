local ConnectionManager = { Connections = {} }

function ConnectionManager:Add(conn, name)
    if conn and typeof(conn) == "RBXScriptConnection" then
        table.insert(self.Connections, { Connection = conn, Name = name or "Unnamed" })
    end
    return conn
end

function ConnectionManager:Cleanup()
    for _, item in ipairs(self.Connections) do
        if item.Connection and item.Connection.Connected then
            pcall(function() item.Connection:Disconnect() end)
        end
    end
    self.Connections = {}
end

local function getParentGui()
    if typeof(gethui) == "function" then
        local ok, res = pcall(gethui)
        if ok and res and typeof(res) == "Instance" then return res end
    end
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
    return playerGui
end

