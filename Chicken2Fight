    systemStatLabel.Text = string.format("%s\n%s", sysStr, fpsStr)

    badgeTextLabel.Text = string.format(
        "%s [ 🥚 Egg ]   %s [ ♻️ Scrap ]   %s [ 🏰 Tower ]   %s [ 🔄 Rebirth ]   %s [ 💰 Feeder ]",
