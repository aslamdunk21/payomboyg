-- ===== 2. ANTI-WALK DETECTION BYPASS (จำลองการเดินของมนุษย์) =====
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")

local function createHumanLikeMovement()
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    -- เก็บค่าเดิม
    local oldWalkSpeed = humanoid.WalkSpeed
    local oldJumpPower = humanoid.JumpPower
    
    -- เพิ่มความผันผวนให้การเดิน (มนุษย์ไม่เดินความเร็วคงที่)
    local walkSpeedOffset = 0
    local jumpOffset = 0
    
    local connection
    connection = RunService.Heartbeat:Connect(function(deltaTime)
        if not getgenv().autoMasterEngineEnabled then
            if connection then connection:Disconnect() end
            return
        end
        
        -- สุ่มค่าความผันผวน
        walkSpeedOffset = (math.random() - 0.5) * 2
        jumpOffset = (math.random() - 0.5) * 1
        
        -- ใช้เฉพาะเมื่อกำลังเดินอยู่ (ไม่ใช่เวลายืนนิ่ง)
        if humanoid.MoveDirection.Magnitude > 0.1 then
            humanoid.WalkSpeed = oldWalkSpeed + walkSpeedOffset * 0.5
        else
            humanoid.WalkSpeed = oldWalkSpeed
        end
        
        humanoid.JumpPower = oldJumpPower + jumpOffset * 0.3
    end)
    
    return connection
end

-- เริ่ม Anti-Walk
local antiWalkConnection = nil
local function startAntiWalk()
    if antiWalkConnection then return end
    antiWalkConnection = createHumanLikeMovement()
end

local function stopAntiWalk()
    if antiWalkConnection then
        antiWalkConnection:Disconnect()
        antiWalkConnection = nil
    end
end

