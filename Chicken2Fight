-- ===== 3. ANTI-NOCLIP DETECTION BYPASS (จำลองการผ่านสิ่งกีดขวาง) =====
local function advancedNoclipBypass()
    local character = LocalPlayer.Character
    if not character then return end
    
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            -- อย่าปิด CanCollide ตลอดเวลา ให้ปิดเฉพาะเวลาที่กำลังเคลื่อนที่ผ่านกำแพง
            local originalCanCollide = part.CanCollide
            
            -- ใช้ TouchInterest เพื่อตรวจจับว่ากำลังชนอะไร
            local touchInterest = Instance.new("TouchInterest")
            touchInterest.Parent = part
            
            touchInterest.Touched:Connect(function(hit)
                if getgenv().autoScrapEnabled then
                    -- ถ้าชนวัตถุที่ควรจะผ่านได้ ให้ปิด CanCollide ชั่วคราว
                    if hit:IsA("BasePart") and hit.CanCollide then
                        part.CanCollide = false
                        task.delay(0.2, function()
                            if part and part.Parent then
                                part.CanCollide = true
                            end
                        end)
                    end
                end
            end)
        end
    end
end

