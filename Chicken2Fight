function KaitunDashboard:Update()
    if not self.Frame or not self.Frame.Parent then return end

    pcall(function()
        local moneyVal = getCurrentMoney()

        local rebirthCount = 0
        if dataControllerModule and dataControllerModule.rebirth then
            local rData = dataControllerModule.rebirth()
            if rData and rData.count then rebirthCount = rData.count end
        end

        local towerFloor = 0
        if dataControllerModule and dataControllerModule.towerBest then
            towerFloor = tonumber(dataControllerModule.towerBest()) or 0
        end

        local scrapCount = getScrapStackCount()
        local eggCount = #getOwnedEggPositions()

        local feederCount = 0
        local coopSlots = 0
        local coopData = getCoopData()
        if coopData then
            if type(coopData.generators) == "table" then feederCount = #coopData.generators end
            if type(coopData.slots) == "number" then coopSlots = coopData.slots end
        end

        local eventLive = isChaosEventLive()
        local eventText = eventLive and "<font color=\"#ff3b3b\">🔥 LIVE (บอสไก่เดือด)</font>" or "<font color=\"#888888\">💤 STANDBY</font>"

        local curTask = "IDLE"
        local statusThai = "กำลังสแตนด์บายพักผ่อน"

        if getgenv().autoChaosEnabled and eventLive then
            curTask = "CHAOS_EVENT"
            statusThai = "⚔️ ลุย Chaos Event Arena"
        elseif getgenv().autoTowerEnabled and isTowerRunActive() then
            curTask = "TOWER_RUN"
            statusThai = "🏰 ตะลุยดันหอคอย (Auto Tower)"
        elseif getgenv().autoRebirthEnabled and isRebirthReady and isRebirthReady() then
            curTask = "REBIRTH_ROUTINE"
            statusThai = "⚡ เคลียร์เงื่อนไขเตรียม Rebirth"
        elseif getgenv().autoScrapEnabled and scrapCount > 6 then
            curTask = "DEPOSIT_SCRAP"
            statusThai = "🗑️ นำเศษเหล็กไปส่งเครื่อง Recycler"
        elseif getgenv().autoCollectEggEnabled and eggCount > 0 then
            curTask = "COLLECT_EGGS"
            statusThai = "🥚 เดินเก็บไข่ไก่รอบเล้า"
        elseif getgenv().autoScrapEnabled then
            curTask = "COLLECT_SCRAP"
            statusThai = "🔧 เก็บเศษเหล็กขยะใน PIT"
        end

        local priorityMap = {
            CHAOS_EVENT = "[P0] CHAOS_EVENT",
            REBIRTH_ROUTINE = "[P1] REBIRTH_ROUTINE",
            DEPOSIT_SCRAP = "[P1] DEPOSIT_SCRAP",
            TOWER_RUN = "[P2] AUTO_TOWER",
            COLLECT_EGGS = "[P3] COLLECT_EGGS",
            COLLECT_SCRAP = "[P4] COLLECT_SCRAP",
            IDLE = "[P5] STANDBY_IDLE"
        }

        local pText = priorityMap[curTask] or ("[P1] " .. curTask)

        local elapsedTime = os.time() - self.StartTime
        local timeStr = formatTime(elapsedTime)

        local score = math.clamp(math.floor((rebirthCount * 20) + (towerFloor * 2) + (coopSlots * 5)), 0, 100)
        local barFilled = math.floor(score / 10)
        local barEmpty = 10 - barFilled
        local progressBar = string.rep("█", barFilled) .. string.rep("░", barEmpty)

        if self.StatusLbl then self.StatusLbl.Text = "⚡ แอ็กชัน: " .. statusThai end
        if self.MissionLbl then self.MissionLbl.Text = "🎯 ภารกิจหลัก: " .. pText end
        if self.EventLbl then self.EventLbl.Text = "⚔️ Chaos Event: " .. eventText end
        if self.ResourceLbl then self.ResourceLbl.Text = string.format("🗑️ ขยะ: %d/6  |  🥚 ไข่: %d  |  🍗 รางอาหาร: %d Slot", scrapCount, eggCount, feederCount) end
        if self.AccountLbl then self.AccountLbl.Text = string.format("💰 เงิน: $%s  |  📊 Rebirth: %d  |  🏰 หอคอย: ชั้น %d", formatMoney(moneyVal), rebirthCount, towerFloor) end
        if self.ProgressLbl then self.ProgressLbl.Text = string.format("🔥 KAITUN SCORE: [<font color=\"#00ffaa\">%s</font>] %d%% (⏱️ %s)", progressBar, score, timeStr) end
    end)
end

