-- ฟังก์ชันสำหรับ Hook RemoteFunction ให้ข้ามการตรวจสอบ
local function hookRemoteFunction(remoteName)
    local remote = remotesFolder:FindFirstChild(remoteName)
    if remote and remote:IsA("RemoteFunction") then
        -- เก็บฟังก์ชันเดิม
        local oldInvoke = remote.InvokeServer
        remote.InvokeServer = function(self, ...)
            -- ข้ามการตรวจสอบบางอย่างโดยการเพิ่มพารามิเตอร์ปลอม
            local args = {...}
            -- ถ้า Remote คาดหวัง Player เป็นอาร์กิวเมนต์แรก ให้ส่ง LocalPlayer ไป
            if #args == 0 or (type(args[1]) == "number" and args[1] == 0) then
                return oldInvoke(self, game:GetService("Players").LocalPlayer, unpack(args))
            end
            return oldInvoke(self, unpack(args))
        end
        warn("[BZ] Hooked RemoteFunction:", remoteName)
    end
end

-- ฟังก์ชันสำหรับ Hook RemoteEvent
local function hookRemoteEvent(remoteName)
    local remote = remotesFolder:FindFirstChild(remoteName)
    if remote and remote:IsA("RemoteEvent") then
        local oldFire = remote.FireServer
        remote.FireServer = function(self, ...)
            local args = {...}
            if #args == 0 or (type(args[1]) == "number" and args[1] == 0) then
                return oldFire(self, game:GetService("Players").LocalPlayer, unpack(args))
            end
            return oldFire(self, unpack(args))
        end
        warn("[BZ] Hooked RemoteEvent:", remoteName)
    end
end

