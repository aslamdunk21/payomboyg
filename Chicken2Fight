            GameState.TowerBestFloor = dataControllerModule.towerBest() or 0
        end

        if rebirthBonusModule and rebirthExperimentModule and dataControllerModule then
            local usesV2 = rebirthExperimentModule.armOf(localPlayer) == rebirthExperimentModule.VARIANT
            GameState.IsRebirthReady = rebirthBonusModule.ready(GameState.TowerBestFloor, GameState.RebirthCount, usesV2)
        end

        local coopData = getCoopData()
