-- ===== 4. RATE LIMIT BYPASS (กระจายการเรียก Remote) =====
local remoteCallQueue = {}
local isProcessingQueue = false

local function processRemoteQueue()
    if isProcessingQueue then return end
    isProcessingQueue = true
    
    task.spawn(function()
        while #remoteCallQueue > 0 do
            local call = table.remove(remoteCallQueue, 1)
            if call then
                -- กระจายการเรียกให้ห่างกัน
                local delay = call.delay or 0.3
                task.wait(delay)
                
                pcall(function()
                    if call.type == "function" then
                        call.remote:InvokeServer(unpack(call.args))
                    elseif call.type == "event" then
                        call.remote:FireServer(unpack(call.args))
                    end
                end)
            end
        end
        isProcessingQueue = false
    end)
end

local function queueRemoteCall(remote, args, delay, type)
    table.insert(remoteCallQueue, {
        remote = remote,
        args = args or {},
        delay = delay or 0.3,
        type = type or "function"
    })
    processRemoteQueue()
end

-- แทนที่การเรียก Remote ด้วย Queue
local function safeInvokeWithQueue(remoteName, ...)
    local remote = remotesFolder:FindFirstChild(remoteName)
    if not remote then return end
    local args = {...}
    queueRemoteCall(remote, args, 0.3, "function")
end

local function safeFireWithQueue(remoteName, ...)
    local remote = remotesFolder:FindFirstChild(remoteName)
    if not remote then return end
    local args = {...}
    queueRemoteCall(remote, args, 0.3, "event")
end

