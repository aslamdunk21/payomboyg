function GAG1TradeEngine:SendEggGiftOrOffer(targetName, rawEggItem)
    if not targetName or targetName == "" or targetName == "ไม่มีผู้เล่นอื่นในเซิร์ฟเวอร์" then
        Engine:Notify({ Title = "ส่งไข่ล้มเหลว ❌", Content = "กรุณาเลือกผู้เล่นเป้าหมายในเซิร์ฟเวอร์ก่อน!" })
        return
    end
    local cleanEgg = Engine:CleanItemName(rawEggItem)
    if not cleanEgg or cleanEgg == "" or cleanEgg:find("ไม่มีไอเทม") then
        Engine:Notify({ Title = "ส่งไข่ล้มเหลว ❌", Content = "กรุณาเลือกไข่ในสัมภาระก่อนกดส่ง!" })
        return
    end

    pcall(function()
        local targetPlayer = Players:FindFirstChild(targetName)
        if not targetPlayer then
            Engine:Notify({ Title = "ส่งไข่ล้มเหลว ❌", Content = "ไม่พบผู้เล่น: " .. tostring(targetName) })
            return
        end

        local giftRemote = ReplicatedStorage.GameEvents:FindFirstChild("GiftEgg") or ReplicatedStorage.GameEvents:FindFirstChild("SendGift") or ReplicatedStorage.GameEvents:FindFirstChild("GiveEgg")
        if giftRemote then
            giftRemote:FireServer(targetPlayer, cleanEgg)
            Engine:Notify({ Title = "ส่งไข่สำเร็จ! 🥚", Content = string.format("ส่งไข่ '%s' ให้ %s เรียบร้อย!", cleanEgg, targetName) })
        else
            local tradeRemote = ReplicatedStorage.GameEvents:FindFirstChild("SendTradeRequest") or ReplicatedStorage.GameEvents:FindFirstChild("Trade")
            if tradeRemote then
                tradeRemote:FireServer(targetPlayer, cleanEgg)
                Engine:Notify({ Title = "ส่งข้อเสนอเทรดไข่ 🥚", Content = string.format("เสนอเทรดไข่ '%s' ให้ %s", cleanEgg, targetName) })
            end
        end
    end)
end

function GAG1TradeEngine:InitAutoAccept()
    pcall(function()
        local playerGui = LocalPlayer:WaitForChild("PlayerGui")
        playerGui.ChildAdded:Connect(function(child)
