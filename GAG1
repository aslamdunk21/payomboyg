function Engine:CleanItemName(name)
    if not name then return "" end
    local clean = tostring(name)
    clean = clean:gsub("%[%w+%]%s*", "")
    clean = clean:gsub("%(x%d+%)", "")
    clean = clean:gsub("%s*x%d+", "")
    clean = clean:gsub("^%s*(.-)%s*$", "%1")
    return clean
end

function Engine:IsItemSelected(selectedMap, itemName)
    if not selectedMap or not itemName then return false end
    if selectedMap[itemName] then return true end
    local cleanTarget = self:CleanItemName(itemName):lower()
    for item, state in pairs(selectedMap) do
        if state and self:CleanItemName(item):lower() == cleanTarget then
            return true
        end
    end
    return false
end

