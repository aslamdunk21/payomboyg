local GAG1TradeEngine = {}

function GAG1TradeEngine:GetServerPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.Name)
        end
    end
    if #list == 0 then
        table.insert(list, "ไม่มีผู้เล่นอื่นในเซิร์ฟเวอร์")
    end
