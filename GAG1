function Engine:SaveConfig()
    pcall(function()
        if writefile then
            writefile("GAG1_Config.json", HttpService:JSONEncode(self.Config))
        end
    end)
end

function Engine:LoadConfig()
    pcall(function()
        if isfile and isfile("GAG1_Config.json") then
            local data = HttpService:JSONDecode(readfile("GAG1_Config.json"))
            if type(data) == "table" then
                for k, v in pairs(data) do
                    self.Config[k] = v
                end
            end
        end
    end)
end

