        if u.Equip then
            statusText = statusText .. "⚔️ Slot " .. tostring(u.Equip) .. " • "
        end
        if u.Trait and u.Trait ~= "None" then
            statusText = statusText .. "✨ " .. tostring(u.Trait)
        else
            statusText = statusText .. "พรสวรรค์: ไม่มี"
