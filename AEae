local function afkRenderUnitCards()
    if not AFK.unitScroll then return end
    
    -- Cleanup existing cards
    for _, cardFrame in ipairs(AFK.unitCardPool) do
        cardFrame:Destroy()
    end
    AFK.unitCardPool = {}

    local units = AFK.cachedData.Units or {}
    if #units == 0 then
        -- Default Info Text if no units fetched yet
        local infoCard = Instance.new("Frame")
        infoCard.Size = UDim2.new(1, -4, 0, 60)
        infoCard.BackgroundColor3 = AFK_COLOR.raised
        infoCard.BorderSizePixel = 0
        infoCard.Parent = AFK.unitScroll

        local icCorner = Instance.new("UICorner")
        icCorner.CornerRadius = UDim.new(0, 10)
        icCorner.Parent = infoCard

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -16, 1, 0)
        lbl.Position = UDim2.fromOffset(8, 0)
