-- Horst Status Update Helper
local function sendHorstStatus()
    local success, err = pcall(function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local Nodes = require(ReplicatedStorage:WaitForChild("Nodes"))

        local replica = Nodes.GET_PLAYER_REPLICA:InvokeSelf()
        if not replica then error("Replica not found") end

        local data = replica.Data
        if not data then error("Data not found") end

        local itemData = data.ItemData
        if not itemData then error("ItemData not found") end

        local level = data.Level or 0
        local gem = itemData.Gem and type(itemData.Gem) == "table" and itemData.Gem.Amount or 0
        local gold = itemData.Gold and type(itemData.Gold) == "table" and itemData.Gold.Amount or 0
        local trait = itemData.TraitReroll and type(itemData.TraitReroll) == "table" and itemData.TraitReroll.Amount or 0

        local message = string.format("⭐ Level : %d • 💎 Gems : %s • 🪙 Gold : %s • 🎲 RR : %s",
            level, formatNumber(gem), formatNumber(gold), formatNumber(trait))

        if _G.Horst_SetDescription then
            _G.Horst_SetDescription(message)
        end

        if GEM_TARGET and gem >= GEM_TARGET and not _G.ScriptShouldStop and not hasSummonConfig then
            if _G.Horst_AccountChangeDone then
                if _G.Horst_SetDescription then _G.Horst_SetDescription(message) end
                task.wait(15)
                local ok, doneErr = pcall(_G.Horst_AccountChangeDone)
                if ok then
                    _G.ScriptShouldStop = true
                    while true do
                        pcall(function()
                            local r = Nodes.GET_PLAYER_REPLICA:InvokeSelf()
                            if r and r.Data and r.Data.ItemData then
                                local dLoop = r.Data
                                local iLoop = dLoop.ItemData
                                local lLoop = dLoop.Level or 0
                                local meG = iLoop.Gem and iLoop.Gem.Amount or 0
                                local meGo = iLoop.Gold and iLoop.Gold.Amount or 0
                                local meTr = iLoop.TraitReroll and iLoop.TraitReroll.Amount or 0
                                _G.Horst_SetDescription(string.format("⭐ Level : %d • 💎 Gems : %s • 🪙 Gold : %s • 🎲 RR : %s",
                                    lLoop, formatNumber(meG), formatNumber(meGo), formatNumber(meTr)))
                            end
                        end)
                        task.wait(5)
                    end
                else
                    warn(string.format("❌ [PayomboyZ HUB] ส่งสถานะ DONE ไม่สำเร็จ: %s", tostring(doneErr)))
                end
            end
        end
    end)
end

