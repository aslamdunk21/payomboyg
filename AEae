-- Asynchronous Background Stat & Unit Poller Thread (Zero Lag)
task.spawn(function()
    while true do
        task.wait(1)
        pcall(function()
            local ReplicatedStorage = game:GetService("ReplicatedStorage")
            local Nodes = require(ReplicatedStorage:WaitForChild("Nodes"))
            
            -- Fetch Primary Replica Data
            local replica = Nodes.GET_PLAYER_REPLICA:InvokeSelf()
            if replica and replica.Data then
                AFK.cachedData.Level = replica.Data.Level or AFK.cachedData.Level or 0
                local itemData = replica.Data.ItemData or {}
                if itemData.Gem then AFK.cachedData.Gems = (type(itemData.Gem) == "table" and itemData.Gem.Amount) or itemData.Gem end
                if itemData.Gold then AFK.cachedData.Gold = (type(itemData.Gold) == "table" and itemData.Gold.Amount) or itemData.Gold end
                if itemData.TraitReroll then AFK.cachedData.RR = (type(itemData.TraitReroll) == "table" and itemData.TraitReroll.Amount) or itemData.TraitReroll end
            end

            -- Fallback Fetch via GET_DATA_VALUE
            pcall(function()
                local itemVal = Nodes.GET_DATA_VALUE:InvokeSelf("ItemData")
                if type(itemVal) == "table" then
                    if itemVal.Gem and itemVal.Gem.Amount then AFK.cachedData.Gems = itemVal.Gem.Amount end
                    if itemVal.Gold and itemVal.Gold.Amount then AFK.cachedData.Gold = itemVal.Gold.Amount end
                    if itemVal.TraitReroll and itemVal.TraitReroll.Amount then AFK.cachedData.RR = itemVal.TraitReroll.Amount end
                end
            end)

            -- Fetch Player Level Fallback
            pcall(function()
                local lvlVal = Nodes.GET_DATA_VALUE:InvokeSelf("Level")
                if type(lvlVal) == "number" and lvlVal > 0 then AFK.cachedData.Level = lvlVal end
            end)

            -- Fetch Unit Inventory & Equipped Units
            pcall(function()
                local unitData = Nodes.GET_DATA_VALUE:InvokeSelf("UnitData")
                if type(unitData) == "table" then
                    local parsedUnits = {}
                    for fullKey, data in pairs(unitData) do
                        if type(data) == "table" then
                            local displayName = data.DisplayName or fullKey:split("#")[1] or "Unit"
                            local equipSlot = data.Equip or data.EquippedSlot or nil
                            local trait = data.Trait or "None"
                            local shiny = data.Shiny or false
                            local rarity = data.Rarity or "Unknown"

                            table.insert(parsedUnits, {
                                Name = displayName,
                                FullKey = fullKey,
                                Equip = equipSlot,
                                Trait = trait,
                                Shiny = shiny,
                                Rarity = rarity,
                            })
                        end
                    end
                    table.sort(parsedUnits, function(a, b)
                        local aEq = a.Equip and 1 or 0
                        local bEq = b.Equip and 1 or 0
                        return aEq > bEq
                    end)
                    AFK.cachedData.Units = parsedUnits
                    AFK.unitDirty = true
                end
            end)
        end)
    end
end)

local function PayomboyZLog(kind, text)
    if not text or text == "" then return end
    local timeStr = os.date("%H:%M:%S")
    local line = string.format("[%s] [%s] %s", timeStr, string.upper(kind or "INFO"), text)
    table.insert(AFK.logHistory, 1, line)
    if #AFK.logHistory > 100 then table.remove(AFK.logHistory) end
    if AFK.on then AFK.logDirty = true end
end

local function afkEnterLowPower()
    pcall(function()
        if getfpscap then AFK.prevFps = getfpscap() end
        if setfpscap then setfpscap(AFK_FPS_CAP) end
    end)
    pcall(function()
        AFK.prevQuality = settings().Rendering.QualityLevel
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
    pcall(function()
        if RunService.Set3dRenderingEnabled then
            AFK.prev3D = true
            RunService:Set3dRenderingEnabled(false)
        end
    end)
end

local function afkExitLowPower()
    pcall(function()
        if setfpscap then setfpscap((AFK.prevFps and AFK.prevFps > 0) and AFK.prevFps or 240) end
    end)
    pcall(function()
        if AFK.prevQuality then settings().Rendering.QualityLevel = AFK.prevQuality end
    end)
    pcall(function()
        if AFK.prev3D and RunService.Set3dRenderingEnabled then
            RunService:Set3dRenderingEnabled(true)
        end
    end)
    AFK.prevFps, AFK.prevQuality, AFK.prev3D = nil, nil, nil
end

local function afkPushLog(text)
    if not AFK.on or not AFK.logList or not text then return end
    AFK.poolHead = AFK.poolHead % AFK_MAX_LOGS + 1
    local row = AFK.pool[AFK.poolHead]
    if not row then return end
    row.Text = text
    row.Visible = true
    for i = 1, AFK_MAX_LOGS do
        local r = AFK.pool[i]
        if r and r.Visible then
            r.LayoutOrder = (AFK.poolHead - i) % AFK_MAX_LOGS
        end
    end
end

local function afkSeedLogs()
    for i = 1, AFK_MAX_LOGS do
        local r = AFK.pool[i]
        if r then r.Visible = false end
    end
    AFK.poolHead = 0
    local maxCount = math.min(#AFK.logHistory, AFK_MAX_LOGS)
    for i = maxCount, 1, -1 do
        afkPushLog(AFK.logHistory[i])
    end
end

local function afkClock(sec)
    sec = math.max(0, math.floor(sec))
    return string.format("%02d:%02d:%02d", math.floor(sec / 3600), math.floor((sec % 3600) / 60), sec % 60)
end

