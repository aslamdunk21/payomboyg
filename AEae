        uSub.Font = Enum.Font.Gotham
        uSub.TextSize = 10
        uSub.TextXAlignment = Enum.TextXAlignment.Left
        uSub.Parent = card

        table.insert(AFK.unitCardPool, card)
    end
end

local function afkPump()
    if AFK.wantShow then
        AFK.wantShow = false
        if AFK.gui then AFK.gui.Enabled = true end
        afkEnterLowPower()
    end
    if AFK.wantHide then
        AFK.wantHide = false
        if AFK.gui then AFK.gui.Enabled = false end
        afkExitLowPower()
    end

    if not AFK.on then return end

    if AFK.wantSeed then
        AFK.wantSeed = false
        afkSeedLogs()
    end

    if AFK.logDirty then
        AFK.logDirty = false
        afkPushLog(AFK.logHistory[1])
    end

    if AFK.unitDirty then
        AFK.unitDirty = false
        pcall(afkRenderUnitCards)
    end

    local sec = math.floor(os.clock() - AFK.startAt)
    if sec == AFK.lastSec then return end
    AFK.lastSec = sec

    local currentGems = AFK.cachedData.Gems or 0
    local currentGold = AFK.cachedData.Gold or 0
    local currentLevel = AFK.cachedData.Level or 0
    local currentRR = AFK.cachedData.RR or 0

    local gemsEarned = math.max(0, currentGems - AFK.startGems)
    local goldEarned = math.max(0, currentGold - AFK.startGold)
    local elapsedMin = math.max(1, sec / 60)
    local gemsPerMin = math.floor(gemsEarned / elapsedMin)

    local s = AFK.stat
    if s.gems then s.gems.Text = "+" .. string.gsub(tostring(gemsEarned), "^(-?%d+)(%d%d%d)", '%1,%2') end
    if s.gold then s.gold.Text = "+" .. string.gsub(tostring(goldEarned), "^(-?%d+)(%d%d%d)", '%1,%2') end
    if s.rate then s.rate.Text = string.gsub(tostring(gemsPerMin), "^(-?%d+)(%d%d%d)", '%1,%2') .. " / น." end
    if s.time then s.time.Text = afkClock(sec) end

    -- Update Resource Summary Panel
    if AFK.resRows and #AFK.resRows >= 4 then
        if AFK.resRows[1] then AFK.resRows[1].Val.Text = string.gsub(tostring(currentGems), "^(-?%d+)(%d%d%d)", '%1,%2') .. " Gems" end
        if AFK.resRows[2] then AFK.resRows[2].Val.Text = string.gsub(tostring(currentGold), "^(-?%d+)(%d%d%d)", '%1,%2') .. " Gold" end
        if AFK.resRows[3] then AFK.resRows[3].Val.Text = string.gsub(tostring(currentRR), "^(-?%d+)(%d%d%d)", '%1,%2') .. " ใบ" end
        if AFK.resRows[4] then AFK.resRows[4].Val.Text = "Level " .. tostring(currentLevel) end
    end
end

