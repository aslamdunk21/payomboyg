        uTitle.TextColor3 = AFK_COLOR.label
        uTitle.Font = Enum.Font.GothamBold
        uTitle.TextSize = 13
        uTitle.TextXAlignment = Enum.TextXAlignment.Left
        uTitle.Parent = card

        local uSub = Instance.new("TextLabel")
        uSub.Size = UDim2.new(1, -55, 0, 18)
        uSub.Position = UDim2.fromOffset(52, 26)
        uSub.BackgroundTransparency = 1
        
