local HeapFlow = {
    allocSizes = {},
    gcIntervals = {},
    lastGCTime = 0,
    signature = "",
}

local function randomizeHeapSignature()
    local noise = {}
    for i = 1, math.random(10, 30) do
        local size = math.random(64, 4096)
        noise[i] = string.rep(string.char(math.random(0, 255)), size)
        table.insert(HeapFlow.allocSizes, size)
    end
    local shuffled = {}
    for i = 1, #noise do shuffled[i] = i end
    for i = #shuffled, 2, -1 do
        local j = math.random(i)
        shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
    end
    for _, idx in ipairs(shuffled) do
        noise[idx] = nil
    end
    HeapFlow.signature = ""
    for i = 1, 16 do
        HeapFlow.signature = HeapFlow.signature .. string.char(math.random(0, 255))
    end
    while #HeapFlow.allocSizes > 50 do
        table.remove(HeapFlow.allocSizes, 1)
    end
end

local function maskGCTiming()
    local now = tick()
    local interval = now - HeapFlow.lastGCTime
    table.insert(HeapFlow.gcIntervals, interval)
    HeapFlow.lastGCTime = now
    while #HeapFlow.gcIntervals > 20 do
        table.remove(HeapFlow.gcIntervals, 1)
    end
    if math.random() < 0.3 then
        pcall(function() gcinfo() end)
    end
end

