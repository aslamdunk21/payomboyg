local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local LP = Players.LocalPlayer

local BLOCK_REMOTES = true
local DISABLE_SCRIPTS = true
local HOOK_FUNCTIONS = true

local AC_FUNCTION_KEYWORDS = {
    "anticheat", "anti cheat", "anti-cheat", "detect", "detection",
    "suspicious", "cheater", "exploiter", "exploitation", "integrity",
    "ban", "kick", "flag", "report", "audit"
}

local AC_REMOTE_KEYWORDS = {
    "anticheat", "anti cheat", "anti-cheat", "detect", "detection",
    "suspicious", "exploit", "cheat", "cheater", "ban", "kick",
    "flag", "report", "audit"
}

local getconstants = getconstants or debug.getconstants or function(f)
    local out = {}
    return out
end

local getinfo = getinfo or debug.getinfo or function(f)
    return {}
end

local getgc = getgc or function(t)
    return {}
end

local islclosure = islclosure or function(f)
    return true
end

local newcclosure = newcclosure or function(f)
    return f
end

local hookfunction = hookfunction or function(old, new)
    return old
end

local hookmetamethod = hookmetamethod or function(obj, name, hook)
    return rawget(obj, name)
end

local hookedFunctions = {}

local function containsKeyword(str, keywords)
    str = str:lower()
    for _, kw in ipairs(keywords) do
        if str:find(kw, 1, true) then
            return true
        end
    end
    return false
end

local function disableSuspiciousScripts()
    if not DISABLE_SCRIPTS then
        return 0
    end

    local count = 0
    for _, v in ipairs(game:GetDescendants()) do
        if (v:IsA("LocalScript") or v:IsA("ModuleScript")) and not v.Disabled then
            local name = v.Name:lower()
            local parentName = v.Parent and v.Parent.Name:lower() or ""

            if containsKeyword(name, AC_FUNCTION_KEYWORDS) or containsKeyword(parentName, AC_FUNCTION_KEYWORDS) then
                v.Disabled = true
                count = count + 1
            end
        end
    end

    return count
end

local function hookSuspiciousFunctions()
    if not HOOK_FUNCTIONS or not hookfunction or not newcclosure then
        return 0
    end

    local found = getgc(true)
    local hookedCount = 0

    for _, fn in next, found do
        if type(fn) == "function" and islclosure(fn) and not hookedFunctions[fn] then
            local consts = getconstants(fn)

            if type(consts) ~= "table" then
                consts = {}
            end

            local suspicious = false
            for _, c in ipairs(consts) do
                if type(c) == "string" and containsKeyword(c, AC_FUNCTION_KEYWORDS) then
                    suspicious = true
                    break
                end
            end

            if suspicious then
                hookedFunctions[fn] = true
                hookedCount = hookedCount + 1

                local dummy = newcclosure(function(...)
                    return nil
                end)

                pcall(hookfunction, fn, dummy)
            end
        end
    end

    return hookedCount
end

local function installRemoteHook()
    if not BLOCK_REMOTES or not hookmetamethod or not newcclosure then
        return false
    end

    local oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()

        if method == "FireServer" or method == "InvokeServer" then
            if typeof(self) == "Instance" then
                local isRemote = self:IsA("RemoteEvent")
                    or self:IsA("RemoteFunction")
                    or self:IsA("UnreliableRemoteEvent")

                if isRemote and containsKeyword(self.Name, AC_REMOTE_KEYWORDS) then
                    warn("[Bypass] Blocked detection " .. self.ClassName .. " " .. self.Name)
                    return nil
                end
            end
        end

        return oldNamecall(self, ...)
    end))

    return true
end

local function runAntiCheatBypass()
    local disabledScripts = disableSuspiciousScripts()
    local hookedFunctionCount = hookSuspiciousFunctions()
    local remoteHookInstalled = installRemoteHook()

    if remoteHookInstalled then
        print("[CrazyHub] Anti-Cheat Bypassed successfully!")
        print("[CrazyHub] Disabled scripts: " .. disabledScripts .. " | Hooked functions: " .. hookedFunctionCount .. " | Remote hook: active")
    else
        print("[CrazyHub] Warning: Anti-cheat function not found yet, proceeding with fallback...")
        print("[CrazyHub] Disabled scripts: " .. disabledScripts .. " | Hooked functions: " .. hookedFunctionCount .. " | Remote hook: unavailable")
    end
end

runAntiCheatBypass()
