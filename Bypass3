-- ─── Crazy Hub AC Bypass (Standalone) ───
-- เปิดแค่ Anti-Cheat โดยไม่ง้อ UI ของ Crazy Hub
-- ใช้งาน: loadstring(game:HttpGet("url"))() หรือ paste ลง executor

local ACBypass = {}
ACBypass.__index = ACBypass

-- Configuration
local Config = {
    Debug = false,
    BlockPatterns = {
        -- Anti-cheat remote patterns (case-insensitive matching)
        "anticheat", "anti_cheat", "detection", "detect",
        "integrity", "verify", "verification", "check",
        "report", "suspicious", "exploit", "bypass",
        "security", "monitor", "log", "flag",
        "position", "speed", "teleport", "correction",
        "physics", "raycast", "hitbox", "distance",
        -- Common Roblox AC remotes
        "anticheat", "serverinfo", "clientcheck",
        "validate", "sanity", "heartbeat_check"
    },
    -- Additional safety: block by remote type
    BlockRemoteEvents = true,
    BlockRemoteFunctions = false, -- usually safe to leave false
    -- Logging
    LogBlocked = false,
    LogFormat = "[AC-Bypass] Blocked %s:%s"
}

-- Blocked counter for debug
local blockedCount = 0
local blockedRemotes = {}

-- Check if a remote name should be blocked
local function shouldBlock(remoteName)
    if not remoteName or type(remoteName) ~= "string" then
        return false
    end
    local lowerName = remoteName:lower()
    for _, pattern in ipairs(Config.BlockPatterns) do
        if lowerName:find(pattern:lower(), 1, true) then
            return true
        end
    end
    return false
end

-- Main bypass function
function ACBypass:Enable()
    if self._enabled then
        warn("[AC-Bypass] Already enabled!")
        return false
    end

    -- Check if hookmetamethod is available
    if type(hookmetamethod) ~= "function" then
        warn("[AC-Bypass] hookmetamethod not found — check your executor")
        return false
    end

    if type(getnamecallmethod) ~= "function" then
        warn("[AC-Bypass] getnamecallmethod not found")
        return false
    end

    -- Store original
    local originalNamecall = nil

    -- Create the hook closure
    local function hookClosure(self_obj, ...)
        local args = { ... }
        local method = nil
        pcall(function() method = getnamecallmethod() end)

        -- Only intercept FireServer/InvokeServer
        if method == "FireServer" or method == "InvokeServer" then
            -- Get remote name safely
            local remoteName = nil
            pcall(function() remoteName = self_obj.Name end)

            if remoteName and shouldBlock(remoteName) then
                blockedCount += 1
                blockedRemotes[remoteName] = (blockedRemotes[remoteName] or 0) + 1

                if Config.LogBlocked then
                    print(Config.LogFormat:format(
                        method,
                        remoteName
                    ))
                end

                if Config.Debug then
                    print(string.format(
                        "[AC-Bypass] #%d blocked: %s:%s (total: %d)",
                        blockedCount,
                        method,
                        remoteName,
                        blockedRemotes[remoteName]
                    ))
                end

                return nil -- Block the call
            end
        end

        -- Pass through legitimate calls
        if type(originalNamecall) == "function" then
            return originalNamecall(self_obj, unpack(args))
        end
        return nil
    end

    -- Wrap in newcclosure if available (better anti-detection)
    local closure = hookClosure
    if type(newcclosure) == "function" then
        local ok, result = pcall(newcclosure, hookClosure)
        if ok and type(result) == "function" then
            closure = result
        end
    end

    -- Apply the hook
    local ok = pcall(function()
        originalNamecall = hookmetamethod(game, "__namecall", closure)
    end)

    if not ok then
        warn("[AC-Bypass] Failed to apply hookmetamethod")
        return false
    end

    self._enabled = true
    self._originalNamecall = originalNamecall

    print(string.format(
        "[AC-Bypass] Enabled successfully — blocking %d patterns",
        #Config.BlockPatterns
    ))
    return true
end

-- Disable the bypass
function ACBypass:Disable()
    if not self._enabled then
        return false
    end

    -- Remove hook by restoring original
    if type(self._originalNamecall) == "function" then
        pcall(function()
            hookmetamethod(game, "__namecall", self._originalNamecall)
        end)
    end

    self._enabled = false
    print("[AC-Bypass] Disabled")
    return true
end

-- Get statistics
function ACBypass:GetStats()
    return {
        Enabled = self._enabled or false,
        TotalBlocked = blockedCount,
        UniqueRemotes = #blockedRemotes,
        BlockedDetails = blockedRemotes
    }
end

-- Add custom pattern to block
function ACBypass:AddPattern(pattern)
    if type(pattern) == "string" and not table.find(Config.BlockPatterns, pattern) then
        table.insert(Config.BlockPatterns, pattern)
        print(string.format("[AC-Bypass] Added pattern: '%s'", pattern))
        return true
    end
    return false
end

-- Remove pattern
function ACBypass:RemovePattern(pattern)
    for i, p in ipairs(Config.BlockPatterns) do
        if p:lower() == pattern:lower() then
            table.remove(Config.BlockPatterns, i)
            print(string.format("[AC-Bypass] Removed pattern: '%s'", pattern))
            return true
        end
    end
    return false
end

-- Quick one-liner enable
local function EnableAC()
    return ACBypass:Enable()
end

-- Quick stats
local function ACStats()
    local s = ACBypass:GetStats()
    print(string.format(
        "AC Bypass: %s | Blocked: %d | Unique: %d",
        s.Enabled and "ON" or "OFF",
        s.TotalBlocked,
        s.UniqueRemotes
    ))
    if s.UniqueRemotes > 0 and Config.Debug then
        print("Blocked remotes:")
        for name, count in pairs(s.BlockedDetails) do
            print(string.format("  %s: %d times", name, count))
        end
    end
end

