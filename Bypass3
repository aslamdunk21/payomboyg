-- CrazyHub Anti-Cheat Bypass - FINAL
-- สเตเบิล ไม่พังเกม ไม่เบลอจอ

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")

local BLOCK_LIST = {
    "X-34", "X-33", "X-35", "X-36",
    "AntiCheat", "Detect", "Report",
    "Check", "Verify", "Pulse",
    "Flag", "AC", "Ban", "Kick"
}

local function shouldBlockName(name)
    if not name then return false end
    local lowered = name:lower()
    for _, entry in ipairs(BLOCK_LIST) do
        if lowered == entry:lower() then
            return true
        end
    end
    return false
end

local function isRemoteObject(obj)
    local ok1, r1 = pcall(function() return obj:IsA("RemoteEvent") end)
    if ok1 and r1 then return true end
    local ok2, r2 = pcall(function() return obj:IsA("RemoteFunction") end)
    if ok2 and r2 then return true end
    local ok3, r3 = pcall(function() return obj:IsA("UnreliableRemoteEvent") end)
    if ok3 and r3 then return true end
    return false
end

-- 1) GC Patch
local function patchGc()
    if type(getgc) ~= "function" then return false end
    if type(hookfunction) ~= "function" then return false end
    local getconstants = getconstants or debug.getconstants
    if type(getconstants) ~= "function" then return false end

    local objs = getgc(true)
    if type(objs) ~= "table" then return false end

    local patched = 0
    for _, fn in pairs(objs) do
        if type(fn) == "function" then
            local consts = {}
            pcall(function() consts = getconstants(fn) end)
            local susp = false
            for _, c in pairs(consts) do
                if type(c) == "string" then
                    local lower = c:lower()
                    if lower:find("anticheat", 1, true) or lower:find("detect", 1, true) or
                       lower:find("suspicious", 1, true) or lower:find("cheater", 1, true) then
                        susp = true
                        break
                    end
                    if shouldBlockName(c) then susp = true break end
                end
            end
            if susp then
                pcall(function()
                    hookfunction(fn, function() return nil end)
                    patched = patched + 1
                end)
            end
        end
    end
    return patched > 0
end

-- 2) Namecall Hook
local function installNamecallHook()
    if type(hookmetamethod) ~= "function" then return false end
    if type(getnamecallmethod) ~= "function" then return false end

    local newcclosureFn = type(newcclosure) == "function" and newcclosure or function(f) return f end
    local old = nil

    local body = function(self, ...)
        local method = getnamecallmethod()
        if (method == "FireServer" or method == "InvokeServer") and isRemoteObject(self) then
            local name = pcall(function() return self.Name end) and self.Name or ""
            if shouldBlockName(name) then
                return nil
            end
        end
        if type(old) == "function" then
            return old(self, ...)
        end
        return nil
    end

    local wrapped = newcclosureFn(body)
    local ok = pcall(function() old = hookmetamethod(game, "__namecall", wrapped) end)
    if not ok or type(old) ~= "function" then return false end
    return true
end

-- 3) Clear Blur (กันจอเบลอค้าง)
local function clearBlur()
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("BlurEffect") then
            v.Enabled = false
            v:Destroy()
        end
    end
    Lighting.Blur = 0
end

-- 4) Disable Scripts
local function disableScripts()
    local count = 0
    for _, v in ipairs(game:GetDescendants()) do
        if (v:IsA("LocalScript") or v:IsA("ModuleScript")) and not v.Disabled then
            local name = v.Name:lower()
            if name:find("anticheat", 1, true) or name:find("detect", 1, true) or name:find("cheat", 1, true) then
                v.Disabled = true
                count = count + 1
            end
        end
    end
    return count > 0
end

-- MAIN
local function main()
    disableScripts()
    local gc = patchGc()
    local hook = installNamecallHook()

    if gc or hook then
        print("[CrazyHub] Anti-Cheat Bypassed successfully!")
    else
        print("[CrazyHub] Anti-Cheat Bypass Failed.")
    end

    -- loop ล้างเบลอ
    spawn(function()
        while true do
            wait(1)
            clearBlur()
        end
    end)
end

main()
