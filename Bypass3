MemoryFlow = {
    allocCount = 0,
    lastAllocTime = 0,
    connectionCount = 0,
    yieldHistory = {},
    maxHistory = 30,
}

local function randomizeMemoryPattern()
    local chunks = {}
    for i = 1, math.random(5, 15) do
        chunks[i] = string.rep("\0", math.random(100, 500))
    end
    local order = {}
    for i = 1, #chunks do order[i] = i end
    for i = #order, 2, -1 do
        local j = math.random(i)
        order[i], order[j] = order[j], order[i]
    end
    for _, idx in ipairs(order) do
        chunks[idx] = nil
    end
    local memBefore = gcinfo()
    for i = 1, 3 do chunks[i] = nil end
    local memAfter = gcinfo()
    MemoryFlow.allocCount = MemoryFlow.allocCount + (memBefore - memAfter)
end

local function maskConnectionCount()
