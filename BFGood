function Controller:Acquire(name, priority)
    if self.hardLock and self.hardLock ~= name and priority < 999 then
        return false, "hard-locked by " .. tostring(self.hardLock)
    end
    if self.LockOwner and self.LockOwner ~= name then
        return false -- Fragile Mode Lock
