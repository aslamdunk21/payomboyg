local function Attack(v)
    if not getgenv().Configs.FastAttack then return end
    local now = tick()
    if now - LastAttackTime < ATTACK_COOLDOWN then return end
    LastAttackTime = now

    -- Activate tool animation + Buso
    pcall(function()
        local activeTool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if activeTool then
            activeTool:Activate()
        end
        if LocalPlayer.Character and not LocalPlayer.Character:FindFirstChild("HasBuso") then
            CommF_:InvokeServer("Buso")
        end
    end)

    -- Auto-cast V skill
    TryAutoSkillV()

    -- Refresh remote if stale or missing
    if not r or not r.Parent then
        RefreshCombatRemote()
    end
    -- Periodic seed refresh (damage watchdog: too many hits without refresh = stale key)
    HitsSinceRefresh = HitsSinceRefresh + 1
    if HitsSinceRefresh > 50 or (now - LastSeedRefresh > SEED_REFRESH_INTERVAL) then
        pcall(function()
            if ReplicatedStorage.Modules.Net:FindFirstChild("seed") then
                seed = ReplicatedStorage.Modules.Net.seed:InvokeServer() * 2
            end
        end)
        LastSeedRefresh = now
        HitsSinceRefresh = 0
    end
    if not r then return end

    -- Build encoded key & hit ID
    local h = "RE/RegisterHit"
    local serverTime = workspace:GetServerTimeNow()
    local key = math.floor(serverTime / 10 % 10)
    local encoded = ""
    for i = 1, #h do
        encoded = encoded .. string.char(bit32.bxor(string.byte(h, i), key + 1))
    end
    local hitId = bit32.bxor((r:GetAttribute("Id") or 0) + 909090, seed)
    local comboTag = tostring(LocalPlayer.UserId):sub(2, 4) .. tostring(math.floor(serverTime % 10000))

    if type(v) == "table" and v[1] and v[1]:FindFirstChild("Head") then
        pcall(function()
            if ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterAttack") then
                ReplicatedStorage.Modules.Net["RE/RegisterAttack"]:FireServer(0)
            end
            r:FireServer(encoded, hitId, v[1].Head, {{ v[1], v[1].Head }, v[1]}, nil, comboTag)
            ReplicatedStorage.Modules.Net["RE/RegisterHit"]:FireServer(v[1].Head, {{ v[1], v[1].Head }, v[1]}, comboTag)
        end)
    elseif typeof(v) == "Instance" and v:FindFirstChild("Head") then
        pcall(function()
            if ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterAttack") then
                ReplicatedStorage.Modules.Net["RE/RegisterAttack"]:FireServer(0)
            end
            r:FireServer(encoded, hitId, v.Head, {{ v, v.Head }, v}, comboTag)
            ReplicatedStorage.Modules.Net["RE/RegisterHit"]:FireServer(v.Head, {{ v, v.Head }, v}, comboTag)
        end)
    end
end

