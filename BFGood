local KaitunCache = {
    Data = {},
    Time = {}
}

function KaitunCache:Get(key, fetchFunc, ttl)
    ttl = ttl or 10
    local now = os.clock()
    if self.Data[key] ~= nil and self.Time[key] and (now - self.Time[key] < ttl) then
        return self.Data[key]
    end
    local ok, val = pcall(fetchFunc)
    if ok and val ~= nil then
        self.Data[key] = val
        self.Time[key] = now
        return val
    end
    return self.Data[key]
end

function KaitunCache:Invalidate(key)
    self.Data[key] = nil
    self.Time[key] = nil
end

