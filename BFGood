local function CalculateGlobalUtilityScore(t, currentStage)
    if not t.feasible() then return -math.huge end

    local LP = game:GetService("Players").LocalPlayer
    local hrp = LP and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local dist = (hrp and t.pos) and (hrp.Position - t.pos).Magnitude or 0
    local travelCost = dist / math.max(1, AdaptiveStats.Data.travelSpeed)
    local switchCost = (t.id ~= Controller:Current()) and 25 or 0

    local totalCost = math.max(t.execTime + travelCost + switchCost, 1)
    local S_t = StageRelevance(t.stage, currentStage)
    local oppBonus = dist < 500 and 3.0 or (dist < 2000 and 1.5 or 1.0)

    local baseScore = (t.value * t.urgency * t.pSuccess * t.window * S_t) / totalCost
    local ageBonus = t.age * AGE_RATE
    local riskPenalty = t.risk or 0

    return (baseScore + ageBonus - riskPenalty) * oppBonus
end

