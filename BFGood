function NormalizeFruitName(str)
    if not str or type(str) ~= "string" then return "" end
    local base = string.split(str, "-")[1] or str
    base = string.gsub(base, "%s*Fruit$", "")
    return string.lower(string.gsub(base, "%s+", ""))
end

