-- Inventory / Tool Helper
local function IsOwn(name)
    if not name then return nil end
    if LocalPlayer.Backpack:FindFirstChild(name) then
        return LocalPlayer.Backpack:FindFirstChild(name)
    end
    local k
    if LocalPlayer.Character then
        for _, v in ipairs(LocalPlayer.Character:GetChildren()) do 
            if v:IsA("Tool") and v.Name == name then
                k = v
            end
        end
    end
    return k or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(name))
end

