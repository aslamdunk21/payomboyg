-- Safe Script Loading Helper
local function SafeLoadScript(url)
    local ok, content = pcall(function()
        return game:HttpGet(url)
    end)
    if not ok or not content or type(content) ~= "string" then
        warn("[PayomboyZ Loader Error]: Failed to fetch script from URL: " .. tostring(url))
        return false
    end
    if content:find("404: Not Found") or content:sub(1, 3) == "404" then
        warn("[PayomboyZ Loader Error]: Loader URL returned 404 Not Found: " .. tostring(url))
        return false
    end
    local func, err = loadstring(content)
    if not func then
        warn("[PayomboyZ Loader Error]: Syntax error during loader string parsing: " .. tostring(err))
        return false
    end
    pcall(func)
    return true
end

-- Server Browser Teleport
local function TeleportServer(cursor)
    cursor = cursor or ""
    local placeId = game.PlaceId
    local ok, data = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100&cursor=%s", tostring(placeId), tostring(cursor))))
    end)
    if not ok or not data or not data.data or #data.data == 0 then
        return false, ""
    end
    local chosenJobId = nil
    for _, server in ipairs(data.data) do
        if server.playing < server.maxPlayers then
            chosenJobId = server.id
            break
        end
    end
    if not chosenJobId and data.nextPageCursor then
        return TeleportServer(data.nextPageCursor)
    elseif not chosenJobId then
        return false, ""
    end
    local res = ReplicatedStorage.__ServerBrowser:InvokeServer("teleport", chosenJobId)
    return true, res
end

