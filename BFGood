                    end

                    local targets = {}
                    local selTarget = getgenv().Configs.TargetFruit or "Top 5 (Top Tier)"
                    local selList = {}
                    if type(selTarget) == "table" then
                        selList = selTarget
                    else
                        table.insert(selList, selTarget)
                    end

                    for _, item in ipairs(selList) do
                        if item == "Top 5 (Top Tier)" then
                            for _, topF in ipairs(Top5Priority) do
                                table.insert(targets, topF)
                            end
                        else
                            local clean = string.split(item, "-")[1] or item
                            table.insert(targets, clean)
                        end
                    end
                    FruitSystem.State.TargetPriority = targets

                    local foundAnyTargetInStock = false
                    for _, targetName in ipairs(targets) do
                        local normTarget = NormalizeFruitName(targetName)
                        for _, fruitData in pairs(stock) do
                            local rawName = fruitData.Name or fruitData.Value or fruitData.FruitName or ""
                            local price = tonumber(fruitData.Price) or 0
                            local normRaw = NormalizeFruitName(rawName)
                            local inStock = (fruitData.OnSale == true) or (fruitData.InStock == true)

                            if normRaw ~= "" and normRaw == normTarget and inStock then
                                foundAnyTargetInStock = true
                                FruitSystem.Stats.TargetFound = FruitSystem.Stats.TargetFound + 1
                                FruitSystem.State.Status = "🔥 TARGET FOUND"
                                FruitSystem:UpdateUI()
                                FruitLogManager:AddLog("STOCK", string.format((ObsidianGlassEngine.CurrentLanguage == "th" and "🔥 เจอผลเป้าหมายในร้าน: %s | ราคา: $%d" or "🔥 TARGET FOUND IN STOCK: %s | Price: $%d"), targetName, price), "FOUND")

                                if currentBeli - price >= reserve or not FruitSystem.Config.EnforceBeliReserve then
                                    FruitSystem.State.Status = "🛒 BUYING"
                                    FruitSystem:UpdateUI()
                                    FruitLogManager:AddLog("BUY", string.format("🛒 [BUY] Purchasing %s ($%d)...", rawName, price), "info")

                                    local boughtSuccess = false
                                    local beliBefore = LocalPlayer.Data.Beli.Value

                                    -- 3 Retries
                                    for attempt = 1, 3 do
                                        local buyResponse = nil
                                        local ok1 = pcall(function() buyResponse = CommF_:InvokeServer("PurchaseRawFruit", rawName) end)
                                        local beliAfter = LocalPlayer.Data and LocalPlayer.Data:FindFirstChild("Beli") and LocalPlayer.Data.Beli.Value or beliBefore

                                        if (ok1 and buyResponse == true) or buyResponse == 1 or (beliAfter < beliBefore) then
                                            boughtSuccess = true
                                            break
                                        end

                                        if ShopNetRF then
                                            local ok2 = pcall(function() buyResponse = ShopNetRF:InvokeServer("BuyFruit", rawName) end)
                                            beliAfter = LocalPlayer.Data and LocalPlayer.Data:FindFirstChild("Beli") and LocalPlayer.Data.Beli.Value or beliBefore
                                            if (ok2 and buyResponse == true) or buyResponse == 1 or (beliAfter < beliBefore) then
                                                boughtSuccess = true
                                                break
                                            end
                                        end
                                        task.wait(1)
                                    end

                                    local beliFinal = LocalPlayer.Data and LocalPlayer.Data:FindFirstChild("Beli") and LocalPlayer.Data.Beli.Value or beliBefore
                                    if boughtSuccess then
                                        FruitSystem.Stats.PurchaseSuccess = FruitSystem.Stats.PurchaseSuccess + 1
                                        FruitSystem.Stats.MoneySpent = FruitSystem.Stats.MoneySpent + price
                                        FruitLogManager:AddLog("BUY", string.format("✅ [BUY SUCCESS] %s Purchased! Beli Remaining: $%d", targetName, beliFinal), "BUY")

                                        -- RECEIVE Step
                                        FruitSystem.State.Status = "📦 VERIFYING"
                                        FruitSystem:UpdateUI()
                                        local fruitTool = nil
                                        local startWait = tick()
                                        while tick() - startWait < 5 do
                                            local bp = LocalPlayer:FindFirstChild("Backpack")
                                            local char = LocalPlayer.Character
                                            if bp then
                                                for _, item in ipairs(bp:GetChildren()) do
                                                    if NormalizeFruitName(item.Name) == normTarget then fruitTool = item break end
                                                end
                                            end
                                            if not fruitTool and char then
                                                for _, item in ipairs(char:GetChildren()) do
                                                    if item:IsA("Tool") and NormalizeFruitName(item.Name) == normTarget then fruitTool = item break end
                                                end
                                            end
                                            if fruitTool then break end
                                            task.wait(0.3)
                                        end

                                        if fruitTool then
                                            FruitLogManager:AddLog("STORE", string.format("✅ [RECEIVE SUCCESS] Found tool: %s", fruitTool.Name), "success")
                                            if getgenv().Configs.AutoStoreFruit then
                                                FruitSystem.State.Status = "💾 STORING"
                                                FruitSystem:UpdateUI()
                                                local storeOk = pcall(function() CommF_:InvokeServer("StoreFruit", fruitTool.Name, fruitTool) end)
                                                if storeOk then
                                                    FruitSystem.Stats.StoreSuccess = FruitSystem.Stats.StoreSuccess + 1
                                                    FruitLogManager:AddLog("STORE", string.format("✅ [STORE SUCCESS] %s Stored!", fruitTool.Name), "STORE")
                                                else
                                                    FruitSystem.Stats.StoreFailed = FruitSystem.Stats.StoreFailed + 1
                                                    FruitLogManager:AddLog("ERROR", string.format("❌ [STORE FAILED] StoreFruit remote failed for %s", fruitTool.Name), "FAIL")
                                                end
                                            end
                                        else
                                            FruitLogManager:AddLog("ERROR", string.format("❌ [RECEIVE FAILED] %s Tool not found in Backpack", targetName), "FAIL")
                                        end
                                        break
                                    else
                                        FruitSystem.Stats.PurchaseFailed = FruitSystem.Stats.PurchaseFailed + 1
                                        FruitLogManager:AddLog("ERROR", string.format("❌ [BUY FAILED] Remote purchase rejected after 3 attempts for %s", targetName), "FAIL")
                                    end
                                else
                                    FruitLogManager:AddLog("ERROR", string.format("❌ [BELI PROTECTION] Have $%d, Need $%d + $%d Reserve", currentBeli, price, reserve), "FAIL")
                                end
                            end
                        end
                    end

                    if stockChanged and not foundAnyTargetInStock then
                        FruitLogManager:AddLog("STOCK", string.format("Dealer Stock Updated: %d items on sale. No Target In Stock.", #stockHashParts), "info")
                    end
                else
                    FruitLogManager:AddLog("ERROR", "⚠️ Dealer Stock returned null response", "FAIL")
                end
                FruitSystem.State.Status = "🟢 MONITORING"
                FruitSystem:UpdateUI()
            end)
        end
    end
end)

