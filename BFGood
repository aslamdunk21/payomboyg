-- Main Single-Engine Farming Coroutine
task.spawn(function()
    while scriptRunning and task.wait() do
        if getgenv().Configs.AutoFarmLevel then
            DieWait()
            
            local FruitWhitelist = {
                ["kitsune"] = true, ["leopard"] = true, ["dragon"] = true, ["dough"] = true,
                ["t-rex"] = true, ["mammoth"] = true, ["venom"] = true, ["control"] = true,
                ["spirit"] = true, ["shadow"] = true, ["portal"] = true, ["buddha"] = true,
                ["blizzard"] = true, ["sound"] = true, ["rumble"] = true, ["magma"] = true, ["light"] = true
            }

            local function IsWhitelistedFruit(fruitName)
                if not fruitName then return false end
                local lowerName = string.lower(fruitName)
                for key in pairs(FruitWhitelist) do
                    if string.find(lowerName, key, 1, true) then
                        return true
                    end
                end
                return false
            end

            if getgenv().Configs.AutoStoreFruit then
                for _, v in workspace:GetChildren() do
                    if string.find(v.Name:lower(), "fruit") and v:IsA("Model") and v:FindFirstChild("Handle") then
                        local origName = v:GetAttribute("OriginalName") or v.Name
                        if IsWhitelistedFruit(origName) then
                            local inv = CommF_:InvokeServer("getInventory")
                            local doesnothave = true
                            if type(inv) == "table" then
                                for _, v1 in ipairs(inv) do
                                    if v1.Name == origName then
                                        doesnothave = false
                                        break
                                    end
                                end
                            end
                            if doesnothave and v and v:FindFirstChild("Handle") then
                                if (v.Handle.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude > 150 then
                                    local riyu = Tween(v.Handle.CFrame, 350)
                                    title.Text = "Get " .. v.Name
                                    if riyu then riyu.Completed:Wait() end
                                    task.wait(0.25)
                                elseif (v.Handle.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude <= 150 then
                                    SafeBypassCFrame(v.Handle.CFrame)
                                    title.Text = "Get " .. v.Name
                                    task.wait(0.1)
                                end
                            end
                        end
                    end
                end
                for _, v in LocalPlayer.Character:GetChildren() do
                    if string.find(v.Name:lower(), "fruit") and v:IsA("Tool") and v:FindFirstChild("Handle") then
                        local origName = v:GetAttribute("OriginalName") or v.Name
                        if IsWhitelistedFruit(origName) then
                            local inv = CommF_:InvokeServer("getInventory")
                            local doesnothave = true
                            if type(inv) == "table" then
                                for _, v1 in ipairs(inv) do
                                    if v1.Name == origName then
                                        doesnothave = false
                                        break
                                    end
                                end
                            end
                            if doesnothave and v then
                                CommF_:InvokeServer("StoreFruit", origName, v)
                            end
                        end
                    end
                end
                local bpStore = LocalPlayer:FindFirstChild("Backpack")
                if bpStore then
                    for _, v in bpStore:GetChildren() do
                        if string.find(v.Name:lower(), "fruit") and v:IsA("Tool") and v:FindFirstChild("Handle") then
                            local origName = v:GetAttribute("OriginalName") or v.Name
                            if IsWhitelistedFruit(origName) then
                                local inv = CommF_:InvokeServer("getInventory")
                                local doesnothave = true
                                if type(inv) == "table" then
                                    for _, v1 in ipairs(inv) do
                                        if v1.Name == origName then
                                            doesnothave = false
                                            break
                                        end
                                    end
                                end
                                if doesnothave and v then
                                    EquipName(v.Name)
                                    CommF_:InvokeServer("StoreFruit", origName, v)
                                end
                            end
                        end
                    end
                end
            end

            CheckQuest()
            local Quest = LocalPlayer.PlayerGui.Main.Quest
            local QuestTitle = Quest.Container.QuestTitle.Title
            local CurLevel = LocalPlayer.Data.Level.Value
            local CurMelee = nil
            local bpMelee = LocalPlayer:FindFirstChild("Backpack")
            if bpMelee then
                for _, v in bpMelee:GetChildren() do
                    if v:IsA("Tool") and v.ToolTip == "Melee" then
                        CurMelee = v.Name
                        break
                    end
                end
            end
            if not CurMelee and LocalPlayer.Character then
                for _, v in LocalPlayer.Character:GetChildren() do
                    if v:IsA("Tool") and v.ToolTip == "Melee" then
                        CurMelee = v.Name
                        break
                    end
                end
            end

            if getgenv().Configs.AutoBuyMelee and CurMelee then
                local curToolObj = IsOwn(CurMelee)
                local curMastery = (curToolObj and curToolObj:FindFirstChild("Level")) and tonumber(curToolObj.Level.Value) or 0
                local meleeData = Melees[CurMelee]
                
                if CurMelee == "Combat" or (meleeData and curMastery >= meleeData.RequiredMastery) then
                    -- Walk the ordered chain to find next melee to buy/train
                    for _, meleeName in ipairs(MeleeOrder) do
                        local v = Melees[meleeName]
                        if v.IsCompleted then
                            -- Already done, skip
                        elseif GetWorld() < v.World then
                            -- Can't reach this world yet, mark done so we skip it
                            v.IsCompleted = true
                        else
                            -- Check if we already own this melee
                            local alreadyOwned = false
                            pcall(function()
                                alreadyOwned = (CommF_:InvokeServer(v.BuyID, true) == 1)
                            end)
                            
                            if alreadyOwned then
                                -- Already bought: equip it, check mastery
                                local tmelee
                                local npcRef = (workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild(v.NPC))
                                    or (ReplicatedStorage:FindFirstChild("NPCs") and ReplicatedStorage.NPCs:FindFirstChild(v.NPC))
                                if npcRef and npcRef:FindFirstChild("HumanoidRootPart") then
                                    tmelee = Tween(npcRef.HumanoidRootPart.CFrame, 350)
                                end
                                if tmelee then
                                    title.Text = "Switching to " .. meleeName
                                    tmelee.Completed:Wait()
                                end
                                pcall(function() CommF_:InvokeServer(v.BuyID) end)
                                -- Check mastery on this melee
                                local targetTool = IsOwn(meleeName)
                                local targetMastery = (targetTool and targetTool:FindFirstChild("Level")) and tonumber(targetTool.Level.Value) or 0
                                if targetMastery >= v.RequiredMastery then
                                    v.IsCompleted = true
                                else
                                    subtitle.Text = "Farming " .. meleeName .. " Mastery " .. targetMastery .. "/" .. v.RequiredMastery
                                    break
                                end
                            else
                                -- Not owned yet: check if we can afford it
                                local hasBeli = LocalPlayer.Data.Beli.Value >= v.Price.Beli
                                local hasFrags = true
                                if v.Price.Fragments > 0 then
                                    hasFrags = LocalPlayer.Data.Fragments.Value >= v.Price.Fragments
                                end
                                if hasBeli and hasFrags then
                                    -- Go buy it
                                    local npcRef = (workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild(v.NPC))
                                        or (ReplicatedStorage:FindFirstChild("NPCs") and ReplicatedStorage.NPCs:FindFirstChild(v.NPC))
                                    if npcRef and npcRef:FindFirstChild("HumanoidRootPart") then
                                        local tmelee = Tween(npcRef.HumanoidRootPart.CFrame, 350)
                                        if tmelee then
                                            title.Text = "Buying " .. meleeName
                                            tmelee.Completed:Wait()
                                        end
                                    end
                                    pcall(function() CommF_:InvokeServer(v.BuyID) end)
                                    break
                                else
                                    subtitle.Text = "Need Resources: " .. meleeName .. " ($" .. v.Price.Beli .. " / " .. v.Price.Fragments .. " Frags)"
                                    break
                                end
                            end
                        end
                    end
                else
                    if meleeData then
