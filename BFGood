local function TierBottleneck(tier, fragCount, awakenAccumSec)
    local tierCosts = { 1000, 1500, 2250, 3000, 3750, 4500, 5250, 5500 }
    local tierTimes = { 300, 600, 900, 1200, 1500, 1800, 2100, 2400 }

    local targetCost = tierCosts[tier] or 3000
    local targetTime = tierTimes[tier] or 1200

    local needTime = math.max(0, targetTime - awakenAccumSec)
    local needFrag = math.max(0, targetCost - fragCount)

    local etaTime = needTime / 0.4 -- 40% awakening uptime ratio
    local etaFrag = (needFrag / 5000) * 3600 -- 5000 frags / hr rate

    if etaTime > etaFrag then
        return "TIME", "⚡ Focus Energy Mobs (Accelerate Awakening)"
    else
        return "FRAG", "💰 Focus Raids / Chips (Maximize Frag/hr)"
    end
end

