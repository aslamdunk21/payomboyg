    if self.Owner == nil or priority > self.Priority or self.Owner == name then
        if self.Owner and self.Owner ~= name and self.Modules[self.Owner] and self.Modules[self.Owner].Suspend then
            pcall(function() self.Modules[self.Owner]:Suspend() end)
        end
        if self.Owner ~= name then
