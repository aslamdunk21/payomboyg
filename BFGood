-- 🧠 Phase 1: AccountScanner (Full Profile State Analyzer)
local AccountScanner = {
    LastScanTime = 0,
    AccountState = {
        Level = 1,
        Sea = 1,
        Beli = 0,
        Fragments = 0,
        EquippedFruit = "None",
        FruitMastery = 0,
        SelectStyle = "Combat",
        UnlockedSaber = false,
        UnlockedBartilo = false,
        CanUnlockSea2 = false,
        CanUnlockSea3 = false,
        CanUnlockGodhuman = false,
        MissingBeli = 0,
        MissingFragments = 0,
        RecommendedGoal = "LEVEL_FARM"
    }
}

function AccountScanner:Scan()
    local data = LP:FindFirstChild("Data")
    if not data then return self.AccountState end

    local state = self.AccountState
    state.Level = data:FindFirstChild("Level") and data.Level.Value or 1
    state.Beli = data:FindFirstChild("Beli") and data.Beli.Value or 0
    state.Fragments = data:FindFirstChild("Fragments") and data.Fragments.Value or 0

    local pId = game.PlaceId
    state.Sea = (pId == 2753915549 and 1 or pId == 4442272183 and 2 or 3)

    -- Check Saber
    if getgenv().IsSaber ~= nil then state.UnlockedSaber = getgenv().IsSaber end

    -- Progression Checks
    if state.Level >= 700 and state.Sea == 1 then
        state.CanUnlockSea2 = true
        state.RecommendedGoal = "SEA_PROGRESSION_SEA2"
    elseif state.Level >= 1500 and state.Sea == 2 then
        state.CanUnlockSea3 = true
        state.RecommendedGoal = "SEA_PROGRESSION_SEA3"
    elseif state.Level >= 200 and not state.UnlockedSaber and state.Sea == 1 then
        state.RecommendedGoal = "UNLOCK_SABER"
    elseif state.Level >= 1500 and state.Beli >= 5000000 and state.Fragments >= 5000 then
        state.CanUnlockGodhuman = true
        state.RecommendedGoal = "UNLOCK_GODHUMAN"
    else
        state.RecommendedGoal = "LEVEL_FARM"
    end

    self.LastScanTime = os.clock()
    return state
end

-- 🧠 Phase 2: Goal Dependency System
local GoalDependencyEngine = {}
function GoalDependencyEngine:ResolveDependencies(goalName)
    local state = AccountScanner:Scan()
    local deps = {
        Goal = goalName,
        Ready = false,
        Missing = {}
    }

    if goalName == "Godhuman" then
        if state.Level < 1500 then table.insert(deps.Missing, "Level 1500+") end
        if state.Beli < 5000000 then table.insert(deps.Missing, string.format("Beli: %d / 5,000,000", state.Beli)) end
        if state.Fragments < 5000 then table.insert(deps.Missing, string.format("Fragments: %d / 5,000", state.Fragments)) end
        if #deps.Missing == 0 then deps.Ready = true end
    elseif goalName == "Sea2_Transition" then
        if state.Level < 700 then table.insert(deps.Missing, "Level 700+") end
        if #deps.Missing == 0 then deps.Ready = true end
    elseif goalName == "Sea3_Transition" then
        if state.Level < 1500 then table.insert(deps.Missing, "Level 1500+") end
        if #deps.Missing == 0 then deps.Ready = true end
    else
        deps.Ready = true
    end

    return deps
end

