local function IsOwn(name)
    if not name then return nil end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp and bp:FindFirstChild(name) then
        return bp:FindFirstChild(name)
    end
    local k
    if LocalPlayer.Character then
        for _, v in ipairs(LocalPlayer.Character:GetChildren()) do 
            if v:IsA("Tool") and v.Name == name then
                k = v
            end
        end
    end
    return k or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(name))
end

local function EquipWeapon(type)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") then return end
    for _, v in pairs(LocalPlayer.Character:GetChildren()) do
        if v:IsA("Tool") and v.ToolTip == type then
            return
        end
    end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not bp then return end
    for _, v in pairs(bp:GetChildren()) do
        if v:IsA("Tool") and v.ToolTip == type then
            LocalPlayer.Character.Humanoid:EquipTool(v)
            break
        end
    end
end

local function EquipName(toolName)
