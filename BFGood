-- ============================================================
local ConnectionManager = {
    Connections = {},
    Threads = {}
}

function ConnectionManager:Add(conn)
    if conn then
        table.insert(self.Connections, conn)
    end
    return conn
end

function ConnectionManager:Spawn(func)
    local thread = task.spawn(function()
        pcall(func)
    end)
    table.insert(self.Threads, thread)
    return thread
end

function ConnectionManager:Cleanup()
    getgenv().scriptRunning = false
    for _, conn in ipairs(self.Connections) do
        pcall(function()
            if conn and conn.Connected then
                conn:Disconnect()
            end
        end)
    end
    table.clear(self.Connections)

    for _, th in ipairs(self.Threads) do
        pcall(function()
            if th then
                task.cancel(th)
            end
        end)
    end
    table.clear(self.Threads)
end

if getgenv().PayomboyZ_CleanUp then
    pcall(getgenv().PayomboyZ_CleanUp)
end
getgenv().PayomboyZ_CleanUp = function()
    ConnectionManager:Cleanup()
end

