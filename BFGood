local function SmartMoveAndAttack(mainMob, QuestTitle, Quest, IsCheckQuest, CustomName)
    if IsCheckQuest == nil then IsCheckQuest = true end
    CustomName = CustomName or NameCheckQuest
    pcall(sethiddenproperty, LocalPlayer, "SimulationRadius", math.huge)
    
    if not mainMob or not mainMob.Parent or not mainMob:FindFirstChild("Humanoid") or not mainMob:FindFirstChild("HumanoidRootPart") then
        return false
    end

    local humanoid = mainMob.Humanoid
    local hrp = mainMob.HumanoidRootPart
    humanoid.JumpPower = 0
    humanoid.WalkSpeed = 0
    hrp.CanCollide = false
    
    if getgenv().Configs.BringMob then
        local bv = hrp:FindFirstChild("BringVelocity")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "BringVelocity"
            bv.MaxForce = Vector3.new(100000, 100000, 100000)
            bv.Parent = hrp
        end
        bv.Velocity = Vector3.zero
    end

    local secondMob = nil
    local tween = nil

    repeat task.wait()
        title.Text = "Status: Kill " .. mainMob.Name
        if mobHpLabel and humanoid then
            pcall(function()
                mobHpLabel.Text = string.format("Mob HP: %d / %d", math.floor(humanoid.Health), math.floor(humanoid.MaxHealth))
            end)
        end
        
        if not secondMob and getgenv().Configs.BringMob then
            secondMob = GetNearestMob(mainMob, 350)
        end
        if secondMob and secondMob.Parent and secondMob:FindFirstChild("Humanoid") and secondMob.Humanoid.Health > 0 and secondMob:FindFirstChild("HumanoidRootPart") then
            secondMob.HumanoidRootPart.CFrame = hrp.CFrame
            secondMob.Humanoid.JumpPower = 0
            secondMob.Humanoid.WalkSpeed = 0
            secondMob.HumanoidRootPart.CanCollide = false
            local bv2 = secondMob.HumanoidRootPart:FindFirstChild("BringVelocity")
            if not bv2 then
                bv2 = Instance.new("BodyVelocity")
                bv2.Name = "BringVelocity"
                bv2.MaxForce = Vector3.new(100000, 100000, 100000)
                bv2.Parent = secondMob.HumanoidRootPart
            end
            bv2.Velocity = Vector3.zero
        else
            secondMob = nil
        end

        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHRP then break end

        local targetPos = hrp.Position + Vector3.new(0, 7.5, 0)
        local distance = (myHRP.Position - hrp.Position).Magnitude

        if distance > 45 then
            if not tween or tween.PlaybackState ~= Enum.PlaybackState.Playing then
                tween = Tween(CFrame.lookAt(targetPos, hrp.Position), 150)
            end
        else
            if tween then
                tween:Cancel()
                tween = nil
            end
            
            EquipWeapon(getgenv().Configs.SelectWeapon or "Melee")
            AutoSkillUse()
            myHRP.CFrame = CFrame.lookAt(targetPos, hrp.Position)

            -- บินถึงมอนแล้วตีทันทีต่อเนื่อง
            if secondMob then
                Attack({mainMob, secondMob})
            else
                Attack(mainMob)
            end
        end
    until not mainMob 
        or not mainMob.Parent 
        or not mainMob:FindFirstChild("Humanoid") 
        or (mainMob.Humanoid.Health <= 0) 
        or not getgenv().Configs.AutoFarmLevel

    if tween then
        tween:Cancel()
        tween = nil
    end

    return humanoid.Health <= 0
end

