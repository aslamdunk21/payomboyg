local function FindFlower(color)
    local LP = game:GetService("Players").LocalPlayer
    local hrp = LP and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local hrpPos = hrp and hrp.Position or Vector3.zero

    -- 1) Live Workspace Scan (Search for spawned flower objects in workspace)
    local targetNames = {
        Red = { "Flower1", "Red Flower", "RedFlower" },
        Blue = { "Flower2", "Blue Flower", "BlueFlower" },
        Yellow = { "Flower3", "Yellow Flower", "YellowFlower" }
    }
    
    local searchList = targetNames[color] or { color .. "Flower" }
    local foundPos = nil
    local shortestDist = math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        for _, name in ipairs(searchList) do
            if obj.Name == name and (obj:IsA("BasePart") or obj:IsA("Model")) then
                local p = obj:IsA("BasePart") and obj.Position or (obj:FindFirstChild("Handle") and obj.Handle.Position or (obj.PrimaryPart and obj.PrimaryPart.Position))
                if p then
                    local d = (hrpPos - p).Magnitude
                    if d < shortestDist then
                        shortestDist = d
                        foundPos = p
                    end
                end
            end
        end
    end

    if foundPos then return foundPos, true end -- Live flower found!

    -- 2) Fallback Route: Nearest Unvisited Known Spawn Point
    local spawnSets = {
        Red = RED_FLOWER_POSITIONS,
        Blue = BLUE_FLOWER_POSITIONS
    }

    local list = spawnSets[color] or {}
    local bestPoint = nil
    local minDist = math.huge

    for _, spawnPos in ipairs(list) do
        local d = (hrpPos - spawnPos).Magnitude
        if d < minDist then
            minDist = d
            bestPoint = spawnPos
        end
    end

    return bestPoint or Vector3.new(1250, 40, -5100), false
end

