-- Safe Checkpoint Teleport Engine (Bypasses Anti-CFrame rubberbanding for short/medium steps)
local function SafeBypassCFrame(targetCFrame)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    if dist <= 5 then
        hrp.CFrame = targetCFrame
        return
    end

    local CHECKPOINT_STEP = 120
    local steps = math.max(1, math.floor(dist / CHECKPOINT_STEP))
    local startPos = hrp.Position
    local endPos = targetCFrame.Position
    local dirVector = (endPos - startPos).Unit

    for i = 1, steps do
        if not scriptRunning or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then break end
        local curHRP = LocalPlayer.Character.HumanoidRootPart
        local alpha = i / steps
        local stepPos = startPos:Lerp(endPos, alpha)
        
        curHRP.CFrame = CFrame.new(stepPos, endPos)
        curHRP.AssemblyLinearVelocity = dirVector * 150
        task.wait(0.02)
    end

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = targetCFrame
        LocalPlayer.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
    end
end

local function Tween(target, speed)
    speed = speed or 150
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local distance = (hrp.Position - target.Position).Magnitude
    if distance <= 15 then
        if CurrentActiveTween then
            pcall(function() CurrentActiveTween:Cancel() end)
            CurrentActiveTween = nil
        end
        IsTweening = false
        FlightVelocity = Vector3.zero
        hrp.CFrame = target
        return nil
    end

    -- Reuse existing playing tween if target is unchanged
    if CurrentActiveTween and LastTargetPos and (LastTargetPos.Position - target.Position).Magnitude < 10 then
        if CurrentActiveTween.PlaybackState == Enum.PlaybackState.Playing then
            IsTweening = true
            return CurrentActiveTween
        end
    end

    if CurrentActiveTween then
        pcall(function() CurrentActiveTween:Cancel() end)
        CurrentActiveTween = nil
    end

    LastTargetPos = target
    FlightVelocity = (target.Position - hrp.Position).Unit * speed

    local tweenInfo = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = target})
    CurrentActiveTween = tween
    IsTweening = true
    tween:Play()

    task.spawn(function()
        while tween and tween.PlaybackState == Enum.PlaybackState.Playing do
            IsTweening = true
            local curHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if curHRP then
                FlightVelocity = (target.Position - curHRP.Position).Unit * speed
            end
            task.wait(0.05)
        end
        if CurrentActiveTween == tween then
            IsTweening = false
            FlightVelocity = Vector3.zero
            CurrentActiveTween = nil
        end
    end)
    return tween
end

