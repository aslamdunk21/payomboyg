function ProgressionEngine:Evaluate()
    WorldState:Update()
    local lvl = WorldState.Level
    local curSea = WorldState.Sea

    -- 1. Check Max Level Mode (M16)
    if lvl >= MaxLevel then
        self.CurrentStage = "ENDGAME_MODE"
        return {
            Mark = "M16",
            Priority = "P9",
            Objective = "ENDGAME_MODE",
            Reason = "Max Level 2800 Reached — Kaitun Level Farm OFF, Endgame Mode ON",
            IsMax = true
        }
    end

    -- 2. Find Active Level Mark
    local activeMark = nil
    for _, m in ipairs(ProgressionMarks) do
        if lvl >= m.MinLvl and lvl <= m.MaxLvl then
            activeMark = m
            break
        end
    end
    if not activeMark then activeMark = ProgressionMarks[#ProgressionMarks - 1] end
    self.CurrentMark = activeMark

    -- 3. Multi-Dimensional Mark Check: Mandatory Sea Transitions & Pre-requisites
    if lvl >= 700 and curSea == 1 then
        return {
            Mark = "M06",
            Priority = "P1",
            Objective = "SEA_TRANSITION",
            Reason = "Level >= 700: Mandatory Second Sea Transition (Dressrosa Quest)",
            IsTransition = true
        }
    end

    if lvl >= 1500 and curSea == 2 then
        local bartiloProg = CommF_:InvokeServer("BartiloQuestProgress", "Bartilo")
        
        if bartiloProg ~= 3 then
            return {
                Mark = "M09",
                Priority = "P2",
                Objective = "MANDATORY_PROGRESSION",
                Reason = "Level >= 1500: Complete Bartilo Quest before Sea 3 Transition",
                IsMandatory = true
            }
        else
            return {
                Mark = "M10",
                Priority = "P1",
                Objective = "SEA_TRANSITION",
                Reason = "Level >= 1500: Mandatory Third Sea Transition (Rip Indra / Trevor)",
                IsTransition = true
            }
        end
    end

    -- 4. Default Level Farm Evaluation
    return {
        Mark = activeMark.Mark,
        Priority = "P4",
        Objective = activeMark.Primary,
        Secondary = activeMark.Secondary,
        Reason = string.format("[%s] %s", activeMark.Mark, activeMark.Description)
    }
end

