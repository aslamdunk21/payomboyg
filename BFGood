function DynamicMobPackEngine:EvaluatePackSize(playerHpPct, currentFps)
    local cfg = AggressiveFarmMode:GetConfig()
    local maxLimit = cfg.MaxPackSize

    if playerHpPct < 40 or (currentFps and currentFps < 25) then
        self.CurrentPackSize = math.max(4, self.CurrentPackSize - 2)
    elseif playerHpPct > 80 and (not currentFps or currentFps > 45) then
        self.CurrentPackSize = math.min(maxLimit, self.CurrentPackSize + 1)
    end

    self.RecommendedPackSize = math.min(maxLimit, self.CurrentPackSize + 3)
    self.MaxSafePackSize = maxLimit
    return self.CurrentPackSize
end

-- 🧠 5. Adaptive Farming AI & PPM (Progress Per Minute) Optimizer
local AdaptiveFarmingAI = {
    WeaponStats = {}, -- [WeaponName] = { Kills = 0, TimeSpent = 0, PPM = 0 }
    CurrentWeaponName = "Melee"
}

function AdaptiveFarmingAI:RecordKill(weaponName, timeSpentSecs)
    if not self.WeaponStats[weaponName] then
        self.WeaponStats[weaponName] = { Kills = 0, TimeSpent = 0, PPM = 0 }
    end
    local st = self.WeaponStats[weaponName]
    st.Kills = st.Kills + 1
    st.TimeSpent = st.TimeSpent + math.max(0.1, timeSpentSecs)
    st.PPM = (st.Kills / st.TimeSpent) * 60
end

function AdaptiveFarmingAI:GetBestWeapon()
    local bestName = nil
    local maxPPM = -1
    for wName, st in pairs(self.WeaponStats) do
        if st.PPM > maxPPM then
            maxPPM = st.PPM
            bestName = wName
        end
