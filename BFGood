    statusTextLabel.Text = string.format(
        "Status: %s | Target: %s\nLast Scan: %s | Next Scan: %ds\n\n💰 BELI PROTECTION\nCurrent: $%s | Reserve: $%s | Available: $%s\n\n📊 STATISTICS COUNTER\nScans: %d | Found: %d | Buy OK: %d | Buy Fail: %d | Store OK: %d | Store Fail: %d",
        FruitSystem.State.Status,
        getgenv().Configs.TargetFruit or "Top 5 (Top Tier)",
        FruitSystem.State.LastScanTime,
        FruitSystem.State.NextScanCountdown,
        string.format("%d", curBeli),
        string.format("%d", reserve),
        string.format("%d", avail),
        FruitSystem.Stats.StockScans,
        FruitSystem.Stats.TargetFound,
        FruitSystem.Stats.PurchaseSuccess,
        FruitSystem.Stats.PurchaseFailed,
        FruitSystem.Stats.StoreSuccess,
        FruitSystem.Stats.StoreFailed
    )

    if #FruitSystem.State.CurrentStock > 0 then
        local stockStr = "DEALER STOCK: "
        for idx, item in ipairs(FruitSystem.State.CurrentStock) do
            if idx <= 6 then
                stockStr = stockStr .. string.format("%s (%s)  ", item.name, item.inStock and "✅" or "❌")
            end
        end
        local prioStr = "🎯 TARGET PRIORITY: " .. table.concat(FruitSystem.State.TargetPriority, " > ")
        stockTextLabel.Text = stockStr .. "\n\n" .. prioStr
    end
end

