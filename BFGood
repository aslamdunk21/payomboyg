local function EquipWeapon(type)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") then return end
    local targetToolName = ""
    for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do
        if v:IsA("Tool") and v.ToolTip == type then
            targetToolName = v.Name
            break
        end
    end
    for _, v in pairs(LocalPlayer.Character:GetChildren()) do
        if v:IsA("Tool") and v.ToolTip == type then
            targetToolName = v.Name
            break
        end
    end
    if targetToolName ~= "" and LocalPlayer.Backpack:FindFirstChild(targetToolName) then
        local tool = LocalPlayer.Backpack:FindFirstChild(targetToolName)
        task.wait()
        LocalPlayer.Character.Humanoid:EquipTool(tool)
    end
end

