local function GetWorld()
    if World1 then return 1
    elseif World2 then return 2
    elseif World3 then return 3
    end
    
    -- Fail-safe Level Fallback for Private Servers / Reserved Places
    local data = LocalPlayer:FindFirstChild("Data")
    local lvl = data and data:FindFirstChild("Level") and data.Level.Value or 1
    if lvl >= 1500 then
        World3 = true
        return 3
    elseif lvl >= 700 then
        World2 = true
        return 2
    else
        World1 = true
        return 1
    end
end

local WorldState = {
    Level = 1,
    Sea = 1,
    HRP = nil,
    Char = nil,
    LastUpdate = 0
}

function WorldState:Update()
    local char = LocalPlayer.Character
    self.Char = char
    self.HRP = char and char:FindFirstChild("HumanoidRootPart")
    local data = LocalPlayer:FindFirstChild("Data")
    self.Level = data and data:FindFirstChild("Level") and data.Level.Value or 1
    self.Sea = GetWorld()
    self.LastUpdate = os.clock()
    return self
end

