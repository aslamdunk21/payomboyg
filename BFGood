-- Safe Parent GUI Resolver (Supports All Executors & Prevents CoreGui Capability Errors)
local function GetSafeParentGui()
    local success, result = pcall(function()
        if typeof(gethui) == "function" then
            local h = gethui()
            if h and typeof(h) == "Instance" then return h end
        end
        local core = game:GetService("CoreGui")
        local testObj = Instance.new("Folder")
        testObj.Parent = core
        testObj:Destroy()
        return core
    end)
    if success and result then
        return result
    end
    return LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
end

-- Destroy Existing UI Elements across all potential parents
local function DestroyExistingUI(uiName)
    pcall(function()
        if typeof(gethui) == "function" then
            local h = gethui()
            if h and h:FindFirstChild(uiName) then h[uiName]:Destroy() end
        end
        local core = game:GetService("CoreGui")
        if core and core:FindFirstChild(uiName) then core[uiName]:Destroy() end
        if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild(uiName) then
            LocalPlayer.PlayerGui[uiName]:Destroy()
        end
    end)
end

-- Safe Script Loading Helper (Prevents 404 syntax errors)
local function SafeLoadScript(url)
    local ok, content = pcall(function()
        return game:HttpGet(url)
    end)
    if not ok or not content or type(content) ~= "string" then
        warn("[PayomboyZ Loader Error]: Failed to fetch script from URL: " .. tostring(url))
        return false
    end
    if content:find("404: Not Found") or content:sub(1, 3) == "404" then
        warn("[PayomboyZ Loader Error]: Loader URL returned 404 Not Found: " .. tostring(url))
        return false
    end
    local func, err = loadstring(content)
    if not func then
        warn("[PayomboyZ Loader Error]: Syntax error during loader string parsing: " .. tostring(err))
        return false
    end
    pcall(func)
    return true
end

-- Server Browser Teleport (From LogicMain.txt)
local function TeleportServer(cursor)
    cursor = cursor or ""
    local placeId = game.PlaceId
    local ok, data = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100&cursor=%s", tostring(placeId), tostring(cursor))))
    end)
    if not ok or not data or not data.data or #data.data == 0 then
        return false, ""
    end
    local chosenJobId = nil
    for _, server in ipairs(data.data) do
        if server.playing < server.maxPlayers then
            chosenJobId = server.id
            break
        end
    end
    if not chosenJobId and data.nextPageCursor then
        return TeleportServer(data.nextPageCursor)
    elseif not chosenJobId then
        return false, ""
    end
    local res = ReplicatedStorage.__ServerBrowser:InvokeServer("teleport", chosenJobId)
    return true, res
end

-- Movement & Tween System (From LogicMain.txt)
local IsTweening = false
local function Tween(target, speed)
    speed = speed or 350
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local closestEntrance = nil
    local minEntranceDist = math.huge
    for _, entrancePos in ipairs(Entrance) do
        local dist = (entrancePos - target.Position).Magnitude
        if dist < minEntranceDist then
            minEntranceDist = dist
            closestEntrance = entrancePos
        end
    end
    if not hrp:FindFirstChild("fixvelo") then
        local fixvelo = Instance.new("BodyVelocity")
        fixvelo.Name = "fixvelo"
        fixvelo.MaxForce = Vector3.new(0, 100000, 0)
        fixvelo.Velocity = Vector3.zero
        fixvelo.Parent = hrp
    end
    if closestEntrance and minEntranceDist < (hrp.Position - target.Position).Magnitude then
        IsTweening = true
        pcall(function() CommF_:InvokeServer("requestEntrance", closestEntrance) end)
    end
    local distance = (hrp.Position - target.Position).Magnitude
    local tweenInfo = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = target})
    tween:Play()
    task.spawn(function()
        while tween and tween.PlaybackState == Enum.PlaybackState.Playing do
            IsTweening = true
            task.wait()
        end
        IsTweening = false
    end)
    return tween
end

