-- ── 9a. GOD-TIER SYSTEM 1: Enemy Cooldown Telemetry ──────────────────────────
local EnemyCooldownTracker = {}

local function trackEnemySkillUse(userId, skillType, duration)
    if not userId then return end
    EnemyCooldownTracker[userId] = EnemyCooldownTracker[userId] or {}
    EnemyCooldownTracker[userId][skillType] = os.clock() + (duration or 4.0)
end

local function isEnemySkillOnCD(userId, skillType)
    if not userId or not EnemyCooldownTracker[userId] then return false end
    local expTime = EnemyCooldownTracker[userId][skillType]
