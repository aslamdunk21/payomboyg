if _G.GakuranCleanup then
    pcall(_G.GakuranCleanup)
end

local cleanupTasks = {}
local function registerCleanup(item)
    table.insert(cleanupTasks, item)
end

_G.GakuranCleanup = function()
    for _, item in ipairs(cleanupTasks) do
        if type(item) == "table" and item.Disconnect then
            pcall(function() item:Disconnect() end)
        elseif type(item) == "thread" then
            pcall(function() task.cancel(item) end)
        elseif type(item) == "userdata" and item.Destroy then
            pcall(function() item:Destroy() end)
        end
    end
    cleanupTasks = {}
end

