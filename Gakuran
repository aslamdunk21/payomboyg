-- ── 9b. GOD-TIER SYSTEM 2: Frame Advantage & Startup Counter Engine ────────────
local function analyzeTrackPhase(track)
    if not track or not track.IsPlaying or track.Length <= 0 then
        return "UNKNOWN", 0
    end
    local progress = track.TimePosition / track.Length
    if progress < 0.28 then
        return "STARTUP", progress  -- Prime counter-hit interrupt window!
    elseif progress <= 0.65 then
        return "ACTIVE", progress   -- Active hitbox: Must Parry or Dodge!
    else
        return "RECOVERY", progress -- Punish window!
    end
end

-- ── 9c. GOD-TIER SYSTEM 3: Raycast Environment & Corner Trapping ──────────────
local wallRayParams = RaycastParams.new()
wallRayParams.FilterType = Enum.RaycastFilterType.Exclude

local function evalEnvironmentHazards(myHRP, enemyHRP)
    local myChar = LocalPlayer.Character
    if not myChar or not myHRP then
        return { myBackWall = false, enemyCornered = false }
    end

    local ignoreList = {myChar}
    if enemyHRP and enemyHRP.Parent then
        table.insert(ignoreList, enemyHRP.Parent)
    end
    wallRayParams.FilterDescendantsInstances = ignoreList

    local myPos = myHRP.Position + Vector3.new(0, 1, 0)
    local myBackDir = -myHRP.CFrame.LookVector
    local rayMyBack = Workspace:Raycast(myPos, myBackDir * 4.5, wallRayParams)
    local myBackWall = (rayMyBack ~= nil)

    local enemyCornered = false
    if enemyHRP then
        local ePos = enemyHRP.Position + Vector3.new(0, 1, 0)
        local eLook = enemyHRP.CFrame.LookVector
        local rayEBack  = Workspace:Raycast(ePos, -eLook * 4.0, wallRayParams)
        local rayELeft  = Workspace:Raycast(ePos, -enemyHRP.CFrame.RightVector * 3.5, wallRayParams)
        local rayERight = Workspace:Raycast(ePos, enemyHRP.CFrame.RightVector * 3.5, wallRayParams)

        if rayEBack and (rayELeft or rayERight) then
            enemyCornered = true
        end
    end

    return {
        myBackWall = myBackWall,
        enemyCornered = enemyCornered
    }
end

-- ── 9d. Enemy State Reader (Enhanced with Telemetry) ───────────────────────────
local function readEnemyState(enemyChar)
    if not enemyChar then return nil end
    local hrp = enemyChar:FindFirstChild("HumanoidRootPart")
    local hum = enemyChar:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return nil end
    local hp = hum.Health
    local maxHp = hum.MaxHealth
    local blocking  = enemyChar:GetAttribute("Blocking") == true
    local stunned   = enemyChar:GetAttribute("Stunned") == true
    local ragdoll   = enemyChar:GetAttribute("Ragdoll") == true
    local downed    = enemyChar:GetAttribute("Downed") == true
    local grappling = enemyChar:GetAttribute("Grappling") == true
    local guardBroken = enemyChar:GetAttribute("GuardBroken") == true
    local evasiveCD = enemyChar:GetAttribute("EvasiveCooldown") == true
    local m2CD      = enemyChar:GetAttribute("M2Cooldown") == true

    local plr = Players:GetPlayerFromCharacter(enemyChar)
    local telemetryNoDodge = (plr and isEnemySkillOnCD(plr.UserId, "Evasive")) or evasiveCD

    return {
        HRP = hrp, Humanoid = hum, Char = enemyChar, Player = plr,
        HP = hp, MaxHP = maxHp, HPRatio = (maxHp > 0) and (hp / maxHp) or 1,
        Blocking = blocking, Stunned = stunned, Ragdoll = ragdoll,
        Downed = downed, Grappling = grappling, GuardBroken = guardBroken,
        EvasiveCD = telemetryNoDodge, M2CD = m2CD,
        IsDisabled = (stunned or ragdoll or downed or guardBroken),
    }
end

-- ── 9e. Threat Scoring (multi-target priority) ────────────────────────────────
local function scoreThreat(myHRP, plr)
    local char = plr.Character
    local state = readEnemyState(char)
    if not state or not state.HRP then return -999 end
    local dist = (myHRP.Position - state.HRP.Position).Magnitude
    if dist > 25 then return -999 end
    if state.Downed or state.Ragdoll then return -500 end

    local score = 100 - dist * 3              -- closer = higher threat
    if state.Blocking then score = score - 15 end
    if state.Stunned or state.GuardBroken then score = score + 30 end -- free hit
    if state.HPRatio < 0.3 then score = score + 20 end               -- finish low HP
    if state.Grappling then score = score - 40 end

    local toMe = (myHRP.Position - state.HRP.Position)
    if toMe.Magnitude > 0.5 then
        local dot = state.HRP.CFrame.LookVector:Dot(toMe.Unit)
        if dot > 0.6 then score = score + 25 end -- facing us = high threat
    end
    return score
end

local function getThreatsRanked(myHRP, maxCount)
    maxCount = maxCount or 5
    local threats = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local sc = scoreThreat(myHRP, plr)
        if sc > -500 then
            table.insert(threats, {Player = plr, Score = sc})
        end
    end
    table.sort(threats, function(a, b) return a.Score > b.Score end)
    if #threats > maxCount then
        for i = #threats, maxCount + 1, -1 do threats[i] = nil end
    end
    return threats
end

-- ── 9f. Distance Zone Classification ──────────────────────────────────────────
local ZONE_MELEE   = 6.0   -- close enough to M1
local ZONE_GRAPPLE = 10.0  -- M2 range
local ZONE_MID     = 16.0  -- approach zone
local ZONE_FAR     = 25.0  -- disengage

local function getZone(dist)
    if dist <= ZONE_MELEE   then return "MELEE"   end
    if dist <= ZONE_GRAPPLE then return "GRAPPLE" end
    if dist <= ZONE_MID     then return "MID"     end
    return "FAR"
end

-- ── 9g. GOD-TIER SYSTEM 4: Smart Attack & Parry Bait Decision ────────────────
-- Returns: "M1", "M2", "FEINT", "WAIT", "NONE"
local function decideAttack(myChar, enemyState, dist, zone, multiCount)
    if not canAttack(myChar) then return "NONE" end
    if myChar:GetAttribute("Grappling") == true then return "NONE" end

    -- enemy is disabled → free hit
    if enemyState.IsDisabled then
        if zone == "MELEE" then return "M1" end
        if zone == "GRAPPLE" and not (myChar:GetAttribute("M2Cooldown") == true) then return "M2" end
        return "WAIT"
    end

    -- enemy is blocking → check if we can M2 guard break or execute Parry Bait Feint
    if enemyState.Blocking then
        if zone == "GRAPPLE" and not (myChar:GetAttribute("M2Cooldown") == true) then
            return "M2" -- Break guard with heavy
        end
        if zone == "MELEE" then
            local enemyPlr = enemyState.Player
            -- If enemy Parry is on recovery or CD, feint first!
            if enemyPlr and not isEnemySkillOnCD(enemyPlr.UserId, "Parry") then
                return "FEINT" -- Bait enemy parry!
            end
            return "WAIT" -- don't punch blindly into block
        end
        return "NONE"
    end

    -- multi-fight: be conservative
    if multiCount > 1 then
        if zone == "MELEE" then return "M1" end
        return "WAIT"
    end

    -- 1v1 normal: if enemy cannot dodge (tracked via Telemetry), punish with M2 or full M1
    if zone == "MELEE" then return "M1" end
    if zone == "GRAPPLE" and not (myChar:GetAttribute("M2Cooldown") == true) and enemyState.EvasiveCD then
        return "M2" -- guaranteed grapple punish when dodge is on CD
    end
    return "WAIT"
end

