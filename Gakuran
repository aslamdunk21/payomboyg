    HakariAnims=0.35, HakariOtherAnims=0.35, KarateAnims=0.36, KureAnims=0.34,
    MuayThaiAnims=0.33, SluggerAnims=0.36, StrikerAnims=0.29, WrestlingAnims=0.42, Grappling=0.42,
}
local COMBO_SHAVE = {0, -0.015, -0.028, -0.038}

-- smart evasive direction: in multi-fight, dodge AWAY from crowd center
local function getSmartEvasiveDir(myHRP, attackerHRP)
    local myChar = LocalPlayer.Character
    if not myChar then return "Backward" end

    local threats = getThreatsRanked(myHRP, 5)
    if #threats <= 1 then
        -- 1v1: dodge sideways to flank
        local dirs = {"Left", "Right"}
        return dirs[math.random(1, 2)]
    end

    -- multi-fight: compute crowd center, dodge away from it
    local cx, cz, count = 0, 0, 0
    for _, t in ipairs(threats) do
        local es = readEnemyState(t.Player.Character)
        if es and es.HRP then
            cx = cx + es.HRP.Position.X
            cz = cz + es.HRP.Position.Z
            count = count + 1
        end
    end
    if count == 0 then return "Backward" end
    cx, cz = cx / count, cz / count

    local awayVec = Vector3.new(myHRP.Position.X - cx, 0, myHRP.Position.Z - cz)
    if awayVec.Magnitude < 0.1 then return "Backward" end
    local localDir = myHRP.CFrame:VectorToObjectSpace(awayVec.Unit)

    if math.abs(localDir.Z) > math.abs(localDir.X) then
        return localDir.Z < 0 and "Forward" or "Backward"
    else
        return localDir.X < 0 and "Left" or "Right"
    end
end

-- decide: DODGE, PARRY, or BOTH
local function decideDefenseAction(isM2, myChar)
    local autoDefense = Options.AutoDefense and Options.AutoDefense.Value
    local autoEvasive = Options.AutoEvasive and Options.AutoEvasive.Value
    local canDodge = autoEvasive and not (myChar:GetAttribute("EvasiveCooldown") == true)

    if isM2 then
        -- M2 (heavy): DODGE first priority (parry timing is tight, guard break risk)
        if canDodge then return "DODGE" end
        if autoDefense then return "PARRY" end
        return "NONE"
    else
        -- M1 (light): PARRY preferred (saves dodge CD for heavies)
        if autoDefense then return "PARRY" end
        if canDodge then return "DODGE" end
        return "NONE"
    end
end

local function monitorAnimator(enemyPlayer, animator)
    local conn = animator.AnimationPlayed:Connect(function(track)
        if enemyPlayer == LocalPlayer then return end
        local autoDefense = Options.AutoDefense and Options.AutoDefense.Value
        local autoEvasive = Options.AutoEvasive and Options.AutoEvasive.Value
        if not autoDefense and not autoEvasive then return end

        local trackId = string.match(track.Animation.AnimationId, "%d+")
        if not trackId then return end

        local moveData = StrictCombatMovements[trackId]

        -- fallback: detect unknown combat anims via Priority
        if not moveData then
            local pri = track.Priority
            if pri == Enum.AnimationPriority.Action
            or pri == Enum.AnimationPriority.Action2
            or pri == Enum.AnimationPriority.Action3
            or pri == Enum.AnimationPriority.Action4 then
                local nameUp = string.upper(track.Animation.Name or "")
                local guessHeavy = not not (string.find(nameUp, "M2") or string.find(nameUp, "BREAK") or string.find(nameUp, "HEAVY"))
                moveData = { Style = "Unknown", Name = track.Animation.Name or "?", IsHeavy = guessHeavy, IsEHit = false, ComboIndex = 1 }
            end
        end
        if not moveData then return end

        local myChar  = LocalPlayer.Character
        local myHRP   = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local enemyChar = enemyPlayer.Character
        local enemyHRP  = enemyChar and enemyChar:FindFirstChild("HumanoidRootPart")
        if not myHRP or not enemyHRP then return end

        local dist = (myHRP.Position - enemyHRP.Position).Magnitude
        if dist > MAX_REACH_DISTANCE then return end

        local isM2       = moveData.IsHeavy
        local isEHit     = moveData.IsEHit
        local comboIndex = moveData.ComboIndex
        local styleName  = moveData.Style

        -- Record skill usage telemetry
        if enemyPlayer and enemyPlayer.UserId then
            if isM2 then
                trackEnemySkillUse(enemyPlayer.UserId, "M2", 3.8)
            end
            if isEHit then
                trackEnemySkillUse(enemyPlayer.UserId, "Evasive", 4.0)
            end
        end

        local fired = false
        local markerConns = {}
        local stopConn
        local fallbackThread

        local function cleanup()
            for _, c in ipairs(markerConns) do pcall(c.Disconnect, c) end
            if stopConn then pcall(stopConn.Disconnect, stopConn) end
            if fallbackThread then pcall(task.cancel, fallbackThread) end
        end

        local function doDefense()
            if fired then return end
            fired = true
            cleanup()

            local mc = LocalPlayer.Character
            local mh = mc and mc:FindFirstChild("HumanoidRootPart")
            local ec = enemyPlayer.Character
            local eh = ec and ec:FindFirstChild("HumanoidRootPart")
            if not mh or not eh then return end
            if mc:GetAttribute("Grappling") == true then return end

            local states = mc:FindFirstChild("States")
            if states then
                local beingGripped = states:FindFirstChild("BeingGripped")
                if beingGripped and beingGripped:IsA("ObjectValue") and beingGripped.Value ~= nil then return end
            end

            -- always face attacker
            forceLookAt(mh, eh, 0.35)

            local action = decideDefenseAction(isM2, mc)

            if action == "DODGE" then
                task.spawn(function()
                    if mc:GetAttribute("Grappling") == true then return end
                    local dir = getSmartEvasiveDir(mh, eh)
                    pcall(function() callClientFunction("Combat", "Evasive", "Evasive", dir) end)
                end)

            elseif action == "PARRY" then
                task.spawn(function()
                    if mc:GetAttribute("Grappling") == true then return end
                    local sigs = {
                        {"Combat","Block","Block"},
                        {"Combat","Block","OnBlockActivated"},
                        {"Combat","Block","StartBlock"},
                        {"Block","Block","Block"},
                        {"Block","Block","OnBlockActivated"},
                    }
                    for _, s in ipairs(sigs) do
                        pcall(function() callClientFunction(s[1], s[2], s[3]) end)
                    end
                    local holdTime = isM2 and 0.55 or 0.25
                    task.wait(holdTime)
                    pcall(function() callClientFunction("Combat", "Block", "Unblock") end)
                    pcall(function() callClientFunction("Combat", "Block", "OnBlockDeactivated") end)
                    pcall(function() callClientFunction("Block", "Block", "Unblock") end)
                end)
            end
        end

        for _, markerName in ipairs({"Hitbox", "Hit", "HitboxOpen", "Attack", "Strike", "Impact", "Fire"}) do
            local c = track:GetMarkerReachedSignal(markerName):Connect(function()
                doDefense()
            end)
            table.insert(markerConns, c)
        end

        stopConn = track.Stopped:Connect(cleanup)

        local fireAt
        if isM2 then
            fireAt = math.max(0.03, (M2_BASE_DELAY[styleName] or 0.37) - 0.045)
        else
            local base = M1_BASE_DELAY[styleName] or 0.22
            if isEHit then base = base * 0.82 end
            local shave = COMBO_SHAVE[math.clamp(comboIndex, 1, 4)] or -0.038
            fireAt = math.max(0.03, math.max(0.07, base + shave) - 0.045)
        end

        fallbackThread = task.delay(fireAt, doDefense)
    end)
    registerCleanup(conn)
end

local function setupPlayerTracking(player)
    if player == LocalPlayer then return end

    local function attachAnimator(char)
        if not char then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
        if not humanoid then return end

        local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 5)
        if animator then
            monitorAnimator(player, animator)
        else
            local cConn
            cConn = humanoid.ChildAdded:Connect(function(child)
                if child:IsA("Animator") then
                    cConn:Disconnect()
                    monitorAnimator(player, child)
                end
            end)
            registerCleanup(cConn)
        end
    end

    local cAdded = player.CharacterAdded:Connect(attachAnimator)
    registerCleanup(cAdded)

    if player.Character then
        task.spawn(attachAnimator, player.Character)
    end
end

local pAdded = Players.PlayerAdded:Connect(setupPlayerTracking)
registerCleanup(pAdded)
for _, p in pairs(Players:GetPlayers()) do setupPlayerTracking(p) end

-- ── 12. ฟังก์ชัน No-Slow ───────────────────────────────────────────────────────
local _lastGrappleEnd = 0
local POSTGRAPPLE_GRACE = 1.2
local _noSlowConn = nil

local function activateNoSlow()
    if _noSlowConn then return end
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local hum = myChar:FindFirstChildOfClass("Humanoid") or myChar:WaitForChild("Humanoid", 3)
    if not hum then return end

    local baseWalk = hum.WalkSpeed
    local baseJump = hum.JumpPower

    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
    end)

    local badAttrs = {"Stunned", "GuardBroken", "CantAnything"}

    _noSlowConn = RunService.Heartbeat:Connect(function()
        if not (Options.NoSlow and Options.NoSlow.Value) then
            if _noSlowConn then
                _noSlowConn:Disconnect()
                _noSlowConn = nil
            end
            return
        end
        local char = LocalPlayer.Character
        local h = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not h then return end

        if char:GetAttribute("Grappling") == true then
            _lastGrappleEnd = os.clock()
            return
        end
        if (os.clock() - _lastGrappleEnd) < POSTGRAPPLE_GRACE then return end
        local states = char:FindFirstChild("States")
        if states then
            local beingGripped = states:FindFirstChild("BeingGripped")
            if beingGripped and beingGripped:IsA("ObjectValue") and beingGripped.Value ~= nil then return end
        end

        if h.WalkSpeed ~= baseWalk then h.WalkSpeed = baseWalk end
        if h.JumpPower ~= baseJump then h.JumpPower = baseJump end
        if h.PlatformStand then h.PlatformStand = false end

        local st = h:GetState()
        if st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Ragdoll then
            h:ChangeState(Enum.HumanoidStateType.Running)
        end

        for _, attr in ipairs(badAttrs) do
            if char:GetAttribute(attr) == true then
                char:SetAttribute(attr, false)
            end
        end
    end)
    registerCleanup(_noSlowConn)
end

ToggleNoSlow:OnChanged(function(Value)
    if Value then
        activateNoSlow()
    end
end)

