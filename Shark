local function addRow(pkt)
    if not matchFilter(pkt) then return end
    pcall(function()
        local even = pkt.id % 2 == 0
        local row  = Instance.new("TextButton")
        row.Name           = "Row_" .. pkt.id
        row.LayoutOrder    = pkt.id
        row.Size           = UDim2.new(1, 0, 0, 20)
        row.BackgroundColor3 = even and C.ROW_B or C.ROW_A
        row.BorderSizePixel  = 0
        row.Text           = ""
        row.AutoButtonColor = false
        row.Parent         = ListScroll

        local sep = Instance.new("Frame")
        sep.Size           = UDim2.new(1, 0, 0, 1)
        sep.Position       = UDim2.new(0, 0, 1, -1)
        sep.BackgroundColor3 = C.BORDER
        sep.BorderSizePixel  = 0
        sep.ZIndex         = 2
        sep.Parent         = row

        local function cell(txt, x, w, col, al)
            local l = Instance.new("TextLabel")
            l.Size          = UDim2.new(0, w, 1, 0)
            l.Position      = UDim2.new(0, x, 0, 0)
            l.BackgroundTransparency = 1
            l.Text          = tostring(txt)
            l.TextColor3    = col or C.TEXT
            l.TextSize      = 11
            l.Font          = Enum.Font.Code
            l.TextXAlignment = al or Enum.TextXAlignment.Left
            l.ClipsDescendants = true          -- replaces TextTruncate (broken in some execs)
            l.ZIndex        = 2
            l.Parent        = row
        end

        cell(tostring(pkt.id),                 6,  30, C.SUBTEXT)
        cell(pkt.time,                         40,  80, C.SUBTEXT)
        cell(pkt.method,                      124,  58, methodColor(pkt.method))
        cell(truncate(pkt.url, 60),           186, 365, C.TEXT)
        cell(statusLabel(pkt.status, pkt.err),556,  52, statusColor(pkt.status), Enum.TextXAlignment.Center)
        cell(pkt.responseSize and tostring(pkt.responseSize) .. "B" or "—",
                                              612,  60, C.SUBTEXT, Enum.TextXAlignment.Center)
        cell(pkt.latency and string.format("%.0f", pkt.latency * 1000) or "—",
                                              676,  60, C.SUBTEXT, Enum.TextXAlignment.Center)

        row.MouseButton1Click:Connect(function()
            if selectedIdx and rowFrames[selectedIdx] then
                local pr = rowFrames[selectedIdx]
                local pe = selectedIdx % 2 == 0
                pr.BackgroundColor3 = pe and C.ROW_B or C.ROW_A
            end
            selectedIdx = pkt.id
            row.BackgroundColor3 = C.ROW_SEL
            pcall(function()
                DetailText.Text = buildDetail(pkt)
            end)
        end)

        row.MouseEnter:Connect(function()
            if selectedIdx ~= pkt.id then
                row.BackgroundColor3 = Color3.fromHex("0f1e0f")
            end
        end)
        row.MouseLeave:Connect(function()
            if selectedIdx ~= pkt.id then
                row.BackgroundColor3 = even and C.ROW_B or C.ROW_A
            end
        end)

        rowFrames[pkt.id] = row

        if not selectedIdx then
            task.defer(function()
                ListScroll.CanvasPosition = Vector2.new(
                    0, math.max(0, ListLayout.AbsoluteContentSize.Y - ListFrame.AbsoluteSize.Y)
                )
            end)
        end
    end)
end

local function logPacket(pkt)
    if paused then return end
    packetCount   += 1
    pkt.id         = packetCount
    packets[#packets + 1] = pkt

    if #packets > MAX_PACKETS then
        local old = table.remove(packets, 1)
        pcall(function()
            if rowFrames[old.id] then
                rowFrames[old.id]:Destroy()
                rowFrames[old.id] = nil
            end
        end)
    end

    pcall(function() CountLabel.Text = packetCount .. " packets" end)

    print(string.format("[Sempshark] #%d  %s  %s  → %s",
        pkt.id, pkt.method, pkt.url, statusLabel(pkt.status, pkt.err)))

    addRow(pkt)
end

local function intercept(method, url, reqHeaders, reqBody, callFn, ...)
    local vargs = table.pack(...)
    local t0    = tick()

    local results = table.pack(pcall(callFn, table.unpack(vargs, 1, vargs.n)))
    local dt      = tick() - t0
    local ok      = results[1]

    task.spawn(function()
        pcall(function()
            local resp     = ok and results[2] or nil
            local status   = 200
            local respBody = nil

            if ok then
                if type(resp) == "table" then
                    status   = resp.StatusCode or 200
                    respBody = resp.Body
                else
                    respBody = tostring(resp or "")
                end
            end

            logPacket({
                time         = elapsed(),
                method       = method,
                url          = url,
                reqHeaders   = reqHeaders,
                reqBody      = reqBody,
                response     = respBody,
                responseSize = respBody and #respBody or 0,
                status       = ok and status or nil,
                err          = not ok and tostring(results[2]) or nil,
                latency      = dt,
            })
        end)
    end)

    if ok then
        return table.unpack(results, 2, results.n)
    else
        error(results[2], 2)
    end
end

local oldNC
oldNC = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args   = table.pack(...)

    local isHS = false
    pcall(function() isHS = (self.ClassName == "HttpService") end)

    if not isHS then
        return oldNC(self, table.unpack(args, 1, args.n))
    end

    if method == "GetAsync" then
        return intercept(
            "GET", args[1] or "", args[3], nil,
            oldNC, self, table.unpack(args, 1, args.n)
        )

    elseif method == "PostAsync" then
        return intercept(
            "POST", args[1] or "", args[5], args[2],
            oldNC, self, table.unpack(args, 1, args.n)
        )

    elseif method == "RequestAsync" or method == "Request" then
        local opts = args[1] or {}
        return intercept(
            (opts.Method or "GET"):upper(),
            opts.Url or opts.url or "",
            opts.Headers,
            opts.Body,
            oldNC, self, table.unpack(args, 1, args.n)
        )
    end

    return oldNC(self, table.unpack(args, 1, args.n))
end)

local function wrapExecReq(fn)
    if type(fn) ~= "function" then return fn end
    local old = fn
    return hookfunction(old, function(opts)
        opts = opts or {}
        local url    = opts.Url or opts.url or ""
        local meth   = (opts.Method or opts.method or "GET"):upper()
        local t0     = tick()
        local results = table.pack(pcall(old, opts))
        local dt     = tick() - t0
        local ok     = results[1]
        local resp   = ok and results[2] or nil
        task.spawn(function()
            pcall(function()
                local body = resp and (type(resp) == "table" and (resp.Body or resp.body) or tostring(resp)) or nil
                logPacket({
                    time         = elapsed(),
                    method       = meth,
                    url          = url,
                    reqHeaders   = opts.Headers or opts.headers,
                    reqBody      = opts.Body or opts.body,
                    response     = body,
                    responseSize = body and #body or 0,
                    status       = ok and (type(resp) == "table" and (resp.StatusCode or resp.status_code) or 200) or nil,
                    err          = not ok and tostring(results[2]) or nil,
                    latency      = dt,
                })
            end)
        end)
        if ok then return table.unpack(results, 2, results.n) end
        error(results[2], 2)
    end)
end

