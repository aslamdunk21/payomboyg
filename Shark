local function elapsed()
    local e = tick() - START_TIME
    return string.format("%02d:%06.3f", math.floor(e / 60), e % 60)
end

local function methodColor(m) return C[m] or C.OTHER end

local function statusColor(c)
    if not c            then return C.SERR end
    if c >= 500         then return C.S5XX end
    if c >= 400         then return C.S4XX end
    if c >= 300         then return C.S3XX end
    if c >= 200         then return C.S2XX end
    return C.SERR
end

local function statusLabel(code, err)
    if err  then return "ERR" end
    if code then return tostring(code) end
    return "???"
end

local function truncate(s, n)
    s = tostring(s or "")
    return #s > n and s:sub(1, n) .. "…" or s
end

local function safeEncode(v)
    if type(v) == "table" then
        local ok, s = pcall(function() return HttpService:JSONEncode(v) end)
        return ok and s or tostring(v)
    end
    return tostring(v or "")
end

local function prettyJSON(s)
    if type(s) ~= "string" then s = safeEncode(s) end
    if #s > 4000 then s = s:sub(1, 4000) .. "\n…(truncated)" end
    local out, indent = {}, 0
    for i = 1, #s do
        local ch = s:sub(i, i)
        if ch == "{" or ch == "[" then
            indent += 1
            out[#out+1] = ch .. "\n" .. string.rep("  ", indent)
        elseif ch == "}" or ch == "]" then
            indent = math.max(0, indent - 1)
            out[#out+1] = "\n" .. string.rep("  ", indent) .. ch
        elseif ch == "," then
            out[#out+1] = ch .. "\n" .. string.rep("  ", indent)
        else
            out[#out+1] = ch
        end
    end
    return table.concat(out)
end

local function escXML(s)
    s = tostring(s or "")
    return s:gsub("&","&amp;"):gsub("<","&lt;"):gsub(">","&gt;")
end

local function matchFilter(pkt)
    if filterText == "" then return true end
    local f = filterText:lower()
    return (pkt.url    or ""):lower():find(f, 1, true)
        or (pkt.method or ""):lower():find(f, 1, true)
        or tostring(pkt.status or ""):find(f, 1, true)
end

local function buildDetail(pkt)
    local function kv(label, val, col)
        col = col or "c5e8c5"
        return string.format(
            '<font color="#6a8f6a">%-12s</font><font color="#%s">%s</font>\n',
            label, col, escXML(tostring(val or "—"))
        )
    end

    local t = {}
    t[#t+1] = string.format(
        '<font color="#00e535"><b>── Packet #%d ─────────────────────</b></font>\n', pkt.id)
    t[#t+1] = kv("TIME",    pkt.time)
    t[#t+1] = kv("METHOD",  pkt.method,
        pkt.method == "GET" and "48c86e" or pkt.method == "POST" and "ffa028" or "c5e8c5")
    t[#t+1] = kv("URL",     pkt.url)
    t[#t+1] = kv("STATUS",  statusLabel(pkt.status, pkt.err),
        pkt.err and "ff4b4b" or (pkt.status and pkt.status >= 400 and "ff4b4b" or "48c86e"))
    t[#t+1] = kv("LATENCY", pkt.latency and string.format("%.0f ms", pkt.latency * 1000) or "—")
    t[#t+1] = kv("SIZE",    pkt.responseSize and string.format("%d B", pkt.responseSize) or "—")

    if pkt.reqHeaders and next(pkt.reqHeaders) then
        t[#t+1] = '\n<font color="#00e535"><b>── Request Headers</b></font>\n'
        for k, v in pairs(pkt.reqHeaders) do
            t[#t+1] = kv("  " .. k, v)
        end
    end

    if pkt.reqBody and pkt.reqBody ~= "" then
        t[#t+1] = '\n<font color="#00e535"><b>── Request Body</b></font>\n'
        t[#t+1] = string.format('<font color="#c8d8c8">%s</font>\n',
            escXML(prettyJSON(pkt.reqBody)))
    end

    if pkt.err then
        t[#t+1] = '\n<font color="#ff4b4b"><b>── Error</b></font>\n'
        t[#t+1] = string.format('<font color="#ff4b4b">%s</font>\n', escXML(pkt.err))
    elseif pkt.response then
        t[#t+1] = '\n<font color="#00e535"><b>── Response Body</b></font>\n'
        t[#t+1] = string.format('<font color="#c8d8c8">%s</font>\n',
            escXML(prettyJSON(pkt.response)))
    end

    return table.concat(t)
end

