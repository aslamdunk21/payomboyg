local function isToolGnome(item)
    if not item or not item:IsA("Tool") then return false end
    if item:GetAttribute("FarmerName") then return true end
    local itemType = tostring(item:GetAttribute("type") or ""):lower()
    if itemType == "farmer" or itemType == "gnome" then return true end
    if CfgFarmers and type(CfgFarmers) == "table" and CfgFarmers[item.Name] then return true end
    if string.find(string.lower(item.Name), "gnome") then return true end
    return false
end

local function GetInventoryGnomesForTrade()
    local inventory = {}
    local function scanFolder(folder)
        if not folder then return end
        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Tool") and isToolGnome(item) then
                local displayName = tostring(
                    item:GetAttribute("FarmerName")
                    or item:GetAttribute("TemplateName")
                    or item.Name
                )
                local rarityAttr = getCardRank(item)
                local mutation = getCardMutation(item)
                local key = displayName
                if tostring(rarityAttr) ~= "-" then key = key .. " | " .. tostring(rarityAttr) end
                if tostring(mutation) ~= "-" then key = key .. " | " .. tostring(mutation) end
                inventory[key] = (inventory[key] or 0) + 1
            end
        end
    end
    pcall(function()
        if LocalPlayer then
            scanFolder(LocalPlayer:FindFirstChild("Backpack") or LocalPlayer.Backpack)
            if LocalPlayer.Character then scanFolder(LocalPlayer.Character) end
        end
    end)
    local list = {}
    for key, count in pairs(inventory) do
        table.insert(list, key .. " (x" .. tostring(count) .. ")")
    end
    if #list == 0 then table.insert(list, L("NoGnomesFound")) end
    return list
end

local function GetInventoryFruitsForTrade()
    local inventory = {}
    local function scanFolder(folder)
        if not folder then return end
        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Tool") and not isToolGnome(item) then
                local displayName = tostring(
                    item:GetAttribute("PlantName")
                    or item:GetAttribute("CardName")
                    or item:GetAttribute("TemplateName")
