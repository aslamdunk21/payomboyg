local function sendDiscordWebhookReport(isTest)
    local url = CONFIG.webhookUrl
    if not url or url == "" or not url:find("https://") then
        if isTest then
            ObsidianGlassEngine:Notify({ Title = "Webhook Error", Content = CurrentLang == "TH" and "กรุณากรอก Discord Webhook URL ให้ถูกต้อง" or "Invalid Webhook URL!", Duration = 3 })
        end
        return
    end

    local requestFunc = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not requestFunc then
        if isTest then
            ObsidianGlassEngine:Notify({ Title = "Webhook Error", Content = "Executor ไม่รองรับ HTTP Request", Duration = 3 })
        end
        return
    end

    pcall(function()
        local playerName = LocalPlayer and LocalPlayer.Name or "Unknown"
        local plants, farmers = inventoryCounts()
        local embed = {
            title = "🤖 Roll A Gnome - Status Report",
            color = 65280,
            fields = {
                { name = "👤 Player", value = playerName, inline = true },
                { name = "💰 Cash", value = "$" .. abbreviate(STATE.money), inline = true },
                { name = "📈 Income", value = "$" .. abbreviate(STATE.observed) .. "/s", inline = true },
                { name = "🎅 Gnomes Placed", value = tostring(STATE.gnomes) .. "/" .. tostring(STATE.gnomeCap > 0 and STATE.gnomeCap or "?"), inline = true },
                { name = "🌾 Harvested Crops", value = tostring(STATE.collected), inline = true },
                { name = "🎲 Rolls / Bought", value = tostring(STATE.rolls) .. " / " .. tostring(STATE.bought), inline = true },
            },
            footer = { text = "PayomboyZ Hub • " .. os.date("%X") }
        }

        local payload = game:GetService("HttpService"):JSONEncode({
            username = "PayomboyZ Gnome Bot",
            avatar_url = "https://i.imgur.com/8N4M9e7.png",
            embeds = { embed }
        })

        requestFunc({
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = payload
        })

        if isTest then
            ObsidianGlassEngine:Notify({ Title = "Webhook Success", Content = CurrentLang == "TH" and "ส่งรายงานเข้า Discord เรียบร้อย!" or "Webhook sent successfully!", Duration = 3 })
        end
    end)
end

