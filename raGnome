local Replication = requireIdent(ReplicatedStorage:WaitForChild("Replication", 30))

local CfgFarmers  = requireIdent(Configs and Configs:WaitForChild("Farmers", 30))
local CfgPlants   = requireIdent(Configs and Configs:WaitForChild("Plants", 30))
local CfgTree     = requireIdent(Configs and Configs:WaitForChild("Upgrade Tree", 30))
local CfgRebirths = requireIdent(Configs and Configs:WaitForChild("Rebirths", 30))
local CfgExpand   = requireIdent(Configs and Configs:WaitForChild("Expand", 30))

