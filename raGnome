local SelectedConfigName = "default"

local function getConfigFilePath(name)
    local clean = tostring(name or "default"):gsub("[%s/\\%?%%%*:%|\"<>]", "")
    if clean == "" then clean = "default" end
    return clean .. "_rollagnome_config.json"
end

local function getSavedConfigFiles()
    local files = { "default" }
    pcall(function()
        if type(listfiles) == "function" then
            for _, path in ipairs(listfiles("")) do
                local filename = path:match("([^/\\]+)$")
                if filename and filename:find("_rollagnome_config%.json$") then
                    local cfgName = filename:gsub("_rollagnome_config%.json", "")
                    if cfgName ~= "" and not table.find(files, cfgName) then
                        table.insert(files, cfgName)
                    end
                end
            end
        end
    end)
    return files
end

local function SaveConfigFile(name)
    pcall(function()
        local cfgName = (name and tostring(name) ~= "") and name or SelectedConfigName
        local filePath = getConfigFilePath(cfgName)
        local dataToSave = {}
        for k, v in pairs(CONFIG) do
            if type(v) ~= "function" then
                dataToSave[k] = v
            end
        end
        local json = game:GetService("HttpService"):JSONEncode(dataToSave)
        writefile(filePath, json)
        ObsidianGlassEngine:Notify({
            Title = L("ConfigSection"),
            Content = (CurrentLang == "TH" and "บันทึก Config (" .. cfgName .. ") เรียบร้อย!" or "Config (" .. cfgName .. ") saved!"),
            Duration = 3
        })
    end)
end

