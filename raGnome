local AutoGiftToggle = Tabs.Trade:AddToggle("AutoGiftCards", { Title = L("AutoGiftToggle"), Default = false })
AutoGiftToggle:OnChanged(function(state)
    getgenv().AutoGiftCards = state
    if state then
        task.spawn(function()
            while getgenv().AutoGiftCards do
                local targetPlayer = findTargetPlayer(getgenv().SelectedTradePlayer)
                if targetPlayer and targetPlayer.Character then
                    local targetHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local localChar = LocalPlayer and LocalPlayer.Character
                    if targetHrp and localChar and localChar:FindFirstChild("Humanoid") then
                        
                        local function getGiftableTool()
                            local hasGnomeSel = getgenv().SelectedTradeGnomes and next(getgenv().SelectedTradeGnomes) ~= nil
                            local hasFruitSel = getgenv().SelectedTradeFruits and next(getgenv().SelectedTradeFruits) ~= nil

                            local function isSelected(t)
                                if not t:IsA("Tool") then return false end
                                local isGnome = isToolGnome(t)

                                if isGnome and hasGnomeSel then
                                    local displayName = tostring(t:GetAttribute("FarmerName") or t:GetAttribute("TemplateName") or t.Name)
                                    local key = displayName
                                    local r = getCardRank(t)
                                    local m = getCardMutation(t)
                                    if tostring(r) ~= "-" then key = key .. " | " .. tostring(r) end
                                    if tostring(m) ~= "-" then key = key .. " | " .. tostring(m) end
                                    for sel, _ in pairs(getgenv().SelectedTradeGnomes) do
                                        if sel:find(displayName, 1, true) or sel:find(t.Name, 1, true) or sel:find(key, 1, true) then return true end
                                    end
                                    return false
                                elseif not isGnome and hasFruitSel then
                                    local displayName = tostring(t:GetAttribute("PlantName") or t:GetAttribute("CardName") or t:GetAttribute("TemplateName") or t.Name)
                                    local key = displayName
                                    local r = getCardRank(t)
                                    local m = getCardMutation(t)
                                    if tostring(r) ~= "-" then key = key .. " | " .. tostring(r) end
                                    if tostring(m) ~= "-" then key = key .. " | " .. tostring(m) end
                                    for sel, _ in pairs(getgenv().SelectedTradeFruits) do
                                        if sel:find(displayName, 1, true) or sel:find(t.Name, 1, true) or sel:find(key, 1, true) then return true end
                                    end
                                    return false
                                elseif not hasGnomeSel and not hasFruitSel then
                                    return true
                                end
                                return false
                            end

                            local backpack = LocalPlayer and (LocalPlayer:FindFirstChild("Backpack") or LocalPlayer.Backpack)
                            if backpack then
                                for _, t in ipairs(backpack:GetChildren()) do
                                    if isSelected(t) then return t end
                                end
                            end
                            if localChar then
                                for _, t in ipairs(localChar:GetChildren()) do
                                    if isSelected(t) then return t end
                                end
                            end
                            return nil
                        end

                        local tool = getGiftableTool()
                        if tool then
                            if tool.Parent ~= localChar then
                                localChar.Humanoid:EquipTool(tool)
                                task.wait(0.1)
                            end
                            local localHrp = localChar:FindFirstChild("HumanoidRootPart")
                            if localHrp then localHrp.CFrame = targetHrp.CFrame + Vector3.new(0, 3, 0) end
                            task.wait(0.1)

                            local function tryFireGiftPrompts()
                                local targetPos = targetHrp.Position
                                local toolUid = tool:GetAttribute("uuid") or tool:GetAttribute("UUID") or tool:GetAttribute("uid") or tool:GetAttribute("UID") or tool:GetAttribute("id") or tool.Name

                                -- 1. Fire RemoteEvent directly if present in Communication.Events
                                pcall(function()
                                    local comm = game:GetService("ReplicatedStorage"):FindFirstChild("Communication")
                                    local events = comm and comm:FindFirstChild("Events")
                                    if events then
                                        for _, child in ipairs(events:GetChildren()) do
                                            if child:IsA("RemoteEvent") then
                                                pcall(function()
                                                    child:FireServer(targetPlayer, toolUid)
                                                end)
                                            end
                                        end
                                    end
                                end)

                                -- 2. Fire ProximityPrompts
                                local function checkPrompt(desc)
                                    if not desc:IsA("ProximityPrompt") then return end
                                    local action = string.lower(desc.ActionText or "")
                                    local obj = string.lower(desc.ObjectText or "")
                                    local name = string.lower(desc.Name or "")
                                    if action:find("gift") or obj:find("gift") or name:find("gift")
                                        or action:find("ส่ง") or action:find("trade") or action:find("แลก")
                                        or action:find("give") or obj:find("give") then
                                        desc.RequiresLineOfSight = false
                                        desc.MaxActivationDistance = 99999
                                        fireproximityprompt(desc)
                                    end
                                end
                                for _, desc in ipairs(targetPlayer.Character:GetDescendants()) do
                                    checkPrompt(desc)
                                end
                                for _, desc in ipairs(workspace:GetDescendants()) do
                                    if desc:IsA("ProximityPrompt") then
                                        local pPos
                                        pcall(function()
                                            if desc.Parent:IsA("BasePart") then pPos = desc.Parent.Position
                                            elseif desc.Parent:IsA("Attachment") then pPos = desc.Parent.WorldPosition
                                            elseif desc.Parent and desc.Parent.Parent and desc.Parent.Parent:IsA("Model") and desc.Parent.Parent.PrimaryPart then
                                                pPos = desc.Parent.Parent.PrimaryPart.Position
                                            end
                                        end)
                                        if pPos and (pPos - targetPos).Magnitude <= 20 then
                                            checkPrompt(desc)
                                        end
                                    end
                                end
                            end

                            local function autoConfirmGiftSender()
                                for i = 1, 8 do
                                    pcall(function()
                                        local playerGui = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
                                        if playerGui then
                                            for _, descendant in ipairs(playerGui:GetDescendants()) do
                                                if (descendant:IsA("TextButton") or descendant:IsA("ImageButton")) and descendant.Visible then
                                                    local btnText = ""
                                                    if descendant:IsA("TextButton") then
                                                        btnText = string.upper(string.match(descendant.Text or "", "^%s*(.-)%s*$") or "")
                                                    else
                                                        local lbl = descendant:FindFirstChildOfClass("TextLabel")
                                                        if lbl then btnText = string.upper(string.match(lbl.Text or "", "^%s*(.-)%s*$") or "") end
                                                    end

                                                    if btnText == "YES" or btnText == "YES!" or btnText == "GIVE" or btnText == "CONFIRM" or btnText == "ตกลง" or btnText == "ส่ง" then
                                                        local parentModal = descendant.Parent
                                                        local isGivePrompt = false
                                                        pcall(function()
                                                            if parentModal then
                                                                for _, sub in ipairs(parentModal:GetDescendants()) do
                                                                    if sub:IsA("TextLabel") and sub.Text then
                                                                        local txt = string.lower(sub.Text)
                                                                        if txt:find("give") or txt:find("want to give") or txt:find("hey") or txt:find("ส่ง") then
                                                                            isGivePrompt = true
                                                                            break
                                                                        end
                                                                    end
                                                                end
                                                            end
                                                        end)

                                                        if isGivePrompt or btnText == "YES" then
                                                            local fired = false
                                                            if getconnections then
                                                                for _, conn in pairs(getconnections(descendant.MouseButton1Click)) do conn:Fire() fired = true end
                                                                for _, conn in pairs(getconnections(descendant.Activated)) do conn:Fire() fired = true end
                                                            end
                                                            if not fired then
                                                                local vim = game:GetService("VirtualInputManager")
                                                                local center = descendant.AbsolutePosition + (descendant.AbsoluteSize / 2)
                                                                vim:SendMouseButtonEvent(center.X, center.Y + 36, 0, true, game, 1)
                                                                task.wait(0.05)
                                                                vim:SendMouseButtonEvent(center.X, center.Y + 36, 0, false, game, 1)
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end)
                                    task.wait(0.1)
                                end
                            end

                            tryFireGiftPrompts()
                            autoConfirmGiftSender()
                            task.wait(0.5)
                        else
                            task.wait(1)
                        end
                    end
                end
                task.wait(0.5)
            end
        end)
    end
end)

