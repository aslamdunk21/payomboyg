local function abbreviate(n)
    n = tonumber(n) or 0
    local units = { "", "K", "M", "B", "T", "Qd", "Qn" }
    local index = 1
    while math.abs(n) >= 1000 and index < #units do
        n = n / 1000
        index = index + 1
    end
    if index == 1 then return string.format("%d", n) end
    return string.format("%.2f%s", n, units[index])
end

