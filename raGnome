                ObsidianGlassEngine:Notify({
                    Title = L("ConfigSection"),
                    Content = (CurrentLang == "TH" and "โหลด Config (" .. cfgName .. ") เรียบร้อย!" or "Config (" .. cfgName .. ") loaded!"),
                    Duration = 3
