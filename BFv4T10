-- ⚡ Token Bucket Rate Limiter & Safe Remote Wrapper
local Limiter = { buckets = {} }

function Limiter:Allow(key, perSec)
    local b = self.buckets[key] or { tokens = perSec, last = os.clock() }
    local now = os.clock()
    b.tokens = math.min(perSec, b.tokens + (now - b.last) * perSec)
    b.last = now
    if b.tokens < 1 then return false end
    b.tokens = b.tokens - 1
    self.buckets[key] = b
    return true
end

local SafeRemote = { lastQuestState = nil }

function SafeRemote:InvokeQuest(questName, questLevel)
    local stateKey = tostring(questName) .. "_" .. tostring(questLevel)
    if self.lastQuestState == stateKey then
        if not Limiter:Allow("QuestRemote_Repeat", 0.2) then
            return false
        end
    else
        if not Limiter:Allow("QuestRemote_Change", 2.0) then
            return false
        end
        self.lastQuestState = stateKey
    end

    local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes") and game.ReplicatedStorage.Remotes:FindFirstChild("CommF_")
    if remote then
        local success, result = pcall(function()
            return remote:InvokeServer("StartQuest", questName, questLevel)
        end)
        return success, result
    end
    return false
end

-- 🎨 1. UI Pooling Engine & Auto-Degrade Performance Manager
local NotifPool = { free = {}, MAX = 8 }

function NotifPool:Get()
    local item = table.remove(self.free)
    if not item then
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, 240, 0, 40)
        frame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        local text = Instance.new("TextLabel", frame)
        text.Size = UDim2.new(1, 0, 1, 0)
        text.TextColor3 = Color3.fromRGB(255, 255, 255)
        text.BackgroundTransparency = 1
        item = frame
    end
    item.Visible = true
    return item
end

function NotifPool:Return(item)
    if not item then return end
    item.Visible = false
    item.Parent = nil
    if #self.free < self.MAX then
        table.insert(self.free, item)
    else
        item:Destroy()
    end
end

