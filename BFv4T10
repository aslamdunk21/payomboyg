-- 🛡️ 2. Comprehensive RecoveryService & Verify-After-Act Engine
local RecoveryService = { failureCounts = {} }

function RecoveryService:Escalate(actionName)
    local count = (self.failureCounts[actionName] or 0) + 1
    self.failureCounts[actionName] = count

    if count >= 3 then
        self.failureCounts[actionName] = 0
        local hrp = LP and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CFrame = CFrame.new(1250, 50, -5100) end
    end
    if count >= 5 then
        local ts = game:GetService("TeleportService")
        pcall(function() ts:Teleport(game.PlaceId) end)
    end
end

local function Act(fn, verify, actionName, retries)
    retries = retries or 3
    for i = 1, retries do
        fn()
        task.wait(0.8)
        if verify() then
            RecoveryService.failureCounts[actionName] = 0
            return true
        end
    end
    RecoveryService:Escalate(actionName)
    return false
end

