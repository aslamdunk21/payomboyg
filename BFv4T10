local Controller = {
    Owner = nil,
    Priority = 0,
    LastSwitchTime = os.clock(),
    Modules = {},
    LockOwner = nil,
    hardLock = nil,
    Status = "Initialized"
}

function Controller:Current()
    return self.Owner
end

function Controller:Acquire(name, priority)
    if self.hardLock and self.hardLock ~= name and priority < 999 then
        return false, "hard-locked by " .. tostring(self.hardLock)
    end
    if self.LockOwner and self.LockOwner ~= name then
        return false
    end
    if self.Owner == nil or priority > self.Priority or self.Owner == name then
        if self.Owner and self.Owner ~= name and self.Modules[self.Owner] and self.Modules[self.Owner].Suspend then
            pcall(function() self.Modules[self.Owner]:Suspend() end)
        end
        if self.Owner ~= name then
            self.LastSwitchTime = os.clock()
        end
        self.Owner = name
        self.Priority = priority
        return true
    end
    return false
end

function Controller:Release(name)
    if self.Owner == name then
        self.Owner = nil
        self.Priority = 0
        if self.LockOwner == name then self.LockOwner = nil end
        return true
    end
    return false
end

function Controller:CanServerHop()
    if self.LockOwner == "V2_FLOWER" then return false end
    if self.Owner == "BLUE_GEAR" or self.Owner == "TRIAL_EXECUTION" then return false end
    return true
end

