-- 💰 4. Cross-Stage Pre-Provisioning Evaluator
local TOTAL_NEED = {
    beli = 500000 + 2000000 + 1000000,
    frag = 3000 + 26750
}

local function ShouldPrioritizeBeli(s, currentBeliPerHour)
    local gap = TOTAL_NEED.beli - s.beli
    if gap <= 0 then return false end
    local etaLevelSec = (1000 - math.min(1000, s.level)) * 120
    local etaBeliSec = (gap / math.max(1, currentBeliPerHour or 500000)) * 3600
    return etaBeliSec > etaLevelSec
end

