local function createTab(tabId, icon, labelText)
    local btn = Instance.new("TextButton")
    btn.Name = "TabBtn_" .. tabId
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = COLORS.glassDeep
    btn.BackgroundTransparency = 0.40
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.Parent = tabButtonsFrame

    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 8)
    bCorner.Parent = btn

    local bStroke = Instance.new("UIStroke")
    bStroke.Color = COLORS.cyan
    bStroke.Thickness = 1
    bStroke.Transparency = 1
    bStroke.Parent = btn

    local bLabel = Instance.new("TextLabel")
    bLabel.Size = UDim2.new(1, -16, 1, 0)
    bLabel.Position = UDim2.new(0, 12, 0, 0)
    bLabel.BackgroundTransparency = 1
    bLabel.Text = icon .. "  " .. labelText
    bLabel.TextColor3 = COLORS.textMuted
    bLabel.Font = Enum.Font.GothamBold
    bLabel.TextSize = 12
    bLabel.TextXAlignment = Enum.TextXAlignment.Left
    bLabel.Parent = btn

    local container = Instance.new("Frame")
    container.Name = "TabContainer_" .. tabId
    container.Size = UDim2.new(1, -36, 1, -100)
    container.Position = UDim2.new(0, 18, 0, 92)
    container.BackgroundTransparency = 1
    container.Visible = false
    container.ZIndex = 6
    container.Parent = mainPanel

    tabContainers[tabId] = container
    tabButtons[tabId] = { button = btn, stroke = bStroke, label = bLabel }

    btn.MouseButton1Click:Connect(function()
        playClickSound()
        for id, tab in pairs(tabContainers) do
            tab.Visible = (id == tabId)
        end
        for id, data in pairs(tabButtons) do
            if id == tabId then
                data.button.BackgroundColor3 = COLORS.surfaceRaised
                data.button.BackgroundTransparency = 0.18
                data.stroke.Transparency = 0.3
                data.label.TextColor3 = COLORS.text
            else
                data.button.BackgroundColor3 = COLORS.glassDeep
                data.button.BackgroundTransparency = 0.40
                data.stroke.Transparency = 1
                data.label.TextColor3 = COLORS.textMuted
            end
        end
    end)

    return container
end

