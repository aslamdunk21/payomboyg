            -- ============================================================
            -- MULTI-TIER TELEPORT SYSTEM (ตาม Logic: Snapshot → Try → Rollback)
            -- ============================================================

            -- 📸 Snapshot: บันทึก state ปัจจุบันก่อนทำการ Teleport
            local snapshot = {
                placeId = game.PlaceId,
                jobId = game.JobId,
                time = tick(),
                name = gameData.Name,
            }

            -- 🔄 Step 1/3: วิธีมาตรฐาน (ไม่ส่ง LocalPlayer ซึ่งเป็น Server-only API)
            hopBtn.Text = "🔄 [1/3] กำลัง Teleport..."
            TweenService:Create(hopBtn, TweenInfo.new(0.15), { BackgroundColor3 = COLORS.primaryPressed }):Play()
            local teleportOk = false

            pcall(function()
                TeleportService:Teleport(placeId)
                teleportOk = true
            end)
            if teleportOk then return end

            task.wait(0.35)

            -- 🔄 Step 2/3: TeleportAsync + TeleportOptions (วิธีใหม่กว่า)
            hopBtn.Text = "🔄 [2/3] TeleportAsync..."
            pcall(function()
                local options = Instance.new("TeleportOptions")
                options.ShouldReserveServer = false
                local result = TeleportService:TeleportAsync(placeId, {LocalPlayer}, options)
                if result then teleportOk = true end
            end)
            if teleportOk then return end

            task.wait(0.35)

            -- 🔄 Step 3/3: Reserve Private Server แล้วเข้า (สำหรับเกมที่ restrict Teleport)
            hopBtn.Text = "🔄 [3/3] Reserve & Join..."
            pcall(function()
                local code = TeleportService:ReserveServer(placeId)
                if code and code ~= "" then
                    TeleportService:TeleportToPrivateServer(placeId, code, {LocalPlayer})
                    teleportOk = true
                end
            end)
            if teleportOk then return end

            -- ❌ Rollback: ทุกวิธีล้มเหลว — คืน state กลับ พร้อมแจ้งเตือน
            hopBtn.Text = "❌ Teleport ล้มเหลว"
            TweenService:Create(hopBtn, TweenInfo.new(0.2), { BackgroundColor3 = COLORS.danger }):Play()
            ShowToast(
                "❌ เข้าแมพไม่ได้",
                "\"" .. snapshot.name .. "\" ไม่อนุญาต Teleport (Error 773)\nลองเปิดเกมตรงผ่าน Roblox แทน",
                true
            )

            -- Rollback ปุ่มกลับมา state เดิมหลัง 3 วินาที
            task.delay(3, function()
                if hopBtn and hopBtn.Parent then
                    hopBtn.Text = "🎮  เข้าเล่นแมพนี้เลย!"
                    hopBtn.Active = true
                    TweenService:Create(hopBtn, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                        BackgroundColor3 = COLORS.primary
                    }):Play()
                end
            end)
        end)
    end)

    -- Entrance animation (Roll Back style)
    card.AnchorPoint = Vector2.new(0.5, 0.5)
    card.Position = UDim2.new(0.5, 0, 0.38, 0)
