local function makeInfoRow(label, value, customValueColor)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 44)
    row.BackgroundColor3 = COLORS.surfacePressed
    row.BackgroundTransparency = 0.10
    row.BorderSizePixel = 0
    row.Parent = infoFrame

    local rCorner = Instance.new("UICorner")
    rCorner.CornerRadius = UDim.new(0, 8)
    rCorner.Parent = row

    local rStroke = Instance.new("UIStroke")
    rStroke.Color = COLORS.glassRaised
    rStroke.Thickness = 1
    rStroke.Transparency = 0.4
    rStroke.Parent = row

    -- ตัวหนังสือฝั่งซ้าย: สีขาวบริสุทธิ์ ตัวหนา
    local rLabel = Instance.new("TextLabel")
    rLabel.Size = UDim2.new(0, 200, 1, 0)
    rLabel.Position = UDim2.new(0, 14, 0, 0)
    rLabel.BackgroundTransparency = 1
    rLabel.Text = label
    rLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    rLabel.Font = Enum.Font.GothamBold
    rLabel.TextSize = 12
    rLabel.TextXAlignment = Enum.TextXAlignment.Left
    rLabel.Parent = row

    -- ตัวหนังสือฝั่งขวา: สีขาวบริสุทธิ์ (หรือสีไฮไลต์) ตัวหนา มองเห็นชัดเจน 100%
    local rVal = Instance.new("TextLabel")
    rVal.Size = UDim2.new(1, -228, 1, 0)
    rVal.Position = UDim2.new(0, 214, 0, 0)
    rVal.BackgroundTransparency = 1
    rVal.Text = tostring(value)
    rVal.TextColor3 = customValueColor or Color3.fromRGB(255, 255, 255)
    rVal.Font = Enum.Font.GothamBold
    rVal.TextSize = 12
    rVal.TextXAlignment = Enum.TextXAlignment.Right
    rVal.TextTruncate = Enum.TextTruncate.AtEnd
    rVal.Parent = row
end

