local function playClickSound()
    pcall(function()
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://6895079853"
        sound.Volume = 0.35
        sound.Parent = SoundService
        sound:Play()
        sound.Ended:Connect(function() sound:Destroy() end)
    end)
end

local function copyText(value)
    local copier = setclipboard or toclipboard
    if type(copier) == "function" then
        return pcall(copier, tostring(value))
    end
    return false
end

local customAvatarAsset = nil
local function loadCustomAvatarImage()
    if customAvatarAsset then return customAvatarAsset end
    local avatarUrl = LuarmorConfig.LogoURL
    local fileName = "payomboyz_avatar.jpg"
    pcall(function()
        if typeof(writefile) == "function" and (typeof(getcustomasset) == "function" or typeof(getsynasset) == "function") then
            local getAsset = getcustomasset or getsynasset
            local isFileExist = (typeof(isfile) == "function" and isfile(fileName))
            if not isFileExist then
                local imageBytes = game:HttpGet(avatarUrl)
                if imageBytes and #imageBytes > 0 then writefile(fileName, imageBytes) end
            end
            if typeof(isfile) == "function" and isfile(fileName) then
                customAvatarAsset = getAsset(fileName)
            end
        end
    end)
    if not customAvatarAsset then
        customAvatarAsset = "rbxthumb://type=AvatarHeadShot&id=" .. LocalPlayer.UserId .. "&w=150&h=150"
    end
    return customAvatarAsset
end

-- ==============================================================================
-- 🖼️ MULTI-TIER SMART MAP THUMBNAIL ENGINE (แก้ไขปัญหารูปภาพแมพไม่แสดง)
-- ==============================================================================
-- สาเหตุที่ภาพแมพไม่ค่อยดึงมาแสดง:
-- 1. การดึงผ่าน URL HTTP ภายนอกมักโดน Roblox Executor หรือ CORS บล็อก
-- 2. การใช้ rbxthumb://type=Asset กับ PlaceId โดยตรงจะไม่แสดงผลเพราะ PlaceId ไม่ใช่ AssetId
-- 3. rbxthumb://type=GameIcon&id={placeId} ต้องระบุประเภท GameIcon ให้ถูกต้อง
-- แก้ไข: ใช้ rbxthumb://type=GameIcon เป็นด่านแรก + ดึง IconImageAssetId จาก MarketplaceService ใน background
local function applyMapThumbnail(imageLabel, placeId)
    if not placeId or placeId == 0 then
        imageLabel.Image = "rbxassetid://68072539"
        return
    end

    -- Tier 1: Roblox Engine Native C++ rbxthumb GameIcon (รวดเร็วและตรงที่สุด)
    imageLabel.Image = string.format("rbxthumb://type=GameIcon&id=%s&w=150&h=150", tostring(placeId))

    -- Tier 2: Dynamic Async Inspection ผ่าน MarketplaceService (กรณี rbxthumb บนบาง executor ติดขัด)
    task.spawn(function()
        pcall(function()
            local info = MarketplaceService:GetProductInfo(placeId)
            if info and info.IconImageAssetId and info.IconImageAssetId > 0 then
                if imageLabel and imageLabel.Parent then
                    imageLabel.Image = "rbxassetid://" .. tostring(info.IconImageAssetId)
                end
            end
        end)
    end)
end

